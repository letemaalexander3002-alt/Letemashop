/* ===== HERO BACKGROUND ===== */
.hero-section {
  position: relative;
  min-height: 100vh;
  background-image: url('/owner.png');
  background-size: cover;
  background-position: center top;
  background-attachment: fixed;
}

.hero-section::before {
  content: '';
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 1;
}

.hero-content {
  position: relative;
  z-index: 2;
  color: white;
}

/* ===== LETEMA BACKGROUND ===== */
.app-bg {
  background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('/owner.png');
  background-size: cover;
  background-position: center top;
  background-attachment: fixed;
}

/* ===== OVERRIDE FINAL ===== */
.app-bg {
  background: linear-gradient(rgba(0,0,0,0.65), rgba(0,0,0,0.65)), url('/owner.png') !important;
  background-size: cover !important;
  background-position: center top !important;
  background-attachment: fixed !important;
}

/* ===== LETEMA FINAL LAYOUT FIX ===== */
#root {
  width: 100%;
  min-height: 100vh;
}

.app-bg {
  width: 100% !important;
  min-height: 100vh !important;
  background: linear-gradient(rgba(0,0,0,0.65), rgba(0,0,0,0.65)), url('/owner.png') !important;
  background-size: cover !important;
  background-position: center top !important;
  background-attachment: fixed !important;
  display: block !important;
}

img[src="/owner.png"] {
  display: none !important;
}

/* ===== NUCLEAR OVERRIDE ===== */
body, #root, .app-bg {
  margin: 0 !important;
  padding: 0 !important;
  width: 100% !important;
  max-width: 100% !important;
  overflow-x: hidden !important;
}

.app-bg {
  background: linear-gradient(rgba(0,0,0,0.60), rgba(0,0,0,0.60)), url('/owner.png') center top / cover fixed no-repeat !important;
}
