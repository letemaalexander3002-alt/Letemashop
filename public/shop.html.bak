// =========================================================
// ===== INIT =====
// =========================================================
document.addEventListener('DOMContentLoaded', () => {
  loadAdminProductData();
  loadAdminServiceData();
  loadStockFromStorage();
  renderProducts();
  renderServices();
  renderCart();
  updateCartCount();
  attachXSSGuards();
  updateUnreadBadge();
  updateAdminStockBadge();

  // ── Set initial active category nav link ─────────────────
  const firstCatLink = document.querySelector('.cat-link[data-cat="all"]');
  if (firstCatLink) firstCatLink.classList.add('active');

  // ── Bootstrap from Supabase: products, orders, auth ──────
  if (window.letemaSupabase) {
    // Products
    window.letemaSupabase.fetchProducts().then(rows => {
      if (rows && rows.length) {
        PRODUCTS.length = 0;
        rows.forEach(r => PRODUCTS.push(r));
        renderProducts(currentCategory);
        if (typeof renderAdminProducts === 'function') renderAdminProducts();
        if (typeof renderStockPanel === 'function')   renderStockPanel();
        updateAdminStockBadge && updateAdminStockBadge();
      }
    });
    // Admin orders
    window.letemaSupabase.fetchOrders().then(rows => {
      if (rows && rows.length) {
        adminOrders = rows;
        saveAdminOrders();
        unreadOrderCount = rows.filter(o => o.status === 'new').length;
        updateUnreadBadge();
        if (typeof renderAdminOrders === 'function') renderAdminOrders();
      }
    });
    // Live updates
    window.letemaSupabase.subscribeOrders((payload) => {
      if (payload.eventType === 'INSERT') {
        const r = payload.new;
        const exists = adminOrders.find(o => o.ref === r.ref);
        if (!exists) {
          adminOrders.unshift({
            ref: r.ref, customer: r.customer, phone: r.phone, email: r.email||'',
            address: r.address||'—', type: r.type, items: r.items||[],
            subtotal: r.subtotal, vat: r.vat, total: r.total,
            payment: r.payment, txnId: r.txn_id||'', notes: r.notes||'',
            status: r.status,
            urgency: r.urgency || null,
            serviceDetails: r.service_details || null,
            timestamp: new Date(r.created_at).toLocaleString('en-TZ',{dateStyle:'short',timeStyle:'short'}),
            date: r.created_at.slice(0,10)
          });
          saveAdminOrders();
          unreadOrderCount++;
          updateUnreadBadge();
          if (typeof renderAdminOrders === 'function') renderAdminOrders();
        }
      } else if (payload.eventType === 'UPDATE') {
        const r = payload.new;
        const o = adminOrders.find(x => x.ref === r.ref);
        if (o) { o.status = r.status; saveAdminOrders(); if (typeof renderAdminOrders === 'function') renderAdminOrders(); }
      }
    });
    // Auth — restore session
    window.letemaSupabase.getSession().then(session => {
      if (session && session.user) {
        const u = session.user;
        const md = u.user_metadata || {};
        _userSession = {
          name:  ((md.first_name || '') + ' ' + (md.last_name || '')).trim() || u.email,
          email: u.email, phone: md.phone || ''
        };
        updateUserNavUI(_userSession);
      }
    });
    window.letemaSupabase.onAuthChange(session => {
      if (!session) {
        _userSession = null;
        const loginBtn = document.getElementById('navLoginBtn');
        if (loginBtn) {
          loginBtn.textContent = '👤 Ingia';
          loginBtn.onclick = () => openModal('loginModal');
        }
      }
    });
  }

  const savedUrl = localStorage.getItem('letema_apps_script_url');
  if (savedUrl) {
    window._appsScriptUrl = savedUrl;
    const inp = document.getElementById('webhookUrlInput');
    if (inp) inp.value = savedUrl;
  }

  // ── Restore user session if previously logged in ─────────
  try {
    const session = JSON.parse(localStorage.getItem('letema_user_session') || 'null');
    if (session && session.name) {
      _userSession = session;
      updateUserNavUI(session);
    }
  } catch(e) {}

  // ── Restore runtime Whapi credentials if admin saved them ─
  const savedToken = localStorage.getItem('letema_whapi_token');
  if (savedToken) window._whapiToken = savedToken;
  const savedOwner = localStorage.getItem('letema_owner_phone');
  if (savedOwner) window._ownerPhone = savedOwner;

  // Keyboard shortcut: Ctrl+Shift+A = admin login
  document.addEventListener('keydown', e => {
    if (e.ctrlKey && e.shiftKey && e.key === 'A') openAdminLogin();
  });
});

// =========================================================
// ===== RENDER PRODUCTS =====
// =========================================================
function renderProducts(filter = 'all') {
  const grid = document.getElementById('productsGrid');
  let items = filter === 'all' ? PRODUCTS : PRODUCTS.filter(p => p.category === filter);
  if (!items.length) {
    grid.innerHTML = `<div style="grid-column:1/-1;text-align:center;padding:40px;color:var(--gray-400);font-family:var(--font-head);font-size:15px;">Hakuna bidhaa za aina hii kwa sasa.</div>`;
    return;
  }
  grid.innerHTML = items.map(p => {
    const isLow   = p.stock_quantity < 5 && p.stock_quantity > 0 && p.stock_quantity !== 999;
    const isOut   = p.stock_quantity === 0;
    const stockBadge = isOut
      ? `<span style="position:absolute;top:10px;right:10px;background:var(--danger);color:white;font-size:9px;font-weight:800;padding:3px 8px;border-radius:50px;font-family:var(--font-head);z-index:2;">IMEKWISHA</span>`
      : isLow
      ? `<span style="position:absolute;top:10px;right:10px;background:var(--warning);color:white;font-size:9px;font-weight:800;padding:3px 8px;border-radius:50px;font-family:var(--font-head);z-index:2;">INAKWISHA</span>`
      : '';
    return `
    <div class="product-card" onclick="${isOut ? '' : `openProduct(${p.id})`}" style="${isOut ? 'opacity:0.6;cursor:not-allowed;' : ''}">
      ${p.badge ? `<span class="product-badge badge-${p.badge}">${p.badge==='hot'?'🔥 Maarufu':p.badge==='new'?'✨ Mpya':'🏷️ Sale'}</span>` : ''}
      ${stockBadge}
      <div class="product-img">${p.icon}</div>
      <div class="product-body">
        <div class="product-category">${getCatLabel(p.category)}</div>
        <div class="product-name">${escapeHTML(p.name)}</div>
        <div class="product-rating">
          <span class="stars">${'★'.repeat(Math.floor(p.rating))}${'☆'.repeat(5-Math.floor(p.rating))}</span>
          <span class="rating-count">(${p.reviews})</span>
        </div>
        <div class="product-price-row">
          <div>
            <div class="product-price">TZS ${p.price.toLocaleString()}</div>
            ${p.stock_quantity !== 999 && p.stock_quantity <= 10 && p.stock_quantity > 0 ? `<div style="font-size:10px;color:var(--warning);font-weight:700;font-family:var(--font-head);margin-top:2px;">Zimebaki ${p.stock_quantity} tu</div>` : ''}
          </div>
          <div class="add-to-cart" onclick="event.stopPropagation();${isOut ? '' : `addToCart(${p.id})`}" style="${isOut ? 'opacity:0.4;cursor:not-allowed;' : ''}" title="${isOut ? 'Bidhaa imekwisha' : 'Ongeza mkononi'}">🛒</div>
        </div>
      </div>
    </div>`;
  }).join('');
}

function getCatLabel(cat) {
  return {
    shule:                '📚 Vifaa Shule',
    ofisi:                '🗂️ Vifaa Ofisi',
    dijitali:             '💾 Kidijitali',
    tech:                 '🔌 Tech',
    picha:                '📸 Picha',
    serikali:             '🏛️ E-Gov',
    kitaalamu:            '💼 Kitaalamu',
    huduma:               '🖨️ Huduma',
    michezo:              '⚽ Vifaa Michezo',
    'dijital-mawasiliano':'📡 Kidijitali & Mawasiliano',
  }[cat] || cat;
}

// =========================================================
// ===== RENDER SERVICES =====
// =========================================================
// CORE_SERVICES: all services that belong in the main Stationery Services grid
// Digital & Communication services (sd*) have their own dedicated section and are excluded here.
const CORE_SERVICE_CATEGORIES = ['huduma','serikali','kitaalamu','picha'];

function renderServices() {
  const grid = document.getElementById('servicesGrid');
  const coreServices = SERVICES.filter(s => CORE_SERVICE_CATEGORIES.includes(s.category));
  grid.innerHTML = coreServices.map(s => `
    <div class="service-card ${s.gold?'gold':''}">
      <div class="service-icon-wrap">${s.icon}</div>
      <div class="service-name">${escapeHTML(s.name)}</div>
      <div class="service-desc">${escapeHTML(s.desc)}</div>
      <span class="service-price">${s.price}</span>
      <button class="order-direct-btn" onclick="openOrderModal('${escapeAttr(s.id)}')">⚡ Agiza Moja kwa Moja</button>
    </div>`).join('');
}

// =========================================================
// ===== FILTER =====
// =========================================================
function filterCategory(cat, el) {
  currentCategory = cat;
  document.querySelectorAll('.cat-link').forEach(l => l.classList.remove('active'));
  if (el) el.classList.add('active');

  // ── Digital & Communication Services tab ────────────────────────────────
  if (cat === 'dijital-mawasiliano') {
    renderServices(); // restore stationery services grid
    document.getElementById('digitalServicesSection').scrollIntoView({behavior:'smooth'});
    return;
  }

  // ── Core service categories — filter + scroll to servicesSection ─────────
  if (CORE_SERVICE_CATEGORIES.includes(cat)) {
    const sGrid = document.getElementById('servicesGrid');
    const filtered = SERVICES.filter(s => s.category === cat);
    if (filtered.length) {
      sGrid.innerHTML = filtered.map(s => `
        <div class="service-card ${s.gold?'gold':''}">
          <div class="service-icon-wrap">${s.icon}</div>
          <div class="service-name">${escapeHTML(s.name)}</div>
          <div class="service-desc">${escapeHTML(s.desc)}</div>
          <span class="service-price">${s.price}</span>
          <button class="order-direct-btn" onclick="openOrderModal('${escapeAttr(s.id)}')">⚡ Agiza Moja kwa Moja</button>
        </div>`).join('');
    } else {
      renderServices();
    }
    document.getElementById('servicesSection').scrollIntoView({behavior:'smooth'});
    return;
  }

  // ── All other product categories ─────────────────────────────────────────
  renderServices(); // restore full core services list
  renderProducts(cat);
  document.getElementById('productsSection').scrollIntoView({behavior:'smooth'});
}

// =========================================================
// ===== SEARCH =====
// =========================================================
function handleSearch(val) {
  if (!val.trim()) {
    renderProducts(currentCategory);
    renderServices();
    // Clear any search highlight on the digital section
    const digSec = document.getElementById('digitalServicesSection');
    if (digSec) { digSec.style.outline = ''; digSec.style.outlineOffset = ''; }
    return;
  }
  const v = val.toLowerCase();

  // ── Products ──────────────────────────────────────────────
  const filteredProducts = PRODUCTS.filter(p =>
    p.name.toLowerCase().includes(v) ||
    p.desc.toLowerCase().includes(v) ||
    getCatLabel(p.category).toLowerCase().includes(v)
  );
  const grid = document.getElementById('productsGrid');
  if (!filteredProducts.length) {
    grid.innerHTML = `<div style="grid-column:1/-1;text-align:center;padding:40px;color:var(--gray-400);font-family:var(--font-head);">Hakuna bidhaa za "<b>${escapeHTML(val)}</b>"</div>`;
  } else {
    grid.innerHTML = filteredProducts.map(p => `
      <div class="product-card" onclick="openProduct(${p.id})">
        <div class="product-img">${p.icon}</div>
        <div class="product-body">
          <div class="product-category">${getCatLabel(p.category)}</div>
          <div class="product-name">${escapeHTML(p.name)}</div>
          <div class="product-price-row">
            <div class="product-price">TZS ${p.price.toLocaleString()}</div>
            <div class="add-to-cart" onclick="event.stopPropagation();addToCart(${p.id})">🛒</div>
          </div>
        </div>
      </div>`).join('');
  }

  // ── Services — split into core (stationery grid) vs digital/comms ──────
  const allMatchedServices = SERVICES.filter(s =>
    s.name.toLowerCase().includes(v) ||
    s.desc.toLowerCase().includes(v) ||
    getCatLabel(s.category).toLowerCase().includes(v) ||
    (s.requirements || []).some(r => r.toLowerCase().includes(v))
  );

  // Core services go to the stationery services grid
  const filteredServices = allMatchedServices.filter(s => CORE_SERVICE_CATEGORIES.includes(s.category));
  const sGrid = document.getElementById('servicesGrid');
  if (!filteredServices.length) {
    sGrid.innerHTML = `<div style="grid-column:1/-1;text-align:center;padding:40px;color:var(--gray-400);font-family:var(--font-head);">Hakuna huduma za "<b>${escapeHTML(val)}</b>"</div>`;
  } else {
    sGrid.innerHTML = filteredServices.map(s => `
      <div class="service-card ${s.gold?'gold':''}">
        <div class="service-icon-wrap">${s.icon}</div>
        <div class="service-name">${escapeHTML(s.name)}</div>
        <div class="service-desc">${escapeHTML(s.desc)}</div>
        <span class="service-price">${s.price}</span>
        <button class="order-direct-btn" onclick="openOrderModal('${escapeAttr(s.id)}')">⚡ Agiza Moja kwa Moja</button>
      </div>`).join('');
  }

  // Digital/comms matches — scroll to that section and highlight it briefly
  const digitalMatches = allMatchedServices.filter(s => s.category === 'dijital-mawasiliano');
  if (digitalMatches.length) {
    const digSec = document.getElementById('digitalServicesSection');
    if (digSec) {
      digSec.style.outline = '3px solid var(--gold)';
      digSec.style.outlineOffset = '-4px';
      digSec.style.borderRadius = 'var(--radius-lg)';
      setTimeout(() => { digSec.style.outline = ''; digSec.style.outlineOffset = ''; }, 2000);
    }
  }

  // Scroll to products then services will follow
  document.getElementById('productsSection').scrollIntoView({behavior:'smooth'});
}

// =========================================================
// ===== CART =====
// =========================================================
function addToCart(id) {
  const product = PRODUCTS.find(p => p.id === id);
  if (!product) return;
  if (product.stock_quantity === 0) {
    showToast(`⚠️ "${product.name}" imekwisha stoani. Tafadhali wasiliana nasi.`, 'error');
    return;
  }
  const hasServices = cart.some(i => i.itemType === 'service');
  if (hasServices) {
    showToast('⚠️ Mkoba wako una huduma. Maliza oda ya huduma kwanza kabla ya kuongeza bidhaa.', 'error');
    return;
  }
  const existing = cart.find(i => i.id === id && i.itemType === 'product');
  if (existing) {
    if (product.stock_quantity !== 999 && existing.qty >= product.stock_quantity) {
      showToast(`⚠️ Hazina imefikia ukomo — zimebaki ${product.stock_quantity} tu!`, 'error');
      return;
    }
    existing.qty++;
  } else {
    cart.push({ id: product.id, name: product.name, price: product.price, icon: product.icon, qty: 1, itemType: 'product' });
  }
  saveCart();
  renderCart();
  updateCartCount();
  showToast(`✅ ${product.name} imeongezwa mkononi!`, 'success');
}

function addServiceToCart(serviceId) {
  const service = SERVICES.find(s => s.id === serviceId);
  if (!service) return;
  // Only allow one service type at a time; also block mixing services + products
  const hasProducts = cart.some(i => i.itemType === 'product');
  if (hasProducts) {
    showToast('⚠️ Huwezi kuchanganya bidhaa na huduma kwenye oda moja. Maliza oda yako ya bidhaa kwanza.', 'error');
    return;
  }
  const existing = cart.find(i => i.id === serviceId && i.itemType === 'service');
  if (existing) {
    showToast(`ℹ️ Huduma "${service.name}" ipo tayari mkononi.`, 'info');
    return;
  }
  cart.push({ id: serviceId, name: service.name, price: 0, icon: service.icon, qty: 1, itemType: 'service', priceLabel: service.price });
  saveCart();
  renderCart();
  updateCartCount();
  showToast(`✅ Huduma ya "${service.name}" imeongezwa! Nenda checkout kukamilisha.`, 'success');
}

// Returns 'service' if all items are services, 'product' if all products, 'mixed' otherwise
function detectCartType() {
  if (!cart.length) return 'empty';
  const types = new Set(cart.map(i => i.itemType || 'product'));
  if (types.size === 1) return [...types][0];
  return 'mixed';
}

function removeFromCart(id, type) {
  if (type === 'service') {
    cart = cart.filter(i => !(i.id === id && i.itemType === 'service'));
  } else {
    cart = cart.filter(i => !(i.id === Number(id) && i.itemType !== 'service'));
  }
  saveCart(); renderCart(); updateCartCount();
}

function changeQty(id, delta) {
  const item    = cart.find(i => i.id === id && i.itemType !== 'service');
  if (!item) return;
  if (delta > 0) {
    // Enforce stock cap on increase
    const product = PRODUCTS.find(p => p.id === id);
    if (product && product.stock_quantity !== 999 && item.qty >= product.stock_quantity) {
      showToast(`⚠️ Hazina imefikia ukomo — zimebaki ${product.stock_quantity} tu!`, 'error');
      return;
    }
  }
  item.qty = Math.max(1, item.qty + delta);
  saveCart(); renderCart(); updateCartCount();
}

function saveCart() {
  try {
    localStorage.setItem('letema_cart_v2', JSON.stringify(cart));
  } catch(e) {}
}

function updateCartCount() {
  const totalItems = cart.reduce((s, i) => s + i.qty, 0);
  const badge = document.getElementById('cartCount');
  badge.textContent = totalItems;
  // Badge bump animation
  badge.classList.remove('bump');
  void badge.offsetWidth; // reflow
  badge.classList.add('bump');
  setTimeout(() => badge.classList.remove('bump'), 300);
}

function renderCart() {
  const container = document.getElementById('cartItems');
  const footer    = document.getElementById('cartFooter');
  if (!cart.length) {
    container.innerHTML = `<div class="cart-empty"><div class="ce-icon">🛒</div><p>Mkoba wako uko wazi</p><p style="font-size:12px;margin-top:4px;color:var(--gray-400);">Ongeza bidhaa kutoka dukani</p></div>`;
    footer.innerHTML = '';
    return;
  }
  container.innerHTML = cart.map(item => `
    <div class="cart-item">
      <div class="cart-item-img">${item.icon}</div>
      <div class="cart-item-info">
        <div class="cart-item-name">${escapeHTML(item.name)}</div>
        <div class="cart-item-price">${item.itemType === 'service' ? (item.priceLabel || 'Bei itakayokubaliwa') : 'TZS ' + (item.price * item.qty).toLocaleString()}</div>
        <div class="cart-item-qty">
          ${item.itemType === 'service'
            ? `<span style="font-size:11px;color:var(--gold);font-weight:700;font-family:var(--font-head);background:rgba(255,198,0,0.12);padding:2px 8px;border-radius:50px;">🛠️ Huduma</span>`
            : `<div class="qty-btn" onclick="changeQty(${item.id},-1)">−</div>
               <span class="qty-num">${item.qty}</span>
               <div class="qty-btn" onclick="changeQty(${item.id},1)">+</div>`
          }
          <span class="cart-remove" onclick="removeFromCart('${item.id}', '${item.itemType || 'product'}')">✕ Ondoa</span>
        </div>
      </div>
    </div>`).join('');

  const cartType    = detectCartType();
  const isService   = cartType === 'service';
  const subtotal    = isService ? 0 : cart.reduce((s, i) => s + i.price * i.qty, 0);
  const totalItems  = cart.reduce((s, i) => s + i.qty, 0);
  const footerLabel = isService ? `Huduma (${totalItems})` : `Bidhaa (${totalItems})`;
  const footerTotal = isService ? 'Bei itakayokubaliwa' : `TZS ${subtotal.toLocaleString()}`;
  footer.innerHTML = `
    <div class="cart-subtotal"><span>${footerLabel}:</span><span>${isService ? '—' : 'TZS ' + subtotal.toLocaleString()}</span></div>
    <div class="cart-subtotal"><span>${isService ? 'Aina:' : 'Delivery:'}</span><span style="color:var(--success);font-weight:600;">${isService ? '🛠️ Huduma' : 'BURE'}</span></div>
    <div class="cart-total"><span>JUMLA:</span><span>${footerTotal}</span></div>
    <button class="checkout-btn" onclick="openCheckout()">${isService ? '📋 Endelea na Ombi' : '💬 Endelea na Malipo'}</button>
    <div style="text-align:center;margin-top:8px;font-size:11px;color:var(--gray-400);">🔒 ${isService ? 'Ombi kwa WhatsApp — Salama 100%' : 'Oda kwa WhatsApp — Salama 100%'}</div>`;
}

function toggleCart() {
  document.getElementById('cartSidebar').classList.toggle('open');
  document.getElementById('cartOverlay').classList.toggle('open');
}

// =========================================================
// ===== CHECKOUT =====
// =========================================================
function openCheckout() {
  if (!cart.length) { showToast('Mkoba wako uko wazi!', 'error'); return; }
  toggleCart();
  document.getElementById('checkoutPage').classList.add('open');
  renderCheckoutSummary();
  applyCheckoutMode();
  document.getElementById('checkoutPage').scrollTop = 0;
}

function closeCheckout() {
  document.getElementById('checkoutPage').classList.remove('open');
}

function renderCheckoutSummary() {
  const cartType = detectCartType();
  const isService = cartType === 'service';

  const subtotal = isService ? 0 : cart.reduce((s, i) => s + i.price * i.qty, 0);
  const vat      = isService ? 0 : Math.round(subtotal * 0.18);
  const total    = subtotal + vat;

  document.getElementById('checkoutItems').innerHTML = cart.map(i =>
    `<div class="os-item">
       <span class="os-item-name">${i.icon} ${escapeHTML(i.name)} ×${i.qty}</span>
       <span class="os-item-price">${i.itemType === 'service' ? (i.priceLabel || '—') : 'TZS ' + (i.price * i.qty).toLocaleString()}</span>
     </div>`
  ).join('');
  document.getElementById('checkoutSubtotal').textContent = isService ? 'Itakubaliwa' : `TZS ${subtotal.toLocaleString()}`;
  document.getElementById('checkoutVat').textContent      = isService ? '—' : `TZS ${vat.toLocaleString()}`;
  document.getElementById('checkoutTotal').textContent    = isService ? 'Itajulikana' : `TZS ${total.toLocaleString()}`;
}

// =========================================================
// ===== CHECKOUT MODE — Product vs Service =====
// =========================================================
let activeCopyType = 'soft'; // 'soft' or 'hard'

function applyCheckoutMode() {
  const cartType  = detectCartType();
  const isService = cartType === 'service';
  const banner    = document.getElementById('orderTypeBanner');
  const svcSection= document.getElementById('serviceReqSection');
  const paySection= document.getElementById('paymentSection');
  const topbar    = document.querySelector('.checkout-topbar h2');

  if (isService) {
    // Show service requirements section, update banner and title
    if (svcSection) svcSection.style.display = 'block';
    if (paySection) paySection.style.display = 'block';
    if (banner) {
      banner.className = 'order-type-banner type-service';
      banner.innerHTML = `<span class="order-type-icon">🛠️</span> <span>Ombi la Huduma</span> <span class="order-type-label">HUDUMA</span>`;
    }
    if (topbar) topbar.textContent = '🛠️ Ombi la Huduma';
    selectCopyType('soft');
    // Relabel address field for service mode
    const addrLabel = document.getElementById('coAddressLabel');
    if (addrLabel) addrLabel.innerHTML = 'Mtaa / Eneo Lako <span style="color:var(--danger)">*</span>';
    const addrInput = document.getElementById('coAddress');
    if (addrInput) addrInput.placeholder = 'Mfano: Mwanjelwa, CUOM, Mjini — ili tuweze kukufikia';

    // ── Inject per-service requirements boxes at the top of serviceReqSection ──
    const reqAnchor = document.getElementById('checkoutReqBoxAnchor');
    if (reqAnchor) {
      const serviceItems = cart.filter(i => i.itemType === 'service');
      if (serviceItems.length) {
        reqAnchor.innerHTML = serviceItems.map(item => {
          const svc = SERVICES.find(s => s.id === item.id);
          if (!svc || !svc.requirements || !svc.requirements.length) return '';
          const rows = svc.requirements
            .map(r => `<div class="svc-req-item">${escapeHTML(r)}</div>`)
            .join('');
          return `
            <div class="svc-req-box" style="margin-bottom:12px;">
              <div class="svc-req-box-icon">${svc.icon}</div>
              <div class="svc-req-box-body">
                <div class="svc-req-box-title">Unachohitaji — ${escapeHTML(svc.name)}</div>
                ${rows}
              </div>
            </div>`;
        }).join('');
      }
    }

    // ── Show/hide file upload based on whether any service in cart needs it ──
    const svcFileSection = document.getElementById('svcFileUploadSection');
    if (svcFileSection) {
      const serviceItems = cart.filter(i => i.itemType === 'service');
      const anyNeedsFile = serviceItems.some(item => {
        const svc = SERVICES.find(s => s.id === item.id);
        return svc && svc.fileUpload === true;
      });
      svcFileSection.style.display = anyNeedsFile ? 'block' : 'none';
      // Update label to show which service needs the file
      if (anyNeedsFile) {
        const fileLabel = document.getElementById('svcFileUploadSectionTitle');
        const fileServices = serviceItems
          .filter(item => { const svc = SERVICES.find(s => s.id === item.id); return svc && svc.fileUpload; })
          .map(item => { const svc = SERVICES.find(s => s.id === item.id); return svc ? svc.name : ''; })
          .filter(Boolean);
        if (fileLabel) {
          fileLabel.textContent = `📎 Pakia Faili — ${fileServices.join(', ')}`;
        }
      }
    }
  } else {
    if (svcSection) svcSection.style.display = 'none';
    if (banner) {
      banner.className = 'order-type-banner type-product';
      banner.innerHTML = `<span class="order-type-icon">🛒</span> <span>Ununuzi wa Bidhaa</span> <span class="order-type-label">BIDHAA</span>`;
    }
    if (topbar) topbar.textContent = '🛒 Maliza Ununuzi';
    // Restore address label for product delivery
    const addrLabel = document.getElementById('coAddressLabel');
    if (addrLabel) addrLabel.innerHTML = 'Mtaa / Eneo la Delivery <span style="color:var(--danger)">*</span>';
    const addrInput = document.getElementById('coAddress');
    if (addrInput) addrInput.placeholder = 'Mfano: Mwanjelwa, Uyole, CUOM...';
  }
}

function selectCopyType(type) {
  activeCopyType = type;
  document.querySelectorAll('.svc-copy-btn').forEach(btn => {
    btn.classList.toggle('selected', btn.dataset.copy === type);
  });
}

// Tracks currently selected payment method type ('mobile' or 'cash')
let activePaymentMethod = 'mobile';

function selectPayment(el) {
  document.querySelectorAll('.pay-method').forEach(m => m.classList.remove('selected'));
  el.classList.add('selected');

  activePaymentMethod = el.dataset.method || 'mobile';
  updateReceiptFieldUI();
}

function updateReceiptFieldUI() {
  const isMobile   = activePaymentMethod === 'mobile';
  const badge      = document.getElementById('receiptRequiredBadge');
  const input      = document.getElementById('coTxnId');
  const hintText   = document.getElementById('receiptHintText');
  const wrapper    = input ? input.closest('.txn-field-wrapper') : null;

  if (!badge || !input) return;

  if (isMobile) {
    badge.textContent        = '🔐 Inahitajika';
    badge.style.background   = 'var(--danger)';
    input.placeholder        = 'Mfano: MP250701ABCD1234 au TZ-00123456';
    if (hintText) hintText.textContent = '📌 Andika namba ya uthibitishaji uliyopokea baada ya kulipa kwa M-Pesa / Tigo Pesa / Airtel Money. Inaonekana kwenye ujumbe wa SMS baada ya malipo.';
    if (wrapper) wrapper.style.opacity = '1';
  } else {
    badge.textContent        = '✏️ Hiari (Optional)';
    badge.style.background   = 'var(--gray-400)';
    input.placeholder        = 'Si lazima kwa Pesa Taslimu — unaweza kuacha wazi';
    input.classList.remove('field-invalid');
    const err = document.getElementById('coTxnIdErr');
    if (err) err.style.display = 'none';
    if (hintText) hintText.textContent = '📌 Kwa Pesa Taslimu, sehemu hii ni ya hiari. Unaweza kuandika kumbuka yoyote au kuiacha wazi.';
    if (wrapper) wrapper.style.opacity = '0.65';
  }
}

// =========================================================
// =========================================================
// ===== PDF RECEIPT GENERATOR =====
// =========================================================
function generateOrderPDF(orderData, cartItems) {
  if (!window.jspdf || !window.jspdf.jsPDF) { showToast('⚠️ PDF library haijapakiwa.', 'error'); return; }
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF({ unit: 'mm', format: 'a4' });
  const pageW = doc.internal.pageSize.getWidth();
  const pageH = doc.internal.pageSize.getHeight();
  const now = new Date(); // required for official stamp

  // ── HEADER BAND ──
  doc.setFillColor(0, 48, 135); // --navy #003087
  doc.rect(0, 0, pageW, 38, 'F');

  // Brand name
  doc.setFont('helvetica', 'bold');
  doc.setFontSize(22);
  doc.setTextColor(255, 255, 255);
  doc.text('LETEMA STATIONERY', 14, 18);

  // Tagline
  doc.setFontSize(9);
  doc.setFont('helvetica', 'normal');
  doc.setTextColor(255, 198, 0); // --gold
  doc.text('Internet Café & Office Supplies — Mbeya', 14, 25);

  // RECEIPT label (right-aligned)
  doc.setFont('helvetica', 'bold');
  doc.setFontSize(14);
  doc.setTextColor(255, 198, 0);
  doc.text('ORDER RECEIPT', pageW - 14, 20, { align: 'right' });

  // Gold divider line
  doc.setDrawColor(255, 198, 0);
  doc.setLineWidth(1);
  doc.line(0, 38, pageW, 38);

  // ── ORDER META ──
  let y = 50;
  doc.setFontSize(10);
  doc.setFont('helvetica', 'normal');
  doc.setTextColor(71, 85, 105); // gray-600

  const metaLeft = [
    ['Customer', orderData.customer],
    ['Phone', orderData.phone],
    ['Address', orderData.address || '—'],
  ];
  const metaRight = [
    ['Order ID', orderData.ref],
    ['Date', orderData.timestamp],
    ['Payment', (orderData.payment === 'cash' ? 'Cash / Pesa Taslimu' : 'Mobile Money')],
  ];

  metaLeft.forEach(([label, val], i) => {
    doc.setFont('helvetica', 'bold');
    doc.setTextColor(0, 48, 135);
    doc.text(label + ':', 14, y + i * 7);
    doc.setFont('helvetica', 'normal');
    doc.setTextColor(30, 41, 59);
    doc.text(String(val), 44, y + i * 7);
  });
  metaRight.forEach(([label, val], i) => {
    doc.setFont('helvetica', 'bold');
    doc.setTextColor(0, 48, 135);
    doc.text(label + ':', pageW / 2 + 4, y + i * 7);
    doc.setFont('helvetica', 'normal');
    doc.setTextColor(30, 41, 59);
    doc.text(String(val), pageW / 2 + 30, y + i * 7);
  });

  y += 28;

  // ── ITEMS TABLE ──
  const tableBody = cartItems.map(item => {
    const isServiceItem = item.type === 'service' || item.itemType === 'service';
    const unitPriceStr  = isServiceItem ? (item.priceLabel || 'Bei itakayokubaliwa') : 'TZS ' + (item.price||0).toLocaleString();
    const totalStr      = isServiceItem ? '—' : 'TZS ' + ((item.price||0) * (item.qty||1)).toLocaleString();
    return [item.name, String(item.qty||1), unitPriceStr, totalStr];
  });

  doc.autoTable({
    startY: y,
    head: [['Item / Bidhaa', 'Qty', 'Unit Price', 'Subtotal']],
    body: tableBody,
    theme: 'grid',
    headStyles: {
      fillColor: [0, 48, 135],
      textColor: [255, 255, 255],
      fontStyle: 'bold',
      fontSize: 10,
    },
    bodyStyles: {
      fontSize: 9.5,
      textColor: [30, 41, 59],
    },
    alternateRowStyles: { fillColor: [241, 244, 251] },
    columnStyles: {
      0: { cellWidth: 'auto' },
      1: { cellWidth: 18, halign: 'center' },
      2: { cellWidth: 38, halign: 'right' },
      3: { cellWidth: 40, halign: 'right' },
    },
    margin: { left: 14, right: 14 },
  });

  // ── TOTALS ──
  let ty = doc.lastAutoTable.finalY + 6;

  const subtotal = orderData.subtotal || cartItems.reduce((s, i) => s + i.price * i.qty, 0);
  const vat      = orderData.vat || Math.round(subtotal * 0.18);
  const total    = orderData.total || (subtotal + vat);

  const totalsX = pageW - 80;
  doc.setDrawColor(224, 232, 245);
  doc.setLineWidth(0.4);
  doc.line(totalsX, ty, pageW - 14, ty);
  ty += 6;

  const drawTotalRow = (label, value, bold = false, color = [71, 85, 105]) => {
    doc.setFont('helvetica', bold ? 'bold' : 'normal');
    doc.setFontSize(bold ? 11 : 10);
    doc.setTextColor(...color);
    doc.text(label, totalsX + 2, ty);
    doc.text(value, pageW - 14, ty, { align: 'right' });
    ty += 7;
  };

  drawTotalRow('Subtotal:', 'TZS ' + subtotal.toLocaleString());
  drawTotalRow('VAT (18%):', 'TZS ' + vat.toLocaleString());

  // Grand total band
  doc.setFillColor(0, 48, 135);
  doc.roundedRect(totalsX - 2, ty - 5, pageW - 14 - totalsX + 16, 10, 2, 2, 'F');
  doc.setFont('helvetica', 'bold');
  doc.setFontSize(12);
  doc.setTextColor(255, 198, 0);
  doc.text('GRAND TOTAL:', totalsX + 2, ty + 2);
  doc.text('TZS ' + total.toLocaleString(), pageW - 14, ty + 2, { align: 'right' });
  ty += 16;

  // Transaction ID if present
  if (orderData.txnId) {
    doc.setFont('helvetica', 'italic');
    doc.setFontSize(9);
    doc.setTextColor(22, 163, 74);
    doc.text('Transaction ID: ' + orderData.txnId, 14, ty);
    ty += 8;
  }

  // ── FOOTER NOTE ──
  doc.setFont('helvetica', 'normal');
  doc.setFontSize(8.5);
  doc.setTextColor(148, 163, 184);
  doc.text('Thank you for shopping at Letema Stationery, Mbeya. Keep this receipt for your records.', 14, pageH - 26);
  doc.text('WhatsApp: +255 620 642 652  |  letema_stationery@gmail.com', 14, pageH - 20);

  // ── OFFICIAL STAMP (red circle, bottom right) ──
  const stampX = pageW - 36;
  const stampY = pageH - 34;
  const stampR = 22;
  const stampNow = new Date();
  const stampDate = stampNow.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).toUpperCase();

  // Outer circle — red fill with opacity
  doc.setFillColor(220, 38, 38);
  doc.setDrawColor(180, 20, 20);
  doc.setLineWidth(1.2);
  doc.circle(stampX, stampY, stampR, 'FD');

  // Inner circle
  doc.setFillColor(255, 255, 255);
  doc.setDrawColor(255, 255, 255);
  doc.setLineWidth(0.8);
  doc.circle(stampX, stampY, stampR - 3, 'D');

  // Stamp text
  doc.setFont('helvetica', 'bold');
  doc.setTextColor(255, 255, 255);
  doc.setFontSize(7.5);
  doc.text('RECEIVED', stampX, stampY - 5, { align: 'center' });
  doc.setFontSize(6.5);
  doc.text('LETEMA ONLINE', stampX, stampY + 0.5, { align: 'center' });
  doc.setFontSize(6);
  doc.text(stampDate, stampX, stampY + 6, { align: 'center' });

  // ── SAVE ──
  doc.save('Letema_Receipt_' + orderData.ref + '.pdf');
}

// =========================================================
// ===== PUBLIC RECEIPT WRAPPER (admin + checkout use) =====
// =========================================================
// Accepts either a full orderRecord object (from checkout) or
// an order ref string (from admin panel) and calls generateOrderPDF.
function generateOrderReceipt(refOrOrder) {
  let order;
  if (typeof refOrOrder === 'string') {
    order = adminOrders.find(o => o.ref === refOrOrder);
    if (!order) { showToast('⚠️ Oda haikupatikana: ' + refOrOrder, 'error'); return; }
  } else {
    order = refOrOrder;
  }
  try {
    generateOrderPDF(order, order.items || []);
    showToast('📄 Risiti inashuka...', 'success');
  } catch (e) {
    console.error('Receipt error:', e);
    showToast('⚠️ Risiti haijaweza kutengenezwa. Jaribu tena.', 'error');
  }
}

// =========================================================
// ===== PLACE ORDER — WhatsApp Integration =====
// =========================================================
function placeOrderWhatsApp() {
  const cartType  = detectCartType();
  const isService = cartType === 'service';

  // Collect & sanitize inputs
  const firstName = sanitizeInput(document.getElementById('coFirstName').value.trim());
  const lastName  = sanitizeInput(document.getElementById('coLastName').value.trim());
  const phone     = document.getElementById('coPhone').value.trim();
  const address   = sanitizeInput(document.getElementById('coAddress').value.trim());
  const notes     = sanitizeInput(document.getElementById('coNotes').value.trim());
  const txnId     = sanitizeInput(document.getElementById('coTxnId').value.trim());

  // Service-specific fields
  const svcInstructions = isService
    ? sanitizeInput((document.getElementById('svcInstructions') || {}).value || '').trim()
    : '';

  // File name — only relevant for service orders
  const svcFileInput = document.getElementById('svcFileUpload');
  const fileName   = (isService && svcFileInput && svcFileInput.files.length > 0)
    ? svcFileInput.files[0].name
    : null;

  // ===== VALIDATION =====
  let valid = true;
  if (!firstName) { showFieldError('coFirstName', 'coFirstNameErr'); valid = false; }
  if (!phone) { showFieldError('coPhone', 'coPhoneErr'); valid = false; }
  else if (!isValidPhone(phone)) { showFieldError('coPhone', 'coPhoneErr'); valid = false; }
  if (!address) { showFieldError('coAddress', 'coAddressErr'); valid = false; }
  if (!txnId && activePaymentMethod === 'mobile') { showFieldError('coTxnId', 'coTxnIdErr'); valid = false; }

  if (!valid) {
    showToast('⚠️ Tafadhali jaza sehemu zote zinazohitajika!', 'error');
    return;
  }

  // ===== BUILD WHATSAPP MESSAGE (Kiswahili, muundo mzuri) =====
  const fullName = lastName ? `${firstName} ${lastName}` : firstName;
  let message = '';

  if (isService) {
    // ---- UJUMBE WA HUDUMA ----
    const serviceNames = cart.map(i => i.name).join(', ');
    const copyLabel    = activeCopyType === 'soft' ? 'Nakala ya Kidijitali (Soft Copy)' : 'Nakala ya Karatasi (Hard Copy)';
    const fileNote     = fileName
      ? `Nimeandaa faili langu: "${fileName}" — nitatuma kwenye mazungumzo haya.`
      : 'Sina faili bado, nitaomba msaada wenu.';
    const instrNote    = svcInstructions ? `\n📝 *Maelekezo ya Ziada:* ${svcInstructions}` : '';
    const malipo       = txnId
      ? `\n💳 *Transaction ID:* ${txnId}`
      : (activePaymentMethod === 'cash' ? '\n💵 *Malipo:* Pesa Taslimu' : '');

    // Build requirements block from all service items in cart
    const reqLines = cart
      .filter(i => i.itemType === 'service')
      .map(item => {
        const svc = SERVICES.find(s => s.id === item.id);
        if (!svc || !svc.requirements || !svc.requirements.length) return '';
        const lines = svc.requirements.map((r, idx) => `  ${idx + 1}. ${r}`).join('\n');
        return `📋 *${svc.name}:*\n${lines}`;
      })
      .filter(Boolean)
      .join('\n\n');

    message =
      `🖨️ *OMBI LA HUDUMA — LETEMA STATIONERY*\n` +
      `━━━━━━━━━━━━━━━━━━━━━━\n\n` +
      `Habari, ninataka kuomba huduma ya *${serviceNames}*.\n` +
      `📋 *Aina ya Nakala:* ${copyLabel}\n` +
      `📎 *Faili:* ${fileNote}\n\n` +
      `✅ *MAHITAJI YALIYOANDALIWA*\n` +
      `━━━━━━━━━━━━━━━━━━━━━━\n` +
      (reqLines || '  — Hakuna mahitaji maalum') + `\n\n` +
      `👤 *MAELEZO YA MTEJA*\n` +
      `━━━━━━━━━━━━━━━━━━━━━━\n` +
      `• *Jina:* ${fullName}\n` +
      `• *Simu/WhatsApp:* ${phone}\n` +
      `• *Eneo:* ${address}` +
      instrNote +
      malipo +
      `\n\n✅ Nimepakua risiti yangu ya PDF. Ninasubiri majibu yenu.`;
  } else {
    // ---- UJUMBE WA BIDHAA ----
    const subtotal  = cart.reduce((s, i) => s + i.price * i.qty, 0);
    const vat       = Math.round(subtotal * 0.18);
    const total     = subtotal + vat;
    const itemsList = cart.map(i =>
      `  • ${i.name} × ${i.qty}  →  TZS ${(i.price * i.qty).toLocaleString()}`
    ).join('\n');
    const notesText = notes    ? `\n📝 *Maelezo:* ${notes}` : '';
    const txnText   = txnId
      ? `\n💳 *Transaction ID / E-Receipt:* ${txnId}`
      : (activePaymentMethod === 'cash' ? '\n💵 *Njia ya Malipo:* Pesa Taslimu' : '');

    message =
      `🛒 *ODA MPYA — LETEMA STATIONERY*\n` +
      `━━━━━━━━━━━━━━━━━━━━━━\n\n` +
      `📦 *BIDHAA ZILIZOAGIZWA*\n` +
      `${itemsList}\n\n` +
      `💰 *MUHTASARI WA MALIPO*\n` +
      `━━━━━━━━━━━━━━━━━━━━━━\n` +
      `• Jumla Ndogo:  TZS ${subtotal.toLocaleString()}\n` +
      `• VAT (18%):    TZS ${vat.toLocaleString()}\n` +
      `• *JUMLA KUU:   TZS ${total.toLocaleString()}*\n\n` +
      `👤 *MAELEZO YA MTEJA*\n` +
      `━━━━━━━━━━━━━━━━━━━━━━\n` +
      `• *Jina:* ${fullName}\n` +
      `• *Simu:* ${phone}\n` +
      `• *Mahali:* ${address}` +
      notesText +
      txnText +
      `\n\n✅ Nimepakua risiti yangu ya PDF. Ninasubiri uthibitisho wenu.`;
  }

  const encodedMsg = encodeURIComponent(message);
  const _rOwner1 = window._ownerPhone || localStorage.getItem('letema_owner_phone') || '255620642652';
  lastWaUrl = `https://wa.me/${_rOwner1}?text=${encodedMsg}`;

  // ===== SHOW SPINNER + PROCESS =====
  const btn = document.getElementById('placeOrderBtn');
  btn.disabled = true;
  showSpinner();

  setTimeout(() => {
    hideSpinner();
    btn.disabled = false;

    const ref = 'LET-' + Date.now().toString().slice(-6);
    document.getElementById('orderRefNum').textContent = ref;

    if (isService && fileName) {
      document.getElementById('successFileTip').style.display = 'flex';
      document.getElementById('successFileName').textContent  = fileName;
    } else {
      document.getElementById('successFileTip').style.display = 'none';
    }

    document.getElementById('checkoutPage').classList.remove('open');
    document.getElementById('successPage').classList.add('open');

    // ===== SAVE TO ADMIN ORDERS =====
    const subtotalFinal = isService ? 0 : cart.reduce((s, i) => s + i.price * i.qty, 0);
    const vatFinal      = isService ? 0 : Math.round(subtotalFinal * 0.18);
    const totalFinal    = subtotalFinal + vatFinal;
    const now           = new Date();
    const orderRecord   = {
      ref,
      timestamp:  now.toLocaleString('en-TZ', {dateStyle:'short', timeStyle:'short'}),
      date:       now.toISOString().slice(0,10),
      customer:   fullName,
      phone,
      address:    address || '—',
      email:      document.getElementById('coEmail')?.value || '',
      type:       isService ? 'service' : 'product',
      items:      cart.map(i => ({id: i.id, name: i.name, qty: i.qty, price: i.price, type: i.itemType})),
      subtotal:   subtotalFinal,
      vat:        vatFinal,
      total:      totalFinal,
      payment:    activePaymentMethod || 'mobile',
      txnId:      txnId || '',
      notes:      notes || '',
      status:     isService ? 'pending_price' : 'new'
    };
    addAdminOrder(orderRecord);

    // ===== DECREMENT STOCK =====
    if (!isService) {
      cart.forEach(item => {
        if (item.itemType === 'product') decrementStock(item.id, item.qty);
      });
      renderProducts(currentCategory);
    }

    // ===== FILE UPLOAD (Service orders only) — Supabase Storage primary, GDrive fallback =====
    if (isService) {
      const svcFile = document.getElementById('svcFileUpload');
      if (svcFile && svcFile.files && svcFile.files.length > 0) {
        const fileToUpload = svcFile.files[0];
        showToast('☁️ Inapakia faili...', 'info');

        (async () => {
          let fileUrl = null;
          let uploaded = false;

          // 1. Jaribu Supabase Storage kwanza
          if (window.letemaSupabase && window.letemaSupabase.uploadFileToSupabase) {
            const sbResult = await window.letemaSupabase.uploadFileToSupabase(fileToUpload, ref, fullName);
            if (sbResult.success) {
              uploaded = true;
              fileUrl = sbResult.url || null;
              showToast('✅ Faili limepakiwa!', 'success');
            } else {
              console.warn('[Upload] Supabase Storage imeshindwa:', sbResult.reason, '— inajaribu GDrive...');
            }
          }

          // 2. Fallback: GDrive (ikiwa Supabase imeshindwa na URL imewekwa)
          if (!uploaded) {
            const gdResult = await uploadFileToGoogleDrive(fileToUpload, ref, fullName);
            if (gdResult.success) {
              uploaded = true;
              fileUrl = gdResult.fileUrl || null;
              showToast('✅ Faili limepakiwa (Google Drive)!', 'success');
            } else if (gdResult.reason === 'no_url') {
              showToast('⚠️ Faili halikupakiwa — tuma mwenyewe kwenye WhatsApp.', 'warning');
            } else {
              showToast('⚠️ Upload imeshindwa: ' + gdResult.reason, 'error');
            }
          }

          // 3. Hifadhi URL kwenye Supabase order notes
          if (fileUrl && window.letemaSupabase) {
            const c = window.letemaSupabase.getClient && window.letemaSupabase.getClient();
            if (c) {
              c.from('orders').update({
                notes: (orderRecord.notes ? orderRecord.notes + '\n' : '') + 'File: ' + fileUrl
              }).eq('ref', ref);
            }
          }
        })();
      }
    }

    // ===== GENERATE & DOWNLOAD PDF RECEIPT =====
    try {
      generateOrderReceipt(orderRecord);
    } catch(pdfErr) {
      console.warn('PDF generation error:', pdfErr);
      showToast('⚠️ PDF haikuweza kutengenezwa, lakini oda yako imetumwa.', 'error');
    }

    // ===== WHATSAPP: Auto-send via Whapi API, fallback to wa.me =====
    const pdfMsg =
      `*ODA MPYA — ${ref}*\n` +
      `Mteja: ${fullName}\n` +
      `Simu: ${phone}\n` +
      `Jumla: TZS ${(totalFinal || 0).toLocaleString()}\n` +
      `Aina: ${isService ? 'Huduma' : 'Bidhaa'}\n` +
      `PDF imepakuliwa. Mteja yuko tayari kutuma nyaraka.`;

    const _rOwner2 = window._ownerPhone || localStorage.getItem('letema_owner_phone') || '255620642652';
    const pdfWaUrl = `https://wa.me/${_rOwner2}?text=${encodeURIComponent(pdfMsg)}`;
    lastWaUrl      = pdfWaUrl;

    cart = [];
    saveCart();
    updateCartCount();
    renderCart();

    // ── Send order details to owner via Whapi ────────────────
    const runtimeOwner = window._ownerPhone || localStorage.getItem('letema_owner_phone') || OWNER_PHONE;
    sendWhatsAppMessage(runtimeOwner, message).then(ownerResult => {
      if (ownerResult.success) {
        showToast('📲 Oda imetumwa kwa WhatsApp kiotomatiki!', 'success');
      } else {
        setTimeout(() => fallbackWhatsApp('255620642652', pdfMsg), 500);
      }
    });

    // ── Send confirmation to customer ────────────────────────
    const custConfirm =
      `Asante ${fullName}! Oda yako *${ref}* imepokelewa na Letema Stationery, Mbeya.\n` +
      `Thamani: TZS ${(totalFinal || 0).toLocaleString()}\n` +
      `Tafadhali tuma PDF yako ya risiti kwenye mazungumzo haya. Tutawasiliana nawe hivi karibuni. 🙏`;
    sendWhatsAppMessage(phone, custConfirm);

  }, 1800);
}

function retryWhatsApp() {
  if (!lastWaUrl) return;
  // Try re-sending via API; fallback to opening wa.me tab
  const urlObj = new URL(lastWaUrl);
  const phone  = urlObj.pathname.replace('/', '');
  const msg    = decodeURIComponent(urlObj.searchParams.get('text') || '');
  sendWhatsAppMessage(phone, msg).then(r => {
    if (!r.success) window.open(lastWaUrl, '_blank');
    else showToast('📲 Ujumbe umetumwa tena kwa mafanikio!', 'success');
  });
}

function closeSuccess() {
  document.getElementById('successPage').classList.remove('open');
  if (_openModalCount === 0) document.body.style.overflow = '';
  lastWaUrl = '';
}

// =========================================================
// ===== PRODUCT MODAL =====
// =========================================================
function openProduct(id) {
  const p = PRODUCTS.find(x => x.id === id);
  if (!p) return;
  const isOut = p.stock_quantity === 0;
  const isLow = !isOut && p.stock_quantity < 5 && p.stock_quantity !== 999;
  const stockBadge = isOut
    ? `<div style="font-size:12px;color:var(--danger);font-weight:700;background:var(--danger-light);padding:4px 10px;border-radius:50px;">❌ Imekwisha Stoani</div>`
    : isLow
    ? `<div style="font-size:12px;color:var(--warning);font-weight:700;background:var(--warning-light);padding:4px 10px;border-radius:50px;">⚠️ Zimebaki ${p.stock_quantity} tu</div>`
    : `<div style="font-size:12px;color:var(--success);font-weight:700;background:var(--success-light);padding:4px 10px;border-radius:50px;">✅ Inapatikana</div>`;

  document.getElementById('productModalTitle').textContent = p.name;
  document.getElementById('productModalBody').innerHTML = `
    <div style="background:var(--gray-100);border-radius:var(--radius-md);height:180px;display:flex;align-items:center;justify-content:center;font-size:80px;margin-bottom:20px;">${p.icon}</div>
    <div style="font-size:11px;font-weight:700;color:var(--gray-400);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:4px;">${getCatLabel(p.category)}</div>
    <div style="font-family:var(--font-head);font-size:20px;font-weight:800;color:var(--navy);margin-bottom:8px;">${escapeHTML(p.name)}</div>
    <div style="display:flex;align-items:center;gap:6px;margin-bottom:12px;">
      <span style="color:var(--gold);font-size:14px;">${'★'.repeat(Math.floor(p.rating))}</span>
      <span style="font-size:13px;color:var(--gray-600);">${p.rating} (${p.reviews} maoni)</span>
    </div>
    <div style="font-size:14px;color:var(--gray-600);line-height:1.7;margin-bottom:20px;">${escapeHTML(p.desc)}</div>
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
      <div style="font-family:var(--font-head);font-size:24px;font-weight:900;color:var(--navy);">TZS ${p.price.toLocaleString()}</div>
      ${stockBadge}
    </div>
    <button class="checkout-btn" ${isOut ? 'disabled style="opacity:0.5;cursor:not-allowed;"' : `onclick="addToCart(${p.id});closeModal('productModal')"`}>
      ${isOut ? '❌ Imekwisha Stoani' : '🛒 Ongeza Mkononi'}
    </button>`;
  openModal('productModal');
}

// =========================================================
// ===== DYNAMIC ORDER MODAL =====
// =========================================================

// Holds the currently active service id for submission
let activeOrderServiceId = null;

function openOrderModal(serviceId) {
  const s = SERVICES.find(x => x.id === serviceId);
  if (!s) return;
  activeOrderServiceId = serviceId;

  // Update title
  document.getElementById('serviceModalTitle').textContent = `⚡ Agiza — ${s.name}`;

  // Inject service banner
  document.getElementById('orderModalServiceBanner').innerHTML = `
    <div class="order-modal-service-banner">
      <div class="order-modal-svc-icon">${s.icon}</div>
      <div>
        <div class="order-modal-svc-name">${escapeHTML(s.name)}</div>
        <div class="order-modal-svc-price">${escapeHTML(s.price)}</div>
      </div>
    </div>
    ${s.requirements && s.requirements.length ? buildRequirementsBox(s) : ''}`;

  // Clear common fields
  document.getElementById('orderClientName').value  = '';
  document.getElementById('orderClientPhone').value = '';
  document.getElementById('orderUrgency').value     = 'leo';

  // Inject dynamic fields based on service
  const dynContainer = document.getElementById('orderDynamicFields');
  dynContainer.innerHTML = getDynamicFields(serviceId);

  openModal('serviceOrderModal');
}

// Builds the amber requirements box HTML
function buildRequirementsBox(s) {
  const items = s.requirements.map(r =>
    `<div class="svc-req-item">${escapeHTML(r)}</div>`
  ).join('');
  return `
    <div class="svc-req-box">
      <div class="svc-req-box-icon">📋</div>
      <div class="svc-req-box-body">
        <div class="svc-req-box-title">Unachohitaji Kuandaa</div>
        ${items}
      </div>
    </div>`;
}

// Returns the HTML string for service-specific fields
function getDynamicFields(serviceId) {
  const divider = `<div class="dyn-fields-divider">✦ Maelezo ya Huduma</div>`;

  switch (serviceId) {

    // ── s1: Photocopy (Rangi) ──────────────────────────────────────────────
    case 's1':
      return divider + `
        <div class="form-group">
          <label class="form-label">📋 Aina ya Uchapishaji <span style="color:var(--danger)">*</span></label>
          <div class="radio-group" id="dynColorGroup">
            <label class="radio-option selected" onclick="selectRadioOpt(this,'dynColorGroup')">
              <input type="radio" name="dynColor" value="Rangi (Color)" checked> 🌈 Rangi
            </label>
            <label class="radio-option" onclick="selectRadioOpt(this,'dynColorGroup')">
              <input type="radio" name="dynColor" value="Nyeusi na Nyeupe (B&W)"> ⬛ B&W
            </label>
          </div>
        </div>
        <div class="dyn-row">
          <div class="form-group">
            <label class="form-label">📄 Idadi ya Kurasa <span style="color:var(--danger)">*</span></label>
            <input class="form-input" type="number" min="1" value="1" placeholder="Mfano: 10" id="dynPages">
          </div>
          <div class="form-group">
            <label class="form-label">📋 Idadi ya Nakala <span style="color:var(--danger)">*</span></label>
            <input class="form-input" type="number" min="1" value="1" placeholder="Mfano: 2" id="dynCopies">
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">📝 Maelezo ya Ziada <span style="color:var(--gray-400);text-transform:none;font-weight:400;">(hiari)</span></label>
          <textarea class="form-input" rows="2" placeholder="Mfano: Ukubwa A3, double-sided, laminate, nk." id="dynNotes" style="resize:vertical;"></textarea>
        </div>`;

    // ── s2: Photocopy (B&W) — same enhanced form ──────────────────────────
    case 's2':
      return divider + `
        <div class="form-group">
          <label class="form-label">📋 Aina ya Uchapishaji <span style="color:var(--danger)">*</span></label>
          <div class="radio-group" id="dynColorGroup">
            <label class="radio-option selected" onclick="selectRadioOpt(this,'dynColorGroup')">
              <input type="radio" name="dynColor" value="Nyeusi na Nyeupe (B&W)" checked> ⬛ B&W
            </label>
            <label class="radio-option" onclick="selectRadioOpt(this,'dynColorGroup')">
              <input type="radio" name="dynColor" value="Rangi (Color)"> 🌈 Rangi
            </label>
          </div>
        </div>
        <div class="dyn-row">
          <div class="form-group">
            <label class="form-label">📄 Idadi ya Kurasa <span style="color:var(--danger)">*</span></label>
            <input class="form-input" type="number" min="1" value="1" placeholder="Mfano: 10" id="dynPages">
          </div>
          <div class="form-group">
            <label class="form-label">📋 Idadi ya Nakala <span style="color:var(--danger)">*</span></label>
            <input class="form-input" type="number" min="1" value="1" placeholder="Mfano: 2" id="dynCopies">
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">📝 Maelezo ya Ziada <span style="color:var(--gray-400);text-transform:none;font-weight:400;">(hiari)</span></label>
          <textarea class="form-input" rows="2" placeholder="Mfano: Ukubwa A4, upande mmoja, nk." id="dynNotes" style="resize:vertical;"></textarea>
        </div>`;

    // ── s3: Printing ───────────────────────────────────────────────────────
    case 's3':
      return divider + `
        <div class="form-group">
          <label class="form-label">📂 Aina ya Faili <span style="color:var(--danger)">*</span></label>
          <select class="form-input" id="dynFileType">
            <option value="">-- Chagua Aina --</option>
            <option value="PDF">📄 PDF</option>
            <option value="Word (DOCX)">📝 Word (DOCX)</option>
            <option value="Excel (XLSX)">📊 Excel (XLSX)</option>
            <option value="PowerPoint (PPTX)">📑 PowerPoint (PPTX)</option>
            <option value="Picha (JPG/PNG)">🖼️ Picha (JPG / PNG)</option>
            <option value="Nyingine">🔗 Nyingine</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">🎨 Uchaguzi wa Rangi <span style="color:var(--danger)">*</span></label>
          <div class="radio-group" id="dynColorGroup">
            <label class="radio-option selected" onclick="selectRadioOpt(this,'dynColorGroup')">
              <input type="radio" name="dynColor" value="Rangi (Color)" checked> 🌈 Rangi
            </label>
            <label class="radio-option" onclick="selectRadioOpt(this,'dynColorGroup')">
              <input type="radio" name="dynColor" value="Nyeusi na Nyeupe (B&W)"> ⬛ B&W
            </label>
          </div>
        </div>
        <div class="dyn-row">
          <div class="form-group">
            <label class="form-label">📄 Idadi ya Kurasa <span style="color:var(--danger)">*</span></label>
            <input class="form-input" type="number" min="1" value="1" placeholder="Mfano: 10" id="dynPages">
          </div>
          <div class="form-group">
            <label class="form-label">📋 Idadi ya Nakala <span style="color:var(--danger)">*</span></label>
            <input class="form-input" type="number" min="1" value="1" placeholder="Mfano: 2" id="dynPrintQty">
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">📎 Pakia Faili la Kuchapishwa <span style="color:var(--danger)">*</span></label>
          <div class="dyn-file-wrap">
            <input type="file" id="dynServiceFile" accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.jpg,.jpeg,.png,.gif,.bmp,.webp"
              onchange="handleDynFileSelect(this,'dynServiceFileLabel','dynServiceFileTitle','dynServiceFileSub','dynServiceFileBadge')">
            <label for="dynServiceFile" class="dyn-file-label" id="dynServiceFileLabel">
              <div class="dyn-file-icon">📁</div>
              <div class="dyn-file-text">
                <div class="dyn-file-title" id="dynServiceFileTitle">Chagua Faili au Gusa Hapa</div>
                <div class="dyn-file-sub" id="dynServiceFileSub">PDF, Word, Excel, PowerPoint, Picha — hadi 20MB</div>
              </div>
              <span class="dyn-file-badge" id="dynServiceFileBadge">Pakia</span>
            </label>
          </div>
          <div class="form-hint" style="margin-top:6px;">⚠️ Pakia faili sasa au ipeleke kwa WhatsApp baada ya kutuma oda.</div>
        </div>
        <div class="form-group">
          <label class="form-label">📝 Maelezo ya Ziada <span style="color:var(--gray-400);text-transform:none;font-weight:400;">(hiari)</span></label>
          <textarea class="form-input" rows="2" placeholder="Mfano: Ukubwa A3, double-sided, laminate, nk." id="dynNotes" style="resize:vertical;"></textarea>
        </div>`;

    // ── s4: Graphics Design ────────────────────────────────────────────────
    case 's4':
      return divider + `
        <div class="form-group">
          <label class="form-label">🎨 Aina ya Muundo <span style="color:var(--danger)">*</span></label>
          <div class="radio-group" id="dynDesignGroup" style="flex-direction:column;gap:6px;">
            <label class="radio-option selected" onclick="selectRadioOpt(this,'dynDesignGroup')">
              <input type="radio" name="dynDesign" value="Logo" checked> 🏷️ Logo
            </label>
            <label class="radio-option" onclick="selectRadioOpt(this,'dynDesignGroup')">
              <input type="radio" name="dynDesign" value="Poster / Tangazo"> 📢 Poster / Tangazo
            </label>
            <label class="radio-option" onclick="selectRadioOpt(this,'dynDesignGroup')">
