                <div class="dyn-file-title" id="dynServiceFileTitle">Chagua Faili (hiari)</div>
                <div class="dyn-file-sub" id="dynServiceFileSub">PDF, Word, TXT — hadi 10MB</div>
              </div>
              <span class="dyn-file-badge" id="dynServiceFileBadge">Pakia</span>
            </label>
