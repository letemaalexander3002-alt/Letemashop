          <div class="dyn-file-wrap">
            <input type="file" id="dynServiceFile" accept=".pdf,.doc,.docx,.txt"
              onchange="handleDynFileSelect(this,'dynServiceFileLabel','dynServiceFileTitle','dynServiceFileSub','dynServiceFileBadge')">
