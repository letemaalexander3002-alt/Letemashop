<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
window.SUPABASE_URL      = 'https://idnpricbfgiwzifwlwii.supabase.co';
window.SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImlkbnByaWNiZmdpd3ppZndsd2lpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzY4NjU0MDgsImV4cCI6MjA5MjQ0MTQwOH0.FItNI4jDuwShdpJGAOXnebMFO7Wd5RqsJp7gP7ZhMy4';

window.letemaSupabase = (function () {
  let client = null;
  function getClient() {
    if (client) return client;
    if (!window.supabase || !window.supabase.createClient) {
      console.warn('[Supabase] SDK not loaded yet');
      return null;
    }
    client = window.supabase.createClient(window.SUPABASE_URL, window.SUPABASE_ANON_KEY, {
      auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: false }
    });
    return client;
  }

  // Map a JS order record (the existing localStorage shape) to the orders row
  function orderToRow(o) {
    return {
      ref:       o.ref,
      customer:  o.customer,
      phone:     o.phone,
      email:     o.email || null,
      address:   o.address || null,
      type:      o.type || 'product',
      subtotal:  o.subtotal || 0,
      vat:       o.vat || 0,
      total:     o.total || 0,
      payment:   o.payment || 'mobile',
      txn_id:    o.txnId || null,
      notes:     o.notes || null,
      status:    (o.status === 'pending_price' ? 'pending_price' : (o.status === 'pending' ? 'new' : (o.status || 'new'))),
      urgency:   o.urgency || null,
      service_details: o.serviceDetails || null,
      items:     o.items || []
    };
  }

  async function insertOrder(order) {
    const c = getClient(); if (!c) return { error: 'no client' };
    try {
      // Attach the logged-in user's id so RLS + fetchUserOrders work correctly
      const { data: sessRes } = await c.auth.getSession();
      const userId = sessRes && sessRes.session ? sessRes.session.user.id : null;
      const row = { ...orderToRow(order) };
      if (userId) row.user_id = userId;
      const { data, error } = await c.from('orders').insert(row).select().single();
      if (error) { console.warn('[Supabase] insertOrder failed:', error.message); return { error }; }
      // Seed initial timeline event so customers/admins see when order was placed
      try {
        await c.from('order_status_events').insert({
          order_ref: order.ref,
          status: 'new',
          changed_by: order.email || 'customer',
          notes: 'Order placed'
        });
      } catch (e) { /* non-fatal */ }
      return { data };
    } catch (e) { console.warn('[Supabase] insertOrder threw:', e); return { error: e }; }
  }

  async function updateOrderStatus(ref, status) {
    const c = getClient(); if (!c) return { error: 'no client' };
    try {
      const { error } = await c.from('orders').update({ status }).eq('ref', ref);
      if (error) console.warn('[Supabase] updateOrderStatus failed:', error.message);
      return { error };
    } catch (e) { return { error: e }; }
  }

  async function fetchOrders() {
    const c = getClient(); if (!c) return [];
    const { data, error } = await c.from('orders').select('*').order('created_at', { ascending: false }).limit(500);
    if (error) { console.warn('[Supabase] fetchOrders:', error.message); return []; }
    // shape back into the legacy adminOrders format
    return (data || []).map(r => ({
      ref:       r.ref,
      timestamp: new Date(r.created_at).toLocaleString('en-TZ', { dateStyle:'short', timeStyle:'short' }),
      date:      r.created_at.slice(0,10),
      customer:  r.customer,
      phone:     r.phone,
      email:     r.email || '',
      address:   r.address || '—',
      type:      r.type,
      items:     r.items || [],
      subtotal:  r.subtotal, vat: r.vat, total: r.total,
      payment:   r.payment, txnId: r.txn_id || '',
      notes:     r.notes || '',
      status:    r.status,
      urgency:   r.urgency,
      serviceDetails: r.service_details
    }));
  }

  async function fetchProducts() {
    const c = getClient(); if (!c) return [];
    const { data, error } = await c.from('products').select('*').eq('is_active', true).order('legacy_id', { ascending: true });
    if (error) { console.warn('[Supabase] fetchProducts:', error.message); return []; }
    return (data || []).map(r => ({
      id:             r.legacy_id || r.id,
      _dbId:          r.id,
      name:           r.name,
      price:          r.price,
      category:       r.category,
      icon:           r.icon || '📦',
      badge:          r.badge,
      rating:         Number(r.rating) || 5.0,
      reviews:        r.reviews || 0,
      desc:           r.description || '',
      stock_quantity: r.stock_quantity
    }));
  }

  async function upsertProduct(p) {
    const c = getClient(); if (!c) return { error: 'no client' };
    const row = {
      legacy_id:      typeof p.id === 'number' ? p.id : null,
      name:           p.name,
      price:          p.price,
      category:       p.category,
      icon:           p.icon || '📦',
      badge:          p.badge || null,
      rating:         p.rating || 5.0,
      reviews:        p.reviews || 0,
      description:    p.desc || '',
      stock_quantity: p.stock_quantity
    };
    if (p._dbId) {
      const { error } = await c.from('products').update(row).eq('id', p._dbId);
      return { error };
    }
    const { data, error } = await c.from('products').insert(row).select().single();
    if (data) p._dbId = data.id;
    return { data, error };
  }

  async function deleteProductRemote(p) {
    const c = getClient(); if (!c) return { error: 'no client' };
    if (p._dbId)        return c.from('products').delete().eq('id', p._dbId);
    if (p.id != null)   return c.from('products').delete().eq('legacy_id', p.id);
  }

  async function setProductStock(p, qty) {
    const c = getClient(); if (!c) return;
    if (p._dbId)      await c.from('products').update({ stock_quantity: qty }).eq('id', p._dbId);
    else if (p.id)    await c.from('products').update({ stock_quantity: qty }).eq('legacy_id', p.id);
  }

  // ---- Auth ----
  async function signUp({ email, password, firstName, lastName, phone }) {
    const c = getClient(); if (!c) return { error: { message: 'no client' } };
    return c.auth.signUp({
      email, password,
      options: {
        emailRedirectTo: window.location.origin,
        data: { first_name: firstName, last_name: lastName, phone }
      }
    });
  }
  async function signIn({ email, password }) {
    const c = getClient(); if (!c) return { error: { message: 'no client' } };
    return c.auth.signInWithPassword({ email, password });
  }
  // OTP login — sends a 6-digit code (or magic link) to email
  async function sendEmailOtp(email) {
    const c = getClient(); if (!c) return { error: { message: 'no client' } };
    return c.auth.signInWithOtp({
      email,
      options: { shouldCreateUser: true, emailRedirectTo: window.location.origin }
    });
  }
  // OTP login — sends 6-digit code via SMS to phone (E.164, e.g. +2557XXXXXXXX)
  async function sendPhoneOtp(phone) {
    const c = getClient(); if (!c) return { error: { message: 'no client' } };
    return c.auth.signInWithOtp({ phone, options: { shouldCreateUser: true } });
  }
  // Verify the 6-digit code the user typed
  async function verifyOtpCode({ email, phone, token }) {
    const c = getClient(); if (!c) return { error: { message: 'no client' } };
    if (email) return c.auth.verifyOtp({ email, token, type: 'email' });
    if (phone) return c.auth.verifyOtp({ phone, token, type: 'sms' });
    return { error: { message: 'no email or phone' } };
  }
  async function resendVerificationEmail(email) {
    const c = getClient(); if (!c) return { error: { message: 'no client' } };
    return c.auth.resend({ type: 'signup', email,
      options: { emailRedirectTo: window.location.origin } });
  }
  async function signOut() {
    const c = getClient(); if (!c) return;
    return c.auth.signOut();
  }
  async function getSession() {
    const c = getClient(); if (!c) return null;
    const { data } = await c.auth.getSession();
    return data.session;
  }
  function onAuthChange(cb) {
    const c = getClient(); if (!c) return;
    c.auth.onAuthStateChange((_evt, session) => cb(session));
  }

  // ---- Realtime ----
  function subscribeOrders(onChange) {
    const c = getClient(); if (!c) return null;
    return c.channel('letema_orders')
      .on('postgres_changes', { event: '*', schema: 'public', table: 'orders' }, (payload) => onChange(payload))
      .subscribe();
  }

  // ---- CSV bulk product upsert ----
  // rows: [{ legacy_id?, name, price, category, icon?, badge?, description?, stock_quantity? }]
  async function bulkUpsertProducts(rows) {
    const c = getClient(); if (!c) return { error: 'no client' };
    if (!Array.isArray(rows) || !rows.length) return { error: 'no rows' };
    // Upsert by legacy_id when present; otherwise plain insert by name.
    const withLegacy    = rows.filter(r => r.legacy_id != null);
    const withoutLegacy = rows.filter(r => r.legacy_id == null);
    let inserted = 0, updated = 0, errors = [];
    if (withLegacy.length) {
      const { data, error } = await c.from('products')
        .upsert(withLegacy, { onConflict: 'legacy_id' }).select();
      if (error) errors.push(error.message); else updated += (data || []).length;
    }
    if (withoutLegacy.length) {
      const { data, error } = await c.from('products').insert(withoutLegacy).select();
      if (error) errors.push(error.message); else inserted += (data || []).length;
    }
    return { inserted, updated, errors };
  }

  // ---- Customer order history (RLS limits to own orders automatically) ----
  async function fetchUserOrders() {
    const c = getClient(); if (!c) return [];
    const { data: sessRes } = await c.auth.getSession();
    if (!sessRes || !sessRes.session) return [];
    const { data, error } = await c.from('orders')
      .select('*').eq('user_id', sessRes.session.user.id)
      .order('created_at', { ascending: false }).limit(100);
    if (error) { console.warn('[Supabase] fetchUserOrders:', error.message); return []; }
    return data || [];
  }


  // =====================================================
  // ===== NEW: Order status timeline =====
  // =====================================================
  async function logOrderStatusEvent(ref, status, changedBy, notes) {
    const c = getClient(); if (!c) return { error: 'no client' };
    try {
      const { error } = await c.from('order_status_events').insert({
        order_ref: ref, status, changed_by: changedBy || 'system', notes: notes || null
      });
      if (error) console.warn('[Supabase] logOrderStatusEvent:', error.message);
      return { error };
    } catch (e) { console.warn('[Supabase] logOrderStatusEvent threw:', e); return { error: e }; }
  }

  async function fetchOrderStatusEvents(ref) {
    const c = getClient(); if (!c) return [];
    const { data, error } = await c.from('order_status_events')
      .select('*').eq('order_ref', ref).order('changed_at', { ascending: true });
    if (error) { console.warn('[Supabase] fetchOrderStatusEvents:', error.message); return []; }
    return data || [];
  }

  // =====================================================
  // ===== NEW: Audit log =====
  // =====================================================
  // Simple full-text-ish search across action + entity_id + entity + actor + JSON meta.
  async function searchAuditLog({ q, entityId, from, to, actor, action, limit = 200 } = {}) {
    const c = getClient(); if (!c) return [];
    let query = c.from('audit_log').select('*').order('occurred_at', { ascending: false }).limit(limit);
    if (from)     query = query.gte('occurred_at', from);
    if (to)       query = query.lte('occurred_at', to);
    if (actor)    query = query.ilike('actor', '%' + actor + '%');
    if (action) {
      // Support comma-separated action list for "quick filters"
      const parts = String(action).split(',').map(s => s.trim()).filter(Boolean);
      if (parts.length === 1) query = query.eq('action', parts[0]);
      else if (parts.length > 1) query = query.in('action', parts);
    }
    if (entityId) query = query.ilike('entity_id', '%' + entityId + '%');
    if (q) {
      // Postgrest `or` filter — search action, entity_id, entity columns.
      const v = q.replace(/[%,()]/g, '');
      query = query.or(`action.ilike.%${v}%,entity_id.ilike.%${v}%,entity.ilike.%${v}%,actor.ilike.%${v}%`);
    }
    const { data, error } = await query;
    if (error) { console.warn('[Supabase] searchAuditLog:', error.message); return []; }
    return data || [];
  }

  async function audit({ actor, action, entity, entity_id, before_data, after_data, meta }) {
    const c = getClient(); if (!c) return { error: 'no client' };
    try {
      const { error } = await c.from('audit_log').insert({
        actor: actor || 'system',
        action, entity: entity || null,
        entity_id: entity_id != null ? String(entity_id) : null,
        before_data: before_data || null,
        after_data: after_data || null,
        meta: meta || null
      });
      if (error) console.warn('[Supabase] audit:', error.message);
      return { error };
    } catch (e) { console.warn('[Supabase] audit threw:', e); return { error: e }; }
  }

  async function fetchAuditLog({ from, to, actor, action, limit = 200 } = {}) {
    const c = getClient(); if (!c) return [];
    let q = c.from('audit_log').select('*').order('occurred_at', { ascending: false }).limit(limit);
    if (from)   q = q.gte('occurred_at', from);
    if (to)     q = q.lte('occurred_at', to);
    if (actor)  q = q.ilike('actor', '%' + actor + '%');
    if (action) q = q.eq('action', action);
    const { data, error } = await q;
    if (error) { console.warn('[Supabase] fetchAuditLog:', error.message); return []; }
    return data || [];
  }

  // =====================================================
  // ===== NEW: Invoice settings =====
  // =====================================================
  async function fetchInvoiceSettings() {
    const c = getClient(); if (!c) return null;
    const { data, error } = await c.from('invoice_settings').select('*').eq('id', 1).maybeSingle();
    if (error) { console.warn('[Supabase] fetchInvoiceSettings:', error.message); return null; }
    return data;
  }
  async function updateInvoiceSettings(patch) {
    const c = getClient(); if (!c) return { error: 'no client' };
    patch.updated_at = new Date().toISOString();
    const { data, error } = await c.from('invoice_settings').update(patch).eq('id', 1).select().single();
    if (error) { console.warn('[Supabase] updateInvoiceSettings:', error.message); return { error }; }
    return { data };
  }
  async function issueInvoiceNumber() {
    const c = getClient(); if (!c) return null;
    const { data, error } = await c.rpc('issue_invoice_number');
    if (error) { console.warn('[Supabase] issue_invoice_number:', error.message); return null; }
    return data;
  }

  // =====================================================
  // ===== OTP brute-force (SERVER-ENFORCED) =====
  // =====================================================
  // The authoritative gate is the Postgres function `otp_record_attempt`
  // (SECURITY DEFINER) which runs inside Supabase. The client only renders
  // the result. See SQL artifact /mnt/documents/letema_otp_hardening.sql.
  async function recordOtpAttempt(identifier, event, channel) {
    const c = getClient();
    if (!c) return { allowed: false, locked: true, fail_count: 0, locked_until: null, reason: 'no_client' };
    const ident = String(identifier || '').toLowerCase();
    const { data, error } = await c.rpc('otp_record_attempt', {
      _identifier: ident,
      _event: event,
      _channel: channel || 'email',
      _user_agent: (navigator && navigator.userAgent) ? navigator.userAgent.slice(0, 180) : null
    });
    if (error) {
      console.warn('[Supabase] otp_record_attempt:', error.message);
      // Fail CLOSED on send/verify so a broken RPC can't bypass the limit.
      return { allowed: false, locked: true, fail_count: 0, locked_until: null, reason: 'rpc_error: ' + error.message };
    }
    const row = Array.isArray(data) ? data[0] : data;
    return row || { allowed: false, locked: true, fail_count: 0, locked_until: null };
  }
  // Back-compat wrappers — every caller now goes through the server gate.
  async function logOtpAttempt(identifier, event, channel) {
    return recordOtpAttempt(identifier, event, channel);
  }
  async function getOtpLockState(identifier) {
    const c = getClient(); if (!c) return { locked: false, fail_count: 0, locked_until: null };
    const { data, error } = await c.rpc('otp_lock_state', { _identifier: String(identifier || '').toLowerCase() });
    if (error) { console.warn('[Supabase] otp_lock_state:', error.message); return { locked: false, fail_count: 0, locked_until: null }; }
    const row = Array.isArray(data) ? data[0] : data;
    return row || { locked: false, fail_count: 0, locked_until: null };
  }

  // =====================================================
  // ===== NEW: Smart CSV upsert (dedupe by name+category,
  // ===== skip identical rows, update only changed fields)
  // =====================================================
  async function smartUpsertProducts(rows) {
    const c = getClient(); if (!c) return { error: 'no client' };
    if (!Array.isArray(rows) || !rows.length) return { error: 'no rows' };
    const { data: existing, error: selErr } = await c.from('products').select('*');
    if (selErr) return { error: selErr.message };
    const norm = s => String(s || '').trim().toLowerCase();
    const keyOf = r => norm(r.name) + '||' + norm(r.category);
    const byKey = new Map();
    (existing || []).forEach(p => byKey.set(keyOf(p), p));

    const trackedFields = ['name','price','category','icon','badge','description','stock_quantity','is_active'];
    let inserted = 0, updated = 0, skipped = 0, errors = [];
    const skippedRows = [], updatedRows = [], insertedRows = [];

    for (const r of rows) {
      const found = byKey.get(keyOf(r));
      if (!found) {
        const { error } = await c.from('products').insert(r);
        if (error) { errors.push(error.message); continue; }
        inserted++; insertedRows.push(r.name);
        continue;
      }
      // Compare fields
      const diff = {};
      for (const f of trackedFields) {
        const a = (r[f] === undefined || r[f] === null) ? null : r[f];
        const b = (found[f] === undefined || found[f] === null) ? null : found[f];
        // Loose equality so '5'==5
        if (String(a) !== String(b) && a !== null) diff[f] = a;
      }
      if (Object.keys(diff).length === 0) {
        skipped++; skippedRows.push(r.name);
        continue;
      }
      const { error } = await c.from('products').update(diff).eq('id', found.id);
      if (error) { errors.push(error.message); continue; }
      updated++; updatedRows.push({ name: r.name, changed: Object.keys(diff) });
    }
    return { inserted, updated, skipped, errors, insertedRows, updatedRows, skippedRows };
  }

  // =====================================================
  // ===== Admin activity log (Supabase-first) =====
  // Inatumia jedwali lile lile la `audit_log` na prefix `admin.`
  // ili logs za admin ziwe synced kwenye vifaa vyote.
  // =====================================================
  async function fetchAdminActivityLog({ limit = 200, from, to } = {}) {
    const c = getClient(); if (!c) return [];
    let q = c.from('audit_log')
      .select('*')
      .like('action', 'admin.%')
      .order('occurred_at', { ascending: false })
      .limit(limit);
    if (from) q = q.gte('occurred_at', from);
    if (to)   q = q.lte('occurred_at', to);
    const { data, error } = await q;
    if (error) { console.warn('[Supabase] fetchAdminActivityLog:', error.message); return []; }
    return data || [];
  }

  async function clearAdminActivityLog() {
    const c = getClient(); if (!c) return { error: 'no client' };
    // Futa tu rekodi za admin.* — usigusi audit zingine (orders, products, otp).
    const { error } = await c.from('audit_log').delete().like('action', 'admin.%');
    if (error) { console.warn('[Supabase] clearAdminActivityLog:', error.message); return { error }; }
    return { ok: true };
  }

  // =====================================================
  // ===== FILE UPLOAD — Supabase Storage =====
  // =====================================================
  /**
   * Uploads a customer file to Supabase Storage bucket "order-files".
   * Path: {orderRef}/{timestamp}_{fileName}
   * Returns { success, url, path } or { success: false, reason }
   */
  async function uploadFileToSupabase(file, orderRef, customerName) {
    const c = getClient();
    if (!c) return { success: false, reason: 'no_client' };
    if (!file) return { success: false, reason: 'no_file' };

    const BUCKET = 'order-files';
    const safeName = file.name.replace(/[^a-zA-Z0-9._-]/g, '_');
    const path = `${orderRef || 'UNKNOWN'}/${Date.now()}_${safeName}`;

    try {
      const { data, error } = await c.storage
        .from(BUCKET)
        .upload(path, file, {
          contentType: file.type || 'application/octet-stream',
          upsert: false,
          metadata: { orderRef: orderRef || '', customer: customerName || '' }
        });

      if (error) {
        console.warn('[Supabase Storage] upload failed:', error.message);
        return { success: false, reason: error.message };
      }

      // Get a signed URL valid for 7 days (604800 seconds)
      const { data: signedData, error: signErr } = await c.storage
        .from(BUCKET)
        .createSignedUrl(path, 604800);

      const url = signedData?.signedUrl || null;
      return { success: true, path, url };
    } catch (e) {
      console.warn('[Supabase Storage] upload threw:', e);
      return { success: false, reason: e.message };
    }
  }

  return {
    getClient,
    insertOrder, updateOrderStatus, fetchOrders, fetchUserOrders,
    fetchProducts, upsertProduct, bulkUpsertProducts, deleteProductRemote, setProductStock,
    signUp, signIn, sendEmailOtp, sendPhoneOtp, verifyOtpCode, resendVerificationEmail,
    signOut, getSession, onAuthChange,
    subscribeOrders,
    // new exports
    logOrderStatusEvent, fetchOrderStatusEvents,
    audit, fetchAuditLog, searchAuditLog,
    fetchInvoiceSettings, updateInvoiceSettings, issueInvoiceNumber,
    logOtpAttempt, getOtpLockState, recordOtpAttempt,
    smartUpsertProducts,
    // admin activity log (synced)
    fetchAdminActivityLog, clearAdminActivityLog,
    // file uploads
    uploadFileToSupabase
  };
})();
</script>

<style>
:root {
  --navy: #003087;
  --navy-dark: #001f5c;
  --navy-mid: #002470;
  --gold: #FFC600;
  --gold-light: #FFE066;
  --gold-dark: #cc9e00;
  --wa-green: #25D366;
  --wa-dark: #128C7E;
  --white: #ffffff;
  --off-white: #f7f9ff;
  --gray-100: #f1f4fb;
  --gray-200: #e0e8f5;
  --gray-400: #94a3b8;
  --gray-600: #475569;
  --gray-800: #1e293b;
  --success: #16a34a;
  --success-light: #dcfce7;
  --danger: #dc2626;
  --danger-light: #fee2e2;
  --warning: #d97706;
  --warning-light: #fef3c7;
  --shadow-sm: 0 1px 3px rgba(0,48,135,0.08);
  --shadow-md: 0 4px 16px rgba(0,48,135,0.12);
  --shadow-lg: 0 8px 32px rgba(0,48,135,0.16);
  --shadow-xl: 0 16px 48px rgba(0,48,135,0.2);
  --radius-sm: 6px;
  --radius-md: 10px;
  --radius-lg: 16px;
  --radius-xl: 24px;
  --font-head: 'Montserrat', sans-serif;
  --font-body: 'Plus Jakarta Sans', sans-serif;
  --transition: 0.2s cubic-bezier(0.4,0,0.2,1);
}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;font-size:16px;}
body{font-family:var(--font-body);background:var(--off-white);color:var(--gray-800);overflow-x:hidden;}
a{text-decoration:none;color:inherit;}
img{max-width:100%;display:block;}
button{cursor:pointer;font-family:var(--font-body);border:none;outline:none;}
input,textarea,select{font-family:var(--font-body);outline:none;}

/* ===== SCROLLBAR ===== */
::-webkit-scrollbar{width:6px;}
::-webkit-scrollbar-track{background:var(--gray-100);}
::-webkit-scrollbar-thumb{background:var(--navy);border-radius:3px;}

/* ===== SECURITY BADGE ===== */
.sec-bar{background:var(--navy-dark);padding:8px 0;text-align:center;}
.sec-bar-inner{display:flex;align-items:center;justify-content:center;gap:20px;flex-wrap:wrap;}
.sec-item{display:flex;align-items:center;gap:6px;font-size:11.5px;color:rgba(255,255,255,0.8);font-family:var(--font-head);font-weight:600;letter-spacing:0.3px;}
.sec-item .si{color:var(--gold);font-size:13px;}

/* ===== TOP NAV ===== */
.topnav{background:var(--white);border-bottom:1px solid var(--gray-200);padding:10px 0;position:sticky;top:0;z-index:1000;box-shadow:var(--shadow-sm);}
.nav-wrap{max-width:1200px;margin:0 auto;padding:0 24px;display:flex;align-items:center;justify-content:space-between;gap:16px;}
.nav-logo{display:flex;align-items:center;gap:12px;cursor:pointer;}
.nav-logo-icon{width:44px;height:44px;background:var(--navy);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0;}
.nav-logo-text{font-family:var(--font-head);font-weight:900;font-size:15px;color:var(--navy);line-height:1.1;text-transform:uppercase;letter-spacing:0.3px;}
.nav-logo-text small{display:block;font-size:10px;font-weight:600;color:var(--gray-400);text-transform:none;letter-spacing:0;}
.nav-search{flex:1;max-width:400px;position:relative;}
.nav-search input{width:100%;padding:10px 16px 10px 42px;border:1.5px solid var(--gray-200);border-radius:50px;font-size:13.5px;background:var(--gray-100);transition:var(--transition);color:var(--gray-800);}
.nav-search input:focus{border-color:var(--navy);background:var(--white);box-shadow:0 0 0 3px rgba(0,48,135,0.08);}
.nav-search .search-icon{position:absolute;left:14px;top:50%;transform:translateY(-50%);font-size:15px;color:var(--gray-400);pointer-events:none;}
.nav-actions{display:flex;align-items:center;gap:8px;}
.nav-btn{padding:9px 18px;border-radius:50px;font-size:13px;font-weight:600;font-family:var(--font-head);transition:var(--transition);cursor:pointer;}
.nav-btn-ghost{background:transparent;border:1.5px solid var(--gray-200);color:var(--gray-600);}
.nav-btn-ghost:hover{border-color:var(--navy);color:var(--navy);}
.nav-btn-primary{background:var(--navy);color:var(--white);border:1.5px solid var(--navy);}
.nav-btn-primary:hover{background:var(--navy-dark);transform:translateY(-1px);box-shadow:var(--shadow-md);}
.cart-btn{position:relative;padding:9px 14px;background:var(--gold);border-radius:50px;color:var(--navy-dark);font-weight:700;font-family:var(--font-head);font-size:13px;transition:var(--transition);}
.cart-btn:hover{background:var(--gold-dark);transform:translateY(-1px);}
.cart-count{position:absolute;top:-6px;right:-6px;background:var(--danger);color:white;font-size:10px;font-weight:700;width:18px;height:18px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:var(--font-head);transition:transform 0.2s;}
.cart-count.bump{transform:scale(1.4);}

/* ===== CATEGORY NAV ===== */
.cat-nav{background:var(--navy);padding:0;}
.cat-nav-inner{max-width:1200px;margin:0 auto;padding:0 24px;display:flex;align-items:center;gap:0;overflow-x:auto;}
.cat-nav-inner::-webkit-scrollbar{height:0;}
.cat-link{padding:12px 18px;font-size:12.5px;font-weight:700;font-family:var(--font-head);color:rgba(255,255,255,0.75);text-transform:uppercase;letter-spacing:0.5px;white-space:nowrap;transition:var(--transition);border-bottom:3px solid transparent;cursor:pointer;}
.cat-link:hover,.cat-link.active{color:var(--gold);border-bottom-color:var(--gold);}

/* ===== HERO ===== */
.hero{background:linear-gradient(135deg,var(--navy) 0%,var(--navy-dark) 50%,#001240 100%);padding:64px 24px;position:relative;overflow:hidden;}
.hero::before{content:'';position:absolute;top:-100px;right:-100px;width:500px;height:500px;border-radius:50%;background:rgba(255,198,0,0.06);pointer-events:none;}
.hero::after{content:'';position:absolute;bottom:-80px;left:10%;width:300px;height:300px;border-radius:50%;background:rgba(255,255,255,0.03);pointer-events:none;}
.hero-inner{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;position:relative;z-index:1;}
.hero-badge{display:inline-flex;align-items:center;gap:6px;background:rgba(255,198,0,0.15);border:1px solid rgba(255,198,0,0.4);border-radius:50px;padding:6px 14px;font-size:12px;font-weight:700;color:var(--gold);font-family:var(--font-head);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:20px;}
.hero h1{font-family:var(--font-head);font-size:42px;font-weight:900;color:var(--white);line-height:1.1;margin-bottom:16px;letter-spacing:-0.5px;}
.hero h1 span{color:var(--gold);}
.hero p{font-size:16px;color:rgba(255,255,255,0.75);line-height:1.7;margin-bottom:28px;}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap;}
.btn-gold{padding:13px 28px;background:var(--gold);color:var(--navy-dark);border-radius:50px;font-weight:800;font-family:var(--font-head);font-size:14px;transition:var(--transition);display:inline-flex;align-items:center;gap:8px;letter-spacing:0.3px;}
.btn-gold:hover{background:var(--gold-light);transform:translateY(-2px);box-shadow:0 8px 24px rgba(255,198,0,0.35);}
.btn-outline-white{padding:13px 28px;background:transparent;border:2px solid rgba(255,255,255,0.3);color:var(--white);border-radius:50px;font-weight:700;font-family:var(--font-head);font-size:14px;transition:var(--transition);display:inline-flex;align-items:center;gap:8px;}
.btn-outline-white:hover{border-color:var(--white);background:rgba(255,255,255,0.08);}
.hero-stats{display:flex;gap:24px;margin-top:32px;}
.hero-stat{text-align:center;}
.hero-stat-num{font-family:var(--font-head);font-size:24px;font-weight:900;color:var(--gold);}
.hero-stat-label{font-size:11px;color:rgba(255,255,255,0.6);text-transform:uppercase;letter-spacing:0.5px;font-weight:600;}
.hero-right{display:flex;flex-direction:column;gap:12px;}
.hero-card{background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.12);border-radius:var(--radius-lg);padding:20px;backdrop-filter:blur(10px);}
.hero-card-title{font-family:var(--font-head);font-size:13px;font-weight:700;color:var(--gold);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:10px;}
.hero-services-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;}
.hsg-item{display:flex;align-items:center;gap:8px;font-size:12.5px;color:rgba(255,255,255,0.85);padding:6px 10px;background:rgba(255,255,255,0.05);border-radius:var(--radius-sm);}
.hsg-icon{font-size:16px;}

/* ===== SECTION LAYOUTS ===== */
.section{padding:60px 24px;}
.section-alt{background:var(--white);}
.section-inner{max-width:1200px;margin:0 auto;}
.section-header{margin-bottom:36px;}
.section-header h2{font-family:var(--font-head);font-size:28px;font-weight:900;color:var(--navy);margin-bottom:6px;}
.section-header p{font-size:15px;color:var(--gray-600);}
.section-header-row{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;}
.view-all{font-size:13px;font-weight:700;color:var(--navy);font-family:var(--font-head);display:flex;align-items:center;gap:4px;white-space:nowrap;transition:var(--transition);cursor:pointer;}
.view-all:hover{color:var(--gold-dark);}

/* ===== PRODUCT CARDS ===== */
.products-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px;}
.product-card{background:var(--white);border:1.5px solid var(--gray-200);border-radius:var(--radius-lg);overflow:hidden;transition:var(--transition);cursor:pointer;position:relative;}
.product-card:hover{border-color:var(--navy);box-shadow:var(--shadow-lg);transform:translateY(-3px);}
.product-badge{position:absolute;top:10px;left:10px;padding:3px 10px;border-radius:50px;font-size:10px;font-weight:700;font-family:var(--font-head);text-transform:uppercase;letter-spacing:0.3px;z-index:1;}
.badge-new{background:var(--success-light);color:var(--success);}
.badge-hot{background:#fff0f0;color:var(--danger);}
.badge-sale{background:var(--warning-light);color:var(--warning);}
.product-img{width:100%;height:160px;background:var(--gray-100);display:flex;align-items:center;justify-content:center;font-size:56px;position:relative;overflow:hidden;}
.product-img::after{content:'';position:absolute;inset:0;background:linear-gradient(to bottom,transparent 60%,rgba(0,0,0,0.04));}
.product-body{padding:14px;}
.product-category{font-size:10.5px;font-weight:700;color:var(--gray-400);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:4px;font-family:var(--font-head);}
.product-name{font-size:14px;font-weight:700;color:var(--gray-800);margin-bottom:8px;line-height:1.3;font-family:var(--font-head);}
.product-price-row{display:flex;align-items:center;justify-content:space-between;gap:8px;}
.product-price{font-size:16px;font-weight:900;color:var(--navy);font-family:var(--font-head);}
.product-price-old{font-size:12px;color:var(--gray-400);text-decoration:line-through;font-weight:500;}
.add-to-cart{width:34px;height:34px;background:var(--navy);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px;transition:var(--transition);flex-shrink:0;}
.add-to-cart:hover{background:var(--gold);transform:scale(1.1);}
.product-rating{display:flex;align-items:center;gap:4px;margin-bottom:6px;}
.stars{color:var(--gold);font-size:12px;}
.rating-count{font-size:11px;color:var(--gray-400);}

/* ===== SERVICES SECTION ===== */
.services-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:16px;}
.service-card{background:var(--white);border:1.5px solid var(--gray-200);border-radius:var(--radius-lg);padding:24px 20px;text-align:center;transition:var(--transition);cursor:pointer;position:relative;overflow:hidden;}
.service-card::before{content:'';position:absolute;top:0;left:0;right:0;height:4px;background:var(--navy);}
.service-card.gold::before{background:var(--gold);}
.service-card:hover{border-color:var(--navy);box-shadow:var(--shadow-lg);transform:translateY(-3px);}
.service-icon-wrap{width:56px;height:56px;background:var(--gray-100);border-radius:var(--radius-md);display:flex;align-items:center;justify-content:center;font-size:28px;margin:0 auto 14px;}
.service-card:hover .service-icon-wrap{background:rgba(0,48,135,0.08);}
.service-name{font-family:var(--font-head);font-size:13.5px;font-weight:700;color:var(--navy);margin-bottom:6px;}
.service-desc{font-size:12px;color:var(--gray-600);line-height:1.5;}
.service-price{display:inline-block;margin-top:10px;padding:4px 12px;background:var(--gold-light);color:var(--navy-dark);border-radius:50px;font-size:11px;font-weight:700;font-family:var(--font-head);}
.order-service-btn{display:block;width:100%;margin-top:14px;padding:9px;background:var(--navy);color:var(--white);border-radius:var(--radius-sm);font-size:12.5px;font-weight:700;font-family:var(--font-head);transition:var(--transition);}
.order-service-btn:hover{background:var(--gold);color:var(--navy-dark);}
.order-direct-btn{display:block;width:100%;margin-top:14px;padding:11px;background:linear-gradient(135deg,var(--gold) 0%,var(--gold-dark) 100%);color:var(--navy-dark);border-radius:var(--radius-md);font-size:13px;font-weight:800;font-family:var(--font-head);transition:var(--transition);letter-spacing:0.2px;box-shadow:0 2px 8px rgba(255,198,0,0.3);}
.order-direct-btn:hover{background:linear-gradient(135deg,var(--gold-light) 0%,var(--gold) 100%);transform:translateY(-2px);box-shadow:0 6px 18px rgba(255,198,0,0.45);}

/* ===== CART SIDEBAR ===== */
.cart-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:2000;opacity:0;pointer-events:none;transition:opacity 0.3s;}
.cart-overlay.open{opacity:1;pointer-events:all;}
.cart-sidebar{position:fixed;right:0;top:0;bottom:0;width:400px;background:var(--white);z-index:2001;transform:translateX(100%);transition:transform 0.35s cubic-bezier(0.4,0,0.2,1);display:flex;flex-direction:column;box-shadow:var(--shadow-xl);}
.cart-sidebar.open{transform:translateX(0);}
.cart-header{padding:20px 24px;border-bottom:1.5px solid var(--gray-200);display:flex;align-items:center;justify-content:space-between;background:var(--navy);}
.cart-header h3{font-family:var(--font-head);font-size:16px;font-weight:700;color:var(--white);}
.cart-close{width:32px;height:32px;background:rgba(255,255,255,0.15);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--white);font-size:18px;cursor:pointer;transition:var(--transition);}
.cart-close:hover{background:rgba(255,255,255,0.25);}
.cart-items{flex:1;overflow-y:auto;padding:16px 24px;}
.cart-item{display:flex;gap:12px;padding:14px 0;border-bottom:1px solid var(--gray-200);}
.cart-item-img{width:56px;height:56px;background:var(--gray-100);border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;font-size:28px;flex-shrink:0;}
.cart-item-info{flex:1;}
.cart-item-name{font-size:13.5px;font-weight:600;color:var(--gray-800);margin-bottom:3px;font-family:var(--font-head);}
.cart-item-price{font-size:14px;font-weight:700;color:var(--navy);font-family:var(--font-head);}
.cart-item-qty{display:flex;align-items:center;gap:8px;margin-top:6px;}
.qty-btn{width:24px;height:24px;background:var(--gray-100);border-radius:4px;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;cursor:pointer;transition:var(--transition);}
.qty-btn:hover{background:var(--navy);color:var(--white);}
.qty-num{font-size:13px;font-weight:700;min-width:20px;text-align:center;font-family:var(--font-head);}
.cart-remove{color:var(--danger);font-size:12px;cursor:pointer;margin-left:auto;font-weight:600;transition:var(--transition);}
.cart-remove:hover{opacity:0.7;}
.cart-footer{padding:20px 24px;border-top:1.5px solid var(--gray-200);background:var(--off-white);}
.cart-subtotal{display:flex;justify-content:space-between;margin-bottom:6px;font-size:14px;color:var(--gray-600);}
.cart-total{display:flex;justify-content:space-between;font-family:var(--font-head);font-size:18px;font-weight:900;color:var(--navy);margin-bottom:16px;}
.checkout-btn{width:100%;padding:15px;background:var(--navy);color:var(--white);border-radius:var(--radius-md);font-family:var(--font-head);font-size:15px;font-weight:700;transition:var(--transition);display:flex;align-items:center;justify-content:center;gap:8px;}
.checkout-btn:hover{background:var(--gold);color:var(--navy-dark);transform:translateY(-1px);box-shadow:var(--shadow-md);}
.cart-empty{text-align:center;padding:60px 20px;color:var(--gray-400);}
.cart-empty .ce-icon{font-size:56px;margin-bottom:12px;}
.cart-empty p{font-size:14px;font-weight:600;font-family:var(--font-head);}

/* ===== MODAL ===== */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:3000;opacity:0;pointer-events:none;transition:opacity 0.3s;display:flex;align-items:center;justify-content:center;padding:20px;}
.modal-overlay.open{opacity:1;pointer-events:all;}
.modal{background:var(--white);border-radius:var(--radius-xl);width:100%;max-width:480px;max-height:90vh;overflow-y:auto;transform:scale(0.92);transition:transform 0.3s;box-shadow:var(--shadow-xl);}
.modal-overlay.open .modal{transform:scale(1);}
.modal-header{padding:24px 28px 20px;border-bottom:1px solid var(--gray-200);display:flex;align-items:center;justify-content:space-between;}
.modal-header h3{font-family:var(--font-head);font-size:18px;font-weight:800;color:var(--navy);}
.modal-close{font-size:22px;cursor:pointer;color:var(--gray-400);transition:var(--transition);}
.modal-close:hover{color:var(--navy);}
.modal-body{padding:24px 28px;}
.modal-footer{padding:16px 28px 24px;display:flex;gap:10px;}

/* ===== ORDER MODAL DYNAMIC FIELDS ===== */
.order-modal-service-banner{display:flex;align-items:center;gap:12px;background:linear-gradient(135deg,var(--navy) 0%,var(--navy-mid) 100%);border-radius:var(--radius-md);padding:14px 16px;margin-bottom:20px;}
.order-modal-svc-icon{font-size:28px;flex-shrink:0;}
.order-modal-svc-name{font-family:var(--font-head);font-size:14px;font-weight:800;color:var(--white);line-height:1.2;}
.order-modal-svc-price{font-size:11px;color:var(--gold);font-weight:700;font-family:var(--font-head);margin-top:2px;}
.dyn-fields-divider{display:flex;align-items:center;gap:10px;margin:16px 0 14px;font-size:11.5px;font-weight:700;color:var(--navy);font-family:var(--font-head);text-transform:uppercase;letter-spacing:0.5px;}
.dyn-fields-divider::before,.dyn-fields-divider::after{content:'';flex:1;height:1.5px;background:var(--gold);opacity:0.5;}
.radio-group{display:flex;gap:8px;flex-wrap:wrap;}
.radio-option{flex:1;min-width:100px;padding:10px 12px;border:1.5px solid var(--gray-200);border-radius:var(--radius-sm);cursor:pointer;transition:var(--transition);display:flex;align-items:center;gap:8px;font-size:13px;font-weight:600;color:var(--gray-700);font-family:var(--font-head);}
.radio-option:hover{border-color:var(--navy);background:rgba(0,48,135,0.04);}
.radio-option.selected{border-color:var(--navy);background:rgba(0,48,135,0.07);color:var(--navy);}
.radio-option input[type="radio"]{accent-color:var(--navy);width:15px;height:15px;}
.order-modal-footer-note{text-align:center;margin-top:10px;font-size:11.5px;color:var(--gray-400);display:flex;align-items:center;justify-content:center;gap:5px;}

/* ===== SERVICE REQUIREMENTS BOX ===== */
.svc-req-box{display:flex;gap:12px;background:linear-gradient(135deg,#fffbeb 0%,#fef9e7 100%);border:1.5px solid var(--gold);border-radius:var(--radius-md);padding:14px 16px;margin-bottom:20px;position:relative;overflow:hidden;}
.svc-req-box::before{content:'';position:absolute;top:0;left:0;width:4px;height:100%;background:linear-gradient(to bottom,var(--gold),var(--gold-dark));border-radius:var(--radius-sm) 0 0 var(--radius-sm);}
.svc-req-box-icon{font-size:22px;flex-shrink:0;line-height:1;}
.svc-req-box-body{flex:1;}
.svc-req-box-title{font-family:var(--font-head);font-size:11px;font-weight:800;color:var(--gold-dark);text-transform:uppercase;letter-spacing:0.6px;margin-bottom:5px;}
.svc-req-box-text{font-size:12.5px;color:var(--gray-700);line-height:1.65;}
.svc-req-item{display:flex;align-items:flex-start;gap:6px;margin-bottom:3px;font-size:12.5px;color:var(--gray-800);}
.svc-req-item::before{content:'✔';color:var(--gold-dark);font-weight:700;font-size:11px;margin-top:2px;flex-shrink:0;}

/* ===== MODAL WIDER FOR ORDER ===== */

.form-group{margin-bottom:16px;}
.form-label{display:block;font-size:12.5px;font-weight:700;color:var(--gray-600);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px;font-family:var(--font-head);}
.form-input{width:100%;padding:11px 14px;border:1.5px solid var(--gray-200);border-radius:var(--radius-sm);font-size:14px;color:var(--gray-800);background:var(--off-white);transition:var(--transition);}
.form-input:focus{border-color:var(--navy);background:var(--white);box-shadow:0 0 0 3px rgba(0,48,135,0.08);}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.form-hint{font-size:11px;color:var(--gray-400);margin-top:4px;}
.form-error{font-size:11px;color:var(--danger);margin-top:4px;display:none;}
.form-input.error{border-color:var(--danger);}
.form-input.error + .form-error{display:block;}
.input-group{position:relative;}
.input-group .form-input{padding-right:44px;}
.input-icon{position:absolute;right:14px;top:50%;transform:translateY(-50%);font-size:16px;cursor:pointer;color:var(--gray-400);}
.divider{display:flex;align-items:center;gap:12px;margin:18px 0;color:var(--gray-400);font-size:12px;}
.divider::before,.divider::after{content:'';flex:1;height:1px;background:var(--gray-200);}
.social-btn{width:100%;padding:11px;border:1.5px solid var(--gray-200);border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;gap:8px;font-size:13.5px;font-weight:600;color:var(--gray-700);transition:var(--transition);background:var(--white);}
.social-btn:hover{border-color:var(--navy);background:var(--off-white);}

/* ===== CHECKOUT ===== */
.checkout-page{display:none;position:fixed;inset:0;background:var(--off-white);z-index:2500;overflow-y:auto;}
.checkout-page.open{display:block;}
.checkout-topbar{background:var(--navy);padding:16px 24px;display:flex;align-items:center;gap:16px;}
.checkout-topbar h2{font-family:var(--font-head);font-size:17px;font-weight:800;color:var(--white);}
.back-btn{background:rgba(255,255,255,0.15);border:none;color:var(--white);padding:8px 14px;border-radius:50px;font-size:13px;font-weight:700;font-family:var(--font-head);cursor:pointer;transition:var(--transition);display:flex;align-items:center;gap:6px;}
.back-btn:hover{background:rgba(255,255,255,0.25);}
.checkout-inner{max-width:1000px;margin:0 auto;padding:32px 24px;display:grid;grid-template-columns:1fr 360px;gap:24px;}
.checkout-form-section{background:var(--white);border-radius:var(--radius-lg);padding:28px;box-shadow:var(--shadow-sm);}
.checkout-section-title{font-family:var(--font-head);font-size:15px;font-weight:800;color:var(--navy);margin-bottom:20px;padding-bottom:12px;border-bottom:1.5px solid var(--gray-200);display:flex;align-items:center;gap:8px;}
.checkout-section-title span{width:26px;height:26px;background:var(--navy);color:var(--white);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;flex-shrink:0;}
.payment-methods{display:flex;flex-direction:column;gap:10px;margin-bottom:20px;}
.pay-method{border:1.5px solid var(--gray-200);border-radius:var(--radius-md);padding:14px 16px;cursor:pointer;transition:var(--transition);display:flex;align-items:center;gap:12px;}
.pay-method:hover,.pay-method.selected{border-color:var(--navy);background:rgba(0,48,135,0.03);}
.pay-method .pm-icon{font-size:22px;width:36px;text-align:center;}
.pm-name{font-family:var(--font-head);font-size:13.5px;font-weight:700;color:var(--gray-800);}
.pm-desc{font-size:11.5px;color:var(--gray-400);}
.pm-radio{width:18px;height:18px;border:2px solid var(--gray-200);border-radius:50%;margin-left:auto;flex-shrink:0;transition:var(--transition);display:flex;align-items:center;justify-content:center;}
.pay-method.selected .pm-radio{border-color:var(--navy);background:var(--navy);}
.pay-method.selected .pm-radio::after{content:'';width:6px;height:6px;background:white;border-radius:50%;}
.order-summary-box{background:var(--white);border-radius:var(--radius-lg);padding:24px;box-shadow:var(--shadow-sm);position:sticky;top:20px;}
.os-title{font-family:var(--font-head);font-size:15px;font-weight:800;color:var(--navy);margin-bottom:16px;padding-bottom:12px;border-bottom:1.5px solid var(--gray-200);}
.os-items{margin-bottom:16px;}
.os-item{display:flex;justify-content:space-between;align-items:center;font-size:13px;padding:6px 0;border-bottom:1px dashed var(--gray-200);}
.os-item-name{color:var(--gray-700);max-width:65%;}
.os-item-price{font-weight:700;color:var(--navy);font-family:var(--font-head);}
.os-line{display:flex;justify-content:space-between;font-size:13px;color:var(--gray-600);margin-bottom:6px;}
.os-total{display:flex;justify-content:space-between;font-family:var(--font-head);font-size:18px;font-weight:900;color:var(--navy);margin-top:10px;padding-top:10px;border-top:2px solid var(--navy);}

/* ===== WHATSAPP ORDER BUTTON ===== */
.place-order-btn{width:100%;margin-top:16px;padding:15px;background:var(--wa-green);color:var(--white);border-radius:var(--radius-md);font-family:var(--font-head);font-size:15px;font-weight:800;transition:var(--transition);display:flex;align-items:center;justify-content:center;gap:8px;border:none;cursor:pointer;}
.place-order-btn:hover{background:var(--wa-dark);transform:translateY(-1px);box-shadow:0 8px 24px rgba(37,211,102,0.35);}
.place-order-btn:disabled{opacity:0.7;cursor:not-allowed;transform:none;}
.security-note{display:flex;align-items:center;gap:6px;margin-top:12px;font-size:11.5px;color:var(--gray-400);justify-content:center;}

/* ===== LIPA KWA SIMU BLOCK ===== */
.lipa-simu-block{background:linear-gradient(135deg,#e8fff0,#f0fff8);border:1.5px solid #86efac;border-radius:var(--radius-md);padding:16px;margin-top:20px;}
.lipa-simu-title{font-family:var(--font-head);font-size:13px;font-weight:800;color:var(--success);margin-bottom:12px;display:flex;align-items:center;gap:6px;}
.lipa-step{display:flex;align-items:flex-start;gap:10px;margin-bottom:8px;font-size:12.5px;color:var(--gray-700);line-height:1.5;}
.lipa-step-num{width:20px;height:20px;background:var(--success);color:white;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;flex-shrink:0;margin-top:1px;}
.lipa-number{font-family:var(--font-head);font-weight:800;color:var(--navy);font-size:14px;background:rgba(0,48,135,0.06);border-radius:4px;padding:2px 8px;letter-spacing:0.5px;}

/* ===== LOADING SPINNER ===== */
.spinner-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.65);z-index:9000;display:none;align-items:center;justify-content:center;flex-direction:column;gap:20px;}
.spinner-overlay.active{display:flex;}
.spinner-ring{width:64px;height:64px;border:5px solid rgba(255,255,255,0.15);border-top-color:var(--wa-green);border-radius:50%;animation:spinRing 0.8s linear infinite;}
@keyframes spinRing{to{transform:rotate(360deg);}}
.spinner-text{font-family:var(--font-head);font-size:15px;font-weight:700;color:var(--white);text-align:center;line-height:1.5;}
.spinner-text small{display:block;font-size:12px;color:rgba(255,255,255,0.6);font-weight:400;margin-top:4px;}

/* ===== SUCCESS PAGE ===== */
.success-page{display:none;position:fixed;inset:0;background:var(--off-white);z-index:3000;align-items:center;justify-content:center;flex-direction:column;padding:24px;text-align:center;}
.success-page.open{display:flex;}
.success-icon{width:96px;height:96px;background:var(--success-light);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:48px;margin-bottom:20px;animation:popIn 0.5s ease;}
@keyframes popIn{0%{transform:scale(0);}70%{transform:scale(1.15);}100%{transform:scale(1);}}
.success-title{font-family:var(--font-head);font-size:28px;font-weight:900;color:var(--success);margin-bottom:8px;}
.success-sub{font-size:15px;color:var(--gray-600);max-width:420px;line-height:1.6;margin-bottom:28px;}
.order-ref{background:var(--white);border:1.5px solid var(--gray-200);border-radius:var(--radius-md);padding:16px 24px;margin-bottom:16px;font-family:var(--font-head);}
.order-ref-label{font-size:11px;color:var(--gray-400);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:4px;}
.order-ref-num{font-size:22px;font-weight:900;color:var(--navy);}
.success-actions{display:flex;gap:12px;flex-wrap:wrap;justify-content:center;}
.btn-wa-success{padding:13px 24px;background:var(--wa-green);color:var(--white);border-radius:50px;font-weight:800;font-family:var(--font-head);font-size:14px;transition:var(--transition);display:inline-flex;align-items:center;gap:8px;cursor:pointer;border:none;}
.btn-wa-success:hover{background:var(--wa-dark);transform:translateY(-2px);}

/* ===== PROMO BANNER ===== */
.promo-banner{background:linear-gradient(135deg,#e8f0ff,#fff8e0);border:1.5px solid rgba(0,48,135,0.12);border-radius:var(--radius-lg);padding:24px 32px;display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:60px;}
.promo-text h3{font-family:var(--font-head);font-size:20px;font-weight:900;color:var(--navy);margin-bottom:4px;}
.promo-text p{font-size:14px;color:var(--gray-600);}
.promo-badge{background:var(--gold);color:var(--navy-dark);font-family:var(--font-head);font-size:28px;font-weight:900;padding:8px 20px;border-radius:var(--radius-md);}

/* ===== TRUST BADGES ===== */
.trust-row{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;}
.trust-card{background:var(--white);border:1.5px solid var(--gray-200);border-radius:var(--radius-lg);padding:20px;text-align:center;}
.trust-icon{font-size:28px;margin-bottom:10px;}
.trust-title{font-family:var(--font-head);font-size:13px;font-weight:700;color:var(--navy);margin-bottom:4px;}
.trust-desc{font-size:12px;color:var(--gray-600);}

/* ===== FOOTER ===== */
footer{background:var(--navy-dark);color:var(--white);padding:48px 24px 24px;}
.footer-grid{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:40px;margin-bottom:40px;}
.footer-brand-logo{display:flex;align-items:center;gap:10px;margin-bottom:14px;}
.fbl-icon{width:40px;height:40px;background:var(--gold);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:18px;}
.fbl-name{font-family:var(--font-head);font-size:14px;font-weight:900;color:var(--white);text-transform:uppercase;}
.footer-desc{font-size:13px;color:rgba(255,255,255,0.6);line-height:1.7;margin-bottom:16px;}
.footer-contact-item{display:flex;align-items:center;gap:8px;font-size:13px;color:rgba(255,255,255,0.8);margin-bottom:8px;}
.fci-icon{font-size:15px;color:var(--gold);}
.footer-col h4{font-family:var(--font-head);font-size:12px;font-weight:700;color:var(--gold);text-transform:uppercase;letter-spacing:0.8px;margin-bottom:14px;}
.footer-link{display:block;font-size:13px;color:rgba(255,255,255,0.65);margin-bottom:8px;transition:var(--transition);cursor:pointer;}
.footer-link:hover{color:var(--gold);}
.footer-bottom{max-width:1200px;margin:0 auto;border-top:1px solid rgba(255,255,255,0.1);padding-top:20px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;}
.footer-bottom p{font-size:12px;color:rgba(255,255,255,0.4);}
.footer-badges{display:flex;gap:8px;}
.footer-badge{background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.12);border-radius:4px;padding:4px 10px;font-size:10.5px;color:rgba(255,255,255,0.6);font-family:var(--font-head);font-weight:600;display:flex;align-items:center;gap:5px;}

/* ===== TOAST ===== */
.toast-container{position:fixed;bottom:24px;right:24px;z-index:9999;display:flex;flex-direction:column;gap:8px;}
.toast{background:var(--white);border:1.5px solid var(--gray-200);border-radius:var(--radius-md);padding:14px 18px;box-shadow:var(--shadow-xl);display:flex;align-items:center;gap:10px;min-width:280px;transform:translateX(120%);transition:transform 0.35s cubic-bezier(0.4,0,0.2,1);font-size:13.5px;font-weight:600;color:var(--gray-800);}
.toast.show{transform:translateX(0);}
.toast.success{border-left:4px solid var(--success);}
.toast.error{border-left:4px solid var(--danger);}
.toast.info{border-left:4px solid var(--navy);}
.toast-icon{font-size:18px;}

/* ===== NOTIFICATION DOT ===== */
@keyframes pulse{0%,100%{opacity:1;}50%{opacity:0.5;}}
.pulse{animation:pulse 2s infinite;}

/* ===== FILE UPLOAD FIELD ===== */
.file-upload-wrapper{position:relative;width:100%;}
.file-upload-label{display:flex;align-items:center;gap:12px;width:100%;padding:13px 16px;border:2px dashed var(--navy);border-radius:var(--radius-md);background:rgba(0,48,135,0.03);cursor:pointer;transition:var(--transition);}
.file-upload-label:hover{background:rgba(0,48,135,0.07);border-color:var(--gold-dark);}
.file-upload-label.has-file{border-style:solid;border-color:var(--success);background:var(--success-light);}
.file-upload-icon{width:38px;height:38px;background:var(--navy);border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0;transition:var(--transition);}
.file-upload-label.has-file .file-upload-icon{background:var(--success);}
.file-upload-text{flex:1;}
.file-upload-title{font-family:var(--font-head);font-size:13px;font-weight:700;color:var(--navy);}
.file-upload-label.has-file .file-upload-title{color:var(--success);}
.file-upload-sub{font-size:11px;color:var(--gray-400);margin-top:2px;}
.file-upload-badge{padding:4px 10px;background:var(--gold);color:var(--navy-dark);border-radius:50px;font-size:10px;font-weight:800;font-family:var(--font-head);text-transform:uppercase;letter-spacing:0.3px;white-space:nowrap;}
.file-upload-label.has-file .file-upload-badge{background:var(--success);color:white;}
input[type="file"].hidden-file-input{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer;z-index:2;}
.file-upload-hint{display:flex;align-items:flex-start;gap:8px;margin-top:10px;padding:10px 12px;background:linear-gradient(135deg,rgba(255,198,0,0.08),rgba(0,48,135,0.06));border:1px solid rgba(255,198,0,0.4);border-radius:var(--radius-sm);}
.file-upload-hint-icon{font-size:14px;flex-shrink:0;margin-top:1px;}
.file-upload-hint-text{font-size:11.5px;color:var(--gray-700);line-height:1.55;}
.file-upload-hint-text strong{color:var(--navy);font-weight:700;}

/* ===== TRANSACTION ID FIELD ===== */
.txn-field-wrapper{background:linear-gradient(135deg,rgba(22,163,74,0.04),rgba(0,48,135,0.04));border:1.5px solid rgba(22,163,74,0.35);border-radius:var(--radius-md);padding:16px;}
.txn-field-header{display:flex;align-items:center;gap:8px;margin-bottom:12px;}
.txn-field-badge{display:inline-flex;align-items:center;gap:5px;padding:3px 10px;background:var(--danger);color:white;border-radius:50px;font-size:10px;font-weight:800;font-family:var(--font-head);text-transform:uppercase;letter-spacing:0.3px;}
.txn-field-title{font-family:var(--font-head);font-size:13px;font-weight:800;color:var(--gray-800);}
.txn-input-group{position:relative;}
.txn-input-group .form-input{padding-left:44px;font-family:var(--font-head);font-weight:700;letter-spacing:0.5px;}
.txn-input-icon{position:absolute;left:14px;top:50%;transform:translateY(-50%);font-size:17px;pointer-events:none;}

/* ===== FIELD VALIDATION ===== */
.form-field-error{font-size:11px;color:var(--danger);margin-top:5px;display:flex;align-items:center;gap:4px;font-weight:600;}
.form-input.field-invalid{border-color:var(--danger);background:#fff8f8;}
.form-input.field-valid{border-color:var(--success);}

/* ===== ORDER TYPE BANNER ===== */
.order-type-banner{display:flex;align-items:center;gap:10px;padding:12px 16px;border-radius:var(--radius-md);margin-bottom:16px;font-family:var(--font-head);font-size:13px;font-weight:700;}
.order-type-banner.type-product{background:rgba(0,48,135,0.06);border:1.5px solid rgba(0,48,135,0.2);color:var(--navy);}
.order-type-banner.type-service{background:linear-gradient(135deg,rgba(255,198,0,0.1),rgba(0,48,135,0.05));border:1.5px solid rgba(255,198,0,0.5);color:var(--navy-dark);}
.order-type-icon{font-size:20px;}
.order-type-label{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:0.5px;padding:2px 8px;border-radius:50px;}
.type-product .order-type-label{background:var(--navy);color:var(--white);}
.type-service .order-type-label{background:var(--gold);color:var(--navy-dark);}

/* ===== SERVICE REQUIREMENTS SECTION ===== */
.svc-req-section{background:var(--white);border-radius:var(--radius-lg);padding:28px;box-shadow:var(--shadow-sm);margin-bottom:16px;border-left:4px solid var(--gold);}
.svc-copy-options{display:flex;gap:10px;margin-bottom:4px;}
.svc-copy-btn{flex:1;padding:12px 16px;border:1.5px solid var(--gray-200);border-radius:var(--radius-md);cursor:pointer;transition:var(--transition);display:flex;align-items:center;gap:10px;background:var(--off-white);}
.svc-copy-btn:hover{border-color:var(--navy);background:rgba(0,48,135,0.03);}
.svc-copy-btn.selected{border-color:var(--navy);background:rgba(0,48,135,0.05);}
.svc-copy-btn .scb-icon{font-size:22px;}
.svc-copy-btn .scb-label{font-family:var(--font-head);font-size:13px;font-weight:700;color:var(--gray-800);}
.svc-copy-btn .scb-sub{font-size:11px;color:var(--gray-400);}
.svc-copy-radio{width:16px;height:16px;border:2px solid var(--gray-200);border-radius:50%;margin-left:auto;flex-shrink:0;transition:var(--transition);display:flex;align-items:center;justify-content:center;}
.svc-copy-btn.selected .svc-copy-radio{border-color:var(--navy);background:var(--navy);}
.svc-copy-btn.selected .svc-copy-radio::after{content:'';width:5px;height:5px;background:white;border-radius:50%;}

/* ===== DIGITAL & COMMUNICATION SERVICES SECTION ===== */
.digital-section{padding:60px 24px;background:var(--white);}
.digital-section-inner{max-width:1200px;margin:0 auto;}
.digital-section-header{margin-bottom:36px;}
.digital-section-header h2{font-family:var(--font-head);font-size:28px;font-weight:900;color:var(--navy);margin-bottom:6px;}
.digital-section-header p{font-size:15px;color:var(--gray-600);}
.digital-section-badge{display:inline-flex;align-items:center;gap:6px;background:rgba(0,48,135,0.08);border:1px solid rgba(0,48,135,0.2);border-radius:50px;padding:5px 14px;font-size:11px;font-weight:700;color:var(--navy);font-family:var(--font-head);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:14px;}

/* Category header row within the section */
.dig-cat-label{display:flex;align-items:center;gap:10px;margin:32px 0 14px;}
.dig-cat-label:first-child{margin-top:0;}
.dig-cat-title{font-family:var(--font-head);font-size:13px;font-weight:800;color:var(--navy);text-transform:uppercase;letter-spacing:0.8px;}
.dig-cat-line{flex:1;height:1.5px;background:linear-gradient(to right,var(--gray-200),transparent);}
.dig-cat-icon{width:30px;height:30px;border-radius:8px;background:var(--navy);display:flex;align-items:center;justify-content:center;flex-shrink:0;}

/* Three-column grid — mirrors .services-grid breakpoints */
.digital-services-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
@media(max-width:900px){.digital-services-grid{grid-template-columns:repeat(2,1fr);}}
@media(max-width:540px){.digital-services-grid{grid-template-columns:1fr;}}

/* Service card variant — reuses .service-card base, adds a gold accent option */
.digital-card{background:var(--white);border:1.5px solid var(--gray-200);border-radius:var(--radius-lg);padding:22px 18px;text-align:center;transition:var(--transition);cursor:default;position:relative;overflow:hidden;}
.digital-card::before{content:'';position:absolute;top:0;left:0;right:0;height:4px;background:var(--navy);}
.digital-card.gold::before{background:linear-gradient(90deg,var(--gold) 0%,var(--gold-dark) 100%);}
.digital-card.green::before{background:linear-gradient(90deg,#16a34a 0%,#15803d 100%);}
.digital-card:hover{border-color:var(--navy);box-shadow:var(--shadow-lg);transform:translateY(-3px);}

.digital-icon-wrap{width:54px;height:54px;background:var(--gray-100);border-radius:var(--radius-md);display:flex;align-items:center;justify-content:center;margin:0 auto 14px;transition:var(--transition);}
.digital-card:hover .digital-icon-wrap{background:rgba(0,48,135,0.08);}
.digital-card-name{font-family:var(--font-head);font-size:13px;font-weight:700;color:var(--navy);margin-bottom:6px;line-height:1.35;}
.digital-card-desc{font-size:11.5px;color:var(--gray-600);line-height:1.55;}
.digital-card-tag{display:inline-block;margin-top:10px;padding:3px 11px;background:rgba(0,48,135,0.07);color:var(--navy);border-radius:50px;font-size:10.5px;font-weight:700;font-family:var(--font-head);letter-spacing:0.2px;}
.digital-card.gold .digital-card-tag{background:var(--gold-light);color:var(--navy-dark);}
.digital-card.green .digital-card-tag{background:#dcfce7;color:#15803d;}

/* ===== ADMIN DASHBOARD ===== */
.admin-overlay{position:fixed;inset:0;background:var(--gray-100);z-index:5000;display:none;flex-direction:column;overflow:hidden;}
.admin-overlay.open{display:flex;}
.admin-topbar{background:var(--navy-dark);padding:0 24px;display:flex;align-items:center;gap:0;border-bottom:3px solid var(--gold);}
.admin-topbar-logo{display:flex;align-items:center;gap:10px;padding:14px 24px 14px 0;border-right:1px solid rgba(255,255,255,0.1);margin-right:8px;}
.admin-topbar-logo span{font-family:var(--font-head);font-size:14px;font-weight:900;color:var(--white);text-transform:uppercase;letter-spacing:0.5px;}
.admin-tab{padding:16px 20px;font-family:var(--font-head);font-size:12.5px;font-weight:700;color:rgba(255,255,255,0.6);text-transform:uppercase;letter-spacing:0.5px;cursor:pointer;border-bottom:3px solid transparent;margin-bottom:-3px;transition:var(--transition);position:relative;display:flex;align-items:center;gap:7px;}
.admin-tab:hover{color:var(--white);}
.admin-tab.active{color:var(--gold);border-bottom-color:var(--gold);}
.admin-badge{background:var(--danger);color:white;font-size:10px;font-weight:800;min-width:18px;height:18px;border-radius:50%;display:flex;align-items:center;justify-content:center;padding:0 4px;font-family:var(--font-head);}
.admin-badge.hidden{display:none;}
.admin-close-btn{margin-left:auto;background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.15);color:var(--white);padding:8px 16px;border-radius:50px;font-size:12px;font-weight:700;font-family:var(--font-head);cursor:pointer;transition:var(--transition);display:flex;align-items:center;gap:6px;}
.admin-close-btn:hover{background:rgba(255,255,255,0.2);}
.admin-body{flex:1;overflow-y:auto;padding:24px;}
.admin-tab-panel{display:none;}
.admin-tab-panel.active{display:block;}
/* Order lifecycle tracker (placed → confirmed → paid → shipped → delivered) */
.order-tracker{display:flex;align-items:center;gap:0;flex-wrap:wrap;padding:10px 0;}
.ot-step{display:flex;flex-direction:column;align-items:center;flex:1;min-width:54px;position:relative;font-family:var(--font-head);}
.ot-dot{width:26px;height:26px;border-radius:50%;background:var(--gray-200);color:var(--gray-500);display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:800;border:2px solid var(--gray-200);transition:var(--transition);z-index:2;}
.ot-step.done .ot-dot{background:var(--success);border-color:var(--success);color:#fff;}
.ot-step.current .ot-dot{background:var(--gold);border-color:var(--navy);color:var(--navy-dark);box-shadow:0 0 0 4px rgba(255,198,0,0.25);animation:otpulse 1.6s ease-in-out infinite;}
.ot-step.cancelled .ot-dot{background:var(--danger);border-color:var(--danger);color:#fff;}
@keyframes otpulse{0%,100%{box-shadow:0 0 0 4px rgba(255,198,0,0.25);}50%{box-shadow:0 0 0 8px rgba(255,198,0,0.05);}}
.ot-label{font-size:10px;font-weight:700;color:var(--gray-500);margin-top:6px;text-transform:uppercase;letter-spacing:0.4px;text-align:center;line-height:1.2;}
.ot-step.done .ot-label,.ot-step.current .ot-label{color:var(--navy);}
.ot-step.cancelled .ot-label{color:var(--danger);}
.ot-bar{flex:1;height:3px;background:var(--gray-200);margin:0 -2px;position:relative;top:-13px;z-index:1;min-width:12px;}
.ot-bar.done{background:var(--success);}
.order-tracker.compact .ot-dot{width:20px;height:20px;font-size:10px;}
.order-tracker.compact .ot-label{font-size:9px;margin-top:3px;}
.order-tracker.compact .ot-bar{top:-10px;height:2px;}
/* Customer order history list */
.cust-order-row{background:var(--white);border:1.5px solid var(--gray-200);border-radius:var(--radius-lg);padding:14px 16px;margin-bottom:12px;}
.cust-order-row .cor-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:10px;flex-wrap:wrap;}
.cust-order-row .cor-ref{font-family:var(--font-head);font-weight:800;color:var(--navy);font-size:14px;}
.cust-order-row .cor-meta{font-size:11.5px;color:var(--gray-500);}
.cust-order-row .cor-items{font-size:12px;color:var(--gray-700);margin-top:8px;line-height:1.5;}
/* CSV import drop zone */
.csv-drop{border:2px dashed var(--gray-300);border-radius:var(--radius-lg);padding:20px;text-align:center;background:var(--off-white);cursor:pointer;transition:var(--transition);}
.csv-drop:hover{border-color:var(--gold);background:#fffdf5;}
.csv-preview{max-height:240px;overflow:auto;border:1px solid var(--gray-200);border-radius:var(--radius-md);margin-top:12px;font-size:11.5px;font-family:monospace;}
.csv-preview table{width:100%;border-collapse:collapse;}
.csv-preview th,.csv-preview td{padding:6px 8px;border-bottom:1px solid var(--gray-200);text-align:left;white-space:nowrap;}
.csv-preview th{background:var(--gray-100);position:sticky;top:0;font-weight:700;}
/* Auth tabs */
.auth-tabs{display:flex;gap:0;border-bottom:1.5px solid var(--gray-200);margin-bottom:18px;}
.auth-tab{flex:1;padding:10px 8px;font-family:var(--font-head);font-size:12px;font-weight:700;color:var(--gray-500);cursor:pointer;border-bottom:3px solid transparent;text-align:center;text-transform:uppercase;letter-spacing:0.3px;transition:var(--transition);}
.auth-tab.active{color:var(--navy);border-bottom-color:var(--gold);}
.auth-pane{display:none;}
.auth-pane.active{display:block;}
.otp-input{letter-spacing:8px;font-size:20px;text-align:center;font-weight:800;font-family:var(--font-head);}
/* Admin stat cards */
.admin-stats-row{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:24px;}
.admin-stat-card{background:var(--white);border:1.5px solid var(--gray-200);border-radius:var(--radius-lg);padding:20px;display:flex;align-items:center;gap:14px;}
.asc-icon{width:48px;height:48px;border-radius:var(--radius-md);display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;}
.asc-icon.navy{background:rgba(0,48,135,0.1);}
.asc-icon.gold{background:rgba(255,198,0,0.15);}
.asc-icon.green{background:var(--success-light);}
.asc-icon.red{background:var(--danger-light);}
.asc-val{font-family:var(--font-head);font-size:24px;font-weight:900;color:var(--navy);line-height:1;}
.asc-label{font-size:12px;color:var(--gray-400);font-weight:600;margin-top:3px;}
/* Admin section title */
.admin-section-title{font-family:var(--font-head);font-size:16px;font-weight:800;color:var(--navy);margin-bottom:16px;display:flex;align-items:center;justify-content:space-between;gap:12px;}
.admin-section-title small{font-size:12px;color:var(--gray-400);font-weight:500;}
/* Orders table */
.orders-table-wrap{background:var(--white);border-radius:var(--radius-lg);border:1.5px solid var(--gray-200);overflow:hidden;}
.orders-toolbar{padding:16px 20px;border-bottom:1px solid var(--gray-200);display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
.admin-btn{padding:8px 16px;border-radius:50px;font-size:12px;font-weight:700;font-family:var(--font-head);cursor:pointer;transition:var(--transition);display:flex;align-items:center;gap:6px;border:1.5px solid var(--gray-200);background:var(--white);color:var(--gray-700);}
.admin-btn:hover{border-color:var(--navy);color:var(--navy);}
.admin-btn.primary{background:var(--navy);color:var(--white);border-color:var(--navy);}
.admin-btn.primary:hover{background:var(--navy-dark);}
.admin-btn.success{background:var(--success);color:var(--white);border-color:var(--success);}
.admin-btn.success:hover{background:#15803d;}
.admin-btn.gold{background:var(--gold);color:var(--navy-dark);border-color:var(--gold);}
.admin-btn-receipt{background:#eef2ff;color:#3730a3;border-color:#c7d2fe;padding:6px 10px;font-size:11px;}
.admin-btn-receipt:hover{background:#c7d2fe;border-color:#6366f1;color:#1e1b4b;}
.admin-search{flex:1;max-width:280px;padding:8px 14px;border:1.5px solid var(--gray-200);border-radius:50px;font-size:13px;font-family:var(--font-body);outline:none;transition:var(--transition);}
.admin-search:focus{border-color:var(--navy);}
.orders-table{width:100%;border-collapse:collapse;}
.orders-table th{padding:11px 16px;text-align:left;font-size:11px;font-weight:800;color:var(--gray-400);text-transform:uppercase;letter-spacing:0.5px;font-family:var(--font-head);background:var(--gray-100);border-bottom:1.5px solid var(--gray-200);}
.orders-table td{padding:12px 16px;border-bottom:1px solid var(--gray-200);font-size:13.5px;color:var(--gray-800);vertical-align:middle;}
.orders-table tr:last-child td{border-bottom:none;}
.orders-table tr:hover td{background:var(--off-white);}
.orders-table .ref{font-family:var(--font-head);font-weight:700;color:var(--navy);font-size:12.5px;}
.orders-table .customer{font-weight:600;}
.orders-table .amount{font-family:var(--font-head);font-weight:800;color:var(--navy);}
/* Status badges & selector */
.status-badge{display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:50px;font-size:11px;font-weight:700;font-family:var(--font-head);text-transform:uppercase;letter-spacing:0.3px;}
.status-new{background:#e0f2fe;color:#0369a1;}
.status-confirmed{background:rgba(0,48,135,0.08);color:var(--navy);}
.status-paid{background:var(--success-light);color:var(--success);}
.status-delivered{background:#f0fdf4;color:#166534;}
.status-shipped{background:#fef3c7;color:#92400e;}
.status-cancelled{background:var(--danger-light);color:var(--danger);}
.status-select{padding:5px 10px;border:1.5px solid var(--gray-200);border-radius:50px;font-size:11.5px;font-weight:700;font-family:var(--font-head);cursor:pointer;background:var(--white);color:var(--gray-700);transition:var(--transition);outline:none;}
.status-select:hover,.status-select:focus{border-color:var(--navy);}
/* Items list in orders table */
.order-items-mini{font-size:11.5px;color:var(--gray-600);line-height:1.6;}
/* Stock warnings */
.stock-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px;}
.stock-card{background:var(--white);border:1.5px solid var(--gray-200);border-radius:var(--radius-md);padding:14px 16px;display:flex;align-items:center;gap:12px;}
.stock-card.low{border-color:var(--danger);background:#fff8f8;}
.stock-card.warning{border-color:var(--warning);background:#fffbeb;}
.stock-icon{font-size:28px;width:42px;text-align:center;}
.stock-info{flex:1;}
.stock-name{font-family:var(--font-head);font-size:13px;font-weight:700;color:var(--gray-800);margin-bottom:3px;}
.stock-qty{font-size:12px;color:var(--gray-500);}
.stock-qty strong{font-family:var(--font-head);font-size:14px;}
.stock-qty strong.low{color:var(--danger);}
.stock-qty strong.warning{color:var(--warning);}
.stock-qty strong.ok{color:var(--success);}
.stock-badge-low{background:var(--danger);color:white;font-size:9px;font-weight:800;padding:2px 7px;border-radius:50px;font-family:var(--font-head);text-transform:uppercase;letter-spacing:0.3px;}
/* Analytics */
.analytics-row{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;}
.analytics-card{background:var(--white);border:1.5px solid var(--gray-200);border-radius:var(--radius-lg);padding:20px;}
.analytics-card.full{grid-column:1/-1;}
.analytics-card-title{font-family:var(--font-head);font-size:13px;font-weight:800;color:var(--navy);margin-bottom:16px;display:flex;align-items:center;gap:7px;}
.chart-container{position:relative;height:240px;}
/* Top products table */
.top-products-list{display:flex;flex-direction:column;gap:8px;}
.tp-item{display:flex;align-items:center;gap:12px;padding:8px 0;border-bottom:1px solid var(--gray-200);}
.tp-item:last-child{border-bottom:none;}
.tp-rank{font-family:var(--font-head);font-size:14px;font-weight:900;color:var(--gray-300);width:24px;text-align:center;}
.tp-icon{font-size:22px;}
.tp-name{flex:1;font-size:13px;font-weight:600;color:var(--gray-800);}
.tp-sales{font-family:var(--font-head);font-size:13px;font-weight:700;color:var(--navy);}
/* Admin login */
.admin-login-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:6000;display:none;align-items:center;justify-content:center;}
.admin-login-overlay.open{display:flex;}
.admin-login-box{background:var(--white);border-radius:var(--radius-xl);padding:36px 32px;max-width:400px;width:100%;box-shadow:var(--shadow-xl);text-align:center;}
.admin-login-icon{font-size:48px;margin-bottom:12px;}
.admin-login-title{font-family:var(--font-head);font-size:22px;font-weight:900;color:var(--navy);margin-bottom:6px;}
.admin-login-sub{font-size:13px;color:var(--gray-400);margin-bottom:24px;}
.code-block{background:#1e293b;color:#e2e8f0;border-radius:var(--radius-md);padding:16px 18px;font-family:monospace;font-size:12px;line-height:1.7;overflow-x:auto;margin:12px 0;white-space:pre;}
.code-block .comment{color:#64748b;}
.code-block .string{color:#86efac;}
.code-block .keyword{color:#93c5fd;}
/* Sound wave animation */
@keyframes soundWave{0%,100%{transform:scaleY(0.5);}50%{transform:scaleY(1.2);}}
.sound-wave{display:inline-flex;align-items:center;gap:2px;height:16px;}
.sw-bar{width:3px;background:var(--gold);border-radius:2px;animation:soundWave 0.6s ease infinite;}
.sw-bar:nth-child(2){animation-delay:0.1s;}
.sw-bar:nth-child(3){animation-delay:0.2s;}
/* ===== MOBILE SEARCH BAR ===== */
.mobile-search-bar{display:none;background:var(--white);border-bottom:1px solid var(--gray-200);padding:10px 16px;}
.mobile-search-inner{position:relative;max-width:100%;}
@media(max-width:600px){
  .mobile-search-bar{display:block;}
}

/* ===== RESPONSIVE ===== */
@media(max-width:900px){
  .hero-inner{grid-template-columns:1fr;}
  .hero-right{display:none;}
  .hero h1{font-size:32px;}
  .footer-grid{grid-template-columns:1fr 1fr;}
  .checkout-inner{grid-template-columns:1fr;}
  .trust-row{grid-template-columns:1fr 1fr;}
  .admin-stats-row{grid-template-columns:1fr 1fr;}
  .analytics-row{grid-template-columns:1fr;}
}
@media(max-width:600px){
  .nav-search{display:none;}
  .cart-sidebar{width:100%;}
  .hero h1{font-size:26px;}
  .form-row{grid-template-columns:1fr;}
  .footer-grid{grid-template-columns:1fr;}
  .trust-row{grid-template-columns:1fr 1fr;}
  .promo-banner{flex-direction:column;text-align:center;}
  .hero-stats{justify-content:center;}
  .products-grid{grid-template-columns:repeat(2,1fr);}
}

/* ===== MODAL INLINE FILE UPLOAD (dynamic fields) ===== */
.dyn-file-wrap{position:relative;}
.dyn-file-wrap input[type="file"]{display:none;}
.dyn-file-label{display:flex;align-items:center;gap:10px;padding:11px 14px;border:2px dashed var(--navy);border-radius:var(--radius-sm);background:rgba(0,48,135,0.03);cursor:pointer;transition:var(--transition);}
.dyn-file-label:hover{background:rgba(0,48,135,0.07);border-color:var(--gold-dark);}
.dyn-file-label.has-file{border-style:solid;border-color:var(--success);background:var(--success-light);}
.dyn-file-icon{width:32px;height:32px;background:var(--navy);border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:15px;flex-shrink:0;transition:var(--transition);}
.dyn-file-label.has-file .dyn-file-icon{background:var(--success);}
.dyn-file-text{flex:1;}
.dyn-file-title{font-family:var(--font-head);font-size:12.5px;font-weight:700;color:var(--navy);}
.dyn-file-label.has-file .dyn-file-title{color:var(--success);}
.dyn-file-sub{font-size:10.5px;color:var(--gray-400);margin-top:1px;}
.dyn-file-badge{padding:3px 9px;background:var(--gold);color:var(--navy-dark);border-radius:50px;font-size:10px;font-weight:800;font-family:var(--font-head);text-transform:uppercase;white-space:nowrap;}
.dyn-file-label.has-file .dyn-file-badge{background:var(--success);color:#fff;}
/* two-col row inside dynamic fields */
.dyn-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
@media(max-width:420px){.dyn-row{grid-template-columns:1fr;}}

/* ===== ADMIN PRODUCT & SERVICE MANAGEMENT ===== */
.admin-service-item{background:var(--white);border:1.5px solid var(--gray-200);border-radius:var(--radius-md);padding:14px 18px;display:flex;align-items:center;gap:16px;transition:var(--transition);}
.admin-service-item:hover{border-color:var(--navy);box-shadow:var(--shadow-sm);}
.admin-mgmt-form{background:var(--white);border:2px solid var(--gold);border-radius:var(--radius-lg);padding:24px;margin-bottom:20px;box-shadow:0 4px 20px rgba(255,198,0,0.12);}
.admin-mgmt-form-title{font-family:var(--font-head);font-size:15px;font-weight:800;color:var(--navy);margin-bottom:18px;display:flex;align-items:center;gap:8px;padding-bottom:12px;border-bottom:1.5px solid var(--gray-200);}
.admin-prod-edit-row{background:rgba(0,48,135,0.03);border-top:1.5px dashed rgba(0,48,135,0.12);border-bottom:1.5px dashed rgba(0,48,135,0.12);}
.admin-prod-edit-row td{padding:16px 20px !important;}
.admin-svc-edit-box{background:rgba(0,48,135,0.03);border:1.5px solid rgba(0,48,135,0.12);border-radius:var(--radius-md);padding:20px;margin-bottom:8px;margin-top:-4px;}
.mgmt-grid-2{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;}
.mgmt-grid-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-bottom:12px;}
@media(max-width:600px){.mgmt-grid-2,.mgmt-grid-3{grid-template-columns:1fr;}}

</style>
</head>
<body>

<!-- SECURITY BAR -->
<div class="sec-bar">
  <div class="sec-bar-inner">
    <div class="sec-item"><span class="si">🔒</span> SSL Encrypted</div>
    <div class="sec-item"><span class="si">🛡️</span> Malipo Salama 100%</div>
    <div class="sec-item"><span class="si">✅</span> BRELA Registered</div>
    <div class="sec-item"><span class="si">📦</span> Delivery Mbeya</div>
    <div class="sec-item"><span class="si">⭐</span> Trusted Since 2020</div>
  </div>
</div>

<!-- TOP NAV -->
<nav class="topnav">
  <div class="nav-wrap">
    <div class="nav-logo" id="aelLogo" onclick="handleLogoClick()" style="cursor:pointer;user-select:none;" title="Letema">
      <div class="nav-logo-icon">🖨️</div>
      <div class="nav-logo-text">
        Letema Shop
        <small>Stationery & Internet Café</small>
      </div>
    </div>
    <div class="nav-search">
      <span class="search-icon">🔍</span>
      <input type="text" id="searchInput" placeholder="Tafuta bidhaa au huduma..." oninput="handleSearch(this.value)">
    </div>
    <div class="nav-actions">
      <button id="navLoginBtn" class="nav-btn nav-btn-ghost" onclick="openModal('loginModal')">👤 Ingia</button>
      <button id="navOrdersBtn" class="nav-btn nav-btn-ghost" style="display:none;" onclick="openOrderHistory()" title="Historia ya maagizo yangu">📋 Maagizo</button>
      <button class="nav-btn nav-btn-primary" onclick="openModal('registerModal')">Jisajili</button>
      <!-- Admin shortcut: HIDDEN. Fungua kwa kubofya logo mara 5 mfululizo (Easter Egg) au Ctrl+Shift+A -->
      <button id="adminNavBtn" class="nav-btn" onclick="openAdminLogin()" style="display:none;background:var(--navy-dark);color:var(--gold);border:1.5px solid var(--gold);position:relative;padding:9px 14px;" title="Admin Dashboard">
        ⚙️
        <span id="adminNavBadge" style="display:none;position:absolute;top:-6px;right:-6px;background:var(--danger);color:white;font-size:10px;font-weight:800;min-width:18px;height:18px;border-radius:50%;align-items:center;justify-content:center;font-family:var(--font-head);padding:0 3px;">0</span>
      </button>
      <button class="cart-btn" onclick="toggleCart()">
        🛒 Mkoba
        <span class="cart-count" id="cartCount">0</span>
      </button>
    </div>
