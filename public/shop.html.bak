// Load persisted stock quantities (they may have been decremented by orders)
function loadStockFromStorage() {
  try {
    const stored = localStorage.getItem('letema_stock_v1');
    if (stored) {
      const stockMap = JSON.parse(stored);
      PRODUCTS.forEach(p => {
        if (stockMap[p.id] !== undefined) p.stock_quantity = stockMap[p.id];
      });
    }
  } catch(e) {}
}

function saveStockToStorage() {
  try {
    const stockMap = {};
    PRODUCTS.forEach(p => { stockMap[p.id] = p.stock_quantity; });
    localStorage.setItem('letema_stock_v1', JSON.stringify(stockMap));
  } catch(e) {}
}

function decrementStock(productId, qty) {
  const p = PRODUCTS.find(x => x.id === productId);
  if (!p) return;
  p.stock_quantity = Math.max(0, p.stock_quantity - qty);
  saveStockToStorage();
  // Check if crossed low-stock threshold
  if (p.stock_quantity < 5) {
    updateAdminStockBadge();
  }
}

function getLowStockCount() {
  return PRODUCTS.filter(p => p.stock_quantity < 5 && p.stock_quantity !== 999).length;
}

function updateAdminStockBadge() {
  const low = getLowStockCount();
  const badge = document.getElementById('stockAlertBadge');
  if (badge) {
    badge.textContent = low;
    badge.classList.toggle('hidden', low === 0);
  }
}

// Load admin orders from localStorage
try {
  const storedOrders = localStorage.getItem('letema_orders_v1');
  if (storedOrders) adminOrders = JSON.parse(storedOrders);
} catch(e) { adminOrders = []; }

function saveAdminOrders() {
  try { localStorage.setItem('letema_orders_v1', JSON.stringify(adminOrders)); } catch(e) {}
}

function addAdminOrder(orderData) {
  adminOrders.unshift(orderData);
  saveAdminOrders();
  unreadOrderCount++;
  updateUnreadBadge();
  playNewOrderSound();
  notifyOwnerWhatsApp(orderData);
  syncOrderToSheets(orderData);  // Supabase
}

function updateUnreadBadge() {
  const badge = document.getElementById('adminOrdersBadge');
  if (badge) {
    badge.textContent = unreadOrderCount;
    badge.classList.toggle('hidden', unreadOrderCount === 0);
  }
  // Update admin nav button badge too
  const navBadge = document.getElementById('adminNavBadge');
  if (navBadge) {
    navBadge.style.display = unreadOrderCount > 0 ? 'inline-flex' : 'none';
    navBadge.textContent = unreadOrderCount;
  }
}

// =========================================================
// ===== SOUND NOTIFICATION =====
// =========================================================
function playNewOrderSound() {
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    const notes = [523.25, 659.25, 783.99, 1046.50]; // C5 E5 G5 C6
    notes.forEach((freq, i) => {
      const osc  = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.type = 'sine';
      osc.frequency.setValueAtTime(freq, ctx.currentTime + i * 0.12);
      gain.gain.setValueAtTime(0.35, ctx.currentTime + i * 0.12);
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + i * 0.12 + 0.4);
      osc.start(ctx.currentTime + i * 0.12);
      osc.stop(ctx.currentTime + i * 0.12 + 0.4);
    });
  } catch(e) { /* Silently fail if no audio context */ }
}

