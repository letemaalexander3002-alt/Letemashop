      <div id="adminServicesEmpty" style="display:none;text-align:center;padding:48px 24px;color:var(--gray-400);">
        <div style="font-size:40px;margin-bottom:12px;">🛠️</div>
        <div style="font-family:var(--font-head);font-weight:700;font-size:15px;">Hakuna huduma bado</div>
      </div>

    </div><!-- /services tab -->

    <!-- ========== INVOICE SETTINGS TAB ========== -->
    <div class="admin-tab-panel" id="adminTab_invoice">
      <div class="admin-section-title">📑 Invoice Template Editor</div>
      <div style="background:var(--white);border:1.5px solid var(--gray-200);border-radius:var(--radius-lg);padding:24px;max-width:780px;">
        <div style="font-size:13px;color:var(--gray-600);margin-bottom:14px;">Mipangilio hii inatumika kila wakati unapobonyeza <b>📑 Invoice</b> kwenye oda.</div>
        <div class="form-group">
          <label class="form-label">Jina la Kampuni</label>
          <input class="form-input" id="invSetCompany" placeholder="LETEMA STATIONERY">
        </div>
        <div class="form-group">
          <label class="form-label">Tagline / Subline</label>
          <input class="form-input" id="invSetTagline" placeholder="Internet Café & Office Supplies — Mbeya, Tanzania">
        </div>
        <div class="form-group">
          <label class="form-label">Anwani</label>
          <input class="form-input" id="invSetAddress" placeholder="Mbeya, Tanzania">
        </div>
        <div class="form-group">
          <label class="form-label">Mawasiliano (laini moja)</label>
          <input class="form-input" id="invSetContact" placeholder="+255 620 642 652  •  letemaalexander3002@gmail.com">
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          <div class="form-group">
            <label class="form-label">VAT Label</label>
            <input class="form-input" id="invSetVatLabel" placeholder="VAT (18%)">
          </div>
          <div class="form-group">
            <label class="form-label">VAT Rate (%)</label>
            <input class="form-input" type="number" step="0.01" id="invSetVatRate" placeholder="18">
          </div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          <div class="form-group">
            <label class="form-label">Invoice Prefix</label>
            <input class="form-input" id="invSetPrefix" placeholder="LET-INV-">
          </div>
          <div class="form-group">
            <label class="form-label">Next Number</label>
            <input class="form-input" type="number" min="1" id="invSetNext" placeholder="1">
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Footer Note</label>
          <input class="form-input" id="invSetFooter" placeholder="Asante kwa kununua na Letema Stationery!">
        </div>
        <div style="display:flex;gap:10px;margin-top:6px;">
          <button class="admin-btn primary" onclick="saveInvoiceSettings()">💾 Hifadhi</button>
          <button class="admin-btn" onclick="loadInvoiceSettingsToForm()">↺ Pakia tena</button>
        </div>
        <div style="margin-top:14px;font-size:12px;color:var(--gray-500);">Invoice number ya sasa itakayotolewa: <b id="invSetPreview">—</b></div>
      </div>
    </div>

    <!-- ========== AUDIT LOG TAB ========== -->
    <div class="admin-tab-panel" id="adminTab_audit">
      <div class="admin-section-title">🛡️ Audit Log</div>

      <!-- ===== CLOUD ADMIN ACTIVITY TIMELINE (Supabase, synced) ===== -->
      <div style="background:linear-gradient(135deg,#eef2ff 0%,#e0e7ff 100%);border:1.5px solid var(--navy);border-radius:var(--radius-lg);padding:18px;margin-bottom:18px;">
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-bottom:12px;">
          <div>
            <div style="font-family:var(--font-head);font-size:15px;font-weight:800;color:var(--navy);">☁️ Admin Activity Timeline (Synced)</div>
            <div style="font-size:12px;color:var(--gray-600);margin-top:2px;">Logins, logouts, dashboard opens — synced kwenye vifaa vyote kupitia Supabase</div>
          </div>
          <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <button class="admin-btn" onclick="renderCloudAdminTimeline()">🔄 Refresh</button>
            <button class="admin-btn danger" onclick="clearCloudAdminTimeline()">🗑️ Futa Logi za Admin</button>
          </div>
        </div>
        <div id="cloudAdminTimeline" style="max-height:420px;overflow-y:auto;padding-right:6px;">
          <div style="text-align:center;color:var(--gray-500);padding:24px;">Bonyeza 🔄 Refresh kuona timeline.</div>
        </div>
        <div style="margin-top:8px;font-size:11px;color:var(--gray-600);">
          ✅ Kumbukumbu hizi zimehifadhiwa kwenye <b>Supabase</b> — zinaonekana kwenye kifaa chochote ulichoingia.
        </div>
      </div>

      <!-- ===== LOCAL ADMIN ACTIVITY LOG (offline fallback) ===== -->
      <div style="background:var(--white);border:1.5px solid var(--gray-300);border-radius:var(--radius-lg);padding:18px;margin-bottom:18px;">
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-bottom:12px;">
          <div>
            <div style="font-family:var(--font-head);font-size:15px;font-weight:800;color:var(--navy);">📒 Admin Activity Log (Local Backup)</div>
            <div style="font-size:12px;color:var(--gray-500);margin-top:2px;">Backup ya offline — kwenye kivinjari hiki tu</div>
          </div>
          <div style="display:flex;gap:8px;flex-wrap:wrap;">
            <button class="admin-btn" onclick="renderLocalActivityLog()">🔄 Refresh</button>
            <button class="admin-btn success" onclick="exportLocalActivityCSV()">📥 Export CSV</button>
            <button class="admin-btn danger" onclick="clearLocalActivityLog()">🗑️ Futa Yote</button>
          </div>
        </div>
        <div style="max-height:320px;overflow-y:auto;border:1px solid var(--gray-200);border-radius:8px;">
          <table style="width:100%;border-collapse:collapse;font-size:12.5px;">
            <thead style="position:sticky;top:0;">
              <tr style="background:var(--navy);color:white;">
                <th style="padding:8px;text-align:left;">Wakati</th>
                <th style="padding:8px;text-align:left;">Tendo</th>
                <th style="padding:8px;text-align:left;">Hali</th>
                <th style="padding:8px;text-align:left;">Maelezo</th>
              </tr>
            </thead>
            <tbody id="localActivityLogBody">
              <tr><td colspan="4" style="padding:20px;text-align:center;color:var(--gray-500);">Hakuna kumbukumbu bado.</td></tr>
            </tbody>
          </table>
        </div>
        <div style="margin-top:8px;font-size:11px;color:var(--gray-500);">
          📌 Kumbukumbu <b>500 za hivi karibuni</b> tu ndizo huhifadhiwa (zilizo kuukuu hufutwa moja kwa moja).
        </div>
      </div>

      <div class="admin-section-title" style="margin-top:6px;">☁️ Audit Log (Supabase / Cloud)</div>
      <div style="background:var(--white);border:1.5px solid var(--gray-200);border-radius:var(--radius-lg);padding:18px;margin-bottom:14px;">
        <!-- Quick filter chips -->
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px;">
          <button class="admin-btn" type="button" onclick="auditQuickFilter('all')">🔁 Zote</button>
          <button class="admin-btn" type="button" onclick="auditQuickFilter('csv')">📥 CSV Import</button>
          <button class="admin-btn" type="button" onclick="auditQuickFilter('otp')">🔐 OTP Events</button>
          <button class="admin-btn" type="button" onclick="auditQuickFilter('lockout')">🔒 Lockouts</button>
          <button class="admin-btn" type="button" onclick="auditQuickFilter('order')">📦 Order Status</button>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end;">
          <div class="form-group" style="margin:0;flex:1;min-width:220px;">
            <label class="form-label">🔎 Tafuta (entity_id, action, actor)</label>
            <input class="form-input" id="audSearch" placeholder="mfano: LET-1024, csv.import, +2557…" onkeydown="if(event.key==='Enter')loadAuditLog()">
          </div>
          <div class="form-group" style="margin:0;">
            <label class="form-label">From</label>
            <input class="form-input" type="datetime-local" id="audFrom">
          </div>
          <div class="form-group" style="margin:0;">
            <label class="form-label">To</label>
            <input class="form-input" type="datetime-local" id="audTo">
          </div>
          <div class="form-group" style="margin:0;">
            <label class="form-label">User (actor)</label>
            <input class="form-input" id="audActor" placeholder="email au admin">
          </div>
          <div class="form-group" style="margin:0;">
            <label class="form-label">Action</label>
            <select class="form-input" id="audAction">
              <option value="">Zote</option>
              <option value="order.status_change">order.status_change</option>
              <option value="product.create">product.create</option>
              <option value="product.update">product.update</option>
              <option value="product.delete">product.delete</option>
              <option value="invoice_settings.update">invoice_settings.update</option>
              <option value="csv.import">csv.import</option>
              <option value="auth.login">auth.login</option>
              <option value="auth.otp_send">auth.otp_send</option>
              <option value="auth.otp_fail">auth.otp_fail</option>
              <option value="auth.lockout">auth.lockout</option>
            </select>
          </div>
          <button class="admin-btn primary" onclick="loadAuditLog()">🔍 Tafuta</button>
          <button class="admin-btn" onclick="document.getElementById('audFrom').value='';document.getElementById('audTo').value='';document.getElementById('audActor').value='';document.getElementById('audAction').value='';document.getElementById('audSearch').value='';loadAuditLog()">↺ Reset</button>
        </div>
      </div>
      <div style="background:var(--white);border:1.5px solid var(--gray-200);border-radius:var(--radius-lg);overflow:hidden;">
        <div style="overflow-x:auto;">
          <table style="width:100%;border-collapse:collapse;font-size:12.5px;">
            <thead>
              <tr style="background:var(--navy);color:white;">
                <th style="padding:10px;text-align:left;">When</th>
                <th style="padding:10px;text-align:left;">Actor</th>
                <th style="padding:10px;text-align:left;">Action</th>
                <th style="padding:10px;text-align:left;">Entity</th>
                <th style="padding:10px;text-align:left;">Details</th>
              </tr>
            </thead>
            <tbody id="auditLogBody"><tr><td colspan="5" style="padding:20px;text-align:center;color:var(--gray-400);">Bonyeza Tafuta kuona events.</td></tr></tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ========== WATEJA (CUSTOMERS) TAB ========== -->
    <div class="admin-tab-panel" id="adminTab_customers">

      <div class="admin-section-title">
        👥 Usimamizi wa Wateja
        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
