      <!-- Stats row -->
      <div class="admin-stats-row" style="margin-bottom:20px;">
        <div class="admin-stat-card">
          <div class="asc-icon navy">👥</div>
          <div><div class="asc-val" id="cst_totalCustomers">—</div><div class="asc-label">Wateja Wote</div></div>
        </div>
        <div class="admin-stat-card">
          <div class="asc-icon gold">💰</div>
          <div><div class="asc-val" id="cst_totalRevenue">—</div><div class="asc-label">Jumla Mapato (PAID)</div></div>
        </div>
        <div class="admin-stat-card">
          <div class="asc-icon" style="background:#ede9fe;color:#7c3aed;">🏆</div>
          <div><div class="asc-val" id="cst_topSpender">—</div><div class="asc-label">Mteja Bora</div></div>
        </div>
        <div class="admin-stat-card">
          <div class="asc-icon" style="background:#ecfdf5;color:#059669;">📦</div>
          <div><div class="asc-val" id="cst_avgOrders">—</div><div class="asc-label">Wastani wa Oda/Mteja</div></div>
        </div>
      </div>

      <!-- Customers table -->
      <div class="orders-table-wrap">
        <div style="overflow-x:auto;">
          <table class="orders-table">
            <thead>
              <tr>
                <th style="width:40px;">#</th>
                <th>Jina la Mteja</th>
                <th>Simu</th>
                <th>Barua Pepe</th>
                <th style="text-align:center;">Oda Zake</th>
                <th>Mapato Yote</th>
                <th>Malipo (PAID)</th>
                <th>Oda ya Mwisho</th>
                <th>Vitendo</th>
              </tr>
            </thead>
            <tbody id="customersTableBody">
              <tr><td colspan="9" style="text-align:center;padding:40px;color:var(--gray-400);">⏳ Inapakia wateja…</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <div style="margin-top:10px;font-size:12px;color:var(--gray-400);">
        📊 Wateja wamehesabiwa kutoka maagizo yaliyopo mfumoni. Imepangwa kwa matumizi — mkubwa kwanza.
      </div>

    </div><!-- /customers tab panel -->

  </div><!-- /admin-body -->
</div><!-- /admin-overlay -->



<div class="cart-overlay" id="cartOverlay" onclick="toggleCart()"></div>
<div class="cart-sidebar" id="cartSidebar">
  <div class="cart-header">
    <h3>🛒 Mkoba Wangu</h3>
    <div class="cart-close" onclick="toggleCart()">✕</div>
  </div>
  <div class="cart-items" id="cartItems"></div>
  <div class="cart-footer" id="cartFooter"></div>
</div>

<!-- LOGIN MODAL -->
<div class="modal-overlay" id="loginModal" onclick="closeModalOutside(event,'loginModal')">
  <div class="modal">
    <div class="modal-header">
      <h3>🔐 Ingia Akaunti</h3>
      <span class="modal-close" onclick="closeModal('loginModal')">✕</span>
    </div>
    <div class="modal-body">
      <div style="background:var(--off-white);border:1px solid var(--gray-200);border-radius:var(--radius-md);padding:12px 14px;margin-bottom:14px;display:flex;align-items:center;gap:8px;">
        <span>🛡️</span>
        <span style="font-size:12px;color:var(--gray-600);">Chagua njia salama ya kuingia. Tunatumia 256-bit SSL encryption.</span>
      </div>

      <!-- Auth method tabs -->
      <div class="auth-tabs">
        <div class="auth-tab active" data-auth="password" onclick="switchAuthTab('password')">🔒 Nywila</div>
        <div class="auth-tab" data-auth="email-otp" onclick="switchAuthTab('email-otp')">📧 Email OTP</div>
        <div class="auth-tab" data-auth="phone-otp" onclick="switchAuthTab('phone-otp')">📱 SMS OTP</div>
      </div>

      <!-- Pane 1: Password -->
      <div class="auth-pane active" id="authPane_password">
        <div class="form-group">
          <label class="form-label">Barua Pepe</label>
          <input class="form-input" type="email" placeholder="email@mfano.com" id="loginEmail" autocomplete="email">
        </div>
        <div class="form-group">
          <label class="form-label">Nywila</label>
          <div class="input-group">
            <input class="form-input" type="password" placeholder="Weka nywila yako" id="loginPassword" autocomplete="current-password">
            <span class="input-icon" onclick="togglePassword('loginPassword')">👁️</span>
          </div>
        </div>
        <div style="text-align:right;margin-bottom:14px;"><span style="font-size:13px;color:var(--navy);cursor:pointer;font-weight:600;" onclick="resendVerification()">Hujapata barua ya uthibitisho? Tuma tena</span></div>
        <button class="checkout-btn" onclick="handleLogin()">🔐 Ingia Sasa</button>
      </div>

      <!-- Pane 2: Email OTP / Magic code -->
      <div class="auth-pane" id="authPane_email-otp">
        <div style="background:#eef2ff;border:1px solid #c7d2fe;border-radius:var(--radius-md);padding:10px 12px;margin-bottom:12px;font-size:12px;color:#3730a3;">
          ✨ Hakuna nywila inayohitajika. Tutakutumia <strong>code ya tarakimu 6</strong> kwenye email.
        </div>
        <div class="form-group">
          <label class="form-label">Barua Pepe</label>
          <input class="form-input" type="email" placeholder="email@mfano.com" id="otpEmail" autocomplete="email">
        </div>
        <button class="checkout-btn" id="otpEmailSendBtn" onclick="handleSendEmailOtp()">📨 Tuma Code</button>
        <div id="otpEmailStep2" style="display:none;margin-top:14px;">
          <div class="form-group">
            <label class="form-label">Code ya Tarakimu 6</label>
            <input class="form-input otp-input" type="text" inputmode="numeric" maxlength="6" placeholder="• • • • • •" id="otpEmailCode">
          </div>
          <button class="checkout-btn" onclick="handleVerifyEmailOtp()">✅ Thibitisha & Ingia</button>
          <div id="otpStatusBox" style="display:none;"></div>
        </div>
      </div>

      <!-- Pane 3: Phone OTP / SMS -->
      <div class="auth-pane" id="authPane_phone-otp">
        <div style="background:#fef3c7;border:1px solid #fde68a;border-radius:var(--radius-md);padding:10px 12px;margin-bottom:12px;font-size:12px;color:#92400e;">
          📱 Tutatuma <strong>SMS code</strong> kwenye simu yako (E.164 format, mfano +2557XXXXXXXX).<br>
          <strong>Note:</strong> Phone provider lazima iwekwe kwenye Supabase dashboard kwanza.
        </div>
        <div class="form-group">
          <label class="form-label">Namba ya Simu (E.164)</label>
          <input class="form-input" type="tel" placeholder="+2557XXXXXXXX" id="otpPhone" autocomplete="tel">
        </div>
        <button class="checkout-btn" onclick="handleSendPhoneOtp()">📨 Tuma SMS Code</button>
        <div id="otpPhoneStep2" style="display:none;margin-top:14px;">
          <div class="form-group">
            <label class="form-label">Code ya Tarakimu 6</label>
            <input class="form-input otp-input" type="text" inputmode="numeric" maxlength="6" placeholder="• • • • • •" id="otpPhoneCode">
          </div>
          <button class="checkout-btn" onclick="handleVerifyPhoneOtp()">✅ Thibitisha & Ingia</button>
        </div>
      </div>
    </div>
    <div class="modal-footer" style="justify-content:center;padding-top:0;">
      <span style="font-size:13px;color:var(--gray-600);">Huna akaunti? <span style="color:var(--navy);font-weight:700;cursor:pointer;" onclick="closeModal('loginModal');openModal('registerModal')">Jisajili hapa</span></span>
    </div>
  </div>
</div>

<!-- REGISTER MODAL -->
<div class="modal-overlay" id="registerModal" onclick="closeModalOutside(event,'registerModal')">
  <div class="modal">
    <div class="modal-header">
      <h3>✨ Fungua Akaunti</h3>
      <span class="modal-close" onclick="closeModal('registerModal')">✕</span>
    </div>
    <div class="modal-body">
      <div style="background:var(--success-light);border:1px solid #bbf7d0;border-radius:var(--radius-md);padding:12px 14px;margin-bottom:18px;display:flex;align-items:center;gap:8px;">
        <span>🎁</span>
        <span style="font-size:12px;color:var(--success);font-weight:600;">Jisajili sasa na upate punguzo la 10% kwa ununuzi wako wa kwanza!</span>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Jina la Kwanza</label>
          <input class="form-input" type="text" placeholder="Jina" id="regFirstName">
        </div>
        <div class="form-group">
          <label class="form-label">Jina la Mwisho</label>
          <input class="form-input" type="text" placeholder="Ukoo" id="regLastName">
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Namba ya Simu</label>
        <input class="form-input" type="tel" placeholder="+255 6XX XXX XXX" id="regPhone">
        <div class="form-hint">Itatumika kwa WhatsApp na uthibitishaji wa malipo</div>
      </div>
      <div class="form-group">
        <label class="form-label">Barua Pepe</label>
        <input class="form-input" type="email" placeholder="email@mfano.com" id="regEmail">
      </div>
      <div class="form-group">
        <label class="form-label">Nywila</label>
        <div class="input-group">
          <input class="form-input" type="password" placeholder="Angalau herufi 8" id="regPassword">
          <span class="input-icon" onclick="togglePassword('regPassword')">👁️</span>
        </div>
        <div class="form-hint">Nywila lazima iwe na herufi kubwa, ndogo, nambari na alama</div>
      </div>
      <div style="display:flex;align-items:flex-start;gap:8px;margin-bottom:16px;">
        <input type="checkbox" id="agreeTerms" style="margin-top:3px;width:15px;height:15px;accent-color:var(--navy);">
        <label for="agreeTerms" style="font-size:12.5px;color:var(--gray-600);line-height:1.5;">Nakubali <span style="color:var(--navy);font-weight:700;cursor:pointer;">Masharti ya Matumizi</span> na <span style="color:var(--navy);font-weight:700;cursor:pointer;">Sera ya Faragha</span></label>
      </div>
      <button class="checkout-btn" onclick="handleRegister()">✨ Fungua Akaunti Bure</button>
    </div>
    <div class="modal-footer" style="justify-content:center;padding-top:0;">
      <span style="font-size:13px;color:var(--gray-600);">Una akaunti tayari? <span style="color:var(--navy);font-weight:700;cursor:pointer;" onclick="closeModal('registerModal');openModal('loginModal')">Ingia hapa</span></span>
    </div>
  </div>
</div>

<!-- CUSTOMER ORDER HISTORY MODAL -->
<div class="modal-overlay" id="orderHistoryModal" onclick="closeModalOutside(event,'orderHistoryModal')">
  <div class="modal" style="max-width:640px;">
    <div class="modal-header">
      <h3>📋 Historia ya Maagizo Yangu</h3>
      <span class="modal-close" onclick="closeModal('orderHistoryModal')">✕</span>
    </div>
    <div class="modal-body" id="orderHistoryBody">
      <div style="text-align:center;padding:40px 20px;color:var(--gray-500);">
        ⏳ Inapakia maagizo yako...
      </div>
    </div>
  </div>
</div>

<!-- SERVICE ORDER MODAL — DYNAMIC -->
<div class="modal-overlay" id="serviceOrderModal" onclick="closeModalOutside(event,'serviceOrderModal')">
  <div class="modal" style="max-width:520px;">
    <div class="modal-header" style="background:var(--navy);border-radius:var(--radius-xl) var(--radius-xl) 0 0;">
      <h3 id="serviceModalTitle" style="color:var(--white);">⚡ Agiza Huduma</h3>
      <span class="modal-close" onclick="closeModal('serviceOrderModal')" style="color:rgba(255,255,255,0.7);">✕</span>
    </div>
    <div class="modal-body" style="padding-top:20px;">

      <!-- Service Banner (injected dynamically) -->
      <div id="orderModalServiceBanner"></div>

      <!-- COMMON FIELDS -->
      <div class="form-group">
        <label class="form-label">👤 Jina Lako Kamili <span style="color:var(--danger)">*</span></label>
        <input class="form-input" type="text" placeholder="Jina na ukoo" id="orderClientName">
      </div>
      <div class="form-group">
        <label class="form-label">📱 Namba ya WhatsApp <span style="color:var(--danger)">*</span></label>
        <input class="form-input" type="tel" placeholder="+255 6XX XXX XXX" id="orderClientPhone">
        <div class="form-hint">Tutawasiliana nawe kwa WhatsApp ndani ya dakika 30</div>
      </div>

      <!-- DYNAMIC SERVICE-SPECIFIC FIELDS (injected by JS) -->
      <div id="orderDynamicFields"></div>

      <!-- URGENCY — common -->
      <div class="form-group">
        <label class="form-label">⏰ Unahitaji Lini?</label>
        <select class="form-input" id="orderUrgency">
          <option value="leo">🔥 Haraka — Leo hii (ziada ya 20%)</option>
          <option value="kesho">📅 Kesho asubuhi</option>
          <option value="siku23">🗓️ Siku 2–3 zijazo</option>
          <option value="wiki">📆 Wiki hii</option>
        </select>
      </div>

      <button class="checkout-btn" onclick="submitOrderModal()" style="margin-top:6px;background:var(--navy);">
        💬 Tuma Ombi kwa WhatsApp
      </button>
      <div class="order-modal-footer-note">
        <span>🔒</span> Ombi lako litatumwa salama kupitia WhatsApp
      </div>
    </div>
  </div>
</div>

<!-- PRODUCT DETAIL MODAL -->
<div class="modal-overlay" id="productModal" onclick="closeModalOutside(event,'productModal')">
  <div class="modal" style="max-width:540px;">
    <div class="modal-header">
      <h3 id="productModalTitle">Bidhaa</h3>
      <span class="modal-close" onclick="closeModal('productModal')">✕</span>
    </div>
    <div class="modal-body" id="productModalBody"></div>
  </div>
</div>

<!-- CHECKOUT PAGE -->
<div class="checkout-page" id="checkoutPage">
  <div class="checkout-topbar">
    <button class="back-btn" onclick="closeCheckout()">← Rudi</button>
    <h2>🛒 Maliza Ununuzi</h2>
    <div style="margin-left:auto;display:flex;align-items:center;gap:6px;font-size:12px;color:rgba(255,255,255,0.7);">
      <span>🔒</span> SSL Encrypted
    </div>
  </div>
  <div class="checkout-inner">
    <div>
      <!-- ORDER TYPE BANNER (dynamic) -->
      <div class="order-type-banner type-product" id="orderTypeBanner" style="margin-bottom:16px;">
        <span class="order-type-icon">🛒</span>
        <span>Ununuzi wa Bidhaa</span>
        <span class="order-type-label">BIDHAA</span>
      </div>

      <!-- SERVICE REQUIREMENTS SECTION (shown only for service orders) -->
      <div class="svc-req-section" id="serviceReqSection" style="display:none;">
        <div class="checkout-section-title" style="border-bottom-color:var(--gold);">
          <span style="background:var(--gold);color:var(--navy-dark);">✦</span> Mahitaji ya Huduma
        </div>

        <!-- Requirements boxes injected here dynamically by applyCheckoutMode() -->
        <div id="checkoutReqBoxAnchor"></div>

        <!-- File Upload for service — shown only for services requiring file upload -->
        <div id="svcFileUploadSection" style="display:none;">
          <div class="form-group">
            <label class="form-label" id="svcFileUploadSectionTitle">📎 Pakia Faili / Hati</label>
            <div class="file-upload-wrapper">
              <input type="file" class="hidden-file-input" id="svcFileUpload"
                accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.jpg,.jpeg,.png,.gif,.webp,.bmp,.heic"
                onchange="handleSvcFileSelect(this)">
              <div class="file-upload-label" id="svcFileUploadLabel">
                <div class="file-upload-icon">📁</div>
                <div class="file-upload-text">
                  <div class="file-upload-title" id="svcFileUploadTitle">Chagua Faili au Drag & Drop</div>
                  <div class="file-upload-sub" id="svcFileUploadSub">PDF, Picha, Word, Excel — hadi 20MB</div>
                </div>
                <span class="file-upload-badge" id="svcFileUploadBadge">Pakia</span>
              </div>
            </div>
            <div class="file-upload-hint" style="margin-top:8px;">
              <span class="file-upload-hint-icon">💡</span>
              <span class="file-upload-hint-text">Pakia faili lako hapa (hiari). Baada ya kutuma WhatsApp, unaweza pia <strong>iunganishe mwenyewe</strong> kwenye mazungumzo ili tuweze kushughulikia ombi lako haraka zaidi.</span>
            </div>
          </div>
        </div>

        <!-- Copy Type Selection -->
        <div class="form-group">
          <label class="form-label">📋 Aina ya Nakala <span style="color:var(--danger)">*</span></label>
          <div class="svc-copy-options">
            <div class="svc-copy-btn selected" data-copy="soft" onclick="selectCopyType('soft')">
              <span class="scb-icon">💾</span>
              <div>
                <div class="scb-label">Soft Copy</div>
                <div class="scb-sub">Faili la kidijitali (PDF, Word...)</div>
              </div>
              <div class="svc-copy-radio"></div>
            </div>
            <div class="svc-copy-btn" data-copy="hard" onclick="selectCopyType('hard')">
              <span class="scb-icon">🖨️</span>
              <div>
                <div class="scb-label">Hard Copy</div>
                <div class="scb-sub">Printout ya karatasi</div>
              </div>
              <div class="svc-copy-radio"></div>
            </div>
          </div>
        </div>

        <!-- Additional Instructions -->
        <div class="form-group">
          <label class="form-label">📝 Maelekezo ya Ziada <span style="color:var(--gray-400);font-weight:400;text-transform:none;">(optional)</span></label>
          <textarea class="form-input" rows="3" id="svcInstructions"
            placeholder="Mfano: Nataka rangi nyekundu, ukubwa A3, nakala 5, au maelekezo mengine maalum..."
            style="resize:vertical;"></textarea>
        </div>
      </div>

      <!-- DELIVERY INFO -->
      <div class="checkout-form-section" style="margin-bottom:16px;">
        <div class="checkout-section-title">
          <span>1</span> Maelezo ya Delivery
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Jina la Kwanza <span style="color:var(--danger)">*</span></label>
            <input class="form-input" type="text" placeholder="Jina" id="coFirstName" oninput="clearFieldError(this)">
            <div class="form-field-error" id="coFirstNameErr" style="display:none;">⚠️ Jina linahitajika</div>
          </div>
          <div class="form-group">
            <label class="form-label">Jina la Mwisho</label>
            <input class="form-input" type="text" placeholder="Ukoo" id="coLastName">
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Simu / WhatsApp <span style="color:var(--danger)">*</span></label>
          <input class="form-input" type="tel" placeholder="+255 6XX XXX XXX" id="coPhone" oninput="clearFieldError(this)">
          <div class="form-field-error" id="coPhoneErr" style="display:none;">⚠️ Namba sahihi inahitajika (+255 au 0 + namba 9)</div>
        </div>
        <div class="form-group">
          <label class="form-label">Barua Pepe (optional)</label>
          <input class="form-input" type="email" placeholder="email@mfano.com" id="coEmail">
        </div>
        <div class="form-group">
          <label class="form-label" id="coAddressLabel">Mtaa / Eneo la Delivery <span style="color:var(--danger)">*</span></label>
          <input class="form-input" type="text" placeholder="Mfano: Mwanjelwa, Uyole, CUOM..." id="coAddress" oninput="clearFieldError(this)">
          <div class="form-field-error" id="coAddressErr" style="display:none;">⚠️ Eneo linahitajika</div>
        </div>
        <div class="form-group">
          <label class="form-label">Maelezo ya Ziada</label>
          <textarea class="form-input" rows="2" placeholder="Karibu na... / Jengo..." id="coNotes" style="resize:none;"></textarea>
        </div>
      </div>
      <!-- PAYMENT -->
      <div class="checkout-form-section" id="paymentSection">
        <div class="checkout-section-title">
          <span>2</span> Njia ya Malipo
        </div>
        <div class="payment-methods">
          <div class="pay-method selected" data-method="mobile" onclick="selectPayment(this)">
            <span class="pm-icon">📱</span>
            <div><div class="pm-name">M-Pesa / Vodacom</div><div class="pm-desc">Lipa kwa simu yako ya Vodacom</div></div>
            <div class="pm-radio"></div>
          </div>
          <div class="pay-method" data-method="mobile" onclick="selectPayment(this)">
            <span class="pm-icon">🟠</span>
            <div><div class="pm-name">Airtel Money</div><div class="pm-desc">Lipa kwa Airtel Money</div></div>
            <div class="pm-radio"></div>
          </div>
          <div class="pay-method" data-method="mobile" onclick="selectPayment(this)">
            <span class="pm-icon">💳</span>
            <div><div class="pm-name">Tigo Pesa</div><div class="pm-desc">Lipa kwa Tigo Pesa</div></div>
            <div class="pm-radio"></div>
          </div>
          <div class="pay-method" data-method="mobile" onclick="selectPayment(this)">
            <span class="pm-icon">🏦</span>
            <div><div class="pm-name">Benki / NMB / CRDB</div><div class="pm-desc">Transfer ya benki</div></div>
            <div class="pm-radio"></div>
          </div>
          <div class="pay-method" data-method="cash" onclick="selectPayment(this)">
            <span class="pm-icon">💵</span>
            <div><div class="pm-name">Pesa Taslimu</div><div class="pm-desc">Lipa unapokuja dukani au delivery</div></div>
            <div class="pm-radio"></div>
          </div>
        </div>

        <!-- ===== LIPA KWA SIMU INSTRUCTIONS ===== -->
        <div class="lipa-simu-block">
          <div class="lipa-simu-title">
            📲 Jinsi ya Kulipa — M-Pesa / Tigo Pesa / Airtel Money
          </div>
          <div class="lipa-step">
            <div class="lipa-step-num">1</div>
            <div>Nenda kwenye <strong>Menu ya Simu</strong> → Chagua <strong>M-Pesa / Tigo Pesa / Airtel Money</strong></div>
          </div>
          <div class="lipa-step">
            <div class="lipa-step-num">2</div>
            <div>Chagua <strong>"Lipa Bili"</strong> au <strong>"Send Money"</strong> kisha weka namba hii: <span class="lipa-number">+255 620 642 652</span></div>
          </div>
          <div class="lipa-step">
            <div class="lipa-step-num">3</div>
            <div>Weka <strong>kiasi cha jumla</strong> cha oda yako — maelezo yatakuja baada ya kutuma WhatsApp</div>
          </div>
          <div class="lipa-step">
            <div class="lipa-step-num">4</div>
            <div>Hifadhi <strong>namba ya uthibitishaji (transaction ID)</strong> utakapoulizwa na wakala</div>
          </div>
          <div style="margin-top:10px;padding:8px 12px;background:rgba(22,163,74,0.08);border-radius:6px;font-size:12px;color:var(--success);font-weight:600;">
            ✅ Malipo yatathibitishwa na timu yetu kupitia WhatsApp ndani ya dakika 30
          </div>
        </div>

        <!-- ===== TRANSACTION ID / E-RECEIPT ===== -->
        <div class="txn-field-wrapper" style="margin-top:16px;">
          <div class="txn-field-header">
            <span class="txn-field-badge" id="receiptRequiredBadge">🔐 Inahitajika</span>
            <span class="txn-field-title">Transaction ID / E-Receipt Number</span>
          </div>
          <div class="txn-input-group">
            <span class="txn-input-icon">🧾</span>
            <input class="form-input" type="text" id="coTxnId"
              placeholder="Mfano: MP250701ABCD1234 au TZ-00123456"
              oninput="clearFieldError(this)" autocomplete="off" spellcheck="false">
          </div>
          <div class="form-field-error" id="coTxnIdErr" style="display:none;">⚠️ Transaction ID / E-Receipt inahitajika kwa uthibitishaji wa malipo ya simu</div>
          <div style="margin-top:8px;font-size:11.5px;color:var(--gray-600);line-height:1.6;" id="receiptHintText">
            📌 Andika namba ya uthibitishaji uliyopokea baada ya kulipa kwa M-Pesa / Tigo Pesa / Airtel Money. Inaonekana kwenye ujumbe wa SMS baada ya malipo.
          </div>
        </div>

        <div style="background:var(--off-white);border:1px solid var(--gray-200);border-radius:var(--radius-md);padding:14px;margin-top:16px;">
          <div style="font-size:12px;color:var(--gray-600);line-height:1.7;">
            🔒 <strong>Usalama wa Malipo:</strong> Taarifa zako zinalindwa na SSL encryption. Hatuwezi kuona nywila za akaunti yako ya benki au mobile money.
          </div>
        </div>
      </div>
    </div>

    <!-- ORDER SUMMARY -->
    <div class="order-summary-box">
      <div class="os-title">📋 Muhtasari wa Agizo</div>
      <div class="os-items" id="checkoutItems"></div>
      <div class="os-line"><span>Jumla ndogo:</span><span id="checkoutSubtotal">TZS 0</span></div>
      <div class="os-line"><span>Delivery:</span><span style="color:var(--success);font-weight:600;">BURE</span></div>
      <div class="os-line"><span>VAT (18%):</span><span id="checkoutVat">TZS 0</span></div>
      <div class="os-total"><span>JUMLA:</span><span id="checkoutTotal">TZS 0</span></div>

      <!-- WhatsApp Order Button -->
      <button class="place-order-btn" id="placeOrderBtn" onclick="placeOrderWhatsApp()">
        💬 Kamilisha Oda via WhatsApp
      </button>
      <div class="security-note">
        <span>🔒</span>
        <span>Oda itatumwa kwa WhatsApp salama</span>
      </div>
    </div>
  </div>
</div>

<!-- SUCCESS PAGE -->
<div class="success-page" id="successPage">
  <div class="success-icon">✅</div>
  <div class="success-title">Oda Imefanikiwa!</div>
  <div class="success-sub">Asante sana kwa ununuzi wako! WhatsApp imefunguliwa — tuma ujumbe wako kwa Letema Stationery (+255 620 642 652) ili kukamilisha oda.</div>

  <!-- FILE REMINDER — shown only when a file was selected -->
  <div id="successFileTip" style="display:none;align-items:center;gap:10px;background:linear-gradient(135deg,#fefce8,#fffbeb);border:2px solid var(--gold);border-radius:var(--radius-md);padding:14px 18px;margin-bottom:18px;max-width:440px;text-align:left;">
    <span style="font-size:22px;flex-shrink:0;">📎</span>
    <div>
      <div style="font-family:var(--font-head);font-size:13px;font-weight:800;color:var(--navy);margin-bottom:3px;">Kumbuka Kutuma Faili Lako!</div>
      <div style="font-size:12px;color:var(--gray-700);line-height:1.55;">
        Faili <strong id="successFileName" style="color:var(--navy-dark);">—</strong> bado haijatumwa. Tafadhali <strong>iunganishe mwenyewe</strong> kwenye mazungumzo ya WhatsApp ili tuweze kushughulikia oda yako haraka.
      </div>
    </div>
  </div>

  <div class="order-ref">
    <div class="order-ref-label">Namba ya Agizo</div>
    <div class="order-ref-num" id="orderRefNum">LET-000000</div>
  </div>
  <div class="success-actions">
    <button class="btn-wa-success" id="retryWaBtn" onclick="retryWhatsApp()">
      💬 Fungua WhatsApp Tena
    </button>
    <button class="btn-gold" onclick="closeSuccess()">🛒 Endelea Kununua</button>
  </div>
  <div style="margin-top:16px;font-size:12px;color:var(--gray-400);max-width:360px;line-height:1.6;">
    Ikiwa WhatsApp haijafunguka, bonyeza kitufe hapo juu. Pia unaweza kutuma ujumbe mwenyewe kwa namba <strong>+255 620 642 652</strong>.
  </div>
</div>

<!-- LOADING SPINNER OVERLAY -->
<div class="spinner-overlay" id="spinnerOverlay">
  <div class="spinner-ring"></div>
  <div class="spinner-text">
    Inakuandalia WhatsApp...
    <small>Tafadhali subiri sekunde chache</small>
  </div>
</div>

<!-- TOAST CONTAINER -->
<div class="toast-container" id="toastContainer"></div>

<script>
// =========================================================
// ===== PRODUCT DATA — Edit here to add/remove items =====
// =========================================================
let PRODUCTS = [
  // ── SHULE ──────────────────────────────────────────────────────────────────
  {id:1,  name:'Daftari A4 — 100 Ukurasa',           price:2500,  category:'shule',    icon:'📓', badge:'hot',  rating:4.8, reviews:42,  desc:'Daftari bora la mistari iliyopangwa sawasawa, karatasi 80gsm nyeupe inayofaa uandishi wa wino na kalamu. Inafaa kwa wanafunzi wa shule ya msingi, sekondari na chuo.', stock_quantity:45},
  {id:2,  name:'Kalamu za Rangi (Box 12)',             price:4000,  category:'shule',    icon:'🖊️', badge:'new',  rating:4.9, reviews:28,  desc:'Seti ya kalamu 12 za rangi angavu tofauti, mwisho laini na wino wa muda mrefu. Zinafaa kwa michoro, ramani za jiografia, diagrams na maelezo ya kisanaa.', stock_quantity:3},
  {id:3,  name:'Penseli HB + Kifutio',                price:1500,  category:'shule',    icon:'✏️', badge:null,   rating:4.6, reviews:15,  desc:'Penseli bora grade HB pamoja na kifutio kikubwa kisichoacha alama. Inafaa kwa mazoezi ya hisabati, michoro na mitihani ya elimumsingi.', stock_quantity:60},
  {id:4,  name:'Rula ya 30cm',                        price:1000,  category:'shule',    icon:'📏', badge:null,   rating:4.5, reviews:20,  desc:'Rula imara ya plastiki ya uwazi 30cm iliyopimwa kwa usahihi, na vipimo vya cm na inches. Inafaa kwa michoro ya uhandisi, hisabati na sanaa.', stock_quantity:4},
  {id:5,  name:'Calculator — Scientific',              price:35000, category:'shule',    icon:'🔢', badge:'hot',  rating:4.9, reviews:67,  desc:'Calculator ya kisayansi yenye vitendaji 240+ ikiwemo logarithm, trigonometry na statistics. Inakubalika rasmi kwa mitihani ya NECTA, CSEE, ACSEE na programu za chuo kikuu.', stock_quantity:12},
  {id:6,  name:'Bag ya Shule — Kubwa',                price:45000, category:'shule',    icon:'🎒', badge:'new',  rating:4.7, reviews:31,  desc:'Bag imara ya shule yenye compartments 3, mfuko wa mbele wa ziada na mifuko ya pande kwa chupa ya maji. Mab ya mgongo yenye pedi laini na zipper ya muda mrefu.', stock_quantity:7},
  {id:21, name:'Counterbook — Quire 1 (96 Ukurasa)', price:3500,  category:'shule',    icon:'📔', badge:null,   rating:4.7, reviews:18,  desc:'Counterbook ya ubora wa juu Quire 1, karatasi 96, mistari wazi. Inafaa kuandika hesabu za biashara, akaunti za msingi na rekodi za ofisi. Jalada imara la kadibodi.', stock_quantity:30},
  {id:22, name:'Counterbook — Quire 2 (192 Ukurasa)',price:6500,  category:'shule',    icon:'📒', badge:null,   rating:4.7, reviews:12,  desc:'Counterbook kubwa Quire 2 yenye kurasa 192 za karatasi yenye mistari, inafaa kuandika rekodi za muda mrefu za biashara ndogo au shule.', stock_quantity:20},
  {id:23, name:'Counterbook — Quire 3 (288 Ukurasa)',price:9500,  category:'shule',    icon:'📗', badge:null,   rating:4.6, reviews:8,   desc:'Counterbook nzito Quire 3, kurasa 288 za karatasi bora. Jalada gumu la kadibodi na uthibitisho wa usajili wa biashara. Inafaa rejista za ofisi na mahesabu ya kina.', stock_quantity:15},
  {id:24, name:'Counterbook — Quire 4 (384 Ukurasa)',price:12000, category:'shule',    icon:'📘', badge:null,   rating:4.6, reviews:6,   desc:'Counterbook kubwa kabisa Quire 4, kurasa 384. Inafaa sekretarieti, benki ndogo na taasisi zinazohitaji rejista za kumbukumbu ndefu. Karatasi ya 70gsm isiyo na rangi.', stock_quantity:10},
  {id:25, name:'Geometry Set — Mathematical',         price:7500,  category:'shule',    icon:'📐', badge:'new',  rating:4.8, reviews:24,  desc:'Seti kamili ya vifaa vya jiometri: compass, protractor ya 180°, set squares 30° na 45°, rula ya 15cm na penseli. Inafaa kwa mwanafunzi wa sekondari na chuo. Imefungwa katika sanduku la chuma imara.', stock_quantity:25},

  // ── OFISI ──────────────────────────────────────────────────────────────────
  {id:7,  name:'Karatasi A4 — Rim (500 Sheets)',     price:18000, category:'ofisi',    icon:'📄', badge:'hot',  rating:4.9, reviews:89,  desc:'Karatasi A4 80gsm za ubora wa juu, zinazopendekezwa kwa printers na photocopiers zote. Zinaprint bila msongamano, zinakauka haraka na hazitoi wino. Brand maarufu inayopatikana Mbeya.', stock_quantity:22},
  {id:8,  name:'Files za Suspension (10 pcs)',        price:12000, category:'ofisi',    icon:'🗂️', badge:null,   rating:4.7, reviews:34,  desc:'Seti ya files 10 za kusimamishwa kabatini, rangi mbalimbali kwa uainishaji rahisi. Ncha ya chuma imara na lebo wazi. Zinafaa kabati za ofisi aina zote.', stock_quantity:2},
  {id:9,  name:'Stapler + Staples Box',               price:8000,  category:'ofisi',    icon:'📌', badge:null,   rating:4.6, reviews:22,  desc:'Stapler imara ya chuma inayoshikilia karatasi hadi 30 kwa wakati mmoja, pamoja na masanduku 2 ya staples 24/6 (jumla staples 2,000). Inafaa ofisi yoyote.', stock_quantity:15},
  {id:10, name:'Punch (2-hole)',                      price:6500,  category:'ofisi',    icon:'🔧', badge:null,   rating:4.5, reviews:18,  desc:'Punch ya ofisi ya chuma, inafanya mashimo 2 sawa kwa karatasi A4 na A5. Ina kisanduku cha kukusanya vipande, na mpangilio wa ukubwa mbalimbali wa karatasi.', stock_quantity:8},
  {id:11, name:'Envelope C5 (Box 50)',                price:7000,  category:'ofisi',    icon:'✉️', badge:null,   rating:4.4, reviews:12,  desc:'Seti ya envelopes 50 ukubwa C5 (162×229mm) za karatasi nyeupe nzuri, zinafaa barua rasmi, fomu na documents. Gundi ya kuziba iliyopo tayari.', stock_quantity:1},
  {id:12, name:'Correction Fluid (Tipp-Ex)',          price:2000,  category:'ofisi',    icon:'🧴', badge:null,   rating:4.5, reviews:25,  desc:'Maji ya kufuta makosa ya kalamu na wino. Inakauka ndani ya sekunde 20, inaweza kuandikwa juu yake mara baada ya kukauka. Inafanya kazi vizuri kwenye karatasi zote za ofisi.', stock_quantity:30},
  {id:26, name:'Box File — Kawaida (Single)',         price:5500,  category:'ofisi',    icon:'📦', badge:null,   rating:4.6, reviews:14,  desc:'Box file imara ya kadibodi na chuma, inashikilia karatasi A4 hadi 500. Ina mpini wa kubeba na lebo ya kuandika. Inafaa kuhifadhi documents muhimu kwa muda mrefu.', stock_quantity:18},
  {id:27, name:'Flat File — Manila (Pack ya 10)',     price:4000,  category:'ofisi',    icon:'📁', badge:null,   rating:4.5, reviews:9,   desc:'Flat files 10 za manila ya ubora wa juu, rangi mbalimbali. Zinafaa kupanga na kuhifadhi karatasi A4, vouchers, risiti na hati za biashara. Zinaweza kuandikwa juu kwa lebo.', stock_quantity:24},

  // ── DIJITALI ───────────────────────────────────────────────────────────────
  {id:13, name:'Flash Disk 32GB — USB 3.0',          price:22000, category:'dijitali', icon:'💾', badge:'hot',  rating:4.9, reviews:95,  desc:'Flash disk ya haraka sana USB 3.0 yenye uwezo wa 32GB, inasoma kwa kasi ya 100MB/s+. Inafanya kazi na Windows, Mac na Linux. Ndogo, imara na inashikilia data kwa usalama.', stock_quantity:18},
  {id:14, name:'Memory Card 64GB (Class 10)',         price:28000, category:'dijitali', icon:'💳', badge:'new',  rating:4.8, reviews:43,  desc:'Memory card 64GB Class 10 UHS-I yenye kasi ya kuandika hadi 80MB/s. Inafaa simu za Android, kamera za dijitali, tablet na dashcam. Inastahimili maji, joto na mshtuko.', stock_quantity:3},
  {id:15, name:'Power Bank 20,000mAh',               price:55000, category:'dijitali', icon:'🔋', badge:'hot',  rating:4.9, reviews:78,  desc:'Power bank kubwa yenye uwezo wa 20,000mAh, inachaji simu 4-5 mara kamili. Ina milango miwili ya USB na moja ya USB-C, inasaidia fast charging. Nyepesi na rahisi kubeba mfukoni.', stock_quantity:9},
  {id:16, name:'Earphones — Bass Quality',           price:15000, category:'dijitali', icon:'🎧', badge:null,   rating:4.6, reviews:31,  desc:'Earphones za wired zenye sauti nzuri ya bass iliyoimarishwa, microphone ya mazungumzo ya simu na kitufe cha kudhibiti muziki. Kebo imara isiyovunjika haraka, inafaa simu zote.', stock_quantity:14},
  {id:17, name:'USB Charger — Fast Charge',          price:12000, category:'dijitali', icon:'🔌', badge:null,   rating:4.7, reviews:29,  desc:'Adapta ya kuchaji ya haraka 20W inayosaidia Quick Charge 3.0 na PD. Inafanya kazi na simu nyingi za kisasa. Ndogo na nyepesi, inafaa kwa safari na nyumbani.', stock_quantity:0},
  {id:18, name:'Mouse — Wireless',                   price:32000, category:'dijitali', icon:'🖱️', badge:'new',  rating:4.8, reviews:19,  desc:'Mouse ya wireless 2.4GHz yenye nano-receiver ndogo. Betri ya AA inacheza hadi miezi 12. Inafaa kushikwa kwa mkono wa kushoto au kulia. Inaenda vizuri kwenye meza, pamba na uso wowote.', stock_quantity:6},

  // ── TECH ───────────────────────────────────────────────────────────────────
  {id:28, name:'Flash Disk 16GB — USB 2.0',          price:12000, category:'tech',     icon:'🗜️', badge:null,   rating:4.7, reviews:22,  desc:'Flash disk ya bei nafuu 16GB USB 2.0 inayofaa kuhifadhi documents, picha na muziki. Inafanya kazi mara moja bila kuinstall software. Inafaa wanafunzi na wafanyikazi.', stock_quantity:30},
  {id:29, name:'Memory Card 32GB — MicroSD Class 10',price:15000, category:'tech',     icon:'💾', badge:null,   rating:4.7, reviews:16,  desc:'MicroSD 32GB Class 10 inayofaa simu za Android, kamera ndogo na vifaa vya sauti. Kasi ya kusoma 80MB/s, salama dhidi ya maji na umeme wa ghafla. Inakuja na adapta ya SD.', stock_quantity:20},
  {id:30, name:'Earphones — Original Brand',         price:18000, category:'tech',     icon:'🎵', badge:'new',  rating:4.8, reviews:11,  desc:'Earphones za original za ubora wa juu, sauti safi na bass iliyopangwa kisanaa. Kichwa cha kuingiza sikio laini na rahisi, kebo ya fabric isiyochanganyika. Ina dhamana ya miezi 6.', stock_quantity:15},
  {id:31, name:'USB Cable — Type-C (1.5m)',          price:5000,  category:'tech',     icon:'🔗', badge:null,   rating:4.6, reviews:33,  desc:'Kebo ya USB Type-C ya urefu 1.5m, inasaidia kuchaji kwa kasi na kuhamisha data kwa 480Mbps. Inafanya kazi na simu za Android na laptop nyingi. Imefungwa kwa nylon imara inayodumu muda mrefu.', stock_quantity:40},
  {id:32, name:'USB Cable — Micro-USB (1m)',         price:3500,  category:'tech',     icon:'🔋', badge:null,   rating:4.5, reviews:19,  desc:'Kebo ya Micro-USB ya mita 1, inafaa simu za zamani za Android, vichezeo vya watoto na vifaa vya ofisi. Inastahimili utumiaji wa kila siku, iliyofungwa kwa nyenzo imara.', stock_quantity:35},
  {id:43, name:'Bluetooth Speaker Mini',             price:38000, category:'tech',     icon:'🔊', badge:'hot',  rating:4.8, reviews:41,  desc:'Spika ndogo ya Bluetooth 5.0 yenye sauti ya bass nzuri. Inacheza masaa 6 kwa betri moja. Inastahimili maji (IPX5), rahisi kubeba mfukoni. Inaunganishwa kwa sekunde chache.', stock_quantity:12},
  {id:44, name:'LED Desk Lamp USB',                  price:22000, category:'tech',     icon:'💡', badge:'new',  rating:4.7, reviews:23,  desc:'Taa ya meza inayotumia USB kwa nuru laini isiyodhuru macho. Ina viwango 3 vya mwanga na uwezo wa kubadilisha pembe. Inafaa kusoma, kufanya kazi na wanafunzi.', stock_quantity:18},
  {id:45, name:'Phone Stand / Holder ya Meza',       price:8500,  category:'tech',     icon:'📱', badge:null,   rating:4.6, reviews:29,  desc:'Stand ya simu ya aluminium inayoweza kurekebisha urefu na pembe. Inashikilia simu za ukubwa wowote. Inafaa video calls, kutazama video na kusoma. Imara na haielezi.', stock_quantity:24},
  {id:46, name:'Screen Protector — Universal 6.5"', price:4500,  category:'tech',     icon:'🛡️', badge:null,   rating:4.5, reviews:37,  desc:'Kinga ya skrini ya kioo laini (tempered glass) 9H kwa simu za skrini hadi 6.5 inch. Inapinga michwazo, mshtuko na fingerprints. Inawekwa rahisi bila viputo.', stock_quantity:50},
  {id:47, name:'Phone Case — Silicon Soft',          price:5000,  category:'tech',     icon:'📲', badge:null,   rating:4.6, reviews:33,  desc:'Mfuko wa simu wa silicon laini unaofunika pembe zote. Unastahimili kuanguka na kuzuia michwazo. Universal 6.1-6.7 inch. Rangi nyingi kuagiza — nyeusi, bluu, nyekundu, kijani.', stock_quantity:40},
  {id:48, name:'3-in-1 Charging Cable (1.2m)',       price:9500,  category:'tech',     icon:'⚡', badge:'new',  rating:4.8, reviews:16,  desc:'Kebo moja inayochaji Type-C, Micro-USB na Lightning kwa wakati mmoja. Urefu 1.2m, inasaidia fast charging. Nylon braid ya kudumu — mwisho wa kuvunjika kwa kebo za kawaida!', stock_quantity:30},
  {id:49, name:'Wireless Earbuds — TWS',             price:48000, category:'tech',     icon:'🎧', badge:'hot',  rating:4.9, reviews:28,  desc:'Earbuds za wireless TWS zenye sauti safi na bass ya kina. Case ya kuchaji inayoongeza betri hadi mara 3. Inaunganishwa moja kwa moja bila kubonyeza buttons. Inastahimili jasho (IPX4).', stock_quantity:8},
  {id:50, name:'OTG Adapter USB-C to USB 3.0',       price:6000,  category:'tech',     icon:'🔌', badge:null,   rating:4.7, reviews:21,  desc:'Adapta OTG inayounganisha simu ya USB-C na vifaa vya USB kama flash disk, keyboard, mouse na zaidi. Inafanya kazi bila kuinstall drivers. Inafaa simu za Android za kisasa.', stock_quantity:22},

  // ── PICHA ──────────────────────────────────────────────────────────────────
  {id:19, name:'Picha za Passport (4 pcs)',          price:5000,  category:'picha',    icon:'📸', badge:'hot',  rating:5.0, reviews:156, desc:'Picha 4 za passport, ID ya kitaifa, vitambulisho vya kazi au chuo. Zinachukuliwa na kuprint mara moja hapa dukani kwa taa maalum na background sahihi inayokubaliwa na mamlaka zote Tanzania.', stock_quantity:999},
  {id:20, name:'Photo Print A4 — Rangi',             price:3000,  category:'picha',    icon:'🖼️', badge:null,   rating:4.8, reviews:44,  desc:'Print picha yako ukubwa A4 kwa rangi angavu za photographic quality. Karatasi ya glossy au matte, inafaa fremu na zawadi. Tuma picha yako kwa WhatsApp au USB.', stock_quantity:999},

  // MICHEZO
  {id:51, name:'Mpira wa Miguu Size 5',              price:35000, category:'michezo',  icon:'⚽', badge:'hot',  rating:4.9, reviews:54,  desc:'Mpira wa miguu wa ubora wa juu Size 5, unaotumiwa rasmi kwenye mechi za ligi na mafunzo. Ngozi ya PU iliyoimarishwa, ndani ya latex inayoshikilia hewa vizuri. Inafaa timu za shule, vyuo na klabuni.', stock_quantity:20},
  {id:52, name:'Mpira wa Kikapu Size 7',             price:48000, category:'michezo',  icon:'🏀', badge:'new',  rating:4.8, reviews:31,  desc:'Mpira wa basketball Size 7 wa ngozi ya PU, mstari mzuri wa kushikilia. Inafaa michezo ya ndani na nje. Uzito unaokubalika kimataifa, unashikilia hewa kwa muda mrefu.', stock_quantity:10},
  {id:33, name:'Mpira wa Raga (Volleyball)',         price:32000, category:'michezo',  icon:'🏐', badge:null,   rating:4.8, reviews:28,  desc:'Mpira wa volleyball wa ubora wa kati-juu, ngozi laini ya PU 18-panel. Unafaa michezo ya nje na ndani. Inashikilia hewa vizuri na pressure inayopendekezwa.', stock_quantity:12},
  {id:34, name:'Pumpu ya Mpira + Sindano 3',         price:7500,  category:'michezo',  icon:'🪧', badge:null,   rating:4.7, reviews:22,  desc:'Pumpu imara ya mkono inayofanya kazi na mipira yote. Inakuja na sindano 3 za kuchomeka. Ncha ya chuma ya kudumu na mwili wa plastiki nzito usiovunjika.', stock_quantity:25},
  {id:35, name:'Filimbi ya Kocha Metal',             price:3500,  category:'michezo',  icon:'📣', badge:null,   rating:4.6, reviews:19,  desc:'Filimbi ya chuma ya sauti kali inayosikika mbali hata kwenye uwanja mkubwa. Inakuja na kamba ya shingoni. Inafaa makocha, walinzi wa uwanja na wakaguzi wa mechi.', stock_quantity:40},
  {id:36, name:'Kamba ya Kuruka Speed Rope',         price:6000,  category:'michezo',  icon:'🪢', badge:'new',  rating:4.7, reviews:16,  desc:'Kamba ya kuruka ya speed inayofaa mazoezi ya moyo na uvumilivu. Mpini wa aluminum mwepesi na kamba ya PVC iliyoimarishwa kwa waya ndani. Inaweza kurekebisha urefu.', stock_quantity:30},
  {id:37, name:'Cones za Mafunzo (Set ya 10)',       price:14000, category:'michezo',  icon:'🔶', badge:null,   rating:4.8, reviews:14,  desc:'Seti ya cones 10 za plastiki laini ya rangi ya machungwa, inafaa kuweka mipaka kwenye mafunzo na drills za haraka. Inasimama imara bila kuanguka na haivunjiki.', stock_quantity:18},
  {id:38, name:'Mfuko wa Michezo Duffel 40L',        price:58000, category:'michezo',  icon:'👜', badge:'hot',  rating:4.9, reviews:37,  desc:'Mfuko wa michezo mkubwa 40L wenye compartments zote: mfuko wa viatu, mfuko wa mbele na straps za kubeba begani. Nyenzo ya Oxford 600D inayostahimili maji.', stock_quantity:8},
  {id:39, name:'Chupa ya Maji ya Michezo 750ml',     price:9000,  category:'michezo',  icon:'🧊', badge:null,   rating:4.7, reviews:29,  desc:'Chupa ya maji ya plastiki isiyo na BPA, inashikilia 750ml. Kichwa cha squeeze kinachofunguka kwa mkono mmoja. Haivuji na ni nyepesi kubeba uwanjani.', stock_quantity:35},
  {id:40, name:'Jersey ya Michezo Dry-Fit',          price:28000, category:'michezo',  icon:'👕', badge:'new',  rating:4.8, reviews:23,  desc:'Jersey za michezo za polyester zinazopumua hewa (dry-fit), zinazofaa soka, raga, kikapu na mbio. Rangi angavu zinazodumu. Zinapatikana kwa saizi S hadi XXL.', stock_quantity:15},
  {id:41, name:'Stopwatch Digital Coach Edition',    price:19500, category:'michezo',  icon:'⏱️', badge:null,   rating:4.8, reviews:18,  desc:'Stopwatch ya dijitali yenye LCD screen kubwa inayosomeka jua. Inaweza kupima lap, split na countdown. Kamba ya shingoni imejumuishwa. Betri inayodumu miaka 2.', stock_quantity:14},
  {id:42, name:'Gloves za Goalkeeper Pro',           price:22000, category:'michezo',  icon:'🥅', badge:null,   rating:4.7, reviews:11,  desc:'Gloves za kinga za goalkeeper zenye latex iliyoimarishwa palmuni. Strap ya Velcro inayoshika kiganja imara. Zinapatikana kwa saizi 7 hadi 10. Zinafaa mechi na mafunzo.', stock_quantity:10},
  {id:53, name:'Mpira wa Tenisi (Seti ya 3)',         price:9500,  category:'michezo',  icon:'🎾', badge:null,   rating:4.7, reviews:14,  desc:'Seti ya mipira 3 ya tenisi ya standard, nyeupe na njano. Pressure ya kawaida inayofaa korti za udongo na saruji. Inafaa mafunzo ya msingi na mechi za kawaida.', stock_quantity:20},
  {id:54, name:'Mpira wa Gofu (Seti ya 6)',           price:15000, category:'michezo',  icon:'⛳', badge:'new',  rating:4.6, reviews:8,   desc:'Seti ya mipira 6 ya gofu ya ubora wa kati, rangi nyeupe na njano. Inafaa mafunzo ya driving range na mechi. Imara na inasafiri mbali. Inafaa wachezaji wanaoanza na wa kati.', stock_quantity:15},
  {id:55, name:'Shin Guards / Gamba la Mguu',         price:12000, category:'michezo',  icon:'🦵', badge:null,   rating:4.8, reviews:22,  desc:'Gamba la kinga ya miguu kwa soka, EVA foam iliyoimarishwa. Strap ya velcro inayoshika imara bila kuteleza. Inastahimili migomo mikali. Saizi ndogo, kati na kubwa zinapatikana.', stock_quantity:25},
  {id:56, name:'Socks za Michezo (Seti ya 3)',        price:8000,  category:'michezo',  icon:'🧦', badge:null,   rating:4.7, reviews:31,  desc:'Seti ya soksi 3 za michezo za cotton iliyoimarishwa, zenye mto chini ya mguu. Zinafaa soka, raga, mbio na gym. Zinazuia jasho na harufu. Saizi 38-44 zinapatikana.', stock_quantity:35},
  {id:57, name:'Resistance Bands (Seti ya 5)',        price:18000, category:'michezo',  icon:'💪', badge:'hot',  rating:4.9, reviews:26,  desc:'Seti ya mikanda 5 ya mpinga (resistance) ya nguvu tofauti: nyepesi hadi nzito sana. Inafaa mazoezi ya nguvu, unyoofu na rehabilitation ya majeraha. Imefungwa katika mfuko wa kubeba.', stock_quantity:18},
  {id:58, name:'Yoga Mat 6mm',                        price:32000, category:'michezo',  icon:'🧘', badge:'new',  rating:4.8, reviews:19,  desc:'Mkeka wa yoga wa 6mm unaoupa faraja na usalama. Uso wa anti-slip wa pande zote mbili. Inafaa yoga, pilates, stretching na mazoezi ya sakafu. Inafungwa na kamba ya kubeba.', stock_quantity:12},
  {id:59, name:'Badminton Set (Rackets 2 + Net)',     price:45000, category:'michezo',  icon:'🏸', badge:null,   rating:4.8, reviews:17,  desc:'Seti kamili ya badminton: raketi 2 za aluminium, neti ya kubeba, na shuttlecock 3. Inafaa mafunzo ya nyumbani, shuleni au bustanini. Imefungwa katika mfuko wa kubeba.', stock_quantity:7},
  {id:60, name:'Hand Wraps ya Boksi (Pea 2)',         price:13500, category:'michezo',  icon:'🥊', badge:null,   rating:4.7, reviews:12,  desc:'Mikanda ya kufunga mikono kwa mazoezi ya boksi, muay thai na martial arts. Urefu 3.5m, pamba iliyoimarishwa. Velcro ya nguvu inayoshika imara. Inazuia majeraha ya mikono.', stock_quantity:20},
  {id:61, name:'Water Bottle Thermos 1L Insulated',   price:26000, category:'michezo',  icon:'🥤', badge:'hot',  rating:4.9, reviews:38,  desc:'Chupa ya thermos 1L ya stainless steel inayoshikilia joto/baridi kwa masaa 12-24. Mdomo mpana wa kuosha vizuri. Haivuji kamwe. Inafaa michezo, safari na ofisi.', stock_quantity:14},
  {id:62, name:'Agility Ladder (6m, 12 squares)',     price:21000, category:'michezo',  icon:'⚡', badge:'new',  rating:4.8, reviews:9,   desc:'Ngazi ya speed ya urefu 6m na kisanduku 12, inafaa mazoezi ya haraka na uratibu wa miguu. Plastiki ya PE inayodumu, inaweza kuhifadhiwa kwenye mfuko wake. Inafaa timu na mtu mmoja.', stock_quantity:10},
  {id:63, name:'Foam Roller Massage 33cm',            price:19500, category:'michezo',  icon:'🫧', badge:null,   rating:4.7, reviews:15,  desc:'Roller ya foam ya 33cm kwa massage ya misuli baada ya mazoezi. Inazuia maumivu ya misuli na kuharakisha kupona. High-density EVA foam isiyobonyea. Inafaa wachezaji wote.', stock_quantity:16},
  {id:64, name:'Sports Sunglasses Polarized',         price:29000, category:'michezo',  icon:'😎', badge:null,   rating:4.6, reviews:11,  desc:'Miwani ya jua ya michezo yenye lensi za polarized zinazopunguza mwanga. Fremu ya TR90 nyepesi isiyovunjika. Inafaa mbio, baiskeli, soka na shughuli zote za nje. UV400 protection.', stock_quantity:9},
  {id:65, name:'Jump Rope Counter Digital',           price:11500, category:'michezo',  icon:'🔢', badge:null,   rating:4.8, reviews:20,  desc:'Kamba ya kuruka yenye counter ya kuhesabu idadi ya kuruka na kalori zilizochomwa. Skrini ya LCD inayosomeka vizuri. Mpini wa foam laini wa kuzuia jasho. Urefu unaoweza kurekebisha.', stock_quantity:22},
];

