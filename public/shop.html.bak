    // ── s7: Picha za Passport ──────────────────────────────────────────────
    case 's7':
      return divider + `
        <div class="form-group">
          <label class="form-label">📸 Ukubwa wa Picha <span style="color:var(--danger)">*</span></label>
          <select class="form-input" id="dynPhotoSize">
            <option value="">-- Chagua ukubwa --</option>
            <option value="Picha ya Pasipoti (Passport Size)">🛂 Picha ya Pasipoti (Passport Size)</option>
            <option value="Picha ya Kitambulisho (ID Size)">🪪 Picha ya Kitambulisho (ID Size)</option>
