    // ── s6: CV & Typing ────────────────────────────────────────────────────
    case 's6':
      return divider + `
        <div class="form-group">
          <label class="form-label">📄 Aina ya Hati <span style="color:var(--danger)">*</span></label>
          <div class="radio-group" id="dynDocGroup" style="flex-direction:column;gap:6px;">
