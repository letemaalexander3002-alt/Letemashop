// =========================================================
// ===== GOOGLE DRIVE UPLOAD VIA APPS SCRIPT =====
// =========================================================
/**
 * Uploads a file to Google Drive via a deployed Google Apps Script Web App.
 * The Apps Script receives: { fileName, mimeType, base64Data, orderRef, customerName }
 * Set window._appsScriptUrl (or save via admin settings) before using.
 */
async function uploadFileToGoogleDrive(file, orderRef, customerName) {
  const appsScriptUrl = window._appsScriptUrl || localStorage.getItem('letema_apps_script_url');
  if (!appsScriptUrl) {
    console.warn('[GDrive] No Apps Script URL configured. Skipping upload.');
    return { success: false, reason: 'no_url' };
  }
  if (!file) return { success: false, reason: 'no_file' };

  return new Promise((resolve) => {
    const reader = new FileReader();
    reader.onload = async function(e) {
      try {
        const base64Data = e.target.result.split(',')[1]; // strip data:...;base64, prefix
        const payload = {
          fileName:     file.name,
          mimeType:     file.type || 'application/octet-stream',
          base64Data,
          orderRef:     orderRef || 'UNKNOWN',
          customerName: customerName || 'Unknown Customer'
        };
        const resp = await fetch(appsScriptUrl, {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify(payload)
        });
        const json = await resp.json();
        if (json && json.success) {
          console.log('[GDrive] File uploaded:', json.fileId);
          resolve({ success: true, fileId: json.fileId, fileUrl: json.fileUrl });
        } else {
          console.warn('[GDrive] Upload failed:', json);
          resolve({ success: false, reason: json.error || 'unknown' });
        }
      } catch(err) {
        console.warn('[GDrive] Upload error:', err);
        resolve({ success: false, reason: err.message });
      }
    };
    reader.onerror = () => resolve({ success: false, reason: 'file_read_error' });
    reader.readAsDataURL(file);
  });
}

// =========================================================
// ===== SERVICE INVOICE PDF GENERATOR (Admin) =====
// =========================================================
/**
 * Generates a professional Service Invoice PDF for admin use.
 * Called by "Finalize Service & Notify" button in admin panel.
 */
function generateServiceInvoicePDF(order, assignedPrice) {
  if (!window.jspdf || !window.jspdf.jsPDF) {
    showToast('⚠️ PDF library haijapakiwa.', 'error');
    return false;
  }
  try {
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF({ unit: 'mm', format: 'a4' });
    const pageW = doc.internal.pageSize.getWidth();
    const pageH = doc.internal.pageSize.getHeight();

    // ── HEADER BAND ──
    doc.setFillColor(0, 48, 135);
    doc.rect(0, 0, pageW, 40, 'F');
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(22);
    doc.setTextColor(255, 255, 255);
    doc.text('LETEMA STATIONERY', 14, 18);
    doc.setFontSize(9);
    doc.setFont('helvetica', 'normal');
    doc.setTextColor(255, 198, 0);
    doc.text('Internet Café & Office Supplies — Mbeya', 14, 26);
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(14);
    doc.setTextColor(255, 198, 0);
    doc.text('SERVICE INVOICE', pageW - 14, 20, { align: 'right' });
    doc.setFontSize(9);
    doc.setFont('helvetica', 'normal');
    doc.text('OFFICIAL RECEIPT', pageW - 14, 28, { align: 'right' });
    doc.setDrawColor(255, 198, 0);
    doc.setLineWidth(1);
    doc.line(0, 40, pageW, 40);

    // ── STATUS BADGE — PAID ──
    doc.setFillColor(22, 163, 74);
    doc.roundedRect(pageW - 52, 43, 38, 10, 2, 2, 'F');
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(9);
    doc.setTextColor(255, 255, 255);
    doc.text('✓ FINALIZED', pageW - 33, 50, { align: 'center' });

    // ── INVOICE META ──
    let y = 58;
    const now = new Date();
    const metaLeft = [
      ['Customer', order.customer],
      ['Phone', order.phone],
      ['Address', order.address || '—'],
    ];
    const metaRight = [
      ['Invoice #', order.ref],
      ['Date', now.toLocaleDateString('en-TZ', { dateStyle: 'medium' })],
      ['Service Date', order.timestamp],
    ];

    doc.setFontSize(10);
    metaLeft.forEach(([label, val], i) => {
      doc.setFont('helvetica', 'bold'); doc.setTextColor(0, 48, 135);
      doc.text(label + ':', 14, y + i * 7);
      doc.setFont('helvetica', 'normal'); doc.setTextColor(30, 41, 59);
      doc.text(String(val), 46, y + i * 7);
    });
    metaRight.forEach(([label, val], i) => {
      doc.setFont('helvetica', 'bold'); doc.setTextColor(0, 48, 135);
      doc.text(label + ':', pageW / 2 + 4, y + i * 7);
      doc.setFont('helvetica', 'normal'); doc.setTextColor(30, 41, 59);
      doc.text(String(val), pageW / 2 + 32, y + i * 7);
    });

    y += 30;

    // ── SERVICES TABLE ──
    const tableBody = (order.items || []).map(item => [
      item.name || 'Huduma',
      '1',
      'Finalized',
      'TZS ' + Number(assignedPrice).toLocaleString()
    ]);
    if (!tableBody.length) {
      tableBody.push([order.serviceDetails || 'Service Order', '1', 'Finalized', 'TZS ' + Number(assignedPrice).toLocaleString()]);
    }

    doc.autoTable({
      startY: y,
      head: [['Service / Huduma', 'Qty', 'Status', 'Amount']],
      body: tableBody,
      theme: 'grid',
      headStyles: { fillColor: [0, 48, 135], textColor: [255, 255, 255], fontStyle: 'bold', fontSize: 10 },
      bodyStyles: { fontSize: 9.5, textColor: [30, 41, 59] },
      alternateRowStyles: { fillColor: [241, 244, 251] },
      columnStyles: { 0: { cellWidth: 'auto' }, 1: { cellWidth: 18, halign: 'center' }, 2: { cellWidth: 30, halign: 'center' }, 3: { cellWidth: 45, halign: 'right' } },
      margin: { left: 14, right: 14 },
    });

    // ── TOTALS ──
    let ty = doc.lastAutoTable.finalY + 8;
    const price = Number(assignedPrice) || 0;
    const totalsX = pageW - 85;
    doc.setDrawColor(224, 232, 245);
    doc.setLineWidth(0.4);
    doc.line(totalsX, ty, pageW - 14, ty);
    ty += 7;

    const drawRow = (label, value, bold = false, color = [71, 85, 105]) => {
      doc.setFont('helvetica', bold ? 'bold' : 'normal');
      doc.setFontSize(bold ? 11 : 10);
      doc.setTextColor(...color);
      doc.text(label, totalsX + 2, ty);
      doc.text(value, pageW - 14, ty, { align: 'right' });
      ty += 7;
    };

    drawRow('Service Total:', 'TZS ' + price.toLocaleString());
    drawRow('VAT (0% — Service):', 'TZS 0');

    doc.setFillColor(0, 48, 135);
    doc.roundedRect(totalsX - 2, ty - 5, pageW - 14 - totalsX + 16, 11, 2, 2, 'F');
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(12);
    doc.setTextColor(255, 198, 0);
    doc.text('AMOUNT DUE:', totalsX + 2, ty + 3);
    doc.text('TZS ' + price.toLocaleString(), pageW - 14, ty + 3, { align: 'right' });
    ty += 18;

    // ── NOTES ──
    if (order.notes) {
      doc.setFont('helvetica', 'italic');
      doc.setFontSize(9);
      doc.setTextColor(100, 116, 139);
      doc.text('Notes: ' + order.notes, 14, ty);
      ty += 8;
    }

    // ── FOOTER ──
    doc.setFont('helvetica', 'normal');
    doc.setFontSize(8.5);
    doc.setTextColor(148, 163, 184);
    doc.text('Thank you for using Letema Stationery services, Mbeya.', 14, pageH - 26);
    doc.text('WhatsApp: +255 620 642 652  |  letema_stationery@gmail.com', 14, pageH - 20);

    // ── OFFICIAL STAMP ──
    const stampX = pageW - 36, stampY = pageH - 36, stampR = 22;
    const stampDate = now.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).toUpperCase();
    doc.setFillColor(220, 38, 38); doc.setDrawColor(180, 20, 20); doc.setLineWidth(1.2);
    doc.circle(stampX, stampY, stampR, 'FD');
    doc.setFillColor(255, 255, 255); doc.setDrawColor(255, 255, 255); doc.setLineWidth(0.8);
    doc.circle(stampX, stampY, stampR - 3, 'D');
    doc.setFont('helvetica', 'bold'); doc.setTextColor(255, 255, 255);
    doc.setFontSize(7.5); doc.text('FINALIZED', stampX, stampY - 5, { align: 'center' });
    doc.setFontSize(6.5); doc.text('LETEMA SVC', stampX, stampY + 0.5, { align: 'center' });
    doc.setFontSize(6); doc.text(stampDate, stampX, stampY + 6, { align: 'center' });

    doc.save('Letema_ServiceInvoice_' + order.ref + '.pdf');
    return true;
  } catch(e) {
    console.error('Service invoice error:', e);
    showToast('⚠️ Invoice generation failed: ' + e.message, 'error');
    return false;
  }
}

// =========================================================
// ===== FINALIZE SERVICE & NOTIFY (Admin) =====
// =========================================================
async function finalizeServiceAndNotify(ref) {
  const order = adminOrders.find(o => o.ref === ref);
  if (!order) { showToast('⚠️ Order not found.', 'error'); return; }

  const priceInput = document.getElementById('svcPrice_' + ref);
  const rawPrice   = priceInput ? priceInput.value.trim() : '';
  if (!rawPrice || isNaN(Number(rawPrice)) || Number(rawPrice) <= 0) {
    showToast('⚠️ Weka bei halali ya nambari kwanza.', 'error');
    if (priceInput) priceInput.focus();
    return;
  }

  const assignedPrice = Number(rawPrice);

  // 1. Update order in Supabase: save price, move to "confirmed"
  if (window.letemaSupabase) {
    const c = window.letemaSupabase.getClient && window.letemaSupabase.getClient();
    if (c) {
      const { error } = await c.from('orders').update({
        total:    assignedPrice,
        subtotal: assignedPrice,
        status:   'confirmed'
      }).eq('ref', ref);
      if (error) console.warn('[Supabase] finalizeService update error:', error.message);
    }
    window.letemaSupabase.audit && window.letemaSupabase.audit({
      actor: 'admin', action: 'service.price_set', entity: 'order', entity_id: ref,
      meta: { price: assignedPrice }
    });
  }
  // Update local cache
  order.total    = assignedPrice;
  order.subtotal = assignedPrice;
  order.status   = 'confirmed';
  saveAdminOrders();
  renderAdminOrders();

  // 2. Download PDF invoice
  generateServiceInvoicePDF(order, assignedPrice);

  // 3. Open notify-customer modal pre-filled with "invoice_ready" template
  showToast(`✅ Bei TZS ${assignedPrice.toLocaleString()} imehifadhiwa. Tuma invoice kwa mteja.`, 'success');
  setTimeout(() => notifyCustomer(ref, 'invoice_tayari', assignedPrice), 500);
}

async function syncStatusToSheets(orderId, status) {
  if (window.letemaSupabase) {
    await window.letemaSupabase.updateOrderStatus(orderId, status);
  }
}

