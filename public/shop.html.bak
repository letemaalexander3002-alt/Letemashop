            <label for="dynServiceFile" class="dyn-file-label" id="dynServiceFileLabel">
              <div class="dyn-file-icon">📁</div>
              <div class="dyn-file-text">
                <div class="dyn-file-title" id="dynServiceFileTitle">Chagua Faili (hiari)</div>
                <div class="dyn-file-sub" id="dynServiceFileSub">Picha, PDF, AI, PSD — hadi 20MB</div>
              </div>
              <span class="dyn-file-badge" id="dynServiceFileBadge">Pakia</span>
            </label>
          </div>
        </div>`;

    // ── s5: Internet / Cyber Café ──────────────────────────────────────────
    case 's5':
      return divider + `
        <div class="form-group">
          <label class="form-label">💻 Aina ya Huduma ya Intaneti <span style="color:var(--danger)">*</span></label>
          <select class="form-input" id="dynInternetActivity">
