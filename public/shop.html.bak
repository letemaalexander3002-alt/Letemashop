/**
 * fallbackWhatsApp: opens wa.me link in a new tab so the user can send manually.
 */
function fallbackWhatsApp(phone, message) {
  const url = `https://wa.me/${String(phone).replace(/^\+/,'')}?text=${encodeURIComponent(message)}`;
  window.open(url, '_blank');
}

// =========================================================
// ===== OWNER WHATSAPP NOTIFICATION (auto-send) =====
// =========================================================
function notifyOwnerWhatsApp(order) {
  const ownerPhone = window._ownerPhone || localStorage.getItem('letema_owner_phone') || OWNER_PHONE;
  const itemsText = (order.items || []).map(i => `${i.name} x${i.qty}`).join(', ') || order.type || 'Huduma';
  const msg =
    `🛒 *ODA MPYA — Letema Shop*\n` +
    `━━━━━━━━━━━━━━━\n` +
    `📌 Ref: ${order.ref}\n` +
    `👤 Mteja: ${order.customer}\n` +
    `📱 Simu: ${order.phone}\n` +
    `📦 Bidhaa: ${itemsText}\n` +
    `💰 Jumla: TZS ${(order.total || 0).toLocaleString()}\n` +
    `📍 Eneo: ${order.address || '—'}\n` +
    `⏰ Wakati: ${order.timestamp}\n` +
    `━━━━━━━━━━━━━━━\n` +
    `Fungua Dashboard: ${window.location.href}`;

  order._ownerNotifUrl = `https://wa.me/${ownerPhone}?text=${encodeURIComponent(msg)}`;
  saveAdminOrders();

  sendWhatsAppMessage(ownerPhone, msg).then(result => {
    if (!result.success) {
      console.warn('[Whapi] Owner notify fallback — use admin panel button.');
    }
  });
}

