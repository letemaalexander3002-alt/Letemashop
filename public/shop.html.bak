          <div class="form-hint">Jina hili litatumika moja kwa moja katika muundo wako</div>
        </div>
        <div class="form-group">
          <label class="form-label">🎨 Maelezo ya Rangi au Mtindo Unaopenda <span style="color:var(--gray-400);text-transform:none;font-weight:400;">(hiari)</span></label>
          <textarea class="form-input" rows="3" placeholder="Mfano: Napenda rangi za samawati na dhahabu, mtindo wa kisasa na wa kitaalamu, bila picha za watu..." id="dynNotes" style="resize:vertical;"></textarea>
        </div>
        <div class="form-group">
          <label class="form-label">📎 Pakia Faili la Rejeleo <span style="color:var(--gray-400);text-transform:none;font-weight:400;">(hiari — logo ya zamani, picha, nk.)</span></label>
          <div class="dyn-file-wrap">
            <input type="file" id="dynServiceFile" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.gif,.bmp,.webp,.ai,.psd,.svg"
