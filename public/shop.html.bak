// Helper: toggle radio-option selected class
function selectRadioOpt(el, groupId) {
  document.querySelectorAll(`#${groupId} .radio-option`).forEach(opt => opt.classList.remove('selected'));
  el.classList.add('selected');
  const radio = el.querySelector('input[type="radio"]');
  if (radio) radio.checked = true;
}

// Collect dynamic field values into a human-readable string for WhatsApp
function collectDynamicFieldValues(serviceId) {
  const g = (id) => { const el = document.getElementById(id); return el ? el.value.trim() : ''; };
  const r = (name) => {
    const checked = document.querySelector(`input[name="${name}"]:checked`);
    return checked ? checked.value : '';
  };
  const f = (id) => {
    const el = document.getElementById(id);
    return (el && el.files && el.files.length > 0) ? `📎 ${el.files[0].name}` : 'Hakuna faili';
  };

  switch (serviceId) {
    case 's1': case 's2':
      return `Aina: ${r('dynColor') || 'Haijachaguliwa'}\nKurasa: ${g('dynPages') || '1'}\nNakala: ${g('dynCopies') || '1'}\nMaelezo: ${g('dynNotes') || 'Hakuna'}`;
    case 's3':
      return `Aina ya Faili: ${g('dynFileType') || 'Haijachaguliwa'}\nRangi: ${r('dynColor') || 'Rangi'}\nKurasa: ${g('dynPages') || '1'}\nNakala: ${g('dynPrintQty') || '1'}\nFaili: ${f('dynServiceFile')}\nMaelezo: ${g('dynNotes') || 'Hakuna'}`;
    case 's4':
      return `Aina ya Muundo: ${r('dynDesign') || 'Haijachaguliwa'}\nJina la Biashara: ${g('dynBusinessName') || 'Haijawekwa'}\nFaili la Rejeleo: ${f('dynServiceFile')}\nMtindo / Rangi: ${g('dynNotes') || 'Hakuna'}`;
    case 's5':
      return `Aina ya Huduma: ${g('dynInternetActivity') || 'Haijachaguliwa'}\nMuda: ${g('dynInternetTime') || '1 Saa'}\nKazi: ${g('dynNotes') || 'Hakuna'}`;
    case 's6':
      return `Aina ya Hati: ${r('dynDoc') || 'Haijachaguliwa'}\nJina Kamili: ${g('dynCvFullName') || 'Haijawekwa'}\nElimu ya Juu: ${g('dynCvEducation') || 'Haijawekwa'}\nLugha: ${r('dynLang') || 'Kiswahili'}\nFaili Iliyopo: ${f('dynServiceFile')}\nMaelezo: ${g('dynNotes') || 'Hakuna'}`;
    case 's7':
      return `Ukubwa wa Picha: ${g('dynPhotoSize') || 'Haijachaguliwa'}\nMatumizi: ${g('dynPhotoUse') || 'Haijachaguliwa'}\nNakala: ${g('dynPhotoCopies') || '4'}\nMaelezo: ${g('dynNotes') || 'Hakuna'}`;
    case 's8':
      return `Aina ya Huduma: ${r('dynOnline') || 'Haijachaguliwa'}\nSimu / Akaunti ID: ${g('dynOnlinePhoneId') || 'Haijawekwa'}\nHati: ${f('dynOnlineFile')}\nMaelezo: ${g('dynNotes') || 'Hakuna'}`;
    // ── Digital & Communication Services ──────────────────────────────────
    case 'sd1':
      return `Aina ya Huduma: ${r('dynMmo') || 'Haijachaguliwa'}\nMtandao: ${g('dynMmoNetwork') || 'Haijachaguliwa'}\nNamba ya Mpokeaji: ${g('dynMmoRecipient') || 'Haijawekwa'}\nKiasi: TZS ${g('dynMmoAmount') || '0'}\nMaelezo: ${g('dynNotes') || 'Hakuna'}`;
    case 'sd2':
      return `Mtandao: ${g('dynLipaMtandao') || 'Haijachaguliwa'}\nKiasi: TZS ${g('dynLipaAmount') || '0'}\nMalipo ni ya: ${g('dynLipaPurpose') || 'Haijawekwa'}\nMaelezo: ${g('dynNotes') || 'Hakuna'}`;
    case 'sd3':
      return `Mtandao: ${g('dynPochiMtandao') || 'Haijachaguliwa'}\nJina la Biashara: ${g('dynPochiBusinessName') || 'Haijawekwa'}\nNamba ya Simu: ${g('dynPochiPhone') || 'Haijawekwa'}\nMaelezo: ${g('dynNotes') || 'Hakuna'}`;
    case 'sd4':
      return `Mtandao: ${g('dynDataMtandao') || 'Haijachaguliwa'}\nNamba ya Simu: ${g('dynDataPhone') || 'Haijawekwa'}\nAina ya Pakiti: ${g('dynDataPackage') || 'Haijachaguliwa'}\nMaelezo: ${g('dynNotes') || 'Hakuna'}`;
    case 'sd5':
      return `Mtandao: ${g('dynWifiMtandao') || 'Haijachaguliwa'}\nMatumizi: ${r('dynWifiUse') || 'Haijachaguliwa'}\nMaelezo: ${g('dynNotes') || 'Hakuna'}`;
    case 'sd6':
      return `Mtandao: ${g('dynWifiLgMtandao') || 'Haijachaguliwa'}\nVifaa vya Kuunganisha: ${g('dynWifiLgDevices') || '5'}\nMaelezo: ${g('dynNotes') || 'Hakuna'}`;
    case 'sd7':
      return `Mtandao: ${g('dynSmeMtandao') || 'Haijachaguliwa'}\nJina la Biashara: ${g('dynSmeName') || 'Haijawekwa'}\nNamba ya Simu: ${g('dynSmePhone') || 'Haijawekwa'}\nMaelezo: ${g('dynNotes') || 'Hakuna'}`;
    case 'sd8':
      return `Lengo la Uwekezaji: ${r('dynInvGoal') || 'Haijachaguliwa'}\nMtaji: ${g('dynInvCapital') || 'Haijachaguliwa'}\nMaelezo: ${g('dynNotes') || 'Hakuna'}`;
    default:
      return `Maelezo: ${g('dynNotes') || 'Hakuna'}`;
  }
}


// ── Compact file-select handler for dynamic modal uploads ──────────────────
function handleDynFileSelect(input, labelId, titleId, subId, badgeId) {
  const label = document.getElementById(labelId);
  const title = document.getElementById(titleId);
  const sub   = document.getElementById(subId);
  const badge = document.getElementById(badgeId);
  if (!label) return;

  if (input.files && input.files.length > 0) {
    const file   = input.files[0];
    const sizeMB = (file.size / (1024 * 1024)).toFixed(2);
    const ext    = file.name.split('.').pop().toUpperCase();
    label.classList.add('has-file');
    title.textContent = file.name.length > 30 ? file.name.slice(0,28) + '…' : file.name;
    sub.textContent   = `${ext} • ${sizeMB} MB — Imepakuliwa ✅`;
    badge.textContent = '✓ Tayari';
    showToast(`📎 "${file.name}" imepakiwa. Kumbuka kuisend kwa WhatsApp!`, 'info');
  } else {
    label.classList.remove('has-file');
    title.textContent = 'Chagua Faili au Gusa Hapa';
    sub.textContent   = 'PDF, Picha, Word — hadi 10 MB';
    badge.textContent = 'Pakia';
  }
}

function submitOrderModal() {
  const s = SERVICES.find(x => x.id === activeOrderServiceId);
  if (!s) return;

  const name  = sanitizeInput(document.getElementById('orderClientName').value.trim());
  const phone = document.getElementById('orderClientPhone').value.trim();
  const urgencyMap = {leo:'🔥 Haraka — Leo hii', kesho:'📅 Kesho asubuhi', siku23:'🗓️ Siku 2–3 zijazo', wiki:'📆 Wiki hii'};
  const urgency = urgencyMap[document.getElementById('orderUrgency').value] || 'Haijachaguliwa';

  // Validation
  if (!name) { showToast('⚠️ Tafadhali weka jina lako kamili!', 'error'); document.getElementById('orderClientName').focus(); return; }
  if (!phone) { showToast('⚠️ Weka namba ya WhatsApp!', 'error'); document.getElementById('orderClientPhone').focus(); return; }
  if (!isValidPhone(phone)) { showToast('⚠️ Namba ya WhatsApp si sahihi! Mfano: +255620642652 au 0620642652', 'error'); document.getElementById('orderClientPhone').focus(); return; }

  // Collect dynamic details
  const details = collectDynamicFieldValues(activeOrderServiceId);

  // ===== GENERATE UNIQUE ORDER ID =====
  const orderId = 'LTM-' + Math.random().toString(36).substring(2, 7).toUpperCase();
  const now = new Date();

  // ===== BUILD ORDER RECORD =====
  const orderRecord = {
    ref:       orderId,
    timestamp: now.toLocaleString('en-TZ', { dateStyle: 'short', timeStyle: 'short' }),
    date:      now.toISOString().slice(0, 10),
    customer:  name,
    phone,
    address:   '—',
    email:     '',
    type:      'service',
    items:     [{ id: s.id, name: s.name, qty: 1, price: 0, type: 'service' }],
    subtotal:  0,
    vat:       0,
    total:     0,
    payment:   'cash',
    txnId:     '',
    notes:     details,
    status:    'pending',
    serviceDetails: details,
    urgency
  };

  // ===== STEP 1: SAVE ORDER TO localStorage (Admin Dashboard) =====
  addAdminOrder(orderRecord);

  // ===== STEP 1b: SAVE TO SUPABASE =====
  if (window.letemaSupabase) {
    window.letemaSupabase.insertOrder(orderRecord).catch(e => console.warn('[Supabase] insertOrder:', e));
  }

  // ===== STEP 1c: UPLOAD FILE (if any) =====
  // Checks dynServiceFile (s3/s4/s6) and dynOnlineFile (s8) inputs
  const _fileInputs = ['dynServiceFile', 'dynOnlineFile'];
  let _fileToUpload = null;
  for (const fid of _fileInputs) {
    const el = document.getElementById(fid);
    if (el && el.files && el.files.length > 0) { _fileToUpload = el.files[0]; break; }
  }
  if (_fileToUpload) {
    showToast('☁️ Inapakia faili...', 'info');
    (async () => {
      let uploaded = false;
      let fileUrl  = null;

      // Supabase Storage (primary)
      if (window.letemaSupabase && window.letemaSupabase.uploadFileToSupabase) {
        const res = await window.letemaSupabase.uploadFileToSupabase(_fileToUpload, orderId, name);
        if (res.success) {
          uploaded = true;
          fileUrl  = res.url || null;
          showToast('✅ Faili limepakiwa!', 'success');
        } else {
          console.warn('[Upload] Supabase imeshindwa:', res.reason, '— inajaribu GDrive...');
        }
      }

      // GDrive fallback
      if (!uploaded) {
        const gr = await uploadFileToGoogleDrive(_fileToUpload, orderId, name);
        if (gr.success) {
          uploaded = true;
          fileUrl  = gr.fileUrl || null;
          showToast('✅ Faili limepakiwa (GDrive)!', 'success');
        } else {
          showToast(
            gr.reason === 'no_url'
              ? '⚠️ Faili halikupakiwa — tuma mwenyewe kwenye WhatsApp.'
              : `⚠️ Upload imeshindwa: ${gr.reason}`,
            'error'
          );
        }
      }

      // Save URL to Supabase
      if (fileUrl && window.letemaSupabase) {
        const c = window.letemaSupabase.getClient && window.letemaSupabase.getClient();
        if (c) c.from('orders').update({ notes: (orderRecord.notes ? orderRecord.notes + '\n' : '') + 'File: ' + fileUrl }).eq('ref', orderId);
      }
    })();
  }

  // ===== STEP 2: CLOSE MODAL =====
  closeModal('serviceOrderModal');

  // ===== STEP 3: GENERATE & DOWNLOAD PDF =====
  try {
    generateServiceOrderPDF(orderRecord, s, details);
  } catch(pdfErr) {
    console.warn('Service PDF generation error:', pdfErr);
    showToast('⚠️ PDF haikuweza kutengenezwa, lakini oda imesajiliwa.', 'error');
  }

  // ===== STEP 4: SUCCESS TOAST =====
  showToast(`✅ Oda ${orderId} imesajiliwa! PDF yako inashuka...`, 'success');

  // ===== STEP 5: WHATSAPP — AUTO-SEND VIA API, FALLBACK TO wa.me =====
  const waMsg =
    `Hello Letema Stationery, my name is ${name}. ` +
    `I have placed an order for ${s.name}. ` +
    `I have downloaded my Order PDF (${orderId}) and I am ready to send it along with the required documents.`;

  const _rOwner3 = window._ownerPhone || localStorage.getItem('letema_owner_phone') || '255620642652';
  lastWaUrl = `https://wa.me/${_rOwner3}?text=${encodeURIComponent(waMsg)}`;

  // ── Send order notification to Letema (owner) ─────────────
  const runtimeOwner = window._ownerPhone || localStorage.getItem('letema_owner_phone') || OWNER_PHONE;
  sendWhatsAppMessage(runtimeOwner, waMsg).then(ownerResult => {
    if (ownerResult.success) {
      showToast('📲 Ujumbe wa oda umetumwa kwa WhatsApp kiotomatiki!', 'success');
    } else {
      // Fallback: open wa.me after short delay so PDF download starts first
      setTimeout(() => fallbackWhatsApp('255620642652', waMsg), 1500);
    }
  });

  // ── Send confirmation to customer ─────────────────────────
  const custConfirm =
    `Asante ${name}! Oda yako *${orderId}* imepokelewa na Letema Stationery & Internet Cafe, Mbeya.\n` +
    `Huduma: ${s.name}\n` +
    `Tafadhali tuma PDF yako ya oda kwenye mazungumzo haya pamoja na nyaraka zinazohitajika.\n` +
    `Tutawasiliana nawe hivi karibuni. Asante! 🙏`;
  sendWhatsAppMessage(phone, custConfirm);
}

// =========================================================
// ===== PDF HELPER: Decode HTML entities for jsPDF text =====
// =========================================================
// sanitizeInput() encodes special chars as HTML entities (&amp; &#x27; etc.)
// jsPDF renders them literally, so we must decode before printing to PDF.
function pdfSafe(str) {
  return String(str || '')
    .replace(/&amp;/g,  '&')
    .replace(/&lt;/g,   '<')
    .replace(/&gt;/g,   '>')
    .replace(/&quot;/g, '"')
    .replace(/&#x27;/g, "'")
    .replace(/&#x2F;/g, '/')
    // Strip emoji / non-Latin-1 characters that jsPDF cannot render
    .replace(/[^\x00-\xFF]/g, '');
}

// =========================================================
// ===== SERVICE ORDER PDF GENERATOR =====
// =========================================================
function generateServiceOrderPDF(orderRecord, service, details) {
  if (!window.jspdf || !window.jspdf.jsPDF) { showToast('⚠️ PDF library haijapakiwa.', 'error'); return; }
  const { jsPDF } = window.jspdf;
  const doc  = new jsPDF({ unit: 'mm', format: 'a4' });
  const pageW = doc.internal.pageSize.getWidth();
  const pageH = doc.internal.pageSize.getHeight();

  // FIX 1: Define `now` inside this function (was missing — caused ReferenceError on stamp)
  const now = new Date();
  doc.setFillColor(0, 48, 135);
  doc.rect(0, 0, pageW, 42, 'F');

  // Gold accent stripe
  doc.setFillColor(255, 198, 0);
  doc.rect(0, 42, pageW, 2.5, 'F');

  // Brand name
  doc.setFont('helvetica', 'bold');
  doc.setFontSize(20);
  doc.setTextColor(255, 255, 255);
  doc.text('LETEMA STATIONERY', 14, 17);

  // Tagline
  doc.setFontSize(8.5);
  doc.setFont('helvetica', 'normal');
  doc.setTextColor(255, 198, 0);
  doc.text('Internet Café & Office Supplies  •  Mbeya, Tanzania', 14, 24);

  // Contact line
  doc.setTextColor(255, 255, 255);
  doc.setFontSize(7.5);
  doc.text('+255 620 642 652  |  letemaalexander3002@gmail.com  |  WhatsApp Available', 14, 30);

  // SERVICE RECEIPT label (right)
  doc.setFont('helvetica', 'bold');
  doc.setFontSize(13);
  doc.setTextColor(255, 198, 0);
  doc.text('SERVICE ORDER', pageW - 14, 18, { align: 'right' });
  doc.setFontSize(9);
  doc.setTextColor(255, 255, 255);
  doc.text('OFFICIAL RECEIPT', pageW - 14, 25, { align: 'right' });

  // ── ORDER ID + DATE PILL ──────────────────────────────────────
  let y = 54;

  // Left: Order ID block
  doc.setFillColor(0, 31, 92);
  doc.roundedRect(12, y - 5, 85, 18, 3, 3, 'F');
  doc.setFont('helvetica', 'bold');
  doc.setFontSize(8);
  doc.setTextColor(255, 198, 0);
  doc.text('ORDER ID', 20, y + 1);
  doc.setFontSize(13);
  doc.setTextColor(255, 255, 255);
  doc.text(orderRecord.ref, 20, y + 8);

  // Right: Date / Status block
  doc.setFillColor(241, 244, 251);
  doc.roundedRect(pageW - 97, y - 5, 85, 18, 3, 3, 'F');
  doc.setFont('helvetica', 'bold');
  doc.setFontSize(8);
  doc.setTextColor(0, 48, 135);
  doc.text('DATE & TIME', pageW - 89, y + 1);
  doc.setFontSize(9);
  doc.setTextColor(30, 41, 59);
  doc.text(orderRecord.timestamp, pageW - 89, y + 8);

  y += 22;

  // ── CUSTOMER & SERVICE INFO TABLE ────────────────────────────
  doc.setFillColor(241, 244, 251);
  doc.roundedRect(12, y, pageW - 24, 30, 3, 3, 'F');

  doc.setFont('helvetica', 'bold');
  doc.setFontSize(7.5);
  doc.setTextColor(0, 48, 135);
  doc.text('CUSTOMER NAME', 18, y + 7);
  doc.setFont('helvetica', 'normal');
  doc.setFontSize(11);
  doc.setTextColor(30, 41, 59);
  doc.text(pdfSafe(orderRecord.customer), 18, y + 14);

  doc.setFont('helvetica', 'bold');
  doc.setFontSize(7.5);
  doc.setTextColor(0, 48, 135);
  doc.text('WHATSAPP / PHONE', 18, y + 22);
  doc.setFont('helvetica', 'normal');
  doc.setFontSize(10);
  doc.setTextColor(30, 41, 59);
  doc.text(pdfSafe(orderRecord.phone), 18, y + 28);

  const midX = pageW / 2 + 4;
  doc.setFont('helvetica', 'bold');
  doc.setFontSize(7.5);
  doc.setTextColor(0, 48, 135);
  doc.text('SERVICE REQUESTED', midX, y + 7);
  doc.setFont('helvetica', 'normal');
  doc.setFontSize(10);
  doc.setTextColor(30, 41, 59);
  const svcLabel = pdfSafe(service.name);
  doc.text(svcLabel || 'Huduma', midX, y + 14);

  doc.setFont('helvetica', 'bold');
  doc.setFontSize(7.5);
  doc.setTextColor(0, 48, 135);
  doc.text('BASE PRICE', midX, y + 22);
  doc.setFont('helvetica', 'normal');
  doc.setFontSize(10);
  doc.setTextColor(22, 163, 74);
  doc.text(pdfSafe(service.price), midX, y + 28);

  y += 38;

  // ── SERVICE REQUIREMENTS TABLE ───────────────────────────────
  const reqRows = (service.requirements && service.requirements.length)
    ? service.requirements.map((r, i) => [`${i + 1}.`, pdfSafe(r)])
    : [['—', 'Hakuna mahitaji maalum yaliyobainishwa.']];

  doc.autoTable({
    startY: y,
    head: [['#', 'MAHITAJI YA HUDUMA (Service Requirements)']],
    body: reqRows,
    theme: 'grid',
    headStyles: {
      fillColor: [0, 48, 135],
      textColor: [255, 255, 255],
      fontStyle: 'bold',
      fontSize: 9,
      cellPadding: 5,
    },
    bodyStyles: {
      fontSize: 9,
      textColor: [30, 41, 59],
      cellPadding: 4,
      lineColor: [224, 232, 245],
    },
    alternateRowStyles: { fillColor: [247, 249, 255] },
    columnStyles: {
      0: { cellWidth: 10, halign: 'center', fontStyle: 'bold', textColor: [0, 48, 135] },
      1: { cellWidth: 'auto' },
    },
    margin: { left: 12, right: 12 },
  });

  y = doc.lastAutoTable.finalY + 8;

  // ── SPECIFIC SERVICE DETAILS BOX ─────────────────────────────
  if (details && details.trim()) {
    doc.setFillColor(255, 251, 235);
    doc.setDrawColor(255, 198, 0);
    doc.setLineWidth(0.6);
    doc.roundedRect(12, y, pageW - 24, 8, 2, 2, 'FD');
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(8);
    doc.setTextColor(180, 100, 0);
    doc.text('MAELEZO YA ODA  /  Order Details', 18, y + 5.5);
    y += 12;

    const safeDetails = pdfSafe(details);
    const detailLines = doc.splitTextToSize(safeDetails, pageW - 36);
    const detailBoxH  = Math.max(detailLines.length * 5.5 + 8, 18);
    doc.setFillColor(255, 253, 245);
    doc.setDrawColor(255, 198, 0);
    doc.setLineWidth(0.4);
    doc.roundedRect(12, y, pageW - 24, detailBoxH, 2, 2, 'FD');

    // Gold left accent bar
    doc.setFillColor(255, 198, 0);
    doc.rect(12, y, 3.5, detailBoxH, 'F');

    doc.setFont('helvetica', 'normal');
    doc.setFontSize(8.5);
    doc.setTextColor(71, 85, 105);
    doc.text(detailLines, 20, y + 6);
    y += detailBoxH + 8;
  }

  // ── STATUS BADGE ─────────────────────────────────────────────
  doc.setFillColor(220, 252, 231);
  doc.setDrawColor(22, 163, 74);
  doc.setLineWidth(0.5);
  doc.roundedRect(12, y, 60, 11, 2, 2, 'FD');
  doc.setFont('helvetica', 'bold');
  doc.setFontSize(8.5);
  doc.setTextColor(22, 163, 74);
  doc.text('STATUS: PENDING / INASUBIRI', 16, y + 7.5);

  // ── OFFICIAL STAMP ───────────────────────────────────────────
  const stampX = pageW - 32;
  const stampY = pageH - 36;
  const stampR = 21;
  const stampDate = now.toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' }).toUpperCase();

  doc.setFillColor(220, 38, 38);
  doc.setDrawColor(160, 20, 20);
  doc.setLineWidth(1.2);
  doc.circle(stampX, stampY, stampR, 'FD');
  doc.setFillColor(255, 255, 255);
  doc.setDrawColor(255, 255, 255);
  doc.setLineWidth(0.7);
  doc.circle(stampX, stampY, stampR - 3, 'D');
  doc.setFont('helvetica', 'bold');
  doc.setTextColor(255, 255, 255);
  doc.setFontSize(7);
  doc.text('ORDER', stampX, stampY - 6, { align: 'center' });
  doc.setFontSize(6.5);
  doc.text('RECEIVED', stampX, stampY - 1, { align: 'center' });
  doc.setFontSize(5.5);
  doc.text('LETEMA STATIONERY', stampX, stampY + 4, { align: 'center' });
  doc.setFontSize(5.5);
  doc.text(stampDate, stampX, stampY + 9, { align: 'center' });

  // ── FOOTER ───────────────────────────────────────────────────
  doc.setDrawColor(224, 232, 245);
  doc.setLineWidth(0.5);
  doc.line(12, pageH - 22, pageW - 12, pageH - 22);
  doc.setFont('helvetica', 'normal');
  doc.setFontSize(7.5);
  doc.setTextColor(148, 163, 184);
  doc.text(
    'Present this receipt + your documents on WhatsApp to complete your service order.',
    pageW / 2, pageH - 17, { align: 'center' }
  );
  doc.text(
    'Letema Stationery & Internet Cafe  |  WhatsApp: +255 620 642 652  |  Mbeya, Tanzania',
    pageW / 2, pageH - 12, { align: 'center' }
  );

  // ── SAVE (triggers download) ─────────────────────────────────
  doc.save(`Letema_ServiceOrder_${orderRecord.ref}.pdf`);
}

// =========================================================
// ===== AUTH — localStorage-backed user session =====
// =========================================================
let _userSession = null;

function updateUserNavUI(session) {
  // Update "Ingia" button to show the user's name with logout option
  const loginBtn  = document.getElementById('navLoginBtn');
  const ordersBtn = document.getElementById('navOrdersBtn');
  if (loginBtn && session) {
    loginBtn.textContent = `👤 ${(session.name || session.email || '').split(' ')[0]}`;
    loginBtn.title = 'Bonyeza kutoka — Log out';
    loginBtn.onclick = handleLogout;
  }
  if (ordersBtn) ordersBtn.style.display = session ? 'inline-flex' : 'none';
}

async function handleLogin() {
  const emailOrPhone = document.getElementById('loginEmail').value.trim();
  const pass  = document.getElementById('loginPassword').value;
  if (!emailOrPhone || !pass) { showToast('⚠️ Jaza barua pepe na nywila!', 'error'); return; }
  if (!emailOrPhone.includes('@')) {
    showToast('⚠️ Tafadhali tumia barua pepe (email) kuingia.', 'error');
    return;
  }

  if (!window.letemaSupabase) { showToast('⚠️ Mfumo unaanza. Jaribu tena baada ya sekunde 2.', 'error'); return; }

  const { data, error } = await window.letemaSupabase.signIn({ email: emailOrPhone, password: pass });
  if (error) {
    showToast('❌ Barua pepe au nywila si sahihi: ' + error.message, 'error');
    document.getElementById('loginPassword').value = '';
    return;
  }
  const u  = data.user;
  const md = u.user_metadata || {};
  _userSession = {
    name:  ((md.first_name || '') + ' ' + (md.last_name || '')).trim() || u.email,
    email: u.email, phone: md.phone || ''
  };
  closeModal('loginModal');
  updateUserNavUI(_userSession);
  showToast(`✅ Karibu tena, ${(md.first_name || u.email)}!`, 'success');
}

async function handleLogout() {
  if (window.letemaSupabase) await window.letemaSupabase.signOut();
  _userSession = null;
  const loginBtn  = document.getElementById('navLoginBtn');
  const ordersBtn = document.getElementById('navOrdersBtn');
  if (loginBtn) {
    loginBtn.textContent = '👤 Ingia';
    loginBtn.title = '';
    loginBtn.onclick = () => openModal('loginModal');
  }
  if (ordersBtn) ordersBtn.style.display = 'none';
  showToast('👋 Umetoka kwa mafanikio.', 'info');
}

async function handleRegister() {
  const firstName = document.getElementById('regFirstName').value.trim();
  const lastName  = document.getElementById('regLastName').value.trim();
  const phone     = document.getElementById('regPhone').value.trim();
  const email     = document.getElementById('regEmail').value.trim();
  const pass      = document.getElementById('regPassword').value;
  const agreed    = document.getElementById('agreeTerms').checked;

  if (!firstName || !phone || !email || !pass) { showToast('⚠️ Jaza taarifa zote!', 'error'); return; }
  if (!agreed) { showToast('⚠️ Kubali masharti ya matumizi!', 'error'); return; }
  if (!isValidPhone(phone)) { showToast('⚠️ Weka namba sahihi ya simu (+255 au 07/06...)', 'error'); return; }
  if (pass.length < 8) { showToast('⚠️ Nywila lazima iwe na herufi 8 au zaidi!', 'error'); return; }
  if (!/[A-Z]/.test(pass)) { showToast('⚠️ Nywila lazima iwe na herufi moja kubwa (A-Z)!', 'error'); return; }
  if (!/[0-9]/.test(pass)) { showToast('⚠️ Nywila lazima iwe na nambari moja (0-9)!', 'error'); return; }

  if (!window.letemaSupabase) { showToast('⚠️ Mfumo unaanza. Jaribu tena.', 'error'); return; }

  const { data, error } = await window.letemaSupabase.signUp({ email, password: pass, firstName, lastName, phone });
  if (error) { showToast('⚠️ ' + error.message, 'error'); return; }

  // If email confirmation is OFF, the user is logged in immediately.
  if (data.session) {
    _userSession = { name: firstName + ' ' + (lastName || ''), email, phone };
    closeModal('registerModal');
    updateUserNavUI(_userSession);
    showToast(`🎉 Karibu ${firstName}! Akaunti yako imefunguliwa.`, 'success');
  } else {
    closeModal('registerModal');
    showToast('📧 Akaunti imefunguliwa! Angalia barua pepe yako (' + email + ') kwa link ya uthibitisho.', 'success');
    // Show a richer in-app explainer too
    setTimeout(() => alert(
      '✅ Akaunti yako imefunguliwa!\n\n' +
      '📧 Tumetuma barua pepe ya uthibitisho kwa:\n   ' + email + '\n\n' +
      'Bonyeza link kwenye email kabla ya kuingia. Ukikosa email, angalia "Spam" folder au bonyeza "Tuma tena" kwenye fomu ya kuingia.'
    ), 400);
  }
}

// =========================================================
// ===== AUTH METHOD TABS / OTP / EMAIL VERIFICATION =====
// =========================================================
function switchAuthTab(method) {
  document.querySelectorAll('.auth-tab').forEach(t => t.classList.toggle('active', t.dataset.auth === method));
  document.querySelectorAll('.auth-pane').forEach(p => p.classList.toggle('active', p.id === `authPane_${method}`));
}

async function resendVerification() {
  const email = (document.getElementById('loginEmail').value || '').trim();
  if (!email || !email.includes('@')) { showToast('⚠️ Andika email kwanza kwenye fomu.', 'error'); return; }
  if (!window.letemaSupabase) return;
  const { error } = await window.letemaSupabase.resendVerificationEmail(email);
  if (error) showToast('⚠️ ' + error.message, 'error');
  else showToast('📨 Email ya uthibitisho imetumwa tena kwa ' + email, 'success');
}

// =====================================================
// ===== OTP brute-force state & timers (client side) =====
// =====================================================
let _otpResendTimer = null;   // setInterval handle for "resend in Xs"
let _otpExpiryTimer = null;   // setInterval handle for "code expires in X:YY"
const OTP_RESEND_COOLDOWN_S = 90;
const OTP_EXPIRY_S          = 600;  // Supabase default is ~10 min

function _otpStatusEl() { return document.getElementById('otpStatusBox'); }
function _otpStatusSet(html, kind) {
  const el = _otpStatusEl(); if (!el) return;
  const colors = { info:['#eef2ff','#c7d2fe','#3730a3'], warn:['#fef3c7','#fde68a','#92400e'], err:['#fee2e2','#fecaca','#991b1b'], ok:['#dcfce7','#bbf7d0','#166534'] };
  const c = colors[kind || 'info'];
  el.style.cssText = `display:block;background:${c[0]};border:1px solid ${c[1]};color:${c[2]};border-radius:var(--radius-md);padding:10px 12px;margin-top:10px;font-size:12.5px;line-height:1.5;`;
  el.innerHTML = html;
}
function _otpStatusClear() { const el = _otpStatusEl(); if (el) el.style.display = 'none'; }
function _fmtSecs(s) { s = Math.max(0,s|0); const m = (s/60)|0, r = s%60; return `${m}:${r.toString().padStart(2,'0')}`; }

function _startResendCountdown(seconds) {
  const btn = document.getElementById('otpEmailSendBtn'); if (!btn) return;
  if (_otpResendTimer) clearInterval(_otpResendTimer);
  let left = seconds;
  btn.disabled = true;
  const tick = () => {
    if (left <= 0) {
      clearInterval(_otpResendTimer); _otpResendTimer = null;
      btn.disabled = false; btn.textContent = '📨 Tuma Code Tena';
      return;
    }
    btn.textContent = `⏳ Tuma tena baada ya ${left}s`;
    left--;
  };
  tick(); _otpResendTimer = setInterval(tick, 1000);
}
function _startExpiryCountdown(seconds) {
  if (_otpExpiryTimer) clearInterval(_otpExpiryTimer);
  let left = seconds;
  const tick = () => {
    if (left <= 0) {
      clearInterval(_otpExpiryTimer); _otpExpiryTimer = null;
      _otpStatusSet('⏰ Code imekwisha. Bonyeza <b>Tuma Code Tena</b> kupata mpya.', 'err');
      const inp = document.getElementById('otpEmailCode'); if (inp) inp.disabled = true;
      return;
    }
    const inp = document.getElementById('otpEmailCode');
    if (inp && !inp.disabled) {
      _otpStatusSet(`📬 Code imetumwa. Itakwisha baada ya <b>${_fmtSecs(left)}</b>. Una majaribio <b>3</b> tu.`, 'info');
    }
    left--;
  };
  tick(); _otpExpiryTimer = setInterval(tick, 1000);
}

// All four handlers below ALWAYS gate through `recordOtpAttempt`, an RPC
// backed by SECURITY DEFINER Postgres logic. The server is the source of
// truth for "are you allowed to send/verify another code right now?".
// The client only renders the verdict.

function _otpLockMessage(state) {
  const until = state.locked_until ? new Date(state.locked_until) : null;
  const mins = until ? Math.max(1, Math.ceil((until - new Date()) / 60000)) : 60;
  return `🔒 Imefungwa na server kwa muda kutokana na majaribio mengi. Jaribu tena baada ya <b>~${mins} dakika</b>.`;
}

async function handleSendEmailOtp() {
  const email = (document.getElementById('otpEmail').value || '').trim().toLowerCase();
  if (!email || !email.includes('@')) { showToast('⚠️ Weka email sahihi.', 'error'); return; }
  if (!window.letemaSupabase) { showToast('⚠️ Mfumo unaanza...', 'error'); return; }

  // SERVER-ENFORCED gate: this RPC checks lockout AND per-window send rate
  // before allowing the SDK to actually request a code.
  const gate = await window.letemaSupabase.recordOtpAttempt(email, 'send', 'email');
  if (!gate.allowed) {
    _otpStatusSet(gate.locked ? _otpLockMessage(gate) : `⏳ Subiri kidogo kabla ya kuomba code nyingine.`, 'err');
    window.letemaSupabase.audit({ actor: email, action: 'auth.lockout', entity: 'auth', meta: { channel:'email', reason: gate.reason || 'rate_limited' } });
    return;
  }

  const btn = document.getElementById('otpEmailSendBtn');
  if (btn) { btn.disabled = true; btn.textContent = '⏳ Inatuma...'; }
  const { error } = await window.letemaSupabase.sendEmailOtp(email);
  if (error) {
    if (btn) { btn.disabled = false; btn.textContent = '📨 Tuma Code'; }
    _otpStatusSet('❌ ' + error.message, 'err');
    return;
  }
  await window.letemaSupabase.audit({ actor: email, action: 'auth.otp_send', entity: 'auth', entity_id: email, meta: { channel: 'email' } });
  document.getElementById('otpEmailStep2').style.display = 'block';
  const inp = document.getElementById('otpEmailCode'); if (inp) { inp.disabled = false; inp.value = ''; inp.focus(); }
  _startResendCountdown(OTP_RESEND_COOLDOWN_S);
  _startExpiryCountdown(OTP_EXPIRY_S);
  showToast('📬 Code imetumwa kwa ' + email, 'success');
}

async function handleVerifyEmailOtp() {
  const email = (document.getElementById('otpEmail').value || '').trim().toLowerCase();
  const token = (document.getElementById('otpEmailCode').value || '').trim();
  if (!/^\d{6}$/.test(token)) { _otpStatusSet('⚠️ Code lazima iwe tarakimu 6.', 'warn'); return; }

  // Pre-verify gate (server). Note this counts as a 'verify' attempt itself
  // so a script hammering the verify endpoint is rate-limited even before
  // hitting the Supabase auth endpoint.
  const pre = await window.letemaSupabase.recordOtpAttempt(email, 'verify_attempt', 'email');
  if (!pre.allowed) {
    _otpStatusSet(_otpLockMessage(pre), 'err');
    const inp = document.getElementById('otpEmailCode'); if (inp) inp.disabled = true;
    if (_otpExpiryTimer) clearInterval(_otpExpiryTimer);
    return;
  }

  const { data, error } = await window.letemaSupabase.verifyOtpCode({ email, token });
  if (error) {
    const post = await window.letemaSupabase.recordOtpAttempt(email, 'verify_fail', 'email');
    await window.letemaSupabase.audit({ actor: email, action: 'auth.otp_fail', entity: 'auth', entity_id: email, meta: { channel:'email', reason: error.message, fail_count: post.fail_count } });
    const remaining = Math.max(0, 3 - (post.fail_count||0));
    if (post.locked) {
      _otpStatusSet(_otpLockMessage(post), 'err');
      const inp = document.getElementById('otpEmailCode'); if (inp) inp.disabled = true;
      if (_otpExpiryTimer) clearInterval(_otpExpiryTimer);
    } else {
      _otpStatusSet(`❌ Code si sahihi. Una majaribio <b>${remaining}</b> tu kabla ya kufungiwa.`, 'err');
    }
    return;
  }

  if (_otpResendTimer) clearInterval(_otpResendTimer);
  if (_otpExpiryTimer) clearInterval(_otpExpiryTimer);
  _otpStatusClear();
  await window.letemaSupabase.recordOtpAttempt(email, 'verify_ok', 'email');
  await window.letemaSupabase.audit({ actor: email, action: 'auth.login', entity: 'auth', entity_id: email, meta: { channel:'otp_email' } });
  const u = data.user, md = (u && u.user_metadata) || {};
  _userSession = {
    name: ((md.first_name||'') + ' ' + (md.last_name||'')).trim() || u.email,
    email: u.email, phone: md.phone || ''
  };
  closeModal('loginModal');
  updateUserNavUI(_userSession);
  showToast('✅ Karibu, umeingia kwa mafanikio!', 'success');
}

async function handleSendPhoneOtp() {
  const phone = (document.getElementById('otpPhone').value || '').trim();
  if (!/^\+\d{8,15}$/.test(phone)) {
    showToast('⚠️ Tumia E.164 format: +2557XXXXXXXX', 'error'); return;
  }
  const gate = await window.letemaSupabase.recordOtpAttempt(phone, 'send', 'sms');
  if (!gate.allowed) {
    showToast(gate.locked ? '🔒 Server imefunga nambari hii kwa muda. Jaribu baadaye.' : '⏳ Subiri kidogo kabla ya kuomba code tena.', 'error');
    window.letemaSupabase.audit({ actor: phone, action: 'auth.lockout', entity: 'auth', meta: { channel:'sms', reason: gate.reason || 'rate_limited' } });
    return;
  }
  const { error } = await window.letemaSupabase.sendPhoneOtp(phone);
  if (error) { showToast('❌ ' + error.message + ' (Hakikisha SMS provider imewekwa kwenye Supabase.)', 'error'); return; }
  await window.letemaSupabase.audit({ actor: phone, action: 'auth.otp_send', entity: 'auth', entity_id: phone, meta: { channel: 'sms' } });
  document.getElementById('otpPhoneStep2').style.display = 'block';
  showToast('📲 SMS code imetumwa kwa ' + phone, 'success');
}

async function handleVerifyPhoneOtp() {
  const phone = (document.getElementById('otpPhone').value || '').trim();
  const token = (document.getElementById('otpPhoneCode').value || '').trim();
  if (!/^\d{6}$/.test(token)) { showToast('⚠️ Code lazima iwe tarakimu 6.', 'error'); return; }
  const pre = await window.letemaSupabase.recordOtpAttempt(phone, 'verify_attempt', 'sms');
  if (!pre.allowed) {
    showToast(pre.locked ? '🔒 Imefungwa na server kwa muda.' : '⏳ Punguza majaribio.', 'error');
    return;
  }
  const { data, error } = await window.letemaSupabase.verifyOtpCode({ phone, token });
  if (error) {
    const post = await window.letemaSupabase.recordOtpAttempt(phone, 'verify_fail', 'sms');
    await window.letemaSupabase.audit({ actor: phone, action: 'auth.otp_fail', entity: 'auth', entity_id: phone, meta: { channel:'sms', reason: error.message, fail_count: post.fail_count } });
    showToast(post.locked ? '🔒 Majaribio yamekwisha. Imefungwa.' : ('❌ Code si sahihi: ' + error.message), 'error');
    return;
  }
  await window.letemaSupabase.recordOtpAttempt(phone, 'verify_ok', 'sms');
  await window.letemaSupabase.audit({ actor: phone, action: 'auth.login', entity: 'auth', entity_id: phone, meta: { channel:'otp_sms' } });
  const u = data.user;
  _userSession = { name: u.phone || phone, email: u.email || '', phone: u.phone || phone };
  closeModal('loginModal');
  updateUserNavUI(_userSession);
  showToast('✅ Umeingia kwa mafanikio!', 'success');
}

// =========================================================
// ===== CUSTOMER ORDER HISTORY =====
// =========================================================
async function openOrderHistory() {
  openModal('orderHistoryModal');
  const body = document.getElementById('orderHistoryBody');
  body.innerHTML = '<div style="text-align:center;padding:40px 20px;color:var(--gray-500);">⏳ Inapakia maagizo yako...</div>';
  if (!window.letemaSupabase) return;
  const orders = await window.letemaSupabase.fetchUserOrders();
  if (!orders.length) {
    body.innerHTML = `
      <div style="text-align:center;padding:40px 20px;">
        <div style="font-size:48px;margin-bottom:12px;">🛍️</div>
        <div style="font-family:var(--font-head);font-weight:800;color:var(--navy);margin-bottom:6px;">Bado huna oda yoyote</div>
        <div style="font-size:13px;color:var(--gray-500);">Anza kununua na utaona maagizo yako hapa.</div>
      </div>`;
    return;
  }
  body.innerHTML = orders.map(o => {
    const itemsTxt = (o.items || []).map(i => `• ${escapeHTML(i.name)} ×${i.qty || 1}`).join('<br>') || '—';
    const ts = new Date(o.created_at).toLocaleString('en-TZ', { dateStyle:'medium', timeStyle:'short' });
    return `
      <div class="cust-order-row">
        <div class="cor-head">
          <div>
            <div class="cor-ref">${escapeHTML(o.ref)}</div>
            <div class="cor-meta">${ts} • TZS ${(o.total || 0).toLocaleString()}</div>
          </div>
          <div style="font-size:11px;color:var(--gray-500);text-transform:uppercase;font-weight:700;">${escapeHTML(o.type || 'product')}</div>
        </div>
        ${renderOrderTracker(o.status)}
        <div class="cor-items">${itemsTxt}</div>
        <div id="tl_${escapeAttr(o.ref)}" class="cor-timeline" style="margin-top:10px;border-top:1px dashed var(--gray-200);padding-top:10px;font-size:12px;color:var(--gray-500);">⏳ Inapakia ratiba ya delivery...</div>
      </div>
    `;
  }).join('');

  // Lazy-load timelines per order
  for (const o of orders) {
    window.letemaSupabase.fetchOrderStatusEvents(o.ref).then(events => {
      const el = document.getElementById('tl_' + o.ref);
      if (!el) return;
      el.innerHTML = renderTimelineHTML(events);
    });
  }
}

// Shared timeline renderer (admin + customer)
function renderTimelineHTML(events) {
  if (!events || !events.length) {
    return '<div style="color:var(--gray-400);">Hakuna events bado.</div>';
  }
  const labels = { new:'🆕 Placed', pending:'🆕 Placed', confirmed:'✅ Confirmed', paid:'💰 Paid', shipped:'🚚 Shipped', delivered:'📦 Delivered', cancelled:'❌ Cancelled' };
  return '<div style="display:flex;flex-direction:column;gap:6px;">' +
    events.map(ev => {
      const t = new Date(ev.changed_at).toLocaleString('en-TZ', { dateStyle:'medium', timeStyle:'short' });
      const who = ev.changed_by ? ` <span style="color:var(--gray-400);">· ${escapeHTML(ev.changed_by)}</span>` : '';
      const note = ev.notes ? ` <span style="color:var(--gray-500);">— ${escapeHTML(ev.notes)}</span>` : '';
      return `<div style="display:flex;gap:8px;align-items:flex-start;">
        <div style="min-width:14px;color:var(--navy);">●</div>
        <div><b>${labels[ev.status] || ev.status}</b> <span style="color:var(--gray-500);">${t}</span>${who}${note}</div>
      </div>`;
    }).join('') + '</div>';
}

// =========================================================
// ===== INVOICE PDF (admin) =====
// =========================================================
function _legacyGenerateInvoicePDF(ref, _settings, _invNum, _opts) {
  const _mode = (_opts && _opts.mode) || 'save'; // 'save' | 'preview'
  const order = adminOrders.find(o => o.ref === ref);
  if (!order) { showToast('⚠️ Oda haikupatikana: ' + ref, 'error'); return; }
  if (!window.jspdf || !window.jspdf.jsPDF) { showToast('⚠️ PDF library haijapakiwa.', 'error'); return; }
  try {
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF({ unit: 'mm', format: 'a4' });
    const pageW = doc.internal.pageSize.getWidth();

    // Header band
    doc.setFillColor(0, 48, 135);
    doc.rect(0, 0, pageW, 28, 'F');
    doc.setFillColor(255, 198, 0);
    doc.rect(0, 28, pageW, 2, 'F');
    doc.setTextColor(255, 255, 255);
    doc.setFont('helvetica', 'bold'); doc.setFontSize(20);
    doc.text((_settings && _settings.company_name) || 'LETEMA STATIONERY', 14, 14);
    doc.setFontSize(9); doc.setFont('helvetica', 'normal');
    doc.text((_settings && _settings.company_tagline) || 'Internet Café & Office Supplies — Mbeya, Tanzania', 14, 20);
    doc.text((_settings && _settings.contact_line) || '+255 620 642 652  •  letemaalexander3002@gmail.com', 14, 25);

    // Invoice title block
    doc.setTextColor(0, 48, 135);
    doc.setFont('helvetica', 'bold'); doc.setFontSize(22);
    doc.text('INVOICE', pageW - 14, 45, { align: 'right' });
    doc.setFont('helvetica', 'normal'); doc.setFontSize(10);
    doc.setTextColor(80, 80, 80);
    doc.text(`Invoice #: ${_invNum || order.ref}`, pageW - 14, 52, { align: 'right' });
    doc.text(`Date: ${order.timestamp || new Date().toLocaleString('en-TZ')}`, pageW - 14, 57, { align: 'right' });
    doc.text(`Status: ${(order.status || 'new').toUpperCase()}`, pageW - 14, 62, { align: 'right' });
    if (order.txnId) doc.text(`Txn: ${order.txnId}`, pageW - 14, 67, { align: 'right' });

    // Bill-to
    doc.setFont('helvetica', 'bold'); doc.setFontSize(11);
    doc.setTextColor(0, 48, 135);
    doc.text('BILL TO', 14, 45);
    doc.setFont('helvetica', 'normal'); doc.setFontSize(10);
    doc.setTextColor(40, 40, 40);
    doc.text(order.customer || '—', 14, 52);
    if (order.phone)   doc.text('Phone: ' + order.phone, 14, 57);
    if (order.email)   doc.text('Email: ' + order.email, 14, 62);
    if (order.address && order.address !== '—') doc.text('Address: ' + order.address, 14, 67);

    // Items table
    const items = (order.items && order.items.length)
      ? order.items
      : [{ name: order.type === 'service' ? '🛠️ Huduma' : '—', qty: 1, price: order.total || 0 }];
    const body = items.map((i, idx) => [
      String(idx + 1),
      i.name,
      String(i.qty || 1),
      'TZS ' + (i.price || 0).toLocaleString(),
      'TZS ' + ((i.price || 0) * (i.qty || 1)).toLocaleString()
    ]);

    doc.autoTable({
      startY: 78,
      head: [['#', 'Description', 'Qty', 'Unit Price', 'Line Total']],
      body,
      theme: 'striped',
      headStyles: { fillColor: [0, 48, 135], textColor: 255, fontStyle: 'bold', halign: 'center' },
      styles: { fontSize: 9.5, cellPadding: 3 },
      columnStyles: {
        0: { halign: 'center', cellWidth: 12 },
        2: { halign: 'center', cellWidth: 18 },
        3: { halign: 'right', cellWidth: 35 },
        4: { halign: 'right', cellWidth: 38 }
      },
      margin: { left: 14, right: 14 }
    });

    // Totals
    let y = doc.lastAutoTable.finalY + 6;
    const labelX = pageW - 70, valX = pageW - 14;
    doc.setFontSize(10); doc.setTextColor(40, 40, 40);
    doc.setFont('helvetica', 'normal');
    doc.text('Subtotal:', labelX, y); doc.text('TZS ' + (order.subtotal || 0).toLocaleString(), valX, y, { align: 'right' });
    y += 6;
    doc.text(((_settings && _settings.vat_label) || 'VAT (18%)') + ':', labelX, y); doc.text('TZS ' + (order.vat || 0).toLocaleString(), valX, y, { align: 'right' });
    y += 6;
    doc.setDrawColor(0, 48, 135); doc.line(labelX, y, valX, y);
    y += 6;
    doc.setFont('helvetica', 'bold'); doc.setFontSize(13); doc.setTextColor(0, 48, 135);
    doc.text('TOTAL:', labelX, y); doc.text('TZS ' + (order.total || 0).toLocaleString(), valX, y, { align: 'right' });

    // Status tracker (textual) — placed/confirmed/paid/shipped/delivered
    y += 14;
    doc.setFontSize(10); doc.setTextColor(0, 48, 135); doc.setFont('helvetica', 'bold');
    doc.text('Order Lifecycle', 14, y); y += 5;
    const cur = (order.status === 'pending' ? 'new' : order.status) || 'new';
    const idx = ORDER_LIFECYCLE.findIndex(s => s.key === cur);
    const trackerStr = ORDER_LIFECYCLE.map((s, i) => {
      const mark = (cur === 'cancelled') ? '✕' : (i < idx ? '✓' : (i === idx ? '●' : '○'));
      return `${mark} ${s.label}`;
    }).join('   →   ');
    doc.setFont('helvetica', 'normal'); doc.setFontSize(9.5); doc.setTextColor(60, 60, 60);
    doc.text(cur === 'cancelled' ? '✕ CANCELLED' : trackerStr, 14, y);

    // Footer
    const fy = doc.internal.pageSize.getHeight() - 18;
    doc.setDrawColor(220, 220, 220); doc.line(14, fy - 4, pageW - 14, fy - 4);
    doc.setFontSize(8); doc.setTextColor(120, 120, 120);
    doc.text(((_settings && _settings.footer_note) || 'Asante kwa kununua na Letema Stationery!') + ' Questions? hello@letema.co.tz', pageW / 2, fy, { align: 'center' });
    doc.text('This invoice was generated electronically and is valid without a signature.', pageW / 2, fy + 4, { align: 'center' });

    if (_mode === 'preview') {
      const blob = doc.output('blob');
      return URL.createObjectURL(blob);
    }
    doc.save(`Letema_Invoice_${order.ref}.pdf`);
    showToast('📑 Invoice imetayarishwa.', 'success');
  } catch (e) {
    console.error('Invoice error:', e);
    showToast('⚠️ Invoice haijaweza kutengenezwa: ' + e.message, 'error');
  }
}

// =========================================================
// ===== CSV BULK IMPORT (products / prices / stock) =====
// =========================================================
let _csvParsedRows = null;

function openCsvImport() {
  const f = document.getElementById('csvImportForm');
  if (f) f.style.display = (f.style.display === 'none' || !f.style.display) ? 'block' : 'none';
}

function csvParseLine(line) {
  // Minimal RFC-4180-ish parser: handles quoted fields and embedded commas.
  const out = []; let cur = '', inQ = false;
  for (let i = 0; i < line.length; i++) {
    const ch = line[i];
    if (inQ) {
      if (ch === '"' && line[i + 1] === '"') { cur += '"'; i++; }
      else if (ch === '"') { inQ = false; }
      else cur += ch;
    } else {
      if (ch === ',') { out.push(cur); cur = ''; }
      else if (ch === '"') { inQ = true; }
      else cur += ch;
    }
  }
  out.push(cur);
  return out.map(s => s.trim());
}

// =====================================================
// Per-row CSV validation + dry-run import preview.
// Validates fields, then queries existing products and classifies each
// row as INSERT / UPDATE / SKIP / ERROR. Upload is BLOCKED until preview ran.
// =====================================================
const _CSV_KNOWN_HEADERS = ['legacy_id','name','price','category','icon','badge','description','stock_quantity','is_active'];
const _CSV_REQUIRED      = ['name','price','category'];
let _csvPreviewReady = false;

function _validateCsvRow(r, idx) {
  const errors = [];
  if (!r.name || !String(r.name).trim()) errors.push('name ni tupu');
  if (r.name && String(r.name).length > 200) errors.push('name ni ndefu sana (>200)');
  const priceNum = Number(r.price);
  if (r.price === '' || r.price == null) errors.push('price haijatolewa');
  else if (!Number.isFinite(priceNum) || priceNum < 0) errors.push('price si nambari halali (' + r.price + ')');
  if (!r.category || !String(r.category).trim()) errors.push('category ni tupu');
  if (r.legacy_id && !/^\d+$/.test(String(r.legacy_id).trim())) errors.push('legacy_id si integer (' + r.legacy_id + ')');
  if (r.stock_quantity && !/^-?\d+$/.test(String(r.stock_quantity).trim())) errors.push('stock_quantity si integer (' + r.stock_quantity + ')');
  if (r.is_active && !['true','false','1','0',''].includes(String(r.is_active).toLowerCase())) errors.push('is_active si bool (' + r.is_active + ')');
  return errors.length ? { rowNumber: idx + 2, errors, raw: r } : null; // +2 = +1 for header, +1 for 1-index
}

function handleCsvFile(input) {
  const file = input.files && input.files[0];
  if (!file) return;
  _csvPreviewReady = false;
  document.getElementById('csvUploadBtn').disabled = true;
  document.getElementById('csvDiffSummary').style.display = 'none';
  const reader = new FileReader();
  reader.onload = (e) => {
    const text = String(e.target.result || '').replace(/\r\n?/g, '\n').trim();
    const lines = text.split('\n').filter(Boolean);
    if (lines.length < 2) { showToast('⚠️ CSV haina data.', 'error'); return; }
    const headers = csvParseLine(lines[0]).map(h => h.toLowerCase().trim());
    const missing = _CSV_REQUIRED.filter(r => !headers.includes(r));
    const unknown = headers.filter(h => !_CSV_KNOWN_HEADERS.includes(h));
    if (missing.length) {
      showToast('⚠️ CSV inakosa columns: ' + missing.join(', '), 'error');
      return;
    }
    const rows = [];
    const rowErrors = [];
    for (let i = 1; i < lines.length; i++) {
      const cells = csvParseLine(lines[i]);
      if (!cells.length || (cells.length === 1 && !cells[0])) continue;
      const r = {}; headers.forEach((h, idx) => r[h] = cells[idx] != null ? cells[idx] : '');
      // Field-count mismatch is itself an error worth surfacing.
      if (cells.length !== headers.length) {
        rowErrors.push({ rowNumber: i + 1, errors: ['idadi ya field haifanani na header (' + cells.length + ' vs ' + headers.length + ')'], raw: r });
      }
      const v = _validateCsvRow(r, i - 1);
      if (v) rowErrors.push(v);
      rows.push({
        legacy_id:      r.legacy_id   ? parseInt(r.legacy_id, 10)   : null,
        name:           r.name,
        price:          parseInt(r.price || '0', 10),
        category:       r.category,
        icon:           r.icon || '📦',
        badge:          r.badge || null,
        description:    r.description || '',
        stock_quantity: r.stock_quantity ? parseInt(r.stock_quantity, 10) : 999,
        is_active:      r.is_active != null && r.is_active !== '' ? (r.is_active === 'true' || r.is_active === '1') : true,
        _row:           i + 1
      });
    }
    _csvParsedRows = rows;

    // Render plain preview table
    const previewMax = Math.min(rows.length, 8);
    let html = '<table><thead><tr>';
    ['#row','legacy_id','name','price','category','stock_quantity'].forEach(h => html += `<th>${h}</th>`);
    html += '</tr></thead><tbody>';
    for (let i = 0; i < previewMax; i++) {
      const r = rows[i];
      html += `<tr><td>${r._row}</td><td>${r.legacy_id ?? ''}</td><td>${escapeHTML(r.name)}</td><td>${r.price}</td><td>${escapeHTML(r.category)}</td><td>${r.stock_quantity}</td></tr>`;
    }
    html += '</tbody></table>';
    document.getElementById('csvPreview').innerHTML = html;

    // Validation block
    const valEl = document.getElementById('csvValidation');
    let vHtml = `📄 Rows zilizosomwa: <b>${rows.length}</b> · headers: <code>${escapeHTML(headers.join(','))}</code>`;
    if (unknown.length) vHtml += `<div style="color:#92400e;background:#fef3c7;border:1px solid #fde68a;border-radius:6px;padding:6px 8px;margin-top:6px;">⚠️ Headers zisizotambulika (zitaachwa): <code>${escapeHTML(unknown.join(', '))}</code></div>`;
    if (rowErrors.length) {
      vHtml += `<div style="color:#991b1b;background:#fee2e2;border:1px solid #fecaca;border-radius:6px;padding:8px;margin-top:6px;"><b>❌ ${rowErrors.length} row(s) zenye matatizo:</b><div style="max-height:160px;overflow:auto;margin-top:4px;font-size:11.5px;">`
        + rowErrors.slice(0, 50).map(re => `<div>row <b>${re.rowNumber}</b>: ${escapeHTML(re.errors.join('; '))}</div>`).join('')
        + (rowErrors.length > 50 ? `<div>… na nyingine ${rowErrors.length - 50}</div>` : '')
        + `</div></div>`;
    } else {
      vHtml += `<div style="color:#166534;margin-top:6px;">✅ Rows zote zimepita validation ya field.</div>`;
    }
    vHtml += `<div style="margin-top:8px;"><button class="admin-btn primary" onclick="previewCsvImport()" ${rowErrors.length === rows.length ? 'disabled' : ''}>🔍 Onesha Preview ya Insert/Update/Skip</button></div>`;
    valEl.innerHTML = vHtml;

    // Cache so previewCsvImport can re-emit them
    _csvParsedRows._rowErrors = rowErrors;

    document.getElementById('csvSummary').textContent = '';
    // Upload still disabled; user must run preview first.
  };
  reader.readAsText(file, 'utf-8');
}

// Dry-run: query existing products, classify each row, render summary.
async function previewCsvImport() {
  if (!_csvParsedRows || !_csvParsedRows.length) { showToast('⚠️ Hakuna rows.', 'error'); return; }
  if (!window.letemaSupabase) { showToast('⚠️ Mfumo haujatayari.', 'error'); return; }
  const c = window.letemaSupabase.getClient();
  if (!c) { showToast('⚠️ Supabase haijapakiwa.', 'error'); return; }
  const { data: existing, error } = await c.from('products').select('*');
  if (error) { showToast('⚠️ ' + error.message, 'error'); return; }
  const norm = s => String(s || '').trim().toLowerCase();
  const keyOf = r => norm(r.name) + '||' + norm(r.category);
  const byKey = new Map();
  (existing || []).forEach(p => byKey.set(keyOf(p), p));
  const tracked = ['name','price','category','icon','badge','description','stock_quantity','is_active'];

  const inserts = [], updates = [], skips = [];
  for (const r of _csvParsedRows) {
    const found = byKey.get(keyOf(r));
    if (!found) { inserts.push(r); continue; }
    const diff = {};
    for (const f of tracked) {
      const a = (r[f] === undefined || r[f] === null) ? null : r[f];
      const b = (found[f] === undefined || found[f] === null) ? null : found[f];
      if (String(a) !== String(b) && a !== null) diff[f] = { from: b, to: a };
    }
    if (Object.keys(diff).length === 0) skips.push(r);
    else updates.push({ row: r, diff, existing_id: found.id });
  }
  const errCount = (_csvParsedRows._rowErrors || []).length;

  document.getElementById('csvDiffSummary').style.display = 'block';
  document.getElementById('csvDiffStats').innerHTML = `
    <div style="background:#dcfce7;border:1px solid #bbf7d0;border-radius:6px;padding:6px 10px;">➕ Insert: <b>${inserts.length}</b></div>
    <div style="background:#dbeafe;border:1px solid #bfdbfe;border-radius:6px;padding:6px 10px;">✏️ Update: <b>${updates.length}</b></div>
    <div style="background:#f1f5f9;border:1px solid var(--gray-200);border-radius:6px;padding:6px 10px;">⏭️ Skip (no change): <b>${skips.length}</b></div>
    ${errCount ? `<div style="background:#fee2e2;border:1px solid #fecaca;border-radius:6px;padding:6px 10px;">❌ Validation errors: <b>${errCount}</b></div>` : ''}
  `;
  const fmtList = (arr, mapper) => arr.length
    ? `<div style="max-height:160px;overflow:auto;">${arr.slice(0,200).map(mapper).join('')}${arr.length > 200 ? `<div>… na nyingine ${arr.length - 200}</div>` : ''}</div>`
    : '<div style="color:var(--gray-400);">—</div>';
  document.getElementById('csvDiffLists').innerHTML = `
    <div style="margin-bottom:8px;"><b>➕ Insert (${inserts.length})</b>${fmtList(inserts, r => `<div>• ${escapeHTML(r.name)} <span style="color:var(--gray-400);">(${escapeHTML(r.category)}, TZS ${r.price})</span></div>`)}</div>
    <div style="margin-bottom:8px;"><b>✏️ Update (${updates.length})</b>${fmtList(updates, u => `<div>• ${escapeHTML(u.row.name)} → ${Object.keys(u.diff).map(k => `<code>${k}</code>: ${escapeHTML(String(u.diff[k].from))} → ${escapeHTML(String(u.diff[k].to))}`).join(', ')}</div>`)}</div>
    <div><b>⏭️ Skip (${skips.length})</b>${fmtList(skips, r => `<div>• ${escapeHTML(r.name)}</div>`)}</div>
  `;
  _csvPreviewReady = true;
  const btn = document.getElementById('csvUploadBtn');
  btn.disabled = (inserts.length + updates.length) === 0;
  btn.textContent = `📤 Thibitisha & Pakia (${inserts.length + updates.length} mabadiliko)`;
}

async function uploadCsvToSupabase() {
  if (!_csvPreviewReady) { showToast('⚠️ Endesha Preview kwanza.', 'error'); return; }
  if (!_csvParsedRows || !_csvParsedRows.length) { showToast('⚠️ Hakuna data ya kupakia.', 'error'); return; }
  if (!window.letemaSupabase) { showToast('⚠️ Mfumo haujatayari.', 'error'); return; }
  const btn = document.getElementById('csvUploadBtn');
  btn.disabled = true; btn.textContent = '⏳ Inalinganisha...';
  const res = await window.letemaSupabase.smartUpsertProducts(_csvParsedRows);
  btn.disabled = false; btn.textContent = '📤 Pakia Tena';

  const sumEl = document.getElementById('csvSummary');
  if (sumEl) {
    let html = `📊 Inserted: <b>${res.inserted||0}</b> · Updated: <b>${res.updated||0}</b> · Skipped (sawa kabisa): <b>${res.skipped||0}</b>`;
    if (res.errors && res.errors.length) html += ` · ⚠️ Errors: <b>${res.errors.length}</b>`;
    if (res.updatedRows && res.updatedRows.length) {
      html += `<details style="margin-top:8px;"><summary style="cursor:pointer;color:var(--navy);">Vipi vimebadilika? (${res.updatedRows.length})</summary><div style="font-size:12px;margin-top:6px;max-height:160px;overflow:auto;">`;
      res.updatedRows.forEach(u => { html += `<div>• <b>${escapeHTML(u.name)}</b> → ${u.changed.join(', ')}</div>`; });
      html += '</div></details>';
    }
    sumEl.innerHTML = html;
  }
  if (res.errors && res.errors.length) showToast('⚠️ Errors: ' + res.errors[0], 'error');
  else showToast(`✅ ${res.inserted||0} mpya, ${res.updated||0} zimesasishwa, ${res.skipped||0} hazikuhitaji mabadiliko.`, 'success');

  window.letemaSupabase.audit({
    actor: 'admin', action: 'csv.import', entity: 'product',
    meta: { inserted: res.inserted||0, updated: res.updated||0, skipped: res.skipped||0,
            errors: (res.errors||[]).slice(0,5),
            updatedRows: (res.updatedRows||[]).slice(0,50) }
  });
  if (typeof renderAdminProducts === 'function') {
    PRODUCTS = await window.letemaSupabase.fetchProducts();
    renderAdminProducts();
  }
}

function downloadCsvTemplate() {
  const csv =
    'legacy_id,name,price,category,icon,badge,description,stock_quantity,is_active\n' +
    '101,Kalamu ya Bluu (Box 10),3500,shule,✏️,hot,Kalamu ya bluu ya ubora wa juu — box ya 10,200,true\n' +
    ',Karatasi A4 (Ream),12000,ofisi,📄,,Ream ya karatasi A4 — sheets 500,150,true\n';
  const blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'letema_products_template.csv';
  a.click();
  setTimeout(() => URL.revokeObjectURL(a.href), 1500);
}

// =========================================================
// ===== SERVICE FILE UPLOAD HANDLER =====
// =========================================================
function handleSvcFileSelect(input) {
  const label = document.getElementById('svcFileUploadLabel');
  const title = document.getElementById('svcFileUploadTitle');
  const sub   = document.getElementById('svcFileUploadSub');
  const badge = document.getElementById('svcFileUploadBadge');

  if (input.files && input.files.length > 0) {
    const file   = input.files[0];
    const sizeMB = (file.size / (1024 * 1024)).toFixed(2);
    const ext    = file.name.split('.').pop().toUpperCase();
    label.classList.add('has-file');
    title.textContent = file.name.length > 32 ? file.name.slice(0, 30) + '…' : file.name;
    sub.textContent   = `${ext} • ${sizeMB} MB — Faili limepakuliwa ✅`;
    badge.textContent = '✓ Tayari';
    showToast(`📎 "${file.name}" imepakiwa. Kumbuka kuisend kwa WhatsApp!`, 'info');
  } else {
    label.classList.remove('has-file');
    title.textContent = 'Chagua Faili au Drag & Drop';
    sub.textContent   = 'PDF, Picha, Word, Excel — hadi 20MB';
    badge.textContent = 'Pakia';
  }
}

// =========================================================
// ===== SPINNER =====
// =========================================================
function showSpinner() {
  document.getElementById('spinnerOverlay').classList.add('active');
}
function hideSpinner() {
  document.getElementById('spinnerOverlay').classList.remove('active');
}

// =========================================================
// ===== FIELD VALIDATION HELPERS =====
// =========================================================
function showFieldError(inputId, errId) {
  const inp = document.getElementById(inputId);
  const err = document.getElementById(errId);
  inp.classList.add('field-invalid');
  if (err) err.style.display = 'flex';
  inp.scrollIntoView({ behavior:'smooth', block:'center' });
}

function clearFieldError(input) {
  input.classList.remove('field-invalid');
  input.classList.add('field-valid');
  const errId = input.id + 'Err';
  const err = document.getElementById(errId);
  if (err) err.style.display = 'none';
}

// =========================================================
// ===== SECURITY: XSS SANITIZATION =====
// =========================================================
function sanitizeInput(str) {
  return String(str)
    .replace(/&/g,  '&amp;')
    .replace(/</g,  '&lt;')
    .replace(/>/g,  '&gt;')
    .replace(/"/g,  '&quot;')
    .replace(/'/g,  '&#x27;')
    .replace(/\//g, '&#x2F;');
}

// For safe insertion into HTML attribute strings
function escapeAttr(str) {
  return String(str).replace(/['"<>&]/g, c => ({'\'':'&#x27;','"':'&quot;','<':'&lt;','>':'&gt;','&':'&amp;'}[c]));
}

// For safe insertion into innerHTML (display only)
function escapeHTML(str) {
  const d = document.createElement('div');
  d.appendChild(document.createTextNode(str));
  return d.innerHTML;
}

// Apply XSS guards to all form inputs on page load
function attachXSSGuards() {
  document.querySelectorAll('.form-input').forEach(inp => {
    if (inp.tagName === 'SELECT') return;
    inp.addEventListener('paste', function(e) {
      // Allow paste but strip dangerous chars after a tick
      setTimeout(() => {
        this.value = this.value.replace(/<script[\s\S]*?>[\s\S]*?<\/script>/gi, '');
      }, 0);
    });
  });
}

// =========================================================
// ===== HELPERS =====
// =========================================================
function isValidPhone(phone) {
  return /^(\+255|0)[67]\d{8}$/.test(phone.replace(/[\s-]/g, ''));
}

function togglePassword(id) {
  const inp = document.getElementById(id);
  inp.type = inp.type === 'password' ? 'text' : 'password';
}

function scrollToProducts() {
  document.getElementById('productsSection').scrollIntoView({behavior:'smooth'});
}
function scrollToServices() {
  document.getElementById('servicesSection').scrollIntoView({behavior:'smooth'});
}

// =========================================================
// ===== MODAL HELPERS =====
// =========================================================
let _openModalCount = 0;
function openModal(id) {
  document.getElementById(id).classList.add('open');
  _openModalCount++;
  document.body.style.overflow = 'hidden';
}
function closeModal(id) {
  document.getElementById(id).classList.remove('open');
  _openModalCount = Math.max(0, _openModalCount - 1);
  if (_openModalCount === 0) document.body.style.overflow = '';
}
function closeModalOutside(e, id) {
  if (e.target.id === id) closeModal(id);
}

// =========================================================
// ===== TOAST =====
// =========================================================
function showToast(msg, type = 'info') {
  const container = document.getElementById('toastContainer');
  const icons = {success:'✅', error:'❌', info:'ℹ️'};
  const toast = document.createElement('div');
  toast.className = `toast ${type}`;
  toast.innerHTML = `<span class="toast-icon">${icons[type] || 'ℹ️'}</span><span>${msg}</span>`;
  container.appendChild(toast);
  setTimeout(() => toast.classList.add('show'), 50);
  setTimeout(() => {
    toast.classList.remove('show');
    setTimeout(() => toast.remove(), 400);
  }, 3500);
}

// =========================================================
// ===== ADMIN LOGIN & DASHBOARD =====
// =========================================================
function openAdminLogin() {
  document.getElementById('adminLoginOverlay').classList.add('open');
  setTimeout(() => {
    const inp = document.getElementById('adminPassInput');
    if (inp && !inp.disabled) inp.focus();
  }, 200);
  // Auto-resume lockout countdown if still locked from a previous session
  try { _checkAndApplyAdminLockoutOnOpen && _checkAndApplyAdminLockoutOnOpen(); } catch(e) {}
}
function closeAdminLogin() {
  document.getElementById('adminLoginOverlay').classList.remove('open');
  document.getElementById('adminPassInput').value = '';
  document.getElementById('adminLoginErr').style.display = 'none';
  const at = document.getElementById('adminLoginAttempts'); if (at) at.style.display = 'none';
}
// adminLogin is defined later with runtime password support (see Setup section)
// Allow Enter key on admin password input (runs after DOM is ready)
document.addEventListener('DOMContentLoaded', () => {
  const passInput = document.getElementById('adminPassInput');
  if (passInput) passInput.addEventListener('keydown', e => { if (e.key === 'Enter') adminLogin(); });
  updateAdminStockBadge();
});
function closeAdminDashboard() {
  document.getElementById('adminDashboard').classList.remove('open');
  // PROTECTED VIEW: enforce display:none kupitia inline style pia (zaidi ya CSS class)
  document.getElementById('adminDashboard').style.display = 'none';
  adminLoggedIn = false;
  // Destroy charts to avoid canvas reuse errors
  if (chartDayInstance) { chartDayInstance.destroy(); chartDayInstance = null; }
  if (chartRevInstance) { chartRevInstance.destroy(); chartRevInstance = null; }
  if (chartTopInstance) { chartTopInstance.destroy(); chartTopInstance = null; }
}

// ===== LOGOUT ADMIN: ficha panel kabisa na rudisha hali ya mteja =====
function logoutAdmin() {
  if (!confirm('Una uhakika unataka ku-logout kwenye Admin Panel?')) return;
  try { logAdminActivity && logAdminActivity('logout', 'success'); } catch(e) {}
  closeAdminDashboard();
  // Ficha pia kitufe cha admin kwenye nav (kama kilikuwa kimefichuliwa)
  const navBtn = document.getElementById('adminNavBtn');
  if (navBtn) navBtn.style.display = 'none';
  // Reset Easter Egg counter
  logoClickCount = 0;
  if (logoClickTimer) { clearTimeout(logoClickTimer); logoClickTimer = null; }
  try { showToast && showToast('🔒 Umetoka kwenye Admin Panel'); } catch(e) {}
}

// ===== EASTER EGG: bonyeza Logo ya AEL mara 5 mfululizo kufungua Admin =====
let logoClickCount = 0;
let logoClickTimer = null;
const LOGO_CLICKS_REQUIRED = 5;
const LOGO_CLICK_WINDOW_MS = 2500; // muda wa juu kati ya mibofyo

function handleLogoClick() {
  // Tabia ya kawaida ya wateja: bonyeza logo => scroll juu
  window.scrollTo({ top: 0, behavior: 'smooth' });

  logoClickCount++;
  if (logoClickTimer) clearTimeout(logoClickTimer);
  logoClickTimer = setTimeout(() => { logoClickCount = 0; }, LOGO_CLICK_WINDOW_MS);

  // Hint kidogo baada ya bofyo ya 3 (lakini bila kufichua siri)
  if (logoClickCount === 3) {
    try { showToast && showToast('✨'); } catch(e) {}
  }

  if (logoClickCount >= LOGO_CLICKS_REQUIRED) {
    logoClickCount = 0;
    if (logoClickTimer) { clearTimeout(logoClickTimer); logoClickTimer = null; }
    try { logAdminActivity && logAdminActivity('easter_egg_unlock', 'info'); } catch(e) {}
    // PROTECTED: fungua login overlay tu — admin panel haitafunguliwa mpaka password sahihi
    openAdminLogin();
  }
}

// ===== PROTECTED VIEW ENFORCEMENT =====
// Hakikisha admin overlay imefichwa kabisa wakati wa kuanza app, hata kama CSS imebadilishwa
document.addEventListener('DOMContentLoaded', () => {
  const dash = document.getElementById('adminDashboard');
  if (dash && !adminLoggedIn) {
    dash.style.display = 'none';
    dash.classList.remove('open');
  }
  const navBtn = document.getElementById('adminNavBtn');
  if (navBtn) navBtn.style.display = 'none';
});
function switchAdminTab(tab) {
  adminCurrentTab = tab;
  document.querySelectorAll('.admin-tab').forEach(t => t.classList.toggle('active', t.dataset.tab === tab));
  document.querySelectorAll('.admin-tab-panel').forEach(p => p.classList.toggle('active', p.id === `adminTab_${tab}`));
  if (tab === 'orders') renderAdminOrders();
  if (tab === 'analytics') { setTimeout(renderAnalytics, 80); }
  if (tab === 'stock') renderStockPanel();
  if (tab === 'products') renderAdminProducts();
  if (tab === 'services') renderAdminServices();
  if (tab === 'invoice')  loadInvoiceSettingsToForm();
  if (tab === 'audit')    { try { renderLocalActivityLog(); } catch(e){} try { renderCloudAdminTimeline(); } catch(e){} loadAuditLog(); }
  if (tab === 'customers') { renderCustomersTab(); }
  if (tab === 'setup')    { try { refreshRecoveryCodeDisplay(); } catch(e){} }
  try { logAdminActivity && logAdminActivity('tab_switch', 'info', { tab }); } catch(e) {}
}

// =========================================================
// ===== ADMIN ORDERS TAB =====
// =========================================================
function renderAdminOrders(filterVal = '') {
  const tbody  = document.getElementById('ordersTableBody');
  const noData = document.getElementById('ordersNoData');
  document.getElementById('adminOrderTotal').textContent  = adminOrders.length;
  const productRevenue   = adminOrders.filter(o => o.type !== 'service').reduce((s,o) => s + (o.total||0), 0);
  const coreServiceOrders   = adminOrders.filter(o => o.type === 'service' && !(o.items&&o.items[0]&&String(o.items[0].id||'').startsWith('sd'))).length;
  const digitalServiceOrders= adminOrders.filter(o => o.type === 'service' &&  (o.items&&o.items[0]&&String(o.items[0].id||'').startsWith('sd'))).length;
  const totalServiceOrders  = coreServiceOrders + digitalServiceOrders;
  let revLabel = `TZS ${productRevenue.toLocaleString()}`;
  if (coreServiceOrders > 0)    revLabel += ` + ${coreServiceOrders} huduma`;
  if (digitalServiceOrders > 0) revLabel += ` + ${digitalServiceOrders} dijital`;
  document.getElementById('adminRevTotal').textContent    = revLabel;
  document.getElementById('adminTodayOrders').textContent = adminOrders.filter(o => o.date === new Date().toISOString().slice(0,10)).length;
  document.getElementById('adminLowStock').textContent    = getLowStockCount();
  // Update customers badge
  try {
    const cBadge = document.getElementById('adminCustomersBadge');
    if (cBadge) {
      const cCount = _buildCustomersFromOrders(adminOrders).length;
      cBadge.textContent = cCount; cBadge.classList.toggle('hidden', cCount === 0);
    }
  } catch(e) {}

  let orders = filterVal
    ? adminOrders.filter(o =>
        o.ref.toLowerCase().includes(filterVal) ||
        o.customer.toLowerCase().includes(filterVal) ||
        o.phone.includes(filterVal))
    : adminOrders;

  if (!orders.length) {
    tbody.innerHTML = '';
    noData.style.display = 'block';
    return;
  }
  noData.style.display = 'none';
  tbody.innerHTML = orders.map(o => {
    const itemsText = (o.items||[]).map(i => `${i.name} ×${i.qty}`).join('<br>') || (o.type === 'service' ? (o.items&&o.items[0]&&(o.items[0].id||'').startsWith('sd') ? '📡 Kidijitali/Mawasiliano' : '🛠️ Huduma') : '—');
    const isServiceOrder = o.type === 'service';
    const isPendingPrice = isServiceOrder && (!o.total || o.total === 0 || o.status === 'pending_price');

    // Build action buttons column
    const actionBtns = isServiceOrder
      ? `<div style="display:flex;flex-direction:column;gap:4px;">
          ${isPendingPrice
            ? `<div style="background:#fffbeb;border:1.5px solid #fcd34d;border-radius:8px;padding:8px 10px;margin-bottom:2px;">
                <div style="font-size:10.5px;font-weight:800;color:#92400e;font-family:var(--font-head);margin-bottom:5px;">💰 Weka Bei ya Huduma</div>
                <input type="number" id="svcPrice_${o.ref}" min="0" placeholder="TZS 0"
                  style="width:100%;padding:5px 8px;border:1.5px solid #fcd34d;border-radius:5px;font-size:12px;font-family:var(--font-head);font-weight:700;color:var(--navy);background:white;margin-bottom:5px;"
                  oninput="this.style.borderColor=this.value&&Number(this.value)>0?'var(--success)':'#fcd34d'">
                <button class="admin-btn" style="width:100%;padding:7px 10px;font-size:11.5px;background:linear-gradient(135deg,#065f46,#047857);color:white;border-color:#047857;font-weight:800;"
                  onclick="finalizeServiceAndNotify('${o.ref}')">
                  📄 Finalize Service &amp; Notify
                </button>
              </div>`
            : `<div style="background:#dcfce7;border:1px solid #bbf7d0;border-radius:6px;padding:5px 8px;font-size:11px;color:#166534;font-weight:700;margin-bottom:2px;">
                ✅ Finalized — TZS ${(o.total||0).toLocaleString()}
              </div>
              <button class="admin-btn" style="width:100%;padding:7px 10px;font-size:11.5px;background:linear-gradient(135deg,#f59e0b,#d97706);color:white;border-color:#d97706;font-weight:800;"
                onclick="notifyCustomer('${o.ref}','invoice_tayari',${o.total||0})">
                📄 Tuma Invoice kwa Mteja
              </button>`
          }
          <button class="admin-btn admin-btn-receipt" onclick="generateOrderReceipt('${o.ref}')" title="Pakua Risiti ya PDF">📄 Risiti</button>
          <button class="admin-btn" style="background:#eef2ff;color:#3730a3;border-color:#c7d2fe;padding:6px 10px;font-size:11px;" onclick="openTimelineModal('${o.ref}')" title="Delivery timeline">🕒 Timeline</button>
        </div>`
      : `<div style="display:flex;flex-direction:column;gap:4px;">
          <button class="admin-btn admin-btn-receipt" onclick="generateOrderReceipt('${o.ref}')" title="Pakua Risiti ya PDF">📄 Risiti</button>
          <button class="admin-btn" style="background:#fef3c7;color:#92400e;border-color:#fde68a;padding:6px 10px;font-size:11px;" onclick="generateInvoicePDF('${o.ref}')" title="Generate printable invoice">📑 Invoice</button>
          <button class="admin-btn" style="background:#eef2ff;color:#3730a3;border-color:#c7d2fe;padding:6px 10px;font-size:11px;" onclick="openTimelineModal('${o.ref}')" title="Delivery timeline">🕒 Timeline</button>
        </div>`;

    return `<tr>
      <td>
        <span class="ref">${escapeHTML(o.ref)}</span><br>
        <span style="font-size:11px;color:var(--gray-400);">${escapeHTML(o.timestamp)}</span>
        ${isServiceOrder ? `<br><span style="font-size:10px;font-weight:700;color:#d97706;background:#fef3c7;padding:1px 6px;border-radius:50px;font-family:var(--font-head);">🛠️ HUDUMA</span>` : ''}
        ${isPendingPrice ? `<br><span style="font-size:10px;font-weight:700;color:#b45309;background:#fffbeb;padding:1px 6px;border-radius:50px;font-family:var(--font-head);border:1px solid #fcd34d;">⏳ PENDING PRICE</span>` : ''}
      </td>
      <td><span class="customer">${escapeHTML(o.customer)}</span><br><span style="font-size:11.5px;color:var(--gray-500);">${escapeHTML(o.phone)}</span></td>
      <td><div class="order-items-mini">${itemsText}</div></td>
      <td><span class="amount">${isServiceOrder && isPendingPrice ? '<span style="color:#d97706;font-style:italic;font-size:12px;">⏳ Pending Price</span>' : (o.total ? 'TZS ' + o.total.toLocaleString() : '—')}</span></td>
      <td style="min-width:280px;">
        <div style="margin-bottom:8px;">${renderOrderTracker(o.status, true)}</div>
        <select class="status-select" onchange="updateOrderStatus('${o.ref}', this.value)">
          <option value="new"          ${o.status==='new'||o.status==='pending'?'selected':''}>🆕 Placed (New)</option>
          <option value="pending_price"${o.status==='pending_price'?'selected':''}>⏳ Pending Price</option>
          <option value="confirmed"    ${o.status==='confirmed'?'selected':''}>✅ Confirmed</option>
          <option value="paid"         ${o.status==='paid'?'selected':''}>💰 Paid</option>
          <option value="shipped"      ${o.status==='shipped'?'selected':''}>🚚 Shipped</option>
          <option value="delivered"    ${o.status==='delivered'?'selected':''}>📦 Delivered</option>
          <option value="cancelled"    ${o.status==='cancelled'?'selected':''}>❌ Cancelled</option>
        </select>
      </td>
      <td>${actionBtns}</td>
      <td style="min-width:160px;">
        <div style="display:flex;flex-direction:column;gap:5px;">
          <button class="admin-btn"
            style="padding:7px 10px;font-size:11.5px;background:linear-gradient(135deg,#25D366,#128C7E);color:white;border-color:#128C7E;font-weight:800;display:flex;align-items:center;gap:5px;justify-content:center;"
            onclick="notifyCustomer('${o.ref}')"
            title="Tuma ujumbe wa WhatsApp kwa mteja — oda inafanyiwa kazi">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Notify Mteja
          </button>
          <button class="admin-btn"
            style="padding:5px 10px;font-size:10.5px;color:var(--gray-600);border-color:var(--gray-200);"
            onclick="sendOwnerNotif('${o.ref}')"
            title="Angalia URL ya WhatsApp ya owner">
            🔔 Owner Notif
          </button>
        </div>
      </td>
    </tr>`;
  }).join('');
}

// =========================================================
// ===== ORDER LIFECYCLE TRACKER (placed → ... → delivered)
// =========================================================
const ORDER_LIFECYCLE = [
  { key: 'new',           label: 'Placed',        icon: '📝' },
  { key: 'pending_price', label: 'Pending Price',  icon: '⏳' },
  { key: 'confirmed',     label: 'Confirmed',      icon: '✅' },
  { key: 'paid',          label: 'Paid',           icon: '💰' },
  { key: 'shipped',       label: 'Shipped',        icon: '🚚' },
  { key: 'delivered',     label: 'Delivered',      icon: '📦' }
];
function renderOrderTracker(status, compact) {
  const norm = (status === 'pending') ? 'new' : (status || 'new');
  if (norm === 'cancelled') {
    return `<div class="order-tracker ${compact?'compact':''}"><div class="ot-step cancelled"><div class="ot-dot">✕</div><div class="ot-label">Cancelled</div></div></div>`;
  }
  const idx = ORDER_LIFECYCLE.findIndex(s => s.key === norm);
  const cur = idx < 0 ? 0 : idx;
  const html = ORDER_LIFECYCLE.map((s, i) => {
    const cls = i < cur ? 'done' : (i === cur ? 'current' : '');
    const bar = i < ORDER_LIFECYCLE.length - 1
      ? `<div class="ot-bar ${i < cur ? 'done':''}"></div>` : '';
    return `<div class="ot-step ${cls}"><div class="ot-dot">${i < cur ? '✓' : s.icon}</div><div class="ot-label">${s.label}</div></div>${bar}`;
  }).join('');
  return `<div class="order-tracker ${compact?'compact':''}">${html}</div>`;
}

async function updateOrderStatus(ref, status) {
  const order = adminOrders.find(o => o.ref === ref);
  if (!order) return;
  const before = order.status;
  if (before === status) return;
  order.status = status;
  saveAdminOrders();
  syncStatusToSheets(ref, status);
  // NEW: timeline + audit
  if (window.letemaSupabase) {
    window.letemaSupabase.logOrderStatusEvent(ref, status, 'admin', null);
    window.letemaSupabase.audit({
      actor: 'admin', action: 'order.status_change', entity: 'order', entity_id: ref,
      before_data: { status: before }, after_data: { status }
    });
  }
  const statusLabels = { new:'🆕 Placed', pending:'🆕 Placed', confirmed:'✅ Confirmed', paid:'💰 Paid', shipped:'🚚 Shipped', delivered:'📦 Delivered', cancelled:'❌ Cancelled' };
  showToast(`📋 ${ref} → ${statusLabels[status] || status}`, 'success');
  renderAdminOrders();
}

function sendOwnerNotif(ref) {
  const order = adminOrders.find(o => o.ref === ref);
  if (order && order._ownerNotifUrl) window.open(order._ownerNotifUrl, '_blank');
}

// =========================================================
// ===== NOTIFY CUSTOMER via WhatsApp =====
// =========================================================
const NOTIFY_TEMPLATES = {
  inakayofanyiwa_kazi: (o) => {
    const items = (o.items||[]).map(i => `  • ${i.name} ×${i.qty}`).join('\n') || (o.type==='service' ? `  • Huduma ya ${(o.items||[{name:'Huduma'}])[0]?.name||'Huduma'}` : '  • Bidhaa yako');
    return `Habari *${o.customer}* 👋\n\nTunakujulisha kuwa agizo lako *#${o.ref}* **limepokelewa na linafanyiwa kazi sasa hivi!** ✅\n\n📦 *Bidhaa/Huduma:*\n${items}\n\n💰 *Jumla:* ${o.total ? 'TZS ' + o.total.toLocaleString() : 'Bei itaainishwa hivi karibuni'}\n⏰ *Muda wa Kukamilika:* Dakika 30–60 (kulingana na huduma)\n\nUna maswali? Wasiliana nasi moja kwa moja hapa WhatsApp.\n\nAsante kwa kununua *Letema Stationery* — Mbeya! 🙏`;
  },
  imekamilika: (o) => {
    const items = (o.items||[]).map(i => `  • ${i.name} ×${i.qty}`).join('\n') || '  • Huduma yako';
    return `Habari *${o.customer}* 🎉\n\nOda yako *#${o.ref}* **imekamilika na iko tayari!** ✅\n\n📦 *Bidhaa/Huduma:*\n${items}\n\n💰 *Jumla ya Kulipa:* ${o.total ? 'TZS ' + o.total.toLocaleString() : '—'}\n\nTafadhali *kuja kuchukua* au tutakufikishia kulingana na makubaliano yetu.\n\nAsante kwa kuamini *Letema Stationery & Internet Café* — Mbeya! 🙏`;
  },
  malipo_yaliyopokelewa: (o) => {
    return `Habari *${o.customer}* 👋\n\n✅ *Malipo yamekubaliwa!*\n\nTumethibitisha malipo ya oda yako *#${o.ref}*.\n💰 *Kiasi:* TZS ${(o.total||0).toLocaleString()}\n\nOda yako inafanyiwa kazi sasa hivi. Utaarifu mwingine ukitarajiwa hivi karibuni.\n\n_Letema Stationery — Mbeya_ 🏪`;
  },
  ombi_la_maelezo: (o) => {
    return `Habari *${o.customer}* 👋\n\nTunahitaji maelezo zaidi kuhusu oda yako *#${o.ref}* ili tuweze kukusaidia vizuri zaidi.\n\nTafadhali tujibu hapa WhatsApp na maelezo au picha inayohitajika.\n\nAsante! — *Letema Stationery* 🙏`;
  },
  ucheleweshaji: (o) => {
    return `Habari *${o.customer}* 👋\n\nTunakuomba msamaha — oda yako *#${o.ref}* imechelewa kidogo kuliko ilivyopangwa.\n\n⏳ Tutakufikia hivi karibuni na sasisho la hali ya oda yako.\n\nTunashukuru subira yako na kuamini huduma zetu.\n\n_Letema Stationery — Mbeya_ 🙏`;
  },
  invoice_tayari: (o, price) => {
    const bei = price || o.total;
    const items = (o.items||[]).map(i => `  • ${i.name}`).join('\n') || (o.serviceDetails ? `  • ${o.serviceDetails}` : '  • Huduma ya Letema');
    return `Habari *${o.customer}* 👋\n\n📄 *Invoice Yako Iko Tayari!*\n\nAgizo lako *#${o.ref}* limefanyiwa kazi na bei imekamilika.\n\n📦 *Huduma:*\n${items}\n\n💰 *Bei Yako Ni:* TZS *${Number(bei).toLocaleString()}*\n\n✅ Tafadhali kuja kulipa au wasiliana nasi ili tupange namna ya malipo.\n\n📱 Malipo yanakubaliwa kwa *M-Pesa / Airtel Money / Cash*\n\nAsante kwa kuamini *Letema Stationery & Internet Café — Mbeya!* 🙏\n_Maswali? Tupigie: +255 620 642 652_`;
  },
  custom: (o, msgExtra) => msgExtra || `Habari *${o.customer}*, ujumbe kuhusu oda yako *#${o.ref}*.`
};

function notifyCustomer(ref, defaultTemplate, invoicePrice) {
  const order = adminOrders.find(o => o.ref === ref);
  if (!order) { showToast('⚠️ Oda haikupatikana.', 'error'); return; }
  // Store invoice price on modal dataset so templates can use it
  if (invoicePrice) order._invoicePrice = invoicePrice;

  // Always rebuild modal so template list stays fresh
  let modal = document.getElementById('notifyCustomerModal');
  if (modal) modal.remove();
  modal = document.createElement('div');
    modal.id = 'notifyCustomerModal';
    modal.className = 'modal-overlay';
    modal.onclick = (e) => closeModalOutside(e, 'notifyCustomerModal');
    modal.innerHTML = `
      <div class="modal" style="max-width:520px;">
        <div class="modal-header" style="background:linear-gradient(135deg,#25D366,#128C7E);border-radius:var(--radius-xl) var(--radius-xl) 0 0;">
          <h3 style="color:white;display:flex;align-items:center;gap:8px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Taarifa Mteja kwa WhatsApp
          </h3>
          <span class="modal-close" onclick="closeModal('notifyCustomerModal')" style="color:rgba(255,255,255,0.8);">✕</span>
        </div>
        <div class="modal-body" style="padding:20px;">

          <!-- Recipient info -->
          <div id="notifyRecipientInfo" style="background:var(--gray-100);border-radius:var(--radius-md);padding:10px 14px;margin-bottom:16px;font-size:13px;"></div>

          <!-- Template selector -->
          <div class="form-group">
            <label class="form-label">📋 Aina ya Ujumbe</label>
            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;" id="notifyTemplateGrid"></div>
          </div>

          <!-- Message preview / editor -->
          <div class="form-group" style="margin-top:14px;">
            <label class="form-label">✏️ Ujumbe (unaweza kuhariri)</label>
            <textarea class="form-input" id="notifyMsgBox" rows="9"
              style="resize:vertical;font-size:13px;line-height:1.7;font-family:var(--font-body);"></textarea>
            <div style="display:flex;justify-content:space-between;align-items:center;margin-top:5px;">
              <div id="notifyCharCount" style="font-size:11px;color:var(--gray-400);"></div>
              <button style="background:none;border:none;font-size:11.5px;color:var(--navy);font-weight:700;cursor:pointer;padding:2px 0;" onclick="document.getElementById('notifyMsgBox').value='';updateNotifyCharCount();">🗑️ Futa</button>
            </div>
          </div>

          <!-- Send buttons -->
          <div style="display:flex;gap:8px;margin-top:4px;flex-wrap:wrap;">
            <button class="checkout-btn" id="notifySendBtn"
              style="flex:1;background:linear-gradient(135deg,#25D366,#128C7E);display:flex;align-items:center;justify-content:center;gap:8px;"
              onclick="sendNotifyCustomerMsg()">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Tuma kwa Whapi.cloud
            </button>
            <button class="admin-btn"
              style="padding:12px 18px;font-size:13px;font-weight:700;background:#e7fdf0;color:#128C7E;border-color:#25D366;"
              onclick="sendNotifyCustomerFallback()">
              📱 Fungua WhatsApp
            </button>
          </div>
          <div id="notifySendResult" style="display:none;margin-top:10px;padding:10px 12px;border-radius:var(--radius-md);font-size:12.5px;font-weight:700;"></div>
        </div>
      </div>`;
    document.body.appendChild(modal);

  // Populate recipient info
  const phone = order.phone || '';
  document.getElementById('notifyRecipientInfo').innerHTML = `
    <div style="display:flex;align-items:center;gap:10px;">
      <div style="width:36px;height:36px;background:linear-gradient(135deg,#25D366,#128C7E);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0;">👤</div>
      <div>
        <div style="font-weight:800;color:var(--navy);font-family:var(--font-head);">${escapeHTML(order.customer)}</div>
        <div style="color:var(--gray-500);font-size:12px;">${escapeHTML(phone)} &nbsp;·&nbsp; Oda: <b>${escapeHTML(order.ref)}</b> &nbsp;·&nbsp; Hali: <b>${order.status||'new'}</b></div>
      </div>
    </div>`;

  // Build template buttons
  const templates = [
    { key:'invoice_tayari',       label:'📄 Invoice Tayari',    color:'#fffbeb', textColor:'#92400e', border:'#fcd34d' },
    { key:'inakayofanyiwa_kazi',  label:'⚙️ Inafanyiwa Kazi',  color:'#eef2ff', textColor:'#3730a3', border:'#c7d2fe' },
    { key:'imekamilika',          label:'✅ Imekamilika',        color:'#dcfce7', textColor:'#166534', border:'#bbf7d0' },
    { key:'malipo_yaliyopokelewa',label:'💰 Malipo Pokewa',     color:'#fef9c3', textColor:'#854d0e', border:'#fde047' },
    { key:'ombi_la_maelezo',      label:'❓ Ombi la Maelezo',   color:'#fce7f3', textColor:'#9d174d', border:'#fbcfe8' },
    { key:'ucheleweshaji',        label:'⏳ Kuchelewa',          color:'#fff7ed', textColor:'#9a3412', border:'#fed7aa' },
    { key:'custom',               label:'✏️ Ujumbe Maalum',     color:'#f1f5f9', textColor:'#0f172a', border:'#cbd5e1' },
  ];
  document.getElementById('notifyTemplateGrid').innerHTML = templates.map(t => `
    <button onclick="loadNotifyTemplate('${t.key}','${escapeAttr(ref)}')"
      style="padding:8px 10px;background:${t.color};color:${t.textColor};border:1.5px solid ${t.border};border-radius:var(--radius-md);font-size:11.5px;font-weight:700;font-family:var(--font-head);cursor:pointer;text-align:left;transition:var(--transition);"
      onmouseover="this.style.filter='brightness(0.95)'" onmouseout="this.style.filter=''">
      ${t.label}
    </button>`).join('');

  // Store ref for send functions
  modal.dataset.ref = ref;

  // Load default template (or invoice_tayari if coming from finalize)
  loadNotifyTemplate(defaultTemplate || 'inakayofanyiwa_kazi', ref);

  document.getElementById('notifySendResult').style.display = 'none';
  openModal('notifyCustomerModal');
}

function loadNotifyTemplate(key, ref) {
  const order = adminOrders.find(o => o.ref === ref);
  if (!order) return;
  const modal = document.getElementById('notifyCustomerModal');
  if (modal) modal.dataset.templateKey = key;
  const msgBox = document.getElementById('notifyMsgBox');
  if (!msgBox) return;
  const tmpl = NOTIFY_TEMPLATES[key];
  // Pass invoicePrice for invoice_tayari template
  const price = order._invoicePrice || order.total || 0;
  msgBox.value = tmpl ? tmpl(order, price) : '';
  // Highlight selected template button
  document.querySelectorAll('#notifyTemplateGrid button').forEach(btn => {
    const isActive = btn.getAttribute('onclick') && btn.getAttribute('onclick').includes(`'${key}'`);
    btn.style.outline = isActive ? '2px solid var(--navy)' : '';
    btn.style.boxShadow = isActive ? '0 0 0 2px var(--navy)' : '';
  });
  updateNotifyCharCount();
}

function updateNotifyCharCount() {
  const box = document.getElementById('notifyMsgBox');
  const cnt = document.getElementById('notifyCharCount');
  if (!box || !cnt) return;
  cnt.textContent = `${box.value.length} herufi`;
}

// Wire up character counter
document.addEventListener('DOMContentLoaded', () => {
  document.body.addEventListener('input', e => {
    if (e.target.id === 'notifyMsgBox') updateNotifyCharCount();
  });
});

async function sendNotifyCustomerMsg() {
  const modal = document.getElementById('notifyCustomerModal');
  const ref   = modal ? modal.dataset.ref : null;
  const order = ref ? adminOrders.find(o => o.ref === ref) : null;
  if (!order) { showToast('⚠️ Oda haikupatikana.', 'error'); return; }
  const msgBox = document.getElementById('notifyMsgBox');
  const msg    = (msgBox ? msgBox.value : '').trim();
  if (!msg) { showToast('⚠️ Ujumbe hauwezi kuwa wazi.', 'error'); return; }

  const sendBtn = document.getElementById('notifySendBtn');
  if (sendBtn) { sendBtn.disabled = true; sendBtn.textContent = '⏳ Inatuma...'; }

  const result = await sendWhatsAppMessage(order.phone, msg);

  const resultBox = document.getElementById('notifySendResult');
  if (sendBtn) {
    sendBtn.disabled = false;
    sendBtn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg> Tuma kwa Whapi.cloud`;
  }

  if (resultBox) {
    resultBox.style.display = 'block';
    if (result.success) {
      resultBox.style.background = '#dcfce7';
      resultBox.style.color = '#166534';
      resultBox.style.border = '1px solid #bbf7d0';
      resultBox.textContent = '✅ Ujumbe umetumwa kwa mafanikio kwa ' + order.customer + ' (' + order.phone + ')';
      if (window.letemaSupabase) {
        window.letemaSupabase.audit({ actor:'admin', action:'customer.notified', entity:'order', entity_id: ref, meta:{ phone: order.phone, channel:'whapi' }});
      }
      showToast('📲 Mteja amearifu kwa WhatsApp!', 'success');
      setTimeout(() => closeModal('notifyCustomerModal'), 2200);
    } else {
      resultBox.style.background = '#fee2e2';
      resultBox.style.color = '#991b1b';
      resultBox.style.border = '1px solid #fecaca';
      resultBox.textContent = '⚠️ Imeshindwa kutumia Whapi — bonyeza "Fungua WhatsApp" kutuma mwenyewe.';
    }
  }
}

function sendNotifyCustomerFallback() {
  const modal = document.getElementById('notifyCustomerModal');
  const ref   = modal ? modal.dataset.ref : null;
  const order = ref ? adminOrders.find(o => o.ref === ref) : null;
  if (!order) { showToast('⚠️ Oda haikupatikana.', 'error'); return; }
  const msgBox = document.getElementById('notifyMsgBox');
  const msg    = (msgBox ? msgBox.value : '').trim();
  if (!msg) { showToast('⚠️ Ujumbe hauwezi kuwa wazi.', 'error'); return; }
  const phone = String(order.phone).replace(/^\+/,'').replace(/\s/g,'');
  const url   = `https://wa.me/${phone}?text=${encodeURIComponent(msg)}`;
  window.open(url, '_blank');
  if (window.letemaSupabase) {
    window.letemaSupabase.audit({ actor:'admin', action:'customer.notified', entity:'order', entity_id: ref, meta:{ phone: order.phone, channel:'wa.me' }});
  }
  showToast('📱 WhatsApp imefunguliwa kwa ' + order.customer, 'success');
}

function searchOrders(val) {
  renderAdminOrders(val.trim().toLowerCase());
}

// =========================================================
// ===== CSV EXPORT =====
// =========================================================
function exportOrdersCSV() {
  if (!adminOrders.length) { showToast('Hakuna maagizo ya kuexport!', 'error'); return; }
  const headers = ['Ref','Tarehe','Wakati','Mteja','Simu','Barua Pepe','Aina','Bidhaa','Jumla Ndogo (TZS)','VAT (TZS)','Jumla (TZS)','Malipo','Transaction ID','Eneo','Maelezo','Hali'];
  const rows    = [];
  adminOrders.forEach(o => {
    const isDigital = o.type === 'service' && (o.items&&o.items[0]&&String(o.items[0].id||'').startsWith('sd'));
    const orderType = o.type === 'service' ? (isDigital ? 'dijital-mawasiliano' : 'huduma') : (o.type || 'product');
    const itemsFlat = (o.items||[]).map(i => `${i.name} x${i.qty} @TZS${i.price||0}`).join(' | ') || orderType;
    rows.push([
      o.ref, o.date, o.timestamp, o.customer, o.phone, o.email||'', orderType,
      `"${itemsFlat}"`, o.subtotal||0, o.vat||0, o.total||0,
      o.payment||'', o.txnId||'', o.address||'', o.notes||'', o.status||'new'
    ]);
    // Optional: add a line per line-item for accounting detail
    (o.items||[]).forEach(item => {
      rows.push([
        o.ref, o.date, o.timestamp, o.customer, o.phone, o.email||'', 'line_item',
        `"${item.name}"`, (item.price||0) * (item.qty||1), '', '', '', '', '', '', ''
      ]);
    });
  });
  const csv  = [headers.join(','), ...rows.map(r => r.join(','))].join('\n');
  const blob = new Blob(['\uFEFF' + csv], {type: 'text/csv;charset=utf-8;'});
  const url  = URL.createObjectURL(blob);
  const a    = document.createElement('a');
  a.href     = url;
  a.download = `letema_orders_${new Date().toISOString().slice(0,10)}.csv`;
  a.click();
  URL.revokeObjectURL(url);
  showToast(`✅ CSV ya maagizo ${adminOrders.length} imedownload!`, 'success');
}

// =========================================================
// ===== STOCK PANEL =====
// =========================================================
function renderStockPanel() {
  const grid = document.getElementById('stockGrid');
  const sorted = [...PRODUCTS].filter(p => p.stock_quantity !== 999).sort((a,b) => a.stock_quantity - b.stock_quantity);
  grid.innerHTML = sorted.map(p => {
    const isLow  = p.stock_quantity < 5;
    const isWarn = p.stock_quantity >= 5 && p.stock_quantity <= 10;
    const cls    = isLow ? 'low' : isWarn ? 'warning' : '';
    const qCls   = isLow ? 'low' : isWarn ? 'warning' : 'ok';
    return `
    <div class="stock-card ${cls}">
      <div class="stock-icon">${p.icon}</div>
      <div class="stock-info">
        <div class="stock-name">${escapeHTML(p.name)}</div>
        <div class="stock-qty">Stock: <strong class="${qCls}">${p.stock_quantity}</strong> pcs
          ${isLow ? `<span class="stock-badge-low" style="margin-left:6px;">⚠️ Chini</span>` : ''}
        </div>
      </div>
      <div style="display:flex;flex-direction:column;gap:4px;">
        <button class="admin-btn" style="padding:4px 10px;font-size:11px;" onclick="adjustStock(${p.id}, 10)">+10</button>
        <button class="admin-btn" style="padding:4px 10px;font-size:11px;color:var(--danger);" onclick="adjustStock(${p.id}, -1)">−1</button>
      </div>
    </div>`;
  }).join('');
  // Always-in-stock services note
  grid.innerHTML += `<div style="grid-column:1/-1;font-size:12px;color:var(--gray-400);padding:10px 4px;">* Huduma (picha, printing, n.k.) hazihesabu stock ya bidhaa.</div>`;
}

function adjustStock(productId, delta) {
  const p = PRODUCTS.find(x => x.id === productId);
  if (!p) return;
  p.stock_quantity = Math.max(0, p.stock_quantity + delta);
  saveStockToStorage();
  if (window.letemaSupabase) window.letemaSupabase.setProductStock(p, p.stock_quantity);
  updateAdminStockBadge();
  renderStockPanel();
  renderProducts(currentCategory);
  showToast(`📦 ${p.name}: stock → ${p.stock_quantity}`, 'info');
}

// =========================================================
// ===== ANALYTICS =====
// =========================================================
function renderAnalytics() {
  // Compute stats for last 30 days
  const now       = new Date();
  const days30    = [];
  const dayLabels = [];
  for (let i = 29; i >= 0; i--) {
    const d = new Date(now); d.setDate(d.getDate() - i);
    days30.push(d.toISOString().slice(0,10));
    dayLabels.push(d.toLocaleDateString('en-TZ', {month:'short', day:'numeric'}));
  }

  const ordersInRange = adminOrders.filter(o => days30.includes(o.date));
  const ordersPerDay  = days30.map(d => ordersInRange.filter(o => o.date === d).length);
  const revenuePerDay = days30.map(d => ordersInRange.filter(o => o.date === d).reduce((s,o) => s + (o.total||0), 0) / 1000);

  // Top products
  const salesMap = {};
  adminOrders.forEach(o => {
    (o.items||[]).forEach(item => {
      if (item.type !== 'service') {
        salesMap[item.name] = (salesMap[item.name] || 0) + (item.qty || 1);
      }
    });
  });
  const topProducts = Object.entries(salesMap).sort((a,b) => b[1]-a[1]).slice(0,5);

  // Build charts
  const dayCtx = document.getElementById('chartOrders')?.getContext('2d');
  const revCtx = document.getElementById('chartRevenue')?.getContext('2d');
  const topCtx = document.getElementById('chartTopProducts')?.getContext('2d');

  if (chartDayInstance) chartDayInstance.destroy();
  if (chartRevInstance) chartRevInstance.destroy();
  if (chartTopInstance) chartTopInstance.destroy();

  const chartDefaults = {
    responsive: true, maintainAspectRatio: false,
    plugins: { legend: { display: false } },
    scales: {
      x: { grid: { display: false }, ticks: { font: { size: 10 }, maxTicksLimit: 8 } },
      y: { grid: { color: '#f1f4fb' }, ticks: { font: { size: 10 } }, beginAtZero: true }
    }
  };

  if (dayCtx) {
    chartDayInstance = new Chart(dayCtx, {
      type: 'bar',
      data: {
        labels: dayLabels,
        datasets: [{ label: 'Maagizo', data: ordersPerDay, backgroundColor: '#003087', borderRadius: 4 }]
      },
      options: { ...chartDefaults }
    });
  }

  if (revCtx) {
    chartRevInstance = new Chart(revCtx, {
      type: 'line',
      data: {
        labels: dayLabels,
        datasets: [{
          label: 'Mapato (TZS 000)',
          data: revenuePerDay,
          borderColor: '#FFC600', backgroundColor: 'rgba(255,198,0,0.12)',
          tension: 0.4, fill: true, pointRadius: 3, pointBackgroundColor: '#FFC600'
        }]
      },
      options: { ...chartDefaults }
    });
  }

  if (topCtx && topProducts.length) {
    chartTopInstance = new Chart(topCtx, {
      type: 'bar',
      data: {
        labels: topProducts.map(p => p[0].slice(0,22)),
        datasets: [{ data: topProducts.map(p => p[1]), backgroundColor: ['#003087','#FFC600','#16a34a','#dc2626','#0369a1'], borderRadius: 4 }]
      },
      options: {
        indexAxis: 'y', responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: { x: { beginAtZero: true, grid: { display: false } }, y: { grid: { display: false } } }
      }
    });
  }

  // Render top product list
  const listEl = document.getElementById('topProductsList');
  if (listEl) {
    const emojis = ['🥇','🥈','🥉','4️⃣','5️⃣'];
    listEl.innerHTML = topProducts.length
      ? topProducts.map((p,i) => {
          const prod = PRODUCTS.find(x => x.name === p[0]);
          return `<div class="tp-item"><span class="tp-rank">${emojis[i]||i+1}</span><span class="tp-icon">${prod?.icon||'📦'}</span><span class="tp-name">${escapeHTML(p[0])}</span><span class="tp-sales">${p[1]} inunuliwa</span></div>`;
        }).join('')
      : '<div style="color:var(--gray-400);font-size:13px;padding:20px 0;text-align:center;">Hakuna data bado. Maagizo yataonekana hapa.</div>';
  }

  // Summary stats
  const productOrders  = adminOrders.filter(o => o.type !== 'service');
  const totalRev       = productOrders.reduce((s,o) => s + (o.total||0), 0);
  const avgOrder       = productOrders.length ? Math.round(totalRev / productOrders.length) : 0;
  const delivered      = adminOrders.filter(o => o.status === 'delivered').length;
  const totalServices  = adminOrders.filter(o => o.type === 'service' && !(o.items&&o.items[0]&&String(o.items[0].id||'').startsWith('sd'))).length;
  const totalDigital   = adminOrders.filter(o => o.type === 'service' &&  (o.items&&o.items[0]&&String(o.items[0].id||'').startsWith('sd'))).length;
  const el = document.getElementById('analyticsSummary');
  if (el) {
    el.innerHTML = `
      <div class="admin-stat-card"><div class="asc-icon navy">💰</div><div><div class="asc-val">TZS ${(totalRev/1000).toFixed(0)}k</div><div class="asc-label">Mapato (Bidhaa)</div></div></div>
      <div class="admin-stat-card"><div class="asc-icon gold">📦</div><div><div class="asc-val">${adminOrders.length}</div><div class="asc-label">Maagizo Yote</div></div></div>
      <div class="admin-stat-card"><div class="asc-icon green">✅</div><div><div class="asc-val">${delivered}</div><div class="asc-label">Yaliyotolewa</div></div></div>
      <div class="admin-stat-card"><div class="asc-icon red">🛠️</div><div><div class="asc-val">${totalServices}</div><div class="asc-label">Maombi ya Huduma</div></div></div>
      <div class="admin-stat-card"><div class="asc-icon" style="background:rgba(0,48,135,0.08);color:var(--navy);">📡</div><div><div class="asc-val">${totalDigital}</div><div class="asc-label">Kidijitali/Mawasiliano</div></div></div>`;
  }
}

// =========================================================
// ===== PRODUCT & SERVICE MANAGEMENT (Admin) =====
// =========================================================

const PRODUCTS_STORAGE_KEY = 'letema_products_admin_v1';
const SERVICES_STORAGE_KEY = 'letema_services_admin_v1';

function loadAdminProductData() {
  try {
    const saved = localStorage.getItem(PRODUCTS_STORAGE_KEY);
    if (saved) {
      const parsed = JSON.parse(saved);
      if (Array.isArray(parsed) && parsed.length > 0) {
        PRODUCTS.length = 0;
        parsed.forEach(p => PRODUCTS.push(p));
      }
    }
  } catch(e) { console.warn('loadAdminProductData failed:', e); }
}

function saveAdminProductData() {
  try { localStorage.setItem(PRODUCTS_STORAGE_KEY, JSON.stringify(PRODUCTS)); } catch(e) {}
}

function loadAdminServiceData() {
  try {
    const saved = localStorage.getItem(SERVICES_STORAGE_KEY);
    if (saved) {
      const parsed = JSON.parse(saved);
      if (Array.isArray(parsed) && parsed.length > 0) {
        SERVICES.length = 0;
        parsed.forEach(s => SERVICES.push(s));
      }
    }
  } catch(e) { console.warn('loadAdminServiceData failed:', e); }
}

function saveAdminServiceData() {
  try { localStorage.setItem(SERVICES_STORAGE_KEY, JSON.stringify(SERVICES)); } catch(e) {}
}

// ── Products Panel ──────────────────────────────────────────
function renderAdminProducts() {
  const tbody = document.getElementById('adminProductsList');
  const empty = document.getElementById('adminProductsEmpty');
  if (!tbody) return;
  if (!PRODUCTS.length) {
    tbody.innerHTML = '';
    if (empty) empty.style.display = 'block';
    return;
  }
  if (empty) empty.style.display = 'none';
  tbody.innerHTML = PRODUCTS.map(p => {
    const stockColor = p.stock_quantity === 0 ? 'var(--danger)' : p.stock_quantity < 5 && p.stock_quantity !== 999 ? 'var(--warning)' : 'var(--success)';
    const stockLabel = p.stock_quantity === 999 ? '∞ Bila kikomo' : p.stock_quantity;
    return `
    <tr id="prodRow_${p.id}">
      <td style="font-size:26px;text-align:center;padding:10px 8px;">${p.icon}</td>
      <td>
        <div style="font-family:var(--font-head);font-weight:700;font-size:13px;color:var(--navy);">${escapeHTML(p.name)}</div>
        <div style="font-size:11px;color:var(--gray-400);margin-top:2px;">${getCatLabel(p.category)}${p.badge ? ` · <span style="color:var(--warning);font-weight:700;">${p.badge==='hot'?'🔥 Hot':p.badge==='new'?'✨ Mpya':'🏷️ Sale'}</span>` : ''}</div>
      </td>
      <td><span style="font-family:var(--font-head);font-weight:800;font-size:14px;color:var(--navy);">TZS ${p.price.toLocaleString()}</span></td>
      <td><span style="font-family:var(--font-head);font-weight:700;font-size:13px;color:${stockColor};">${stockLabel}</span></td>
      <td>
        <div style="display:flex;gap:6px;">
          <button class="admin-btn" style="padding:5px 11px;font-size:11.5px;" onclick="toggleProductEdit(${typeof p.id === 'number' ? p.id : "'"+p.id+"'"})">✏️ Hariri</button>
          <button class="admin-btn" style="padding:5px 11px;font-size:11.5px;color:var(--danger);border-color:rgba(220,38,38,0.4);" onclick="deleteProduct(${typeof p.id === 'number' ? p.id : "'"+p.id+"'"})">🗑️</button>
        </div>
      </td>
    </tr>
    <tr id="prodEdit_${p.id}" class="admin-prod-edit-row" style="display:none;">
      <td colspan="5">
        <div class="mgmt-grid-3" style="margin-bottom:14px;">
          <div>
            <label class="form-label">💰 Bei Mpya (TZS)</label>
            <input class="form-input" type="number" id="editPrice_${p.id}" value="${p.price}" min="0">
          </div>
          <div>
            <label class="form-label">📦 Stok <span style="font-size:10px;font-weight:400;color:var(--gray-400);text-transform:none;">wazi = bila kikomo</span></label>
            <input class="form-input" type="number" id="editStock_${p.id}" value="${p.stock_quantity === 999 ? '' : p.stock_quantity}" min="0" placeholder="999 = ∞">
          </div>
          <div>
            <label class="form-label">🏷️ Badge</label>
            <select class="form-input" id="editBadge_${p.id}">
              <option value="" ${!p.badge?'selected':''}>Hakuna Badge</option>
              <option value="hot" ${p.badge==='hot'?'selected':''}>🔥 Hot</option>
              <option value="new" ${p.badge==='new'?'selected':''}>✨ Mpya</option>
              <option value="sale" ${p.badge==='sale'?'selected':''}>🏷️ Sale</option>
            </select>
          </div>
        </div>
        <div style="margin-bottom:14px;">
          <label class="form-label">📝 Jina la Bidhaa</label>
          <input class="form-input" type="text" id="editName_${p.id}" value="${escapeAttr(p.name)}">
        </div>
        <div style="display:flex;gap:8px;">
          <button class="admin-btn primary" onclick="saveProductEdit(${typeof p.id === 'number' ? p.id : "'"+p.id+"'"})">💾 Hifadhi Mabadiliko</button>
          <button class="admin-btn" onclick="toggleProductEdit(${typeof p.id === 'number' ? p.id : "'"+p.id+"'"})">✕ Ghairi</button>
        </div>
      </td>
    </tr>`;
  }).join('');
}

function toggleProductEdit(id) {
  const row = document.getElementById(`prodEdit_${id}`);
  if (!row) return;
  const isOpen = row.style.display !== 'none';
  // close all others first
  document.querySelectorAll('[id^="prodEdit_"]').forEach(r => r.style.display = 'none');
  if (!isOpen) row.style.display = 'table-row';
}

function saveProductEdit(id) {
  const prod = PRODUCTS.find(p => p.id === id);
  if (!prod) return;
  const before = { name: prod.name, price: prod.price, stock_quantity: prod.stock_quantity, badge: prod.badge };
  const newPrice = parseInt(document.getElementById(`editPrice_${id}`)?.value);
  const rawStock = document.getElementById(`editStock_${id}`)?.value;
  const newBadge = document.getElementById(`editBadge_${id}`)?.value;
  const newName  = document.getElementById(`editName_${id}`)?.value.trim();
  if (isNaN(newPrice) || newPrice < 0) { showToast('⚠️ Weka bei sahihi (nambari).', 'error'); return; }
  if (newName) prod.name = newName;
  prod.price = newPrice;
  prod.stock_quantity = (rawStock === '' || rawStock === undefined) ? 999 : Math.max(0, parseInt(rawStock) || 0);
  prod.badge = newBadge || null;
  saveAdminProductData();
  saveStockToStorage();
  if (window.letemaSupabase) {
    window.letemaSupabase.upsertProduct(prod);
    window.letemaSupabase.audit({
      actor: 'admin', action: 'product.update', entity: 'product', entity_id: prod.id,
      before_data: before,
      after_data: { name: prod.name, price: prod.price, stock_quantity: prod.stock_quantity, badge: prod.badge }
    });
  }
  renderAdminProducts();
  renderProducts();
  updateAdminStockBadge();
  showToast(`✅ "${prod.name}" imesasishwa kikamilifu!`, 'success');
}

function deleteProduct(id) {
  const prod = PRODUCTS.find(p => p.id === id);
  if (!prod) return;
  if (!confirm(`Futa bidhaa "${prod.name}" kutoka orodha yote?`)) return;
  const snapshot = { id: prod.id, name: prod.name, price: prod.price, category: prod.category, stock_quantity: prod.stock_quantity };
  const idx = PRODUCTS.findIndex(p => p.id === id);
  if (idx > -1) PRODUCTS.splice(idx, 1);
  saveAdminProductData();
  if (window.letemaSupabase) {
    window.letemaSupabase.deleteProductRemote(prod);
    window.letemaSupabase.audit({
      actor: 'admin', action: 'product.delete', entity: 'product', entity_id: snapshot.id,
      before_data: snapshot
    });
  }
  renderAdminProducts();
  renderProducts();
  showToast(`🗑️ "${prod.name}" imefutwa.`, 'info');
}

function toggleAddProductForm() {
  const form = document.getElementById('addProductForm');
  if (form) { form.style.display = form.style.display === 'none' ? 'block' : 'none'; form.scrollIntoView({behavior:'smooth',block:'nearest'}); }
}

function addNewProduct() {
  const name  = document.getElementById('newProdName')?.value.trim();
  const price = parseInt(document.getElementById('newProdPrice')?.value);
  const cat   = document.getElementById('newProdCat')?.value;
  const icon  = document.getElementById('newProdIcon')?.value.trim() || '📦';
  const badge = document.getElementById('newProdBadge')?.value || null;
  const rawStk = document.getElementById('newProdStock')?.value;
  const desc  = document.getElementById('newProdDesc')?.value.trim();
  if (!name)                          { showToast('⚠️ Weka jina la bidhaa.', 'error'); return; }
  if (isNaN(price) || price < 0)     { showToast('⚠️ Weka bei sahihi (nambari).', 'error'); return; }
  if (!cat)                           { showToast('⚠️ Chagua kategoria ya bidhaa.', 'error'); return; }
  if (!desc)                          { showToast('⚠️ Weka maelezo ya bidhaa.', 'error'); return; }
  const maxId = PRODUCTS.reduce((m, p) => Math.max(m, typeof p.id === 'number' ? p.id : 0), 0);
  PRODUCTS.push({
    id: maxId + 1, name, price, category: cat, icon, badge: badge || null,
    rating: 5.0, reviews: 0, desc,
    stock_quantity: (rawStk === '' || rawStk === undefined) ? 999 : Math.max(0, parseInt(rawStk) || 0)
  });
  saveAdminProductData();
  if (window.letemaSupabase) {
    const created = PRODUCTS[PRODUCTS.length-1];
    window.letemaSupabase.upsertProduct(created);
    window.letemaSupabase.audit({
      actor: 'admin', action: 'product.create', entity: 'product', entity_id: created.id,
      after_data: { name: created.name, price: created.price, category: created.category, stock_quantity: created.stock_quantity }
    });
  }
  renderAdminProducts();
  renderProducts();
  ['newProdName','newProdPrice','newProdIcon','newProdStock','newProdDesc'].forEach(id => { const el = document.getElementById(id); if (el) el.value = ''; });
  if (document.getElementById('newProdBadge')) document.getElementById('newProdBadge').value = '';
  if (document.getElementById('newProdCat'))   document.getElementById('newProdCat').value = '';
  toggleAddProductForm();
  showToast(`✅ "${name}" imeongezwa kwenye orodha ya bidhaa!`, 'success');
}

// ── Services Panel ──────────────────────────────────────────
function renderAdminServices() {
  const container = document.getElementById('adminServicesList');
  const empty     = document.getElementById('adminServicesEmpty');
  if (!container) return;
  if (!SERVICES.length) {
    container.innerHTML = '';
    if (empty) empty.style.display = 'block';
    return;
  }
  if (empty) empty.style.display = 'none';

  const coreServices    = SERVICES.filter(s => CORE_SERVICE_CATEGORIES.includes(s.category));
  const digitalServices = SERVICES.filter(s => s.category === 'dijital-mawasiliano');

  function buildServiceRow(s) {
    return `
    <div>
      <div class="admin-service-item">
        <span style="font-size:28px;flex-shrink:0;">${s.icon}</span>
        <div style="flex:1;min-width:0;">
          <div style="font-family:var(--font-head);font-weight:800;font-size:14px;color:var(--navy);display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
            ${escapeHTML(s.name)}
            ${s.gold ? '<span style="background:var(--gold);color:var(--navy-dark);font-size:10px;font-weight:800;padding:2px 8px;border-radius:50px;font-family:var(--font-head);">⭐ PREMIUM</span>' : ''}
          </div>
          <div style="font-size:12px;color:var(--gray-500);margin-top:3px;">
            <b style="color:var(--navy);">${escapeHTML(s.price)}</b> ·
            <span style="color:var(--gray-400);">${getCatLabel(s.category)}</span> ·
            <span style="color:var(--gray-500);">${(s.requirements||[]).length} mahitaji</span>
          </div>
        </div>
        <div style="display:flex;gap:7px;flex-shrink:0;">
          <button class="admin-btn" style="padding:6px 13px;font-size:11.5px;" onclick="toggleServiceEdit('${s.id}')">✏️ Hariri</button>
          <button class="admin-btn" style="padding:6px 13px;font-size:11.5px;color:var(--danger);border-color:rgba(220,38,38,0.4);" onclick="deleteService('${s.id}')">🗑️</button>
        </div>
      </div>
      <div id="svcEdit_${s.id}" class="admin-svc-edit-box" style="display:none;">
        <div class="mgmt-grid-2">
          <div class="form-group" style="margin:0;">
            <label class="form-label">📝 Jina la Huduma</label>
            <input class="form-input" type="text" id="editSvcName_${s.id}" value="${escapeAttr(s.name)}">
          </div>
          <div class="form-group" style="margin:0;">
            <label class="form-label">💰 Bei (maandishi)</label>
            <input class="form-input" type="text" id="editSvcPrice_${s.id}" value="${escapeAttr(s.price)}" placeholder="TZS 5,000 au TZS 300/ukurasa">
          </div>
          <div class="form-group" style="margin:0;">
            <label class="form-label">😊 Ikoni (emoji)</label>
            <input class="form-input" type="text" id="editSvcIcon_${s.id}" value="${escapeAttr(s.icon)}" maxlength="4">
          </div>
          <div class="form-group" style="margin:0;">
            <label class="form-label">📂 Kategoria</label>
            <select class="form-input" id="editSvcCat_${s.id}">
              <option value="huduma"               ${s.category==='huduma'?'selected':''}>🖨️ Huduma za Kawaida</option>
              <option value="picha"                ${s.category==='picha'?'selected':''}>📸 Picha</option>
              <option value="kitaalamu"            ${s.category==='kitaalamu'?'selected':''}>💼 Kitaalamu</option>
              <option value="serikali"             ${s.category==='serikali'?'selected':''}>🏛️ Huduma za Serikali</option>
              <option value="dijital-mawasiliano"  ${s.category==='dijital-mawasiliano'?'selected':''}>📡 Kidijitali &amp; Mawasiliano</option>
            </select>
          </div>
        </div>
        <div class="form-group" style="margin-bottom:12px;">
          <label class="form-label">📄 Maelezo ya Huduma</label>
          <textarea class="form-input" id="editSvcDesc_${s.id}" rows="3" style="resize:vertical;">${escapeHTML(s.desc)}</textarea>
        </div>
        <div class="form-group" style="margin-bottom:12px;">
          <label class="form-label">📋 Mahitaji ya Mteja <span style="font-size:10px;color:var(--gray-400);text-transform:none;font-weight:400;">(kila mstari mpya = mahitaji moja)</span></label>
          <textarea class="form-input" id="editSvcReqs_${s.id}" rows="5" style="resize:vertical;font-size:13px;line-height:1.7;">${(s.requirements||[]).join('\n')}</textarea>
        </div>
        <div class="form-group" style="margin-bottom:14px;">
          <label style="display:flex;align-items:center;gap:10px;cursor:pointer;font-family:var(--font-head);font-size:13px;font-weight:700;color:var(--gray-700);padding:10px 14px;border:1.5px solid var(--gray-200);border-radius:var(--radius-sm);">
            <input type="checkbox" id="editSvcGold_${s.id}" ${s.gold?'checked':''} style="width:16px;height:16px;accent-color:var(--gold);cursor:pointer;">
            ⭐ Huduma ya Premium (mstari wa dhahabu)
          </label>
        </div>
        <div style="display:flex;gap:8px;">
          <button class="admin-btn primary" onclick="saveServiceEdit('${s.id}')">💾 Hifadhi Mabadiliko</button>
          <button class="admin-btn" onclick="toggleServiceEdit('${s.id}')">✕ Ghairi</button>
        </div>
      </div>
    </div>`;
  }

  // ── Section label helper ──────────────────────────────────────────────────
  function sectionHeader(icon, label, count, color) {
    return `<div style="display:flex;align-items:center;gap:10px;padding:10px 14px;background:${color};border-radius:var(--radius-sm);margin-bottom:6px;margin-top:8px;">
      <span style="font-size:20px;">${icon}</span>
      <span style="font-family:var(--font-head);font-weight:800;font-size:13px;color:var(--navy);text-transform:uppercase;letter-spacing:0.6px;">${label}</span>
      <span style="margin-left:auto;background:var(--navy);color:#fff;font-size:11px;font-weight:700;padding:2px 9px;border-radius:50px;font-family:var(--font-head);">${count}</span>
    </div>`;
  }

  let html = '';

  if (coreServices.length) {
    html += sectionHeader('🖨️', 'Huduma za Karatasi & Kawaida', coreServices.length, 'rgba(0,48,135,0.06)');
    html += coreServices.map(buildServiceRow).join('');
  }

  if (digitalServices.length) {
    html += sectionHeader('📡', 'Huduma za Kidijitali & Mawasiliano', digitalServices.length, 'rgba(255,198,0,0.12)');
    html += digitalServices.map(buildServiceRow).join('');
  }

  container.innerHTML = html;
}

function toggleServiceEdit(id) {
  const box = document.getElementById(`svcEdit_${id}`);
  if (!box) return;
  const isOpen = box.style.display !== 'none';
  document.querySelectorAll('[id^="svcEdit_"]').forEach(b => b.style.display = 'none');
  if (!isOpen) { box.style.display = 'block'; box.scrollIntoView({behavior:'smooth',block:'nearest'}); }
}

function saveServiceEdit(id) {
  const svc = SERVICES.find(s => s.id === id);
  if (!svc) return;
  const newName  = document.getElementById(`editSvcName_${id}`)?.value.trim();
  const newPrice = document.getElementById(`editSvcPrice_${id}`)?.value.trim();
  const newIcon  = document.getElementById(`editSvcIcon_${id}`)?.value.trim();
  const newCat   = document.getElementById(`editSvcCat_${id}`)?.value;
  const newDesc  = document.getElementById(`editSvcDesc_${id}`)?.value.trim();
  const newGold  = document.getElementById(`editSvcGold_${id}`)?.checked || false;
  const reqsRaw  = document.getElementById(`editSvcReqs_${id}`)?.value || '';
  if (newName)  svc.name  = newName;
  if (newPrice) svc.price = newPrice;
  if (newIcon)  svc.icon  = newIcon;
  if (newCat)   svc.category = newCat;
  if (newDesc)  svc.desc  = newDesc;
  svc.gold = newGold;
  svc.requirements = reqsRaw.split('\n').map(r => r.trim()).filter(r => r.length > 0);
  saveAdminServiceData();
  renderAdminServices();
  renderServices();
  // If this service is in the digital section, also update that section's order buttons
  if (svc.category === 'dijital-mawasiliano') {
    // Refresh the button label in the static digital section card (name only — layout is static HTML)
    const allOrderBtns = document.querySelectorAll('#digitalServicesSection .order-direct-btn');
    allOrderBtns.forEach(btn => {
      const onclickVal = btn.getAttribute('onclick') || '';
      if (onclickVal.includes(`'${svc.id}'`)) {
        // Button already wired; nothing to change structurally
      }
    });
  }
  showToast(`✅ Huduma "${svc.name}" imesasishwa!`, 'success');
}

function deleteService(id) {
  const svc = SERVICES.find(s => s.id === id);
  if (!svc) return;
  if (!confirm(`Futa huduma ya "${svc.name}" kabisa?`)) return;
  SERVICES.splice(SERVICES.findIndex(s => s.id === id), 1);
  saveAdminServiceData();
  renderAdminServices();
  renderServices();
  showToast(`🗑️ Huduma "${svc.name}" imefutwa.`, 'info');
}

function toggleAddServiceForm() {
  const form = document.getElementById('addServiceForm');
  if (form) { form.style.display = form.style.display === 'none' ? 'block' : 'none'; form.scrollIntoView({behavior:'smooth',block:'nearest'}); }
}

function addNewService() {
  const name  = document.getElementById('newSvcName')?.value.trim();
  const price = document.getElementById('newSvcPrice')?.value.trim();
  const icon  = document.getElementById('newSvcIcon')?.value.trim() || '🛠️';
  const cat   = document.getElementById('newSvcCat')?.value || 'huduma';
  const desc  = document.getElementById('newSvcDesc')?.value.trim();
  const gold  = document.getElementById('newSvcGold')?.checked || false;
  const reqsRaw = document.getElementById('newSvcReqs')?.value || '';
  const requirements = reqsRaw.split('\n').map(r => r.trim()).filter(r => r.length > 0);
  if (!name)                  { showToast('⚠️ Weka jina la huduma.', 'error'); return; }
  if (!price)                 { showToast('⚠️ Weka bei ya huduma.', 'error'); return; }
  if (!desc)                  { showToast('⚠️ Weka maelezo ya huduma.', 'error'); return; }
  if (!requirements.length)   { showToast('⚠️ Weka angalau mahitaji moja.', 'error'); return; }
  SERVICES.push({ id: 's' + Date.now(), name, price, icon, category: cat, desc, gold, requirements });
  saveAdminServiceData();
  renderAdminServices();
  renderServices();
  ['newSvcName','newSvcPrice','newSvcIcon','newSvcDesc','newSvcReqs'].forEach(id => { const el = document.getElementById(id); if (el) el.value = ''; });
  if (document.getElementById('newSvcGold')) document.getElementById('newSvcGold').checked = false;
  if (document.getElementById('newSvcCat'))  document.getElementById('newSvcCat').value = 'huduma';
  toggleAddServiceForm();
  if (cat === 'dijital-mawasiliano') {
    showToast(`✅ Huduma ya kidijitali "${name}" imeongezwa! Itaonekana katika sehemu ya 📡 Kidijitali & Mawasiliano kwenye tovuti.`, 'success');
  } else {
    showToast(`✅ Huduma "${name}" imeongezwa kikamilifu!`, 'success');
  }
}

// =========================================================
// ===== SETUP: Save Whapi Credentials =====
// =========================================================
function saveWhapiCredentials() {
  const token = document.getElementById('setupWhapiToken')?.value.trim();
  const phone = document.getElementById('setupOwnerPhone')?.value.trim();
  if (!token && !phone) { showToast('⚠️ Weka angalau token au namba ya simu.', 'error'); return; }
  if (token) { localStorage.setItem('letema_whapi_token', token); window._whapiToken = token; }
  if (phone) {
    if (!/^\d{10,15}$/.test(phone)) { showToast('⚠️ Namba ya simu si sahihi. Mfano: 255620642652', 'error'); return; }
    localStorage.setItem('letema_owner_phone', phone); window._ownerPhone = phone;
  }
  showToast('✅ Credentials zimehifadhiwa. Zitatumika mara moja.', 'success');
}

async function testWhapiConnection() {
  const token   = window._whapiToken || localStorage.getItem('letema_whapi_token') || WHAPI_TOKEN;
  const phone   = window._ownerPhone || localStorage.getItem('letema_owner_phone') || OWNER_PHONE;
  if (!token) { showToast('⚠️ Weka Whapi token kwanza.', 'error'); return; }
  showToast('⏳ Inajaribu muunganisho wa Whapi...', 'info');
  const result = await sendWhatsAppMessage(phone, '🧪 Jaribio la muunganisho kutoka Letema Admin Dashboard. Imefanikiwa!');
  if (result.success) {
    showToast('✅ Muunganisho wa Whapi unafanya kazi vizuri! Ujumbe wa majaribio umetumwa.', 'success');
  } else {
    showToast(`❌ Muunganisho umeshindwa: ${result.error || 'Hitilafu isiyojulikana'}. Angalia token yako.`, 'error');
  }
}

// =========================================================
// ===== SETUP: Save & Test Google Apps Script URL =====
// =========================================================
function saveAppsScriptUrl() {
  const url = (document.getElementById('webhookUrlInput')?.value || '').trim();
  if (!url) { showToast('⚠️ Weka Apps Script URL kwanza.', 'error'); return; }
  if (!url.startsWith('https://script.google.com/')) {
    showToast('⚠️ URL lazima ianze na https://script.google.com/', 'error');
    return;
  }
  localStorage.setItem('letema_apps_script_url', url);
  window._appsScriptUrl = url;
  showToast('✅ Google Drive URL imehifadhiwa! Faili za huduma zitatumwa kwenye Drive yako.', 'success');
}

async function testAppsScriptUrl() {
  const url = (document.getElementById('webhookUrlInput')?.value || '').trim()
              || window._appsScriptUrl
              || localStorage.getItem('letema_apps_script_url');
  const resultBox = document.getElementById('appsScriptTestResult');
  if (!url) {
    showToast('⚠️ Weka Apps Script URL kwanza.', 'error');
    return;
  }
  if (resultBox) {
    resultBox.style.display = 'block';
    resultBox.style.background = '#fef3c7'; resultBox.style.color = '#92400e'; resultBox.style.border = '1px solid #fde68a';
    resultBox.textContent = '⏳ Inajaribu muunganisho...';
  }
  try {
    const resp = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ _test: true, message: 'Letema Admin ping' })
    });
    const json = await resp.json();
    if (resultBox) {
      if (json && (json.success || json.pong)) {
        resultBox.style.background = '#dcfce7'; resultBox.style.color = '#166534'; resultBox.style.border = '1px solid #bbf7d0';
        resultBox.textContent = '✅ Muunganisho wa Google Drive unafanya kazi vizuri!';
      } else {
        resultBox.style.background = '#fef3c7'; resultBox.style.color = '#92400e'; resultBox.style.border = '1px solid #fde68a';
        resultBox.textContent = '⚠️ Script ilijibu lakini haikupata faili. Jibu: ' + JSON.stringify(json).slice(0, 100);
      }
    }
  } catch(e) {
    if (resultBox) {
      resultBox.style.background = '#fee2e2'; resultBox.style.color = '#991b1b'; resultBox.style.border = '1px solid #fecaca';
      resultBox.textContent = '❌ Muunganisho umeshindwa: ' + e.message + '. Angalia CORS settings za Apps Script.';
    }
  }
}

// =========================================================
// ===== ADMIN ACTIVITY LOG (Local + Supabase) =====
// =========================================================
const LOCAL_ACTIVITY_KEY  = 'letema_admin_activity_log';
const LOCAL_ACTIVITY_MAX  = 500;

function logAdminActivity(action, status = 'success', meta = {}) {
  try {
    const entry = {
      ts: new Date().toISOString(),
      action,
      status,
      meta,
      ua: (navigator.userAgent || '').slice(0, 120)
    };
    const raw = localStorage.getItem(LOCAL_ACTIVITY_KEY);
    const list = raw ? JSON.parse(raw) : [];
    list.unshift(entry);
    if (list.length > LOCAL_ACTIVITY_MAX) list.length = LOCAL_ACTIVITY_MAX;
    localStorage.setItem(LOCAL_ACTIVITY_KEY, JSON.stringify(list));

    // Mirror to Supabase audit log if connected
    if (window.letemaSupabase) {
      try {
        window.letemaSupabase.audit({
          actor: 'admin',
          action: 'admin.' + action,
          entity: 'admin_panel',
          meta: Object.assign({ status }, meta)
        });
      } catch (e) { /* silent */ }
    }
  } catch (e) {
    console.warn('[ActivityLog] Failed to record:', e);
  }
}

function getLocalActivityLog() {
  try {
    const raw = localStorage.getItem(LOCAL_ACTIVITY_KEY);
    return raw ? JSON.parse(raw) : [];
  } catch (e) { return []; }
}

function renderLocalActivityLog() {
  const tbody = document.getElementById('localActivityLogBody');
  if (!tbody) return;
  const list = getLocalActivityLog();
  if (!list.length) {
    tbody.innerHTML = '<tr><td colspan="4" style="padding:20px;text-align:center;color:var(--gray-500);">Hakuna kumbukumbu bado.</td></tr>';
    return;
  }
  const fmtTime = (iso) => {
    try { const d = new Date(iso); return d.toLocaleString('sw-TZ'); } catch(e){ return iso; }
  };
  const statusBadge = (s) => {
    const colors = { success:'#16a34a', fail:'#dc2626', info:'#2563eb', warn:'#d97706' };
    return `<span style="background:${colors[s]||'#6b7280'};color:white;padding:2px 8px;border-radius:10px;font-size:11px;font-weight:700;">${s}</span>`;
  };
  const actionLabels = {
    'login': '🔓 Login',
    'login_fail': '⛔ Login Fail',
    'logout': '🚪 Logout',
    'dashboard_open': '📊 Open Dashboard',
    'tab_switch': '🔀 Tab Switch',
    'password_change': '🔒 Password Change',
    'password_recovery': '🔑 Password Recovery',
    'recovery_code_new': '♻️ New Recovery Code',
    'easter_egg_unlock': '🥚 Easter Egg Unlock'
  };
  tbody.innerHTML = list.map((e, idx) => `
    <tr style="border-bottom:1px solid var(--gray-100);background:${idx%2?'var(--gray-50)':'white'};">
      <td style="padding:8px;white-space:nowrap;color:var(--gray-700);">${fmtTime(e.ts)}</td>
      <td style="padding:8px;font-weight:600;color:var(--navy);">${actionLabels[e.action] || e.action}</td>
      <td style="padding:8px;">${statusBadge(e.status)}</td>
      <td style="padding:8px;color:var(--gray-600);font-size:11.5px;">${
        e.meta && Object.keys(e.meta).length ? escapeHtml(JSON.stringify(e.meta)) : '—'
      }</td>
    </tr>
  `).join('');
}

function escapeHtml(str) { return escapeHTML(str); }

function exportLocalActivityCSV() {
  const list = getLocalActivityLog();
  if (!list.length) { showToast('⚠️ Hakuna kumbukumbu za kuhamisha.', 'error'); return; }
  const headers = ['timestamp','action','status','meta','user_agent'];
  const rows = list.map(e => [
    e.ts,
    e.action,
    e.status,
    JSON.stringify(e.meta || {}),
    e.ua || ''
  ]);
  const csv = [headers, ...rows]
    .map(r => r.map(c => `"${String(c).replace(/"/g,'""')}"`).join(','))
    .join('\n');
  const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `letema_admin_activity_${new Date().toISOString().slice(0,10)}.csv`;
  a.click();
  URL.revokeObjectURL(url);
  showToast('✅ Activity log imehamishwa kama CSV.', 'success');
}

function clearLocalActivityLog() {
  if (!confirm('Una uhakika unataka KUFUTA kumbukumbu zote za activity log? Kitendo hiki hakirudishwi.')) return;
  localStorage.removeItem(LOCAL_ACTIVITY_KEY);
  renderLocalActivityLog();
  logAdminActivity('logout', 'info', { note: 'activity_log_cleared' });
  showToast('🗑️ Activity log imefutwa.', 'success');
}

// =========================================================
// ===== CLOUD ADMIN ACTIVITY TIMELINE (Supabase, synced) =====
// =========================================================
async function renderCloudAdminTimeline() {
  const box = document.getElementById('cloudAdminTimeline');
  if (!box) return;
  if (!window.letemaSupabase) {
    box.innerHTML = '<div style="text-align:center;color:var(--gray-500);padding:24px;">⚠️ Supabase haijaungwa.</div>';
    return;
  }
  box.innerHTML = '<div style="text-align:center;color:var(--gray-500);padding:24px;">⏳ Inapakia timeline...</div>';
  let rows = [];
  try {
    rows = await window.letemaSupabase.fetchAdminActivityLog({ limit: 200 });
  } catch (e) {
    box.innerHTML = '<div style="text-align:center;color:var(--danger);padding:24px;">❌ Imeshindikana kupakia: ' + escapeHtml(e.message || e) + '</div>';
    return;
  }
  if (!rows.length) {
    box.innerHTML = '<div style="text-align:center;color:var(--gray-500);padding:24px;">Hakuna kumbukumbu za admin kwenye Cloud bado.</div>';
    return;
  }
  const fmtTime = (iso) => { try { return new Date(iso).toLocaleString('sw-TZ'); } catch(e){ return iso; } };
  const iconFor = (action) => {
    const a = (action || '').replace(/^admin\./, '');
    const map = {
      'login': '🔓', 'login_fail': '⛔', 'login_lockout': '🔒',
      'logout': '🚪', 'dashboard_open': '📊', 'tab_switch': '🔀',
      'password_change': '🔒', 'password_recovery': '🔑',
      'recovery_code_new': '♻️', 'easter_egg_unlock': '🥚',
      'activity_log_cleared': '🗑️'
    };
    return map[a] || '📝';
  };
  const colorFor = (status) => ({ success:'#16a34a', fail:'#dc2626', info:'#2563eb', warn:'#d97706' }[status] || '#6b7280');
  box.innerHTML = `
    <div style="position:relative;padding-left:22px;">
      <div style="position:absolute;left:9px;top:6px;bottom:6px;width:2px;background:linear-gradient(180deg,var(--navy),var(--gold));border-radius:2px;"></div>
      ${rows.map(r => {
        const meta = r.meta || {};
        const status = meta.status || 'info';
        const action = (r.action || '').replace(/^admin\./, '');
        return `
          <div style="position:relative;margin-bottom:14px;padding:12px 14px;background:white;border:1px solid var(--gray-200);border-radius:10px;box-shadow:0 1px 2px rgba(0,0,0,0.04);">
            <div style="position:absolute;left:-22px;top:14px;width:20px;height:20px;border-radius:50%;background:${colorFor(status)};color:white;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;border:2px solid white;box-shadow:0 0 0 2px ${colorFor(status)};">${iconFor(r.action)}</div>
            <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px;flex-wrap:wrap;">
              <div>
                <div style="font-weight:800;color:var(--navy);font-size:13.5px;">${escapeHtml(action)}</div>
                <div style="font-size:11px;color:var(--gray-500);margin-top:2px;">👤 ${escapeHtml(r.actor || 'admin')} • 🕒 ${fmtTime(r.occurred_at)}</div>
              </div>
              <span style="background:${colorFor(status)};color:white;padding:2px 8px;border-radius:10px;font-size:10.5px;font-weight:700;text-transform:uppercase;">${escapeHtml(status)}</span>
            </div>
            ${Object.keys(meta).length > 1 || (Object.keys(meta).length === 1 && !meta.status) ? `
              <div style="margin-top:6px;padding:6px 8px;background:var(--gray-50);border-radius:6px;font-size:11px;color:var(--gray-700);font-family:monospace;word-break:break-all;">
                ${escapeHtml(JSON.stringify(meta))}
              </div>` : ''}
          </div>`;
      }).join('')}
    </div>
  `;
}

async function clearCloudAdminTimeline() {
  if (!adminLoggedIn) { showToast('⚠️ Lazima uwe admin.', 'error'); return; }
  if (!window.letemaSupabase) { showToast('⚠️ Cloud haijaungwa.', 'error'); return; }
  if (!confirm('🗑️ KUFUTA logi zote za admin kwenye Cloud?\n\nKitendo hiki HAKIRUDISHWI na kitafuta admin activity timeline ya vifaa vyote.')) return;
  const res = await window.letemaSupabase.clearAdminActivityLog();
  if (res && res.error) {
    showToast('❌ Imeshindikana kufuta: ' + (res.error.message || res.error), 'error');
    return;
  }
  showToast('✅ Cloud admin timeline imefutwa.', 'success');
  // Hii ni kitendo cha admin pia — log it (after the clear, so it appears as the new first entry).
  logAdminActivity('activity_log_cleared', 'warn', { scope: 'cloud' });
  setTimeout(() => renderCloudAdminTimeline(), 600);
}

// =========================================================
// ===== ADMIN LOGIN RATE LIMITING & LOCKOUT =====
// Hifadhi: localStorage (per-device) — kuzuia brute-force
// Sera:
//   - Majaribio yasizidi MAX_ATTEMPTS ndani ya WINDOW_MS
//   - Kishindwa zaidi ya MAX_ATTEMPTS ⇒ lock kwa LOCKOUT_MS
//   - Lockout inaongezeka ikiwa ataendelea kushindwa baada ya unlock
// =========================================================
const ADMIN_LOGIN_ATTEMPTS_KEY = 'letema_admin_login_attempts';
const ADMIN_LOGIN_LOCK_KEY     = 'letema_admin_login_lock_until';
const ADMIN_LOGIN_FAIL_STREAK  = 'letema_admin_login_fail_streak';
const MAX_ATTEMPTS  = 5;             // majaribio mabaya yanayoruhusiwa
const WINDOW_MS     = 5 * 60 * 1000; // dirisha la dakika 5
const BASE_LOCKOUT_MS = 60 * 1000;   // dakika 1 ya kwanza
const MAX_LOCKOUT_MS  = 30 * 60 * 1000; // kikomo cha juu: dakika 30

function _getRecentAttempts() {
  try {
    const raw = localStorage.getItem(ADMIN_LOGIN_ATTEMPTS_KEY);
    const arr = raw ? JSON.parse(raw) : [];
    const cutoff = Date.now() - WINDOW_MS;
    return arr.filter(t => t > cutoff);
  } catch(e) { return []; }
}
function _saveAttempts(arr) {
  localStorage.setItem(ADMIN_LOGIN_ATTEMPTS_KEY, JSON.stringify(arr));
}
function _recordFailedAttempt() {
  const list = _getRecentAttempts();
  list.push(Date.now());
  _saveAttempts(list);
  return list.length;
}
function _clearAttempts() {
  localStorage.removeItem(ADMIN_LOGIN_ATTEMPTS_KEY);
  localStorage.removeItem(ADMIN_LOGIN_LOCK_KEY);
  localStorage.removeItem(ADMIN_LOGIN_FAIL_STREAK);
}
function _getLockUntil() {
  const v = parseInt(localStorage.getItem(ADMIN_LOGIN_LOCK_KEY) || '0', 10);
  return isNaN(v) ? 0 : v;
}
function _setLockout() {
  const streak = parseInt(localStorage.getItem(ADMIN_LOGIN_FAIL_STREAK) || '0', 10) + 1;
  localStorage.setItem(ADMIN_LOGIN_FAIL_STREAK, String(streak));
  // Exponential backoff: 1m, 2m, 4m, 8m... capped MAX_LOCKOUT_MS
  const ms = Math.min(BASE_LOCKOUT_MS * Math.pow(2, streak - 1), MAX_LOCKOUT_MS);
  const until = Date.now() + ms;
  localStorage.setItem(ADMIN_LOGIN_LOCK_KEY, String(until));
  return { until, ms, streak };
}
function isAdminLoginLocked() {
  return Date.now() < _getLockUntil();
}
function _formatRemaining(ms) {
  if (ms <= 0) return '0s';
  const totalSec = Math.ceil(ms / 1000);
  const m = Math.floor(totalSec / 60);
  const s = totalSec % 60;
  return m > 0 ? `${m}m ${s.toString().padStart(2,'0')}s` : `${s}s`;
}
let _adminLockoutTimer = null;
function _startLockoutCountdown() {
  const errBox = document.getElementById('adminLoginErr');
  const attemptsBox = document.getElementById('adminLoginAttempts');
  const lockBox = document.getElementById('adminLoginLockout');
  const countdown = document.getElementById('adminLockoutCountdown');
  const loginBtn = document.getElementById('adminLoginBtn');
  const passInput = document.getElementById('adminPassInput');
  if (errBox) errBox.style.display = 'none';
  if (attemptsBox) attemptsBox.style.display = 'none';
  if (lockBox) lockBox.style.display = 'block';
  if (loginBtn) { loginBtn.disabled = true; loginBtn.style.opacity = '0.5'; loginBtn.style.cursor = 'not-allowed'; }
  if (passInput) { passInput.disabled = true; }

  if (_adminLockoutTimer) clearInterval(_adminLockoutTimer);
  const tick = () => {
    const remaining = _getLockUntil() - Date.now();
    if (remaining <= 0) {
      clearInterval(_adminLockoutTimer);
      _adminLockoutTimer = null;
      if (lockBox) lockBox.style.display = 'none';
      if (loginBtn) { loginBtn.disabled = false; loginBtn.style.opacity = ''; loginBtn.style.cursor = ''; }
      if (passInput) { passInput.disabled = false; passInput.focus(); }
      // Lockout imekwisha — futa attempts ili user aanze upya
      localStorage.removeItem(ADMIN_LOGIN_ATTEMPTS_KEY);
      localStorage.removeItem(ADMIN_LOGIN_LOCK_KEY);
      return;
    }
    if (countdown) countdown.textContent = _formatRemaining(remaining);
  };
  tick();
  _adminLockoutTimer = setInterval(tick, 1000);
}

// Auto-resume lockout UI when login overlay opens (handles tab/page reopen)
function _checkAndApplyAdminLockoutOnOpen() {
  if (isAdminLoginLocked()) {
    _startLockoutCountdown();
  }
}

// =========================================================
// ===== RECOVERY CODE MANAGEMENT =====
// =========================================================
const RECOVERY_CODE_KEY = 'letema_admin_recovery_code';

function generateRecoveryCodeString() {
  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
  const block = (n) => {
    let s = ''; for (let i=0;i<n;i++) s += chars[Math.floor(Math.random()*chars.length)];
    return s;
  };
  return `LETEMA-${block(4)}-${block(4)}-${block(4)}`;
}

function getOrCreateRecoveryCode() {
  let code = localStorage.getItem(RECOVERY_CODE_KEY);
  if (!code) {
    code = generateRecoveryCodeString();
    localStorage.setItem(RECOVERY_CODE_KEY, code);
  }
  return code;
}

function refreshRecoveryCodeDisplay() {
  const el = document.getElementById('recoveryCodeDisplay');
  if (el) el.textContent = getOrCreateRecoveryCode();
}

function generateNewRecoveryCode() {
  if (!confirm('Tengeneza Recovery Code mpya? Code ya zamani haitafanya kazi tena.')) return;
  const code = generateRecoveryCodeString();
  localStorage.setItem(RECOVERY_CODE_KEY, code);
  refreshRecoveryCodeDisplay();
  logAdminActivity('recovery_code_new', 'success');
  showToast('♻️ Recovery code mpya imezalishwa. Hifadhi salama!', 'success');
}

function copyRecoveryCode() {
  const code = getOrCreateRecoveryCode();
  navigator.clipboard.writeText(code).then(() => {
    showToast('📋 Recovery code imenakiliwa.', 'success');
  }).catch(() => {
    prompt('Nakili recovery code yako:', code);
  });
}

function downloadRecoveryCode() {
  const code = getOrCreateRecoveryCode();
  const content = `Letema Stationery — Admin Recovery Code\n` +
                  `Generated: ${new Date().toLocaleString('sw-TZ')}\n\n` +
                  `Recovery Code: ${code}\n\n` +
                  `MAELEKEZO:\n` +
                  `1. Hifadhi faili hii mahali salama (notebook, password manager).\n` +
                  `2. Ukisahau nywila ya admin, bofya "Nimesahau nywila?" kwenye login screen.\n` +
                  `3. Weka recovery code hii kuweka nywila mpya.\n`;
  const blob = new Blob([content], { type: 'text/plain;charset=utf-8;' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `letema_recovery_code_${new Date().toISOString().slice(0,10)}.txt`;
  a.click();
  URL.revokeObjectURL(url);
  showToast('📥 Recovery code imepakuliwa.', 'success');
}

// Recovery overlay open/close
function openAdminRecovery() {
  closeAdminLogin();
  const ov = document.getElementById('adminRecoveryOverlay');
  if (ov) ov.classList.add('open');
}
function closeAdminRecovery() {
  const ov = document.getElementById('adminRecoveryOverlay');
  if (ov) ov.classList.remove('open');
  ['recoveryCodeInput','recoveryNewPass','recoveryConfirmPass'].forEach(id => {
    const el = document.getElementById(id); if (el) el.value = '';
  });
  const err = document.getElementById('recoveryErr'); if (err) err.style.display = 'none';
}

function performAdminRecovery() {
  const codeInput  = (document.getElementById('recoveryCodeInput')?.value || '').trim().toUpperCase();
  const newPass    = document.getElementById('recoveryNewPass')?.value || '';
  const confirmPass= document.getElementById('recoveryConfirmPass')?.value || '';
  const errBox     = document.getElementById('recoveryErr');
  const showErr = (msg) => { if (errBox) { errBox.textContent = '⚠️ ' + msg; errBox.style.display = 'block'; } };

  if (!codeInput) return showErr('Weka recovery code.');
  if (!newPass || newPass.length < 8) return showErr('Nywila mpya lazima iwe na herufi 8+.');
  if (newPass !== confirmPass) return showErr('Nywila mpya hazifanani.');

  const stored = localStorage.getItem(RECOVERY_CODE_KEY);
  const isMaster = (codeInput === 'LETEMA-RESET-DEFAULT');

  if (!isMaster && (!stored || codeInput !== stored)) {
    logAdminActivity('password_recovery', 'fail', { reason: 'invalid_code' });
    return showErr('Recovery code si sahihi.');
  }

  if (isMaster) {
    // Factory reset to default password
    localStorage.removeItem('letema_admin_password');
    logAdminActivity('password_recovery', 'success', { method: 'master_reset' });
    closeAdminRecovery();
    showToast('✅ Nywila imerejeshwa kuwa default (Letema123@). Badilisha mara moja!', 'success');
    setTimeout(() => openAdminLogin(), 600);
    return;
  }

  // Use recovery code: set new password and rotate the recovery code
  localStorage.setItem('letema_admin_password', newPass);
  const newCode = generateRecoveryCodeString();
  localStorage.setItem(RECOVERY_CODE_KEY, newCode);
  logAdminActivity('password_recovery', 'success', { method: 'recovery_code', new_code_generated: true });
  closeAdminRecovery();
  showToast(`✅ Nywila imebadilishwa. Recovery code mpya: ${newCode} (hifadhi salama!)`, 'success');
  // Show a persistent alert with the new code
  setTimeout(() => alert(`Recovery Code MPYA yako:\n\n${newCode}\n\nIhifadhi salama — utaihitaji ukisahau nywila tena.`), 800);
  setTimeout(() => openAdminLogin(), 600);
}

// =========================================================
// ===== SETUP: Change Admin Password =====
// =========================================================
function changeAdminPassword() {
  const oldPass     = document.getElementById('setupOldPass')?.value;
  const newPass     = document.getElementById('setupNewPass')?.value;
  const confirmPass = document.getElementById('setupConfirmPass')?.value;

  const currentPassword = localStorage.getItem('letema_admin_password') || ADMIN_PASSWORD;
  if (oldPass !== currentPassword) {
    logAdminActivity('password_change', 'fail', { reason: 'wrong_old_password' });
    showToast('❌ Nywila ya sasa si sahihi.', 'error'); return;
  }
  if (!newPass || newPass.length < 8) { showToast('⚠️ Nywila mpya lazima iwe na herufi 8+.', 'error'); return; }
  if (newPass !== confirmPass) { showToast('⚠️ Nywila mpya hazifanani.', 'error'); return; }

  localStorage.setItem('letema_admin_password', newPass);
  ['setupOldPass','setupNewPass','setupConfirmPass'].forEach(id => {
    const el = document.getElementById(id); if (el) el.value = '';
  });
  logAdminActivity('password_change', 'success');
  showToast('✅ Nywila ya admin imebadilishwa. Tumia nywila mpya mara ijayo.', 'success');
}

// One-time forced password reset for v5 release — ensures admin can ALWAYS
// log in with the canonical password 'Letema123@' regardless of any old
// runtime-stored password from previous versions.
(function forceAdminPasswordResetV6(){
  try {
    const FLAG = 'letema_pass_reset_v6';
    if (!localStorage.getItem(FLAG)) {
      localStorage.removeItem('letema_admin_password');
      localStorage.setItem(FLAG, '1');
      console.info('[Letema v6] Admin password reset to default: Letema123@');
    }
  } catch(e) { /* ignore */ }
})();

// Override adminLogin to check runtime-stored password first
// (patch applied after original function — redefine it)
function adminLogin() {
  // ===== Rate-limit gate (kuzuia brute force) =====
  if (isAdminLoginLocked()) {
    _startLockoutCountdown();
    showToast('🔒 Akaunti imefungwa kwa muda. Subiri muda uishe.', 'error');
    logAdminActivity('login_lockout', 'warn', { stage: 'blocked_attempt' });
    return;
  }

  const passInput = document.getElementById('adminPassInput');
  const pass    = passInput ? passInput.value : '';
  const stored  = localStorage.getItem('letema_admin_password');
  const current = stored || ADMIN_PASSWORD;

  // Accept either the runtime-stored password OR the canonical default.
  if (pass === current || pass === ADMIN_PASSWORD) {
    // ✅ SUCCESS — futa attempts/lock yote
    _clearAttempts();
    adminLoggedIn = true;
    unreadOrderCount = 0;
    updateUnreadBadge();
    closeAdminLogin();
    document.getElementById('adminDashboard').style.display = '';
    document.getElementById('adminDashboard').classList.add('open');
    switchAdminTab('orders');
    logAdminActivity('login', 'success');
    logAdminActivity('dashboard_open', 'info');
    getOrCreateRecoveryCode();
    refreshRecoveryCodeDisplay();
    if (window.letemaSupabase) {
      window.letemaSupabase.audit({ actor: 'admin', action: 'auth.login', entity: 'auth' });
    }
    const savedToken = localStorage.getItem('letema_whapi_token');
    const savedPhone = localStorage.getItem('letema_owner_phone');
    if (savedToken) { const el = document.getElementById('setupWhapiToken'); if(el) el.placeholder = '••••••••••• (imehifadhiwa)'; }
    if (savedPhone) { const el = document.getElementById('setupOwnerPhone'); if(el) el.placeholder = savedPhone; }
  } else {
    // ❌ FAIL — record na angalia kama tumefikia kikomo
    const failCount = _recordFailedAttempt();
    const remaining = MAX_ATTEMPTS - failCount;
    logAdminActivity('login_fail', 'fail', {
      reason: 'wrong_password',
      attempted_len: pass.length,
      fail_count_window: failCount,
      remaining_attempts: Math.max(0, remaining)
    });

    document.getElementById('adminLoginErr').style.display = 'block';
    const attemptsBox = document.getElementById('adminLoginAttempts');

    if (failCount >= MAX_ATTEMPTS) {
      // 🔒 Lockout!
      const { ms, streak } = _setLockout();
      logAdminActivity('login_lockout', 'warn', {
        reason: 'too_many_attempts',
        fail_count: failCount,
        lockout_ms: ms,
        lockout_streak: streak
      });
      _startLockoutCountdown();
      showToast(`🔒 Umejaribu mara nyingi. Akaunti imefungwa kwa ${_formatRemaining(ms)}.`, 'error');
    } else {
      if (attemptsBox) {
        attemptsBox.style.display = 'block';
        attemptsBox.textContent = `⚠️ Majaribio ${failCount}/${MAX_ATTEMPTS}. Yaliyobaki: ${remaining}.`;
      }
      passInput && passInput.select();
    }
  }
}


// =========================================================
// ===== WHAPI send — use runtime credentials ===== 
// =========================================================
async function sendWhatsAppMessage(to, body) {
  const token    = window._whapiToken || localStorage.getItem('letema_whapi_token') || WHAPI_TOKEN;
  const phone    = String(to).replace(/^\+/, '').replace(/\s/g, '');
  const recipient = phone.includes('@') ? phone : `${phone}@s.whatsapp.net`;

  if (!token) {
    console.warn('[Whapi] No token configured — falling back to wa.me');
    return { success: false, error: 'no_token' };
  }

  try {
    const resp = await fetch(WHAPI_URL, {
      method:  'POST',
      headers: {
        'Authorization': `Bearer ${token}`,
        'Content-Type':  'application/json',
        'Accept':        'application/json',
      },
      body: JSON.stringify({ to: recipient, body })
    });

    if (!resp.ok) {
      const errData = await resp.json().catch(() => ({}));
      console.warn('[Whapi] API error', resp.status, errData);
      return { success: false, error: `HTTP ${resp.status}` };
    }

    const data = await resp.json();
    return { success: true, data };

  } catch (e) {
    console.warn('[Whapi] Network error:', e.message);
    return { success: false, error: e.message };
  }
}

