  {id:'s9',  name:'TRA — Usajili wa TIN',           price:'TZS 5,000',          icon:'🏦', category:'serikali',  desc:'Tunatusaidia kupata Nambari ya Utambuzi wa Mlipa Kodi (TIN) kutoka Mamlaka ya Mapato Tanzania (TRA). Inafaa wafanyabiashara, wafanyakazi wapya na kampuni zinazosajiliwa. Mchakato haraka ndani ya siku 1-2.', gold:false,
    requirements:['Kitambulisho cha taifa (NIDA card) chenye nambari ya NIDA', 'Namba ya simu ya mtumiaji inayofanya kazi (M-Pesa, Tigo au Airtel)', 'Kama ni kampuni: Cheti cha usajili wa BRELA na jina la kampuni', 'Anwani ya makazi au ofisi halisi (mtaa, wilaya, mkoa)']},

  {id:'s10', name:'HESLB — Maombi ya Mkopo',        price:'TZS 3,000',          icon:'🎓', category:'serikali',  desc:'Tunaongoza na kusaidia kujaza fomu za mkopo wa elimu ya juu kutoka Bodi ya Mikopo ya Wanafunzi wa Elimu ya Juu (HESLB). Tunasaidia kuandaa nyaraka zote zinazohitajika ikiwemo mwanzo hadi mwisho wa mchakato.', gold:false,
    requirements:['Barua ya udahili (admission letter) kutoka chuo chako', 'Kitambulisho cha taifa (NIDA) au cheti cha kuzaliwa', 'Nambari ya TIN ya mzazi/mlezi (kama inajulikana)', 'Hali ya kipato cha mzazi/mlezi — hati kama vile payslip au barua ya mkazi', 'Akaunti ya HESLB portal (kama unayo) au tutakusaidia kuunda mpya']},

  {id:'s11', name:'Ajira Portal — Maombi ya Kazi',  price:'TZS 3,000',          icon:'💼', category:'serikali',  fileUpload:true, desc:'Usaidizi kamili wa kujiandikisha na kutuma maombi ya kazi kupitia Mfumo wa Ajira wa Serikali (Ajira Portal). Tunasaidia kuunda akaunti, kupakua CV, kujaza fomu na kufuatilia hali ya maombi yako.', gold:false,
    requirements:['CV yako ya kisasa (PDF au Word) — tutakuandikia kama huna', 'Vyeti vya elimu: matokeo ya kidato, diploma au shahada (scanned copies)', 'Kitambulisho cha taifa chenye namba ya NIDA', 'Barua pepe inayofanya kazi (email address) — tutakusaidia kuunda kama huna', 'Jina la nafasi unayoomba au nambari ya tangazo (kama unajua)']},

  {id:'s12', name:'Passport & Visa — Maombi',       price:'TZS 5,000',          icon:'✈️', category:'serikali',  fileUpload:true, desc:'Tunakusaidia kujaza na kuwasilisha fomu za maombi ya passport ya Tanzania na visa za nchi mbalimbali. Tunashughulikia nyaraka za kwanza, upya wa passport na maombi ya visa za biashara, utalii na masomo.', gold:true,
    requirements:['Kitambulisho cha taifa (NIDA card) — asili na nakala', 'Cheti cha kuzaliwa asili au halisi', 'Picha 2 za pasipoti (au tutapiga hapa dukani)', 'Kwa upya wa pasipoti: pasipoti ya zamani na cheti cha ndoa (kama jina limebadilika)', 'Kwa visa: barua ya mwaliko, mpango wa safari, au cheti cha kusajiliwa shuleni']},

  {id:'s13', name:'RITA — Usajili wa Vizazi & Ndoa', price:'TZS 4,000',          icon:'📋', category:'serikali',  desc:'Msaada wa ukamilifu katika usajili wa vizazi (cheti cha kuzaliwa), ndoa, vifo na kubadilisha jina kupitia Wakala wa Usajili, Ufilisi na Udhamini (RITA). Tunajua taratibu sahihi na tunakusaidia kufika haraka.', gold:false,
