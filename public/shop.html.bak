        <div class="form-group">
          <label class="form-label">📄 Matumizi ya Picha <span style="color:var(--gray-400);text-transform:none;font-weight:400;">(hiari)</span></label>
          <select class="form-input" id="dynPhotoUse">
            <option value="Passport">🛂 Passport</option>
            <option value="Kitambulisho cha Taifa (NIDA)">🪪 Kitambulisho cha Taifa (NIDA)</option>
            <option value="Visa">✈️ Visa</option>
            <option value="Chuo / Shule">🎓 Chuo / Shule</option>
            <option value="Nyingine">📎 Nyingine</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">🔢 Idadi ya Nakala <span style="color:var(--danger)">*</span></label>
          <input class="form-input" type="number" min="1" value="4" placeholder="Mfano: 6" id="dynPhotoCopies">
          <div class="form-hint">Kawaida pasipoti inahitaji nakala 4–8</div>
        </div>
        <div class="form-group">
          <label class="form-label">📝 Maelezo ya Ziada <span style="color:var(--gray-400);text-transform:none;font-weight:400;">(hiari)</span></label>
          <textarea class="form-input" rows="2" placeholder="Mfano: Background nyeupe, ukubwa maalum, nk." id="dynNotes" style="resize:vertical;"></textarea>
        </div>`;

    // ── s8: Huduma za Mtandaoni ────────────────────────────────────────────
    case 's8':
      return divider + `
        <div class="form-group">
          <label class="form-label">🌐 Aina ya Huduma ya Mtandaoni <span style="color:var(--danger)">*</span></label>
          <div class="radio-group" id="dynOnlineGroup" style="flex-direction:column;gap:6px;">
            <label class="radio-option selected" onclick="selectRadioOpt(this,'dynOnlineGroup')">
              <input type="radio" name="dynOnline" value="NIDA — Usajili / Kadi ya Taifa" checked> 🪪 NIDA — Usajili / Kadi ya Taifa
            </label>
            <label class="radio-option" onclick="selectRadioOpt(this,'dynOnlineGroup')">
              <input type="radio" name="dynOnline" value="RITA — Usajili wa Kuzaliwa / Ndoa / Kifo"> 📜 RITA — Kuzaliwa / Ndoa / Kifo
            </label>
            <label class="radio-option" onclick="selectRadioOpt(this,'dynOnlineGroup')">
              <input type="radio" name="dynOnline" value="TRA — Namba ya Mlipakodi (TIN) / Kodi ya VAT"> 🏦 TRA — TIN / VAT
            </label>
            <label class="radio-option" onclick="selectRadioOpt(this,'dynOnlineGroup')">
              <input type="radio" name="dynOnline" value="HESLB — Ombi la Mkopo wa Elimu"> 🎓 HESLB — Mkopo wa Elimu
            </label>
            <label class="radio-option" onclick="selectRadioOpt(this,'dynOnlineGroup')">
              <input type="radio" name="dynOnline" value="Fomu Nyingine ya Serikali"> 📋 Fomu Nyingine ya Serikali
            </label>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">📱 Nambari ya Simu au Akaunti ID <span style="color:var(--danger)">*</span></label>
          <input class="form-input" type="text" placeholder="Mfano: 0712345678 au ID-123456" id="dynOnlinePhoneId">
          <div class="form-hint">Nambari ya simu iliyosajiliwa au nambari ya akaunti yako</div>
        </div>
        <div class="form-group">
          <label class="form-label">📎 Pakia Hati za Kusaidia <span style="color:var(--gray-400);text-transform:none;font-weight:400;">(kama unayo)</span></label>
          <div class="dyn-file-wrap">
            <input type="file" id="dynOnlineFile"
              accept=".pdf,.jpg,.jpeg,.png,.doc,.docx"
              onchange="handleDynFileSelect(this,'dynOnlineFileLabel','dynOnlineFileTitle','dynOnlineFileSub','dynOnlineFileBadge')">
            <label for="dynOnlineFile" class="dyn-file-label" id="dynOnlineFileLabel">
              <div class="dyn-file-icon">📁</div>
              <div class="dyn-file-text">
                <div class="dyn-file-title" id="dynOnlineFileTitle">Chagua Faili au Gusa Hapa</div>
                <div class="dyn-file-sub" id="dynOnlineFileSub">PDF, Picha, Word — hadi 10 MB</div>
              </div>
              <span class="dyn-file-badge" id="dynOnlineFileBadge">Pakia</span>
            </label>
