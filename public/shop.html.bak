          <div class="top-products-list" id="topProductsList"></div>
        </div>
      </div>

    </div><!-- /analytics tab -->

    <!-- ========== STOCK TAB ========== -->
    <div class="admin-tab-panel" id="adminTab_stock">

      <div class="admin-section-title">
        📦 Usimamizi wa Stok
        <div style="display:flex;gap:8px;">
          <button class="admin-btn gold" onclick="renderStockPanel()">🔄 Refresh</button>
        </div>
      </div>

      <!-- Low stock alert summary -->
      <div id="lowStockAlert" style="background:var(--danger-light);border:1.5px solid var(--danger);border-radius:var(--radius-md);padding:14px 18px;margin-bottom:20px;display:flex;align-items:center;gap:10px;">
        <span style="font-size:22px;">🚨</span>
        <div>
          <div style="font-family:var(--font-head);font-size:13px;font-weight:800;color:var(--danger);">Onyo la Stok Chini</div>
          <div style="font-size:12.5px;color:var(--danger);margin-top:2px;">Bidhaa zinaonyeshwa hapa zimepangwa kutoka kwa idadi ndogo hadi kubwa. Bidhaa chini ya 5 zinaonyeshwa kwa rangi nyekundu.</div>
        </div>
      </div>

      <div class="stock-grid" id="stockGrid"></div>

    </div><!-- /stock tab -->

    <!-- ========== SETUP TAB ========== -->
    <div class="admin-tab-panel" id="adminTab_setup">

      <div class="admin-section-title">🔧 Usanidi wa Mfumo</div>



      <!-- WhatsApp/SMS notification card -->
      <div style="background:var(--white);border:1.5px solid var(--gray-200);border-radius:var(--radius-lg);padding:28px;margin-bottom:20px;max-width:700px;">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
          <span style="font-size:32px;">💬</span>
          <div>
            <div style="font-family:var(--font-head);font-size:16px;font-weight:800;color:var(--navy);">WhatsApp / SMS ya Mmiliki</div>
            <div style="font-size:13px;color:var(--gray-500);margin-top:2px;">Pokea SMS/WhatsApp ya kiotomatiki ukipata agizo jipya</div>
          </div>
        </div>
        <div style="background:var(--success-light);border:1.5px solid #bbf7d0;border-radius:var(--radius-md);padding:14px 16px;margin-bottom:16px;font-size:13px;color:var(--success);">
          ✅ Ujumbe wa WhatsApp unafanya kazi kwa Whapi.cloud. Kila wakati mteja anapoweka oda, ujumbe unatumwa kiotomatiki kupitia Whapi.
        </div>
        <div style="font-size:13px;color:var(--gray-600);line-height:1.7;">
          <strong>Jinsi inavyofanya kazi:</strong><br>
          1. Mteja anaweka oda → oda inahifadhiwa katika dashboard<br>
          2. Kiungo cha WhatsApp kinatengenezwa kwa simu yako (<strong>+255 620 642 652</strong>)<br>
          3. Bonyeza <strong>"💬"</strong> kwenye safu ya oda kuwasiliana moja kwa moja<br>
          4. Kwa automation kamili: Tumia <strong>Whapi.cloud</strong> credentials iliyosanidiwa hapo chini
        </div>
      </div>

      <!-- Export and data management -->
      <div style="background:var(--white);border:1.5px solid var(--gray-200);border-radius:var(--radius-lg);padding:28px;margin-bottom:20px;max-width:700px;">
        <div style="font-family:var(--font-head);font-size:15px;font-weight:800;color:var(--navy);margin-bottom:16px;">🗄️ Usimamizi wa Data</div>
        <div style="display:flex;gap:10px;flex-wrap:wrap;">
          <button class="admin-btn success" onclick="exportOrdersCSV()">📥 Export Orders CSV</button>
          <button class="admin-btn" onclick="if(confirm('Futa historia yote ya maagizo?')){adminOrders=[];saveAdminOrders();renderAdminOrders();showToast('Maagizo yamefutwa','info');}">🗑️ Futa Maagizo Yote</button>
          <button class="admin-btn" onclick="if(confirm('Reset stock yote kwa defaults?')){localStorage.removeItem('letema_stock_v1');loadStockFromStorage();renderStockPanel();showToast('Stock imeresetwa','info');}">🔄 Reset Stock</button>
        </div>
      </div>

      <!-- WhatsApp API (Whapi) credentials card -->
      <div style="background:var(--white);border:1.5px solid var(--gray-200);border-radius:var(--radius-lg);padding:28px;margin-bottom:20px;max-width:700px;">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
          <span style="font-size:32px;">🔑</span>
          <div>
            <div style="font-family:var(--font-head);font-size:16px;font-weight:800;color:var(--navy);">Usanidi wa WhatsApp API (Whapi.cloud)</div>
            <div style="font-size:13px;color:var(--gray-500);margin-top:2px;">Hifadhi credentials za Whapi ili kutuma ujumbe kiotomatiki</div>
          </div>
        </div>
        <div style="background:var(--warning-light);border:1px solid #fde68a;border-radius:var(--radius-sm);padding:10px 14px;margin-bottom:16px;font-size:12px;color:var(--warning);">
          ⚠️ Usishiriki credentials hizi na mtu yeyote. Zinahifadhiwa kwenye kivinjari chako peke yako (localStorage).
        </div>
        <div class="form-group">
          <label class="form-label">Whapi Bearer Token</label>
          <div class="input-group">
            <input class="form-input" type="password" id="setupWhapiToken" placeholder="Weka Whapi token yako hapa...">
            <span class="input-icon" onclick="togglePassword('setupWhapiToken')" style="cursor:pointer;">👁️</span>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Namba ya Simu ya Mmiliki (WhatsApp)</label>
          <input class="form-input" type="tel" id="setupOwnerPhone" placeholder="255620642652 (bila + au nafasi)">
          <div class="form-hint">Namba kamili bila alama ya +. Mfano: 255620642652</div>
        </div>
        <div style="display:flex;gap:10px;margin-top:4px;">
          <button class="admin-btn primary" onclick="saveWhapiCredentials()">💾 Hifadhi Credentials</button>
          <button class="admin-btn" onclick="testWhapiConnection()">🧪 Jaribu Muunganisho</button>
        </div>
      </div>

      <!-- Google Drive Apps Script URL card -->
      <div style="background:var(--white);border:1.5px solid #bbf7d0;border-radius:var(--radius-lg);padding:28px;margin-bottom:20px;max-width:700px;">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
          <span style="font-size:32px;">☁️</span>
          <div>
            <div style="font-family:var(--font-head);font-size:16px;font-weight:800;color:var(--navy);">Google Drive — Apps Script URL</div>
            <div style="font-size:13px;color:var(--gray-500);margin-top:2px;">Faili za huduma zitatumwa kwenye Google Drive yako kiotomatiki</div>
          </div>
        </div>
        <div style="background:#dcfce7;border:1px solid #bbf7d0;border-radius:var(--radius-sm);padding:10px 14px;margin-bottom:16px;font-size:12px;color:#166534;line-height:1.6;">
          📋 <b>Jinsi ya kuweka:</b> Deploy Google Apps Script Web App (code ipo chini ya mfumo), kisha weka URL yake hapa. Mteja anapopakia faili kwenye huduma, itatumwa kwenye Drive yako moja kwa moja.
        </div>
        <div class="form-group">
          <label class="form-label">Apps Script Web App URL</label>
          <input class="form-input" type="url" id="webhookUrlInput" placeholder="https://script.google.com/macros/s/AKfy.../exec">
          <div class="form-hint">URL hii unaipata baada ya Deploy → Deploy as Web App kwenye Google Apps Script</div>
        </div>
        <div style="display:flex;gap:10px;margin-top:4px;flex-wrap:wrap;">
          <button class="admin-btn primary" onclick="saveAppsScriptUrl()">💾 Hifadhi URL</button>
          <button class="admin-btn" onclick="testAppsScriptUrl()">🧪 Jaribu Muunganisho</button>
        </div>
        <div id="appsScriptTestResult" style="display:none;margin-top:10px;font-size:12px;padding:8px 12px;border-radius:6px;"></div>
      </div>

      <!-- Admin password change card -->
      <div style="background:var(--white);border:1.5px solid var(--gray-200);border-radius:var(--radius-lg);padding:28px;max-width:700px;">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
          <span style="font-size:32px;">🔐</span>
          <div>
            <div style="font-family:var(--font-head);font-size:16px;font-weight:800;color:var(--navy);">Badilisha Nywila ya Admin</div>
            <div style="font-size:13px;color:var(--gray-500);margin-top:2px;">Nywila mpya itahifadhiwa kwenye kivinjari hiki</div>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Nywila ya Sasa</label>
          <div class="input-group">
            <input class="form-input" type="password" id="setupOldPass" placeholder="Nywila ya sasa...">
            <span class="input-icon" onclick="togglePassword('setupOldPass')" style="cursor:pointer;">👁️</span>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Nywila Mpya</label>
          <div class="input-group">
            <input class="form-input" type="password" id="setupNewPass" placeholder="Nywila mpya (angalau herufi 8)...">
            <span class="input-icon" onclick="togglePassword('setupNewPass')" style="cursor:pointer;">👁️</span>
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Thibitisha Nywila Mpya</label>
          <input class="form-input" type="password" id="setupConfirmPass" placeholder="Rudia nywila mpya...">
        </div>
        <button class="admin-btn primary" onclick="changeAdminPassword()" style="margin-top:4px;">🔒 Badilisha Nywila</button>
      </div>

      <!-- ===== RECOVERY CODE ===== -->
      <div style="background:var(--white);border:1.5px solid var(--gold);border-radius:var(--radius-lg);padding:28px;max-width:700px;margin-top:18px;">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px;">
          <span style="font-size:32px;">🔑</span>
          <div>
            <div style="font-family:var(--font-head);font-size:16px;font-weight:800;color:var(--navy);">Recovery Code (Backup)</div>
            <div style="font-size:13px;color:var(--gray-500);margin-top:2px;">Tumia code hii kuweka upya nywila kama umesahau</div>
          </div>
        </div>
        <div id="recoveryCodeDisplay" style="background:var(--gray-100);border:2px dashed var(--navy);border-radius:8px;padding:16px;text-align:center;font-family:monospace;font-size:18px;font-weight:800;color:var(--navy);letter-spacing:2px;margin-bottom:12px;">
          —
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
          <button class="admin-btn gold" onclick="generateNewRecoveryCode()">♻️ Tengeneza Code Mpya</button>
          <button class="admin-btn" onclick="copyRecoveryCode()">📋 Nakili</button>
          <button class="admin-btn" onclick="downloadRecoveryCode()">📥 Pakua (.txt)</button>
        </div>
        <div style="margin-top:12px;padding:10px;background:#fff8e1;border-left:3px solid var(--gold);border-radius:6px;font-size:12px;color:var(--gray-700);line-height:1.6;">
          ⚠️ <b>Muhimu:</b> Hifadhi recovery code mahali salama (mfano: notebook, password manager).
          Bila code hii, kama umesahau nywila, italazimika kufanya factory reset kwa kufuta data ya kivinjari.
        </div>
      </div>

    </div><!-- /setup tab -->

    <!-- ========== PRODUCTS MANAGEMENT TAB ========== -->
    <div class="admin-tab-panel" id="adminTab_products">

      <div class="admin-section-title">
        🏷️ Usimamizi wa Bidhaa
        <div style="display:flex;gap:8px;flex-wrap:wrap;">
          <button class="admin-btn gold" onclick="toggleAddProductForm()">➕ Ongeza Bidhaa Mpya</button>
          <button class="admin-btn" onclick="openCsvImport()">📥 Import CSV</button>
          <button class="admin-btn" onclick="renderAdminProducts()">🔄 Refresh</button>
        </div>
      </div>

      <!-- CSV import form (hidden by default) -->
      <div id="csvImportForm" class="admin-mgmt-form" style="display:none;border-color:#3b82f6;box-shadow:0 4px 20px rgba(59,130,246,0.12);">
        <div class="admin-mgmt-form-title" style="border-color:#dbeafe;">📥 Bulk Import / Update Products kutoka CSV</div>
        <div style="font-size:12.5px;color:var(--gray-600);line-height:1.6;margin-bottom:14px;">
          Pakia CSV yenye headers: <code style="background:var(--off-white);padding:2px 6px;border-radius:4px;">name, price, category</code>
          (zinahitajika), na hiari: <code style="background:var(--off-white);padding:2px 6px;border-radius:4px;">legacy_id, icon, badge, description, stock_quantity, is_active</code>.
          Ukitumia <strong>legacy_id</strong>, bidhaa ya zamani itasasishwa (upsert). Bila legacy_id, bidhaa mpya itaongezwa.
        </div>
        <div style="display:flex;gap:10px;margin-bottom:12px;flex-wrap:wrap;">
          <button class="admin-btn" onclick="downloadCsvTemplate()">📋 Pakua CSV Template</button>
          <label class="admin-btn primary" style="cursor:pointer;">
            📁 Chagua CSV File
            <input type="file" accept=".csv,text/csv" onchange="handleCsvFile(this)" style="display:none;">
          </label>
          <button class="admin-btn success" id="csvUploadBtn" onclick="uploadCsvToSupabase()" disabled>📤 Pakia kwa Supabase</button>
          <button class="admin-btn" onclick="openCsvImport()">✕ Funga</button>
        </div>
        <div id="csvSummary" style="font-size:12.5px;color:var(--navy);font-weight:700;margin-bottom:8px;"></div>
        <div id="csvValidation" style="font-size:12.5px;line-height:1.5;margin-bottom:10px;"></div>
        <div id="csvDiffSummary" style="display:none;background:var(--off-white);border:1px solid var(--gray-200);border-radius:var(--radius-md);padding:10px 12px;margin-bottom:10px;font-size:12.5px;">
          <div style="font-weight:800;color:var(--navy);margin-bottom:6px;">🔍 Preview ya Import (kabla haijakimbia)</div>
          <div id="csvDiffStats" style="display:flex;gap:14px;flex-wrap:wrap;margin-bottom:8px;"></div>
          <details><summary style="cursor:pointer;color:var(--navy);">Onyesha rows kwa kategoria</summary>
            <div id="csvDiffLists" style="margin-top:8px;font-size:12px;"></div>
          </details>
        </div>
        <div id="csvPreview" class="csv-preview"></div>
      </div>

      <!-- Add new product form (hidden by default) -->
      <div id="addProductForm" class="admin-mgmt-form" style="display:none;">
        <div class="admin-mgmt-form-title">➕ Ongeza Bidhaa Mpya</div>
        <div class="mgmt-grid-2">
          <div class="form-group" style="margin:0;">
            <label class="form-label">📝 Jina la Bidhaa <span style="color:var(--danger)">*</span></label>
            <input class="form-input" type="text" id="newProdName" placeholder="Mfano: Kalamu ya Bluu (Box 10)">
          </div>
          <div class="form-group" style="margin:0;">
            <label class="form-label">💰 Bei (TZS) <span style="color:var(--danger)">*</span></label>
            <input class="form-input" type="number" id="newProdPrice" placeholder="3500" min="0">
          </div>
          <div class="form-group" style="margin:0;">
            <label class="form-label">📂 Kategoria <span style="color:var(--danger)">*</span></label>
            <select class="form-input" id="newProdCat">
              <option value="">-- Chagua Kategoria --</option>
              <option value="shule">📚 Vifaa Shule</option>
              <option value="ofisi">🗂️ Vifaa Ofisi</option>
              <option value="dijitali">💾 Kidijitali</option>
              <option value="tech">🔌 Tech</option>
              <option value="michezo">⚽ Vifaa Michezo</option>
              <option value="picha">📸 Picha</option>
            </select>
          </div>
          <div class="form-group" style="margin:0;">
            <label class="form-label">😊 Ikoni (emoji moja) <span style="color:var(--gray-400);font-weight:400;text-transform:none;font-size:10px;">inarudishwa 📦 kama wazi</span></label>
            <input class="form-input" type="text" id="newProdIcon" placeholder="✏️" maxlength="4">
          </div>
          <div class="form-group" style="margin:0;">
            <label class="form-label">🏷️ Badge</label>
            <select class="form-input" id="newProdBadge">
              <option value="">Hakuna Badge</option>
              <option value="hot">🔥 Hot — Maarufu</option>
              <option value="new">✨ Mpya</option>
              <option value="sale">🏷️ Sale</option>
            </select>
          </div>
          <div class="form-group" style="margin:0;">
            <label class="form-label">📦 Idadi ya Stok <span style="color:var(--gray-400);font-weight:400;text-transform:none;font-size:10px;">acha wazi = bila kikomo</span></label>
            <input class="form-input" type="number" id="newProdStock" placeholder="50" min="0">
          </div>
        </div>
        <div class="form-group" style="margin-bottom:16px;">
          <label class="form-label">📄 Maelezo ya Bidhaa <span style="color:var(--danger)">*</span></label>
          <textarea class="form-input" id="newProdDesc" rows="3" style="resize:vertical;" placeholder="Elezea bidhaa hii kwa undani — ubora, ukubwa, matumizi na vipengele vyake..."></textarea>
        </div>
        <div style="display:flex;gap:10px;">
          <button class="admin-btn primary" onclick="addNewProduct()">💾 Hifadhi Bidhaa</button>
          <button class="admin-btn" onclick="toggleAddProductForm()">✕ Funga Fomu</button>
        </div>
      </div>

      <!-- Products table -->
      <div class="orders-table-wrap">
        <div style="overflow-x:auto;">
          <table class="orders-table">
            <thead>
              <tr>
                <th style="width:52px;text-align:center;">Ikoni</th>
                <th>Jina la Bidhaa / Kategoria</th>
                <th>Bei ya Sasa</th>
                <th>Stok</th>
                <th>Hatua</th>
              </tr>
            </thead>
            <tbody id="adminProductsList"></tbody>
          </table>
          <div id="adminProductsEmpty" style="display:none;text-align:center;padding:48px 24px;color:var(--gray-400);">
            <div style="font-size:40px;margin-bottom:12px;">📦</div>
            <div style="font-family:var(--font-head);font-weight:700;font-size:15px;">Hakuna bidhaa bado</div>
          </div>
        </div>
      </div>

    </div><!-- /products tab -->

    <!-- ========== SERVICES MANAGEMENT TAB ========== -->
    <div class="admin-tab-panel" id="adminTab_services">

      <div class="admin-section-title">
        🛠️ Usimamizi wa Huduma
        <div style="display:flex;gap:8px;">
          <button class="admin-btn gold" onclick="toggleAddServiceForm()">➕ Ongeza Huduma Mpya</button>
          <button class="admin-btn" onclick="renderAdminServices()">🔄 Refresh</button>
        </div>
      </div>

      <!-- Add new service form (hidden by default) -->
      <div id="addServiceForm" class="admin-mgmt-form" style="display:none;">
        <div class="admin-mgmt-form-title">➕ Ongeza Huduma Mpya</div>
        <div class="mgmt-grid-2">
          <div class="form-group" style="margin:0;">
            <label class="form-label">📝 Jina la Huduma <span style="color:var(--danger)">*</span></label>
            <input class="form-input" type="text" id="newSvcName" placeholder="Mfano: Lamination A4">
          </div>
          <div class="form-group" style="margin:0;">
            <label class="form-label">💰 Bei (maandishi) <span style="color:var(--danger)">*</span></label>
            <input class="form-input" type="text" id="newSvcPrice" placeholder="TZS 2,000 au TZS 500/ukurasa">
          </div>
          <div class="form-group" style="margin:0;">
            <label class="form-label">😊 Ikoni (emoji moja)</label>
            <input class="form-input" type="text" id="newSvcIcon" placeholder="🛠️" maxlength="4">
          </div>
          <div class="form-group" style="margin:0;">
            <label class="form-label">📂 Kategoria</label>
            <select class="form-input" id="newSvcCat">
              <option value="huduma">🖨️ Huduma za Kawaida</option>
              <option value="picha">📸 Picha</option>
              <option value="kitaalamu">💼 Kitaalamu</option>
              <option value="serikali">🏛️ Huduma za Serikali</option>
              <option value="dijital-mawasiliano">📡 Kidijitali &amp; Mawasiliano</option>
            </select>
          </div>
        </div>
        <div class="form-group" style="margin-bottom:12px;">
          <label class="form-label">📄 Maelezo ya Huduma <span style="color:var(--danger)">*</span></label>
          <textarea class="form-input" id="newSvcDesc" rows="3" style="resize:vertical;" placeholder="Elezea huduma hii kwa undani — inafanya nini, inafaa nani, inachukua muda gani..."></textarea>
        </div>
        <div class="form-group" style="margin-bottom:12px;">
          <label class="form-label">📋 Mahitaji ya Mteja <span style="color:var(--danger)">*</span> <span style="font-size:10px;color:var(--gray-400);text-transform:none;font-weight:400;">(kila mstari mpya = mahitaji moja)</span></label>
          <textarea class="form-input" id="newSvcReqs" rows="5" style="resize:vertical;font-size:13px;line-height:1.7;" placeholder="Hati yako ya asili&#10;Idadi ya nakala unazohitaji&#10;Aina ya nakala (rangi au B&amp;W)&#10;Maelekezo maalum yoyote"></textarea>
        </div>
        <div class="form-group" style="margin-bottom:18px;">
          <label style="display:flex;align-items:center;gap:10px;cursor:pointer;font-family:var(--font-head);font-size:13px;font-weight:700;color:var(--gray-700);padding:12px 14px;border:1.5px solid var(--gray-200);border-radius:var(--radius-sm);transition:var(--transition);" onmouseover="this.style.borderColor='var(--gold)'" onmouseout="this.style.borderColor='var(--gray-200)'">
            <input type="checkbox" id="newSvcGold" style="width:17px;height:17px;accent-color:var(--gold);cursor:pointer;">
            <span>⭐ Huduma ya Premium — itaonyeshwa na mstari wa dhahabu na badge ya <b>Premium</b></span>
          </label>
        </div>
        <div style="display:flex;gap:10px;">
          <button class="admin-btn primary" onclick="addNewService()">💾 Hifadhi Huduma</button>
          <button class="admin-btn" onclick="toggleAddServiceForm()">✕ Funga Fomu</button>
