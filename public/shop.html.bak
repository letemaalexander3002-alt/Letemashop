      <span class="footer-link" onclick="window.open('https://wa.me/255620642652','_blank')">💬 Wasiliana Nasi</span>
      <span class="footer-link" onclick="showToast('Bidhaa zote zinakaguliwa kabla ya kutumwa. Hakuna ubadilishaji baada ya kuthibitishwa.','info')">Masharti ya Matumizi</span>
    </div>
