// =====================================================
// ===== NEW: Invoice settings editor =====
// =====================================================
let _invSettingsCache = null;

async function loadInvoiceSettingsToForm() {
  if (!window.letemaSupabase) return;
  const s = await window.letemaSupabase.fetchInvoiceSettings();
  _invSettingsCache = s || {};
  const set = (id, v) => { const el = document.getElementById(id); if (el && v != null) el.value = v; };
  set('invSetCompany', _invSettingsCache.company_name);
  set('invSetTagline', _invSettingsCache.company_tagline);
  set('invSetAddress', _invSettingsCache.address);
  set('invSetContact', _invSettingsCache.contact_line);
  set('invSetVatLabel', _invSettingsCache.vat_label);
  set('invSetVatRate', _invSettingsCache.vat_rate);
  set('invSetPrefix',  _invSettingsCache.invoice_prefix);
  set('invSetNext',    _invSettingsCache.next_number);
  set('invSetFooter',  _invSettingsCache.footer_note);
  const prev = document.getElementById('invSetPreview');
  if (prev && _invSettingsCache.invoice_prefix != null && _invSettingsCache.next_number != null) {
    prev.textContent = _invSettingsCache.invoice_prefix + String(_invSettingsCache.next_number).padStart(5, '0');
  }
}

async function saveInvoiceSettings() {
  if (!window.letemaSupabase) return;
  const before = _invSettingsCache ? { ..._invSettingsCache } : null;
  const patch = {
    company_name:    document.getElementById('invSetCompany').value.trim() || 'LETEMA STATIONERY',
    company_tagline: document.getElementById('invSetTagline').value.trim() || null,
    address:         document.getElementById('invSetAddress').value.trim() || null,
    contact_line:    document.getElementById('invSetContact').value.trim() || null,
    vat_label:       document.getElementById('invSetVatLabel').value.trim() || 'VAT (18%)',
    vat_rate:        parseFloat(document.getElementById('invSetVatRate').value) || 18,
    invoice_prefix:  document.getElementById('invSetPrefix').value.trim() || 'LET-INV-',
    next_number:     Math.max(1, parseInt(document.getElementById('invSetNext').value, 10) || 1),
    footer_note:     document.getElementById('invSetFooter').value.trim() || null
  };
  const { error } = await window.letemaSupabase.updateInvoiceSettings(patch);
  if (error) { showToast('⚠️ Imeshindwa: ' + (error.message || error), 'error'); return; }
  await window.letemaSupabase.audit({
    actor: 'admin', action: 'invoice_settings.update', entity: 'invoice_settings', entity_id: '1',
    before_data: before, after_data: patch
  });
  showToast('✅ Mipangilio ya invoice imehifadhiwa.', 'success');
  loadInvoiceSettingsToForm();
}

// =====================================================
// ===== NEW: Wrapper for Generate Invoice PDF =====
// =====================================================
// Generate the invoice. By default opens a preview modal first; pass
// { skipPreview: true } to download immediately (back-compat).
async function generateInvoicePDF(ref, opts) {
  if (!window.letemaSupabase) { _legacyGenerateInvoicePDF(ref, null, null, { mode: 'save' }); return; }
  const settings = await window.letemaSupabase.fetchInvoiceSettings();
  // Don't burn an invoice number for the preview — only when user confirms.
  if (opts && opts.skipPreview) {
    const invNum = await window.letemaSupabase.issueInvoiceNumber();
    _legacyGenerateInvoicePDF(ref, settings, invNum, { mode: 'save' });
    return;
  }
  openInvoicePreview(ref, settings);
}

// =====================================================
// ===== NEW: Invoice preview modal =====
// =====================================================
async function openInvoicePreview(ref, settings) {
  let modal = document.getElementById('invoicePreviewModal');
  if (!modal) {
    modal = document.createElement('div');
    modal.id = 'invoicePreviewModal';
    modal.className = 'modal-overlay';
    modal.onclick = (e) => closeModalOutside(e, 'invoicePreviewModal');
    modal.innerHTML = `
      <div class="modal" style="max-width:880px;width:96%;">
        <div class="modal-header">
          <h3>📑 Invoice Preview</h3>
          <button class="modal-close" onclick="closeModal('invoicePreviewModal')">✕</button>
        </div>
        <div class="modal-body" style="padding:0;">
          <div style="display:flex;gap:8px;flex-wrap:wrap;padding:12px 16px;border-bottom:1px solid var(--gray-200);background:var(--off-white);">
            <div id="invPreviewMeta" style="font-size:12.5px;color:var(--gray-500);flex:1;align-self:center;">—</div>
            <button class="admin-btn" onclick="closeModal('invoicePreviewModal')">↩ Funga</button>
            <button class="admin-btn primary" id="invPreviewConfirmBtn" onclick="confirmGenerateInvoiceFromPreview()">📥 Toa & Pakua PDF</button>
          </div>
          <iframe id="invPreviewFrame" style="display:block;width:100%;height:70vh;border:0;background:#525659;"></iframe>
        </div>
      </div>`;
    document.body.appendChild(modal);
  }
  openModal('invoicePreviewModal');
  document.getElementById('invPreviewMeta').textContent = 'Inatengeneza preview…';
  document.getElementById('invPreviewFrame').src = 'about:blank';
  // Render with a placeholder invoice number — user has not committed yet.
  const placeholderNum = (settings && settings.invoice_prefix ? settings.invoice_prefix : 'LET-INV-') + 'PREVIEW';
  const blobUrl = _legacyGenerateInvoicePDF(ref, settings, placeholderNum, { mode: 'preview' });
  if (!blobUrl) { document.getElementById('invPreviewMeta').textContent = '⚠️ Imeshindwa kutengeneza preview.'; return; }
  document.getElementById('invPreviewMeta').innerHTML = `Order <b>${escapeHTML(ref)}</b> · Invoice number itatolewa baada ya kuthibitisha.`;
  document.getElementById('invPreviewFrame').src = blobUrl;
  // Stash for confirm step
  document.getElementById('invPreviewConfirmBtn').dataset.ref = ref;
}

async function confirmGenerateInvoiceFromPreview() {
  const ref = document.getElementById('invPreviewConfirmBtn').dataset.ref;
  if (!ref) return;
  closeModal('invoicePreviewModal');
  await generateInvoicePDF(ref, { skipPreview: true });
}

// =====================================================
// ===== NEW: Audit log loader (with FTS + quick filters) =====
// =====================================================
let _lastAuditEvents = [];

function auditQuickFilter(kind) {
  const setEl = (id, v) => { const e = document.getElementById(id); if (e) e.value = v; };
  setEl('audSearch', '');
  setEl('audActor', '');
  if (kind === 'all')         setEl('audAction', '');
  else if (kind === 'csv')    setEl('audAction', 'csv.import');
  else if (kind === 'order')  setEl('audAction', 'order.status_change');
  else if (kind === 'lockout')setEl('audAction', 'auth.lockout');
  else if (kind === 'otp') {
    // multi-action filter via comma-separated value our searchAuditLog understands
    setEl('audAction', 'auth.otp_send,auth.otp_fail,auth.lockout,auth.login');
  }
  loadAuditLog();
}

// =========================================================
// ===== WATEJA (CUSTOMERS) TAB — v16 =====
// =========================================================
function _buildCustomersFromOrders(orders) {
  // Group orders by phone (primary key); fallback to customer name
  const map = {};
  orders.forEach(o => {
    const key = (o.phone || '').trim() || (o.customer || '').trim().toLowerCase();
    if (!key) return;
    if (!map[key]) {
      map[key] = {
        name:       o.customer || '—',
        phone:      o.phone    || '—',
        email:      o.email    || '',
        orders:     [],
        totalAll:   0,
        totalPaid:  0,
        lastDate:   o.timestamp || o.date || '',
      };
    }
    const rec = map[key];
    rec.orders.push(o);
    rec.totalAll  += (o.total || 0);
    if ((o.status || '').toLowerCase() === 'paid' || (o.status || '').toLowerCase() === 'completed') {
      rec.totalPaid += (o.total || 0);
    }
    // Keep most recent date
    const d = o.timestamp || o.date || '';
    if (d > rec.lastDate) rec.lastDate = d;
    // Prefer the record with a real name
    if (!rec.name || rec.name === '—') rec.name = o.customer || rec.name;
    if (!rec.email && o.email) rec.email = o.email;
  });
  // Convert to sorted array (most total spent first)
  return Object.values(map).sort((a, b) => b.totalPaid - a.totalPaid || b.totalAll - a.totalAll);
}

function renderCustomersTab(filter) {
  const filterVal = (filter !== undefined ? filter : (document.getElementById('customersSearch')?.value || '')).trim().toLowerCase();

  // Build customer list from adminOrders (localStorage) + any Supabase fetch
  let customerList = _buildCustomersFromOrders(adminOrders);

  // Update stat cards
  const totalPaidAll = customerList.reduce((s, c) => s + c.totalPaid, 0);
  const avgOrders    = customerList.length > 0 ? (customerList.reduce((s, c) => s + c.orders.length, 0) / customerList.length).toFixed(1) : 0;
  const topSpender   = customerList[0];

  setElText('cst_totalCustomers', customerList.length);
  setElText('cst_totalRevenue',   'TZS ' + totalPaidAll.toLocaleString());
  setElText('cst_topSpender',     topSpender ? topSpender.name : '—');
  setElText('cst_avgOrders',      avgOrders);

  // Update badge
  const badge = document.getElementById('adminCustomersBadge');
  if (badge) { badge.textContent = customerList.length; badge.classList.toggle('hidden', customerList.length === 0); }

  // Filter
  if (filterVal) {
    customerList = customerList.filter(c =>
      (c.name  || '').toLowerCase().includes(filterVal) ||
      (c.phone || '').toLowerCase().includes(filterVal) ||
      (c.email || '').toLowerCase().includes(filterVal)
    );
  }

  const tbody = document.getElementById('customersTableBody');
  if (!tbody) return;

  if (customerList.length === 0) {
    tbody.innerHTML = `<tr><td colspan="9" style="padding:40px;text-align:center;color:var(--gray-400);">
      ${filterVal ? '🔎 Hakuna mteja anayelingana na utafutaji.' : '👥 Bado hakuna wateja waliohifadhiwa.'}
    </td></tr>`;
    return;
  }

  const rankEmoji = ['🥇','🥈','🥉'];

  tbody.innerHTML = customerList.map((c, i) => {
    const rank     = rankEmoji[i] || `<span style="font-weight:800;color:var(--gray-500);">${i+1}</span>`;
    const phone    = c.phone !== '—' ? `<a href="tel:${c.phone}" style="color:var(--navy);font-weight:600;">${escapeHTML(c.phone)}</a>` : '—';
    const waLink   = c.phone !== '—' ? `<a href="https://wa.me/${c.phone.replace(/[^0-9]/g,'')}" target="_blank" title="WhatsApp" style="text-decoration:none;">💬</a>` : '';
    const email    = c.email ? `<span style="font-size:11.5px;color:var(--gray-500);">${escapeHTML(c.email)}</span>` : '<span style="color:var(--gray-300);">—</span>';
    const paidBadge = c.totalPaid > 0
      ? `<span style="background:#ecfdf5;color:#059669;border:1px solid #a7f3d0;padding:2px 8px;border-radius:50px;font-weight:800;font-size:11.5px;">TZS ${c.totalPaid.toLocaleString()}</span>`
      : `<span style="color:var(--gray-300);">—</span>`;
    const allAmt   = `<span style="font-weight:700;">TZS ${c.totalAll.toLocaleString()}</span>`;
    const lastOda  = c.lastDate || '—';
    const orderCount = `<span style="background:#eef2ff;color:#3730a3;border-radius:50px;padding:2px 10px;font-weight:800;font-size:12px;">${c.orders.length}</span>`;

    return `<tr>
      <td style="text-align:center;font-size:18px;">${rank}</td>
      <td class="customer" style="font-weight:700;">${escapeHTML(c.name)}</td>
      <td>${phone} ${waLink}</td>
      <td>${email}</td>
      <td style="text-align:center;">${orderCount}</td>
      <td>${allAmt}</td>
      <td>${paidBadge}</td>
      <td style="font-size:11.5px;color:var(--gray-500);">${escapeHTML(lastOda)}</td>
      <td>
        <div style="display:flex;gap:6px;flex-wrap:wrap;">
          <button class="admin-btn" style="font-size:11px;padding:5px 10px;" onclick="adminFilterOrdersByCustomer('${escapeHTML(c.name).replace(/'/g,"\\'")}')">📋 Oda</button>
          ${c.phone !== '—' ? `<a href="https://wa.me/${c.phone.replace(/[^0-9]/g,'')}" target="_blank" class="admin-btn success" style="font-size:11px;padding:5px 10px;text-decoration:none;">💬 WA</a>` : ''}
        </div>
      </td>
    </tr>`;
  }).join('');
}

function setElText(id, val) {
  const el = document.getElementById(id);
  if (el) el.textContent = val;
}

function adminFilterOrdersByCustomer(name) {
  switchAdminTab('orders');
  setTimeout(() => {
    const searchEl = document.getElementById('ordersSearch') || document.querySelector('.admin-search');
    if (searchEl) { searchEl.value = name; }
    if (typeof renderAdminOrders === 'function') renderAdminOrders(name.toLowerCase());
  }, 100);
}

function exportCustomersCSV() {
  const customerList = _buildCustomersFromOrders(adminOrders);
  const header = ['Nafasi','Jina','Simu','Barua Pepe','Oda','Mapato Yote (TZS)','Malipo PAID (TZS)','Oda ya Mwisho'];
  const rows   = customerList.map((c, i) => [
    i + 1, c.name, c.phone, c.email || '', c.orders.length, c.totalAll, c.totalPaid, c.lastDate
  ]);
  const csv = [header, ...rows].map(r => r.map(v => `"${String(v).replace(/"/g,'""')}"`).join(',')).join('\n');
  const blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });
  const url  = URL.createObjectURL(blob);
  const a    = document.createElement('a');
  a.href = url; a.download = `letema_wateja_${new Date().toISOString().slice(0,10)}.csv`; a.click();
  URL.revokeObjectURL(url);
  showToast('📥 CSV ya wateja imesafirishwa!', 'success');
  try { logAdminActivity && logAdminActivity('customers_csv_export', 'info', { count: customerList.length }); } catch(e) {}
}

// =========================================================
async function loadAuditLog() {
  if (!window.letemaSupabase) return;
  const tbody = document.getElementById('auditLogBody');
  tbody.innerHTML = '<tr><td colspan="5" style="padding:20px;text-align:center;color:var(--gray-400);">⏳ Inapakia...</td></tr>';
  const fromVal = document.getElementById('audFrom').value;
  const toVal   = document.getElementById('audTo').value;
  const search  = (document.getElementById('audSearch')?.value || '').trim();
  const filters = {
    q:      search || undefined,
    actor:  document.getElementById('audActor').value.trim() || undefined,
    action: document.getElementById('audAction').value || undefined,
    from:   fromVal ? new Date(fromVal).toISOString() : undefined,
    to:     toVal   ? new Date(toVal).toISOString()   : undefined,
    limit:  500
  };
  // Prefer the new FTS-aware fetcher; fall back to the legacy one.
  const fetcher = window.letemaSupabase.searchAuditLog || window.letemaSupabase.fetchAuditLog;
  const events = await fetcher(filters);
  _lastAuditEvents = events;
  if (!events.length) {
    tbody.innerHTML = '<tr><td colspan="5" style="padding:20px;text-align:center;color:var(--gray-400);">Hakuna events zilizopatikana.</td></tr>';
    return;
  }
  tbody.innerHTML = events.map(ev => {
    const t = new Date(ev.occurred_at).toLocaleString('en-TZ', { dateStyle:'short', timeStyle:'medium' });
    let detail = '';
    if (ev.action === 'order.status_change' && ev.before_data && ev.after_data) {
      detail = `${escapeHTML(ev.before_data.status||'?')} → <b>${escapeHTML(ev.after_data.status||'?')}</b>`;
    } else if (ev.action === 'csv.import' && ev.meta) {
      detail = `+${ev.meta.inserted||0} mpya · ~${ev.meta.updated||0} updated · =${ev.meta.skipped||0} skipped`;
    } else if (ev.meta || ev.before_data || ev.after_data) {
      const obj = ev.after_data || ev.meta || ev.before_data;
      detail = '<code style="font-size:11px;color:var(--gray-500);">' + escapeHTML(JSON.stringify(obj).slice(0,140)) + '</code>';
    }
    return `<tr style="border-top:1px solid var(--gray-100);">
      <td style="padding:8px 10px;white-space:nowrap;color:var(--gray-500);">${t}</td>
      <td style="padding:8px 10px;font-weight:700;color:var(--navy);">${escapeHTML(ev.actor || '—')}</td>
      <td style="padding:8px 10px;"><code style="font-size:11.5px;background:#f1f5f9;padding:2px 6px;border-radius:4px;">${escapeHTML(ev.action)}</code></td>
      <td style="padding:8px 10px;">${escapeHTML(ev.entity || '—')}${ev.entity_id ? ' · '+escapeHTML(ev.entity_id) : ''}</td>
      <td style="padding:8px 10px;">${detail}</td>
    </tr>`;
  }).join('');
}

// =====================================================
// ===== NEW: Order timeline modal (admin) — w/ exports
// =====================================================
function _timelineLabels() {
  return { new:'Placed', pending:'Placed', confirmed:'Confirmed', paid:'Paid', shipped:'Shipped', delivered:'Delivered', cancelled:'Cancelled' };
}

function exportTimelineCSV(ref) {
  const events = _timelineCache[ref] || [];
  const labels = _timelineLabels();
  const header = ['order_ref','status','status_label','changed_at','changed_by','notes'];
  const esc = v => {
    if (v == null) return '';
    const s = String(v).replace(/"/g, '""');
    return /[",\n]/.test(s) ? `"${s}"` : s;
  };
  const rows = [header.join(',')].concat(events.map(ev => [
    ref, ev.status, labels[ev.status] || ev.status, ev.changed_at, ev.changed_by || '', ev.notes || ''
  ].map(esc).join(',')));
  const blob = new Blob(['\uFEFF' + rows.join('\n')], { type: 'text/csv;charset=utf-8;' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = `Letema_Timeline_${ref}.csv`;
  a.click();
  setTimeout(() => URL.revokeObjectURL(a.href), 1500);
  showToast('📥 Timeline CSV imepakuliwa.', 'success');
}

function exportTimelinePDF(ref) {
  const events = _timelineCache[ref] || [];
  if (!window.jspdf || !window.jspdf.jsPDF) { showToast('⚠️ PDF library haijapakiwa.', 'error'); return; }
  try {
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF({ unit: 'mm', format: 'a4' });
    const pageW = doc.internal.pageSize.getWidth();
    doc.setFillColor(0, 48, 135); doc.rect(0, 0, pageW, 22, 'F');
    doc.setTextColor(255, 255, 255); doc.setFont('helvetica', 'bold'); doc.setFontSize(16);
    doc.text('Delivery Timeline', 14, 14);
    doc.setFontSize(10); doc.setFont('helvetica','normal');
    doc.text('Order: ' + ref, pageW - 14, 14, { align: 'right' });
    const labels = _timelineLabels();
    const body = events.map(ev => [
      labels[ev.status] || ev.status,
      new Date(ev.changed_at).toLocaleString('en-TZ', { dateStyle:'medium', timeStyle:'short' }),
      ev.changed_by || '—',
      ev.notes || ''
    ]);
    doc.autoTable({
      startY: 30,
      head: [['Status','When','Changed by','Notes']],
      body: body.length ? body : [['—','—','—','Hakuna events bado']],
      theme: 'striped',
      headStyles: { fillColor: [0,48,135], textColor: 255, fontStyle:'bold' },
      styles: { fontSize: 10, cellPadding: 3 },
      margin: { left: 14, right: 14 }
    });
    doc.save(`Letema_Timeline_${ref}.pdf`);
    showToast('📑 Timeline PDF imepakuliwa.', 'success');
  } catch (e) { console.error(e); showToast('⚠️ PDF imeshindwa: ' + e.message, 'error'); }
}

const _timelineCache = {};

function openTimelineModal(ref) {
  let modal = document.getElementById('orderTimelineModal');
  if (!modal) {
    modal = document.createElement('div');
    modal.id = 'orderTimelineModal';
    modal.className = 'modal-overlay';
    modal.onclick = (e) => closeModalOutside(e, 'orderTimelineModal');
    modal.innerHTML = `
      <div class="modal" style="max-width:560px;">
        <div class="modal-header">
          <h3>🕒 Delivery Timeline</h3>
          <button class="modal-close" onclick="closeModal('orderTimelineModal')">✕</button>
        </div>
        <div class="modal-body" id="orderTimelineBody" style="padding:18px;">⏳ Inapakia...</div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;padding:12px 18px;border-top:1px solid var(--gray-200);background:var(--off-white);">
          <button class="admin-btn" id="tlExportCsvBtn" onclick="exportTimelineCSV(this.dataset.ref)" disabled>📥 Export CSV</button>
          <button class="admin-btn" id="tlExportPdfBtn" onclick="exportTimelinePDF(this.dataset.ref)" disabled>📑 Export PDF</button>
        </div>
      </div>`;
    document.body.appendChild(modal);
  }
  openModal('orderTimelineModal');
  const body = document.getElementById('orderTimelineBody');
  body.innerHTML = '<div style="text-align:center;padding:24px;color:var(--gray-500);">⏳ Inapakia ratiba...</div>';
  // Reset export buttons
  ['tlExportCsvBtn','tlExportPdfBtn'].forEach(id => {
    const b = document.getElementById(id); if (b) { b.disabled = true; b.dataset.ref = ref; }
  });
  if (!window.letemaSupabase) return;
  window.letemaSupabase.fetchOrderStatusEvents(ref).then(events => {
    _timelineCache[ref] = events || [];
    body.innerHTML = `<div style="font-size:12px;color:var(--gray-500);margin-bottom:10px;">Order: <b>${escapeHTML(ref)}</b></div>` + renderTimelineHTML(events);
    ['tlExportCsvBtn','tlExportPdfBtn'].forEach(id => {
      const b = document.getElementById(id); if (b) b.disabled = !(events && events.length);
    });
  });
}

</script>
</body>
</html>
